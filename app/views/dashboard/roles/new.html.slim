= render("dashboard/shared/dashboard_container", current_page: "roles") do
  = render("dashboard/settings/settings_sidebar", current_page: "roles") do
    .body-section.roles-body.team-inboxes-body data-controller="modalToggler frameToggler"
      .roles-header.team-inboxes-header
        .topbar
          h2.f-semi-18 New Role
        .header-options
          .tabs
            = link_to("Teammates", "#", class: "tab f-reg-16")
            / .tab.f-reg-16.active-tab Teammates
            = link_to("Invited", "#", class: "tab f-reg-16")
            / .tab.f-reg-16.active-tab Invited
            = link_to("Roles", roles_settings_path, class: "tab f-reg-16 active-tab")
            / .tab.f-reg-16.active-tab Roles
            = link_to("Activity Logs", "#", class: "tab f-reg-16")
            / .tab.f-reg-16.active-tab Activity Logs
      .roles-container
        = form_for("#", html: {class: "js-form-wizard form-wizard needs-validation", novalidate: true}) do |f|
          .form-fields
            .form-floating
              = f.label :name, "Name"
              = f.text_field :name, class: "form-control f-reg-14", placeholder: "Enter Name", required: true
            .form-floating
              = f.label :description, "Description"
              = f.text_area :description, class: "form-control f-reg-14 st-desc", placeholder: "Description", required: true
            / .form-floating
            /   = f.label :email, "E-Mail"
            /   = f.email_field :email, class: "form-control", autocomplete: "email", placeholder: "E-Mail", required: true
              
            .custom-select data-controller="choices"
              .select-header data-action="click->choices#toggle"
                .tag.f-semi-14.f-semi-14 AI Copilot
                span.f-semi-14#selected-option data-choices-target="selected" Off
                span.arrow ▼

              #options-menu.select-options.hidden data-choices-target="menu"
                label.f-reg-14
                  input type="radio" name="ai-copilot" value="Off" checked=true data-action="change->choices#select"
                  | Off
                label.f-reg-14
                  input type="radio" name="ai-copilot" value="Included Usage" data-action="change->choices#select"
                  | Included Usage
                label.f-reg-14
                  input type="radio" name="ai-copilot" value="Unlimited Usage" data-action="change->choices#select"
                  | Unlimited Usage
                  
