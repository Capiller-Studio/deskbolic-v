- url = macro.persisted? ? macro_path(macro) : macros_path
- method = macro.persisted? ? :patch : :post
- actions = macro.actions.presence || [{}]

= form_with(model: macro, url: url, method: method, class: "ui-settings-editor ui-settings-form ui-macro-editor", data: { controller: "automation-builder", action: "submit->automation-builder#serialize" }) do |f|
  header.ui-settings-editor__header
    = link_to macros_path, class: "ui-settings-editor__back", aria: { label: t("dashboard.macros.form.back", default: "Back to macros") } do
      = inline_svg_tag("back-arrow.svg", aria: { hidden: true })

    .ui-settings-editor__heading
      h1 = page_title
      p = page_description

    .ui-settings-editor__header-actions
      = link_to t("dashboard.teams.form.cancel", default: "Cancel"), macros_path, class: "ui-btn-secondary"
      = button_tag type: "submit", class: "ui-btn-primary" do
        = inline_svg_tag("mark.svg", aria: { hidden: true })
        span = t("ui.dashboard.macros.edit.save_macro", default: "Save Macro")

  .ui-settings-editor__body
    - if macro.errors.any?
      .ui-error-summary role="alert"
        h3 = t("dashboard.macros.form.error_heading", default: "Please correct the following errors")
        ul
          - macro.errors.full_messages.each do |message|
            li = message

    section.ui-form-card.ui-macro-details-card aria-labelledby="macro-details-title"
      header.ui-form-card__header.ui-form-card__header--identity.ui-macro-card-header
        span.ui-form-card__icon aria-hidden="true"
          = inline_svg_tag("pencil.svg")
        h2#macro-details-title = t("dashboard.conversation_details.title", default: "Details")

      .ui-macro-details-grid
        .ui-field-group
          = f.label :name, t("dashboard.macros.form.name", default: "Name"), class: "ui-label"
          .ui-field-control.ui-field-control--plain
            = f.text_field :name, class: "ui-input ui-control", required: true, autocomplete: "off", placeholder: t("dashboard.macros.form.name_placeholder", default: "e.g. Close & Send Feedback")

        .ui-field-group
          = f.label :visibility, t("dashboard.macros.form.visibility", default: "Visibility"), class: "ui-label"
          .ui-field-control.ui-field-control--plain.ui-field-control--no-icon
            = f.select :visibility,
              options_for_select([[t("forms.options.account_wide", default: "Account-wide"), "account_wide"], [t("forms.options.personal", default: "Personal"), "personal"], [t("forms.options.team", default: "Team"), "team"]], macro.visibility),
              {},
              class: "ui-select ui-control",
              data: { controller: "select", action: "change->automation-builder#visibilityChanged" }

        .ui-field-group data-automation-builder-target="teamField" style=(macro.team? ? "" : "display: none;")
          = label_tag "macro[team_id]", t("forms.options.team", default: "Team"), class: "ui-label"
          .ui-field-control.ui-field-control--plain.ui-field-control--no-icon
            = select_tag "macro[team_id]",
              options_for_select(team_options_for_select, (macro.team? ? macro.scopeable_id : nil)),
              include_blank: t("forms.options.select_team", default: "Select team..."),
              class: "ui-select ui-control",
              data: { controller: "select" }

        .ui-field-group
          = f.label :status, t("dashboard.automations.form.status", default: "Status"), class: "ui-label"
          .ui-field-control.ui-field-control--plain.ui-field-control--no-icon
            = f.select :status,
              options_for_select([[t("general.active", default: "Active"), "active"], [t("general.inactive", default: "Inactive"), "inactive"]], macro.status),
              {},
              class: "ui-select ui-control",
              data: { controller: "select" }

        .ui-field-group.ui-macro-description-field
          .ui-macro-label-row
            = f.label :description, t("dashboard.macros.form.description", default: "Description"), class: "ui-label"
            span = t("dashboard.macros.form.optional", default: "(Optional)")
          .ui-macro-description-control
            = f.text_area :description,
              class: "ui-input ui-macro-description",
              rows: 3,
              maxlength: 500,
              placeholder: t("dashboard.macros.form.description_placeholder", default: "What does this macro do?"),
              data: { "automation-builder-target": "descriptionInput", action: "input->automation-builder#updateDescriptionCounter" }
            span.ui-macro-description-count data-automation-builder-target="descriptionCounter"
              = "#{macro.description.to_s.length} / 500"

    section.ui-form-card.ui-macro-actions-card aria-labelledby="macro-actions-title"
      header.ui-form-card__header.ui-form-card__header--identity.ui-macro-card-header
        span.ui-form-card__icon aria-hidden="true"
          = inline_svg_tag("star_plus.svg")
        h2#macro-actions-title = t("dashboard.domains.index.table.actions", default: "Actions")

      .ui-macro-actions-body data-automation-builder-target="actionsContainer"
        .ui-macro-action-headings aria-hidden="true"
          span = t("dashboard.macros.index.action", default: "Action")
          span = t("dashboard.macros.form.action_details", default: "Details")
          span

        .ui-macro-action-rows data-automation-builder-target="actionRows"
          - actions.each_with_index do |action, action_index|
            = render("dashboard/automations/action_row", action: action, action_index: action_index)

        button.ui-macro-add-action type="button" data-action="click->automation-builder#addAction"
          = inline_svg_tag("plus_black.svg", aria: { hidden: true })
          span = t("ui.dashboard.macros.edit.add_action", default: "+ Add Action").delete_prefix("+ ")

    = f.hidden_field :actions, value: (macro.actions || []).to_json, data: { "automation-builder-target": "actionsField" }
