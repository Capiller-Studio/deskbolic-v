= render("dashboard/shared/dashboard_container", current_page: "domains") do
  = render("dashboard/settings/settings_sidebar", current_page: "domains") do
    .body-section.domains-body
      .domains-header
        h2.f-semi-18 = t("dashboard.domains.edit.title")
        = link_to domains_path, class: "back-link"
          span.f-reg-14 = t("dashboard.domains.edit.back")

      .domain-form-container
        / Domain Status Overview
        .domain-status-overview
          .status-row
            span.f-semi-12 = t("dashboard.domains.edit.status_labels.domain")
            span.f-semi-14 = @domain.value

          .status-row
            span.f-semi-12 = t("dashboard.domains.edit.status_labels.type")
            .status-tag class="#{@domain.subdomain? ? 'bg-purple' : 'bg-blue'}"
              .bullet
              span.f-reg-12 = t("domains.statuses.domain_type.#{@domain.domain_type}")

          .status-row
            span.f-semi-12 = t("dashboard.domains.edit.status_labels.dns_status")
            = render "dashboard/domains/dns_status_badge", domain: @domain

          .status-row
            span.f-semi-12 = t("dashboard.domains.edit.status_labels.ssl_status")
            = render "dashboard/domains/ssl_status_badge", domain: @domain

          - if @domain.dns_verified_at.present?
            .status-row
              span.f-semi-12 = t("dashboard.domains.edit.status_labels.dns_verified_at")
              span.f-reg-12 = @domain.dns_verified_at.strftime("%B %d, %Y at %I:%M %p")

          - if @domain.ssl_expires_at.present?
            .status-row
              span.f-semi-12 = t("dashboard.domains.edit.status_labels.ssl_expires_at")
              span.f-reg-12 = @domain.ssl_expires_at.strftime("%B %d, %Y")

          - if @domain.last_checked_at.present?
            .status-row
              span.f-semi-12 = t("dashboard.domains.edit.status_labels.last_checked")
              span.f-reg-12 = t("dashboard.domains.edit.status_labels.ago", time: time_ago_in_words(@domain.last_checked_at))

          - if @domain.portal.present?
            .status-row
              span.f-semi-12 = t("dashboard.domains.edit.status_labels.attached_portal")
              span.f-reg-12 = @domain.portal.name

        / Edit Form (only name is editable)
        = form_with(model: @domain, url: domain_path(@domain), method: :patch, class: "domain-form") do |f|
          - if @domain.errors.any?
            .alert.alert-red
              p.f-semi-14 = t("dashboard.domains.errors.fix_errors")
              ul
                - @domain.errors.full_messages.each do |message|
                  li.f-reg-12 = message

          .form-section
            h3.f-semi-14 = t("dashboard.domains.edit.section_title")

            .form-group
              = f.label :name, class: "f-semi-12"
                = t("dashboard.domains.edit.name_label")
              = f.text_field :name, class: "form-input", placeholder: t("dashboard.domains.edit.name_placeholder"), autocomplete: "off"
              p.form-hint.f-reg-12 = t("dashboard.domains.edit.name_hint")

          .form-actions
            = f.submit t("dashboard.domains.edit.submit"), class: "btn-primary"
            = link_to t("dashboard.domains.edit.cancel"), domains_path, class: "btn-secondary"

        / CNAME Instructions (for custom domains only)
        - if @domain.custom?
          .form-section.cname-info-box
            h3.f-semi-14 = t("dashboard.domains.edit.dns_config_title")
            p.f-reg-12 = t("dashboard.domains.edit.dns_config_desc")
            .cname-record
              .cname-field
                span.f-reg-12.cname-label = t("dashboard.domains.index.cname_instructions.cname_type")
                span.f-semi-12 CNAME
              .cname-field
                span.f-reg-12.cname-label = t("dashboard.domains.index.cname_instructions.cname_host")
                span.f-semi-12 = @domain.value
              .cname-field
                span.f-reg-12.cname-label = t("dashboard.domains.index.cname_instructions.cname_target")
                span.f-semi-12 = @domain.cname_target

          - unless @domain.dns_verified?
            .form-actions
              = link_to verify_dns_domain_path(@domain), method: :post, class: "btn-primary"
                = t("dashboard.domains.edit.verify_now")
