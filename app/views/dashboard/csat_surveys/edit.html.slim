= render("dashboard/shared/dashboard_container", current_page: "csat-surveys") do
  = render("dashboard/settings/settings_sidebar", current_page: "csat-surveys") do
    .ui-settings-editor.ap-settings-editor
      header.ui-settings-editor__header
        = link_to csat_surveys_path, class: "ui-settings-editor__back", aria: { label: t("shared.back", default: "Back") } do
          = inline_svg_tag("back_arrow.svg", aria: { hidden: true })
        .ui-settings-editor__heading
          h1 = t("dashboard.csat_surveys.edit.title")
          p = t("dashboard.csat_surveys.edit.description")
        .ui-settings-editor__header-actions
          = link_to t("dashboard.assignment_policies.form.cancel", default: "Cancel"), csat_surveys_path, class: "ui-btn-secondary"
          button.ap-btn-save-header type="submit" form="csat-survey-form"
            = image_tag("mark.svg", class: "ap-save-mark-icon", alt: "")
            span = t("dashboard.csat_surveys.form.save_policy", default: "Save Policy")
      .ui-settings-editor__body
        = render "form", survey: @csat_survey
