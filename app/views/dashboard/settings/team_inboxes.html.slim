                        th.f-semi-14 = t("ui.dashboard.settings.team_inboxes.user")
                        th.f-semi-14 = t("dashboard.profile.index.status_label")
                        th.f-semi-14 = t("dashboard.profile.index.email")
                        th.f-semi-14 = t("ui.dashboard.settings.team_inboxes.permission")
                        th.f-semi-14 
