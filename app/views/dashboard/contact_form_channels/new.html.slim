= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "contact-form-channels") do
    .ec-form-page style="display: flex; gap: 32px; align-items: flex-start; max-width: 1200px; margin: 0 auto; padding: 24px;"
      .form-section style="flex: 1; max-width: 800px; min-width: 0;"
        .ec-form-header
          = link_to "← Back to Contact Forms", contact_form_channels_path, class: "ec-back-link"
          h2.f-semi-32 style="margin-top: 16px; color: #0f172a;" = t("dashboard.contact_form_channels.new.title", default: "New Contact Form")

        .ec-form-container
          = render "form", contact_form_channel: @contact_form_channel
