= render("dashboard/settings/settings_sidebar", current_page: "customers") do
  .tm-invite.tm-customer-editor
    header.channel-edit__header
      .channel-edit__header-main
        = link_to customer_path(@customer), class: "channel-edit__back", aria: { label: t("dashboard.customers.edit.back", default: "Back to customer") } do
          = inline_svg_tag("back_arrow.svg", aria: { hidden: true })
        .channel-edit__heading
          h1 = t("dashboard.customers.edit.title", default: "Edit Customer")
          p = t("dashboard.customers.edit.description", name: customer_name(@customer), default: "Update %{name}'s identity information.")
      .channel-edit__header-actions
        = link_to t("dashboard.users.form.cancel", default: "Cancel"), customer_path(@customer), class: "channel-edit__button channel-edit__button--secondary"
        button.channel-edit__button.channel-edit__button--primary type="submit" form="customer-form"
          = t("dashboard.customers.edit.save", default: "Save Changes")

    = form_with model: @customer, url: customer_path(@customer), local: true, id: "customer-form", class: "tm-invite-form" do |f|
      .tm-invite-content
        .tm-invite-main
          - if @customer.errors.any?
            .tm-customer-errors role="alert"
              strong = t("dashboard.customers.edit.errors", default: "Please review the highlighted fields.")
              ul
                - @customer.errors.full_messages.each do |message|
                  li = message

          section.tm-step
            .tm-step-heading
              / span.tm-step-number 1
              h2 = t("dashboard.customers.edit.identity", default: "Identity")
            p.tm-step-hint = t("dashboard.customers.edit.identity_hint", default: "Use the name fields that best match the information supplied by the customer.")
            .tm-customer-form-grid
              label.tm-customer-field.tm-customer-field--wide
                span = t("dashboard.customers.fields.name", default: "Name")
                = f.text_field :name, class: "ui-input", autocomplete: "name"
              label.tm-customer-field
                span = t("dashboard.customers.fields.first_name", default: "First Name")
                = f.text_field :first_name, class: "ui-input", autocomplete: "given-name"
              label.tm-customer-field
                span = t("dashboard.customers.fields.middle_name", default: "Middle Name")
                = f.text_field :middle_name, class: "ui-input", autocomplete: "additional-name"
              label.tm-customer-field
                span = t("dashboard.customers.fields.last_name", default: "Last Name")
                = f.text_field :last_name, class: "ui-input", autocomplete: "family-name"
              label.tm-customer-field
                span = t("dashboard.customers.fields.display_name", default: "Display Name")
                = f.text_field :display_name, class: "ui-input"

        aside.tm-invite-summary.tm-role-editor-summary.tm-customer-editor-summary
          - if @customer.avatar.attached?
            = image_tag @customer.avatar, class: "tm-role-editor-avatar", alt: customer_name(@customer)
          - else
            .tm-role-editor-avatar.tm-role-editor-avatar-fallback.avatar-fallback class=avatar_fallback_color_class(customer_name(@customer))
              = initials(@customer, limit: 2)
          h2 = customer_name(@customer)
          p = customer_contact_value(@customer)
          .tm-role-editor-current
            span.tm-role-badge = customer_type_label(@customer)
            span.tm-role-badge = t("dashboard.customers.edit.channel_count", count: customer_channel_inboxes(@customer).size, default: "%{count} channels")
