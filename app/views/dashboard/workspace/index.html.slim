- content_for :body_class, "auth-themed-body auth-workspaces-body"
- content_for :themed_auth_layout, "true"
- content_for :embedded_auth_locale_picker, "true"

.auth-page.auth-page--workspaces
  main.auth-main
    header.auth-header
      = link_to root_path, class: "auth-logo", aria: { label: "Deskbolic" } do
        = image_tag "logo.png", alt: "Deskbolic"

      - if user_signed_in?
        .auth-header-action
          = link_to t("auth.logout", default: "Sign Out"), destroy_user_session_path, data: { turbo_method: :delete }, class: "auth-secondary-button"

    .auth-form-wrap
      .auth-card.auth-workspace-card
        .auth-card-header
          .auth-eyebrow = t("dashboard.sidebar.all_workspaces")
          h1 = t("dashboard.workspace.chooser.title")
          p = t("dashboard.workspace.chooser.subtitle", email: current_user.email)

        .auth-workspace-list
          - @accounts.each do |account|
            - account_user = @account_users[account.id]
            - role_label = account_user&.owner? ? t("roles.owner", default: "Owner") : t("roles.member", default: "Member")
            = link_to root_url(subdomain: account.identifier), class: "auth-workspace-item", data: { turbo: false } do
              .auth-workspace-identity
                .auth-workspace-avatar aria-hidden="true"
                  = account.name.first(2).upcase
                .auth-workspace-copy
                  h2 = account.name
                  p #{account.identifier}.#{request.domain || "deskbolic.app"}

              .auth-workspace-meta
                span.auth-workspace-role = role_label
                svg.auth-workspace-arrow width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                  polyline points="9 18 15 12 9 6"

        .auth-workspace-actions
          = link_to workspace_path(subdomain: ""), class: "auth-primary-button" do
            svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
              line x1="12" y1="5" x2="12" y2="19"
              line x1="5" y1="12" x2="19" y2="12"
            = t("dashboard.workspace.chooser.create_new")

        .auth-workspace-footer
          = link_to t("dashboard.workspace.chooser.signed_in_as", email: current_user.email), profile_path, class: "auth-muted-link"

    .auth-workspace-locale-row
      = render("layouts/auth_locale_picker")

  aside.auth-visual aria-label=t("auth.registration.marketing_text")
    .auth-visual-orb.auth-visual-orb--one
    .auth-visual-orb.auth-visual-orb--two
    .auth-visual-content
      .auth-visual-badge
        span.auth-visual-badge-dot
        = t("dashboard.workspace.chooser.title")
      = image_tag "register.png", class: "auth-visual-image", alt: "", aria: { hidden: true }
      h2 = t("auth.registration.marketing_text")
