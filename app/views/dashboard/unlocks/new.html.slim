.user-login-container.center-wrapper
  .form-section
    .form-header
      .logo
        = link_to root_path do
          = image_tag "logo.png", alt: "Capiller Rely"
      = link_to t("auth.login.submit"), new_user_session_path, class: "join-btn"

  .login-container
    .login-card
      h2 style="font-size: 24px; font-weight: 600; margin-bottom: 10px;" = t("auth.unlocks.title")
      p = t("auth.unlocks.subtitle")

      .form-fields
        = form_with url: user_unlock_path, method: :post, local: true, data: { turbo: false } do |f|
          .form-floating
            = f.label :email, t("auth.email"), class: "form-label"
            = f.email_field "user[email]", autofocus: true, autocomplete: "email", required: true, class: "form-control", placeholder: t("auth.placeholders.email")

          .actions
            = f.submit t("auth.unlocks.resend"), class: "button"
