- url = contact_form_channel.persisted? ? channels_contact_form_path(contact_form_channel) : channels_contact_form_index_path
- method = contact_form_channel.persisted? ? :patch : :post
- translations = contact_form_channel.translations.reject(&:marked_for_destruction?).select { |translation| translation.locale.present? }
- translations = [contact_form_channel.translations.build(locale: I18n.default_locale)] if translations.empty?

= form_with(model: contact_form_channel, scope: :contact_form_channel, url: url, method: method, id: "contact-form-channel-form", class: "ui-settings-form", data: { controller: "contact-form-channel" }) do |f|
  - if contact_form_channel.errors.any?
    .ww-error-summary
      h3 = t("dashboard.contact_form_channels.form.error_heading")
      ul
        - contact_form_channel.errors.full_messages.each do |message|
          li = message

  / ─── Basic Details & Inbox ───
  .ww-section.ui-section.ui-section--always-open
    .ww-section-header
      .ww-section-title
        = inline_svg_tag("message.svg", class: "ww-section-icon", alt: t("dashboard.contact_form_channels.form.basic_section"))
        span.ww-section-label = t("dashboard.contact_form_channels.form.basic_section")
    .ww-section-body.channel-edit-select-surface
      .ww-form-row
        div
          = f.label :name, t("dashboard.contact_form_channels.form.name_label"), class: "ww-label"
          = f.text_field :name, class: "ww-input", required: true, placeholder: t("dashboard.contact_form_channels.form.name_placeholder")
        div
          = f.label :submit_redirect_url, t("dashboard.contact_form_channels.form.redirect_url_label"), class: "ww-label"
          = f.url_field :submit_redirect_url, class: "ww-input", placeholder: t("dashboard.contact_form_channels.form.redirect_url_placeholder"), pattern: "https?://.+", title: t("dashboard.channels.contact_form.form.valid_url_hint")

      .ww-form-row
        div
          = f.label :outbound_channel_id, t("forms.labels.outbound_channel"), class: "ww-label"
          p.ww-section-desc = t("dashboard.contact_form_channels.form.outbound_channel_hint", default: "Select an Email Channel to send replies from.")
          .channel-edit-select.ui-field-control.ui-field-control--no-icon
            = f.collection_select :outbound_channel_id, @email_channels, :id, :name, { include_blank: t("forms.options.select_email_channel") }, { class: "ui-select ui-control", data: { controller: "select" } }
          = f.hidden_field :outbound_channel_type, value: "Channel::Email"
        div

      - if contact_form_channel.primary_inbox
        .ww-inbox-settings
          h3 = t("dashboard.contact_form_channels.form.inbox_settings", default: "Inbox Settings")
          p = t("dashboard.contact_form_channels.form.inbox_settings_desc", default: "Configure SLA policies and custom reply templates for submissions.")

          = f.fields_for :primary_inbox, contact_form_channel.primary_inbox do |inbox_f|
            .ww-toggle-row
              div
                span.ww-toggle-label = t("ui.dashboard.channels.contact_form.form.auto_assign_conversations")
                label.ww-toggle
                  = inbox_f.check_box :auto_assign
                  span.ww-toggle-slider
              div
                span.ww-toggle-label = t("ui.dashboard.channels.contact_form.form.enable_csat_survey")
                label.ww-toggle
                  = inbox_f.check_box :csat_survey_enabled
                  span.ww-toggle-slider

            .ww-form-row
              div
                = inbox_f.label :conversation_reply_template_id, t("forms.labels.custom_reply_template"), class: "ww-label"
                .channel-edit-select.ui-field-control.ui-field-control--no-icon
                  = inbox_f.collection_select :conversation_reply_template_id, current_account.email_templates, :id, :name, { include_blank: t("forms.options.default_mailer_view") }, { class: "ui-select ui-control", data: { controller: "select" } }
              div
                = inbox_f.label :business_hour_group_id, t("forms.labels.business_hours"), class: "ww-label"
                .channel-edit-select.ui-field-control.ui-field-control--no-icon
                  = inbox_f.collection_select :business_hour_group_id, current_account.business_hour_groups, :id, :name, { include_blank: t("forms.options.always_online_24_7") }, { class: "ui-select ui-control", data: { controller: "select" } }

            .ww-form-row
              div
                = inbox_f.label :sla_policy_ids, t("forms.labels.sla_policies"), class: "ww-label"
                .channel-edit-select.ui-field-control.ui-field-control--no-icon
                  = select_tag "#{inbox_f.object_name}[sla_policy_ids][]", options_from_collection_for_select(current_account.sla_policies, :id, :name, contact_form_channel.primary_inbox.sla_policy_ids.first), include_blank: t("dashboard.channels.edit.none_selected", default: "None Selected"), class: "ui-select ui-control", data: { controller: "select" }
              div
                = inbox_f.label :csat_survey_id, t("forms.labels.csat_survey"), class: "ww-label"
                .channel-edit-select.ui-field-control.ui-field-control--no-icon
                  = inbox_f.collection_select :csat_survey_id, @csat_surveys, :id, :name, { include_blank: t("forms.options.default_survey") }, { class: "ui-select ui-control", data: { controller: "select" } }

  / ─── Appearance & Branding ───
  .ww-section.ui-section data-contact-form-channel-target="appearanceSection"
    .ww-section-header data-action="click->contact-form-channel#toggleSection"
      .ww-section-title
        = inline_svg_tag("setting.svg", class: "ww-section-icon", alt: t("dashboard.contact_form_channels.form.appearance_section"))
        span.ww-section-label = t("dashboard.contact_form_channels.form.appearance_section")
      span.ww-section-chevron ▼
    .ww-section-body.channel-edit-select-surface
      .ww-form-row
        div
          label.ww-label = t("dashboard.contact_form_channels.form.theme_color_label")
          .ww-color-picker-row
            = color_field_tag "contact_form_channel[ui_configurations][theme_color]", contact_form_channel.ui_configurations&.dig("theme_color") || "#0f172a", class: "ww-color-swatch", data: { "contact-form-channel-target": "colorSwatch", "action": "input->contact-form-channel#syncColor" }
            = text_field_tag "contact_form_channel[ui_configurations][theme_color]", contact_form_channel.ui_configurations&.dig("theme_color") || "#0f172a", class: "ww-input", style: "flex: 1;", data: { "contact-form-channel-target": "colorInput", "action": "input->contact-form-channel#syncSwatch" }
        div
          label.ww-label = t("dashboard.contact_form_channels.form.position_label")
          .channel-edit-select.ui-field-control.ui-field-control--no-icon
            = select_tag "contact_form_channel[ui_configurations][position]", options_for_select([[t("forms.options.left_aligned"), "left"], [t("forms.options.center_aligned"), "center"], [t("forms.options.right_aligned"), "right"]], contact_form_channel.ui_configurations&.dig("position") || "left"), class: "ui-select ui-control", data: { controller: "select" }

  / ─── Custom Fields Builder ───
  .ww-section.ui-section data-contact-form-channel-target="integrationsSection"
    .ww-section-header data-action="click->contact-form-channel#toggleSection"
      .ww-section-title
        = inline_svg_tag("fields.svg", class: "ww-section-icon", alt: t("dashboard.contact_form_channels.form.fields_section"))
        span.ww-section-label = t("dashboard.contact_form_channels.form.fields_section")
      span.ww-section-chevron ▼
    .ww-section-body data-controller="custom-field-builder"
      p.ww-section-desc = t("dashboard.contact_form_channels.form.fields_desc", default: "Select and drag-and-drop the custom fields you want to display on this contact form.")

      div data-controller="sortable" data-sortable-handle-value=".drag-handle" class="cf-sortable-list" data-custom-field-builder-target="list"
        - if contact_form_channel.custom_field_resources.any?
          - contact_form_channel.custom_field_resources.order(position: :asc).each do |resource|
            - field = resource.custom_field
            .sortable-item.cf-sortable-item data-sortable-target="item" data-id="#{field.id}" draggable="true" data-action="dragstart->sortable#dragStart dragend->sortable#dragEnd"
              span.drag-handle.cf-drag-handle data-sortable-target="handle" ☰
              div.cf-item-content
                h4 = field.key.titleize
                p
                  - if field.mapped_to.present?
                    = t("dashboard.contact_form_channels.form.mapped_to", mapped_to: field.mapped_to)
                  - else
                    = t("dashboard.contact_form_channels.form.entity_field", entity_type: field.entity_type.titleize)

              .cf-resource-config
                label.cf-resource-checkbox
                  = check_box_tag "contact_form_channel[field_settings][#{field.id}][required_override]", "1", resource.required_override, class: "cf-resource-checkbox-input"
                  = t("dashboard.contact_form_channels.form.required_label")
                = select_tag "contact_form_channel[field_settings][#{field.id}][width]", options_for_select([[t("dashboard.contact_form_channels.form.full_width"), "full"], [t("dashboard.contact_form_channels.form.half_width"), "half"]], resource.configurations["width"]), class: "ww-select cf-resource-select"

              span.ww-badge.ww-badge-active.cf-item-badge = field.entity_type.titleize
              button.ww-action-delete type="button" data-action="click->custom-field-builder#removeField"
                svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
                  path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"
              = hidden_field_tag "contact_form_channel[ordered_fields][]", field.id, data: { custom_field_builder_target: "hiddenInput" }

      .cf-add-field-row data-custom-field-builder-target="addButtonRow"
        button.ww-btn-secondary.cf-add-field-btn type="button" data-action="click->custom-field-builder#openModal"
          svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
            path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"
          | #{t("ui.dashboard.channels.contact_form.form.add_field")}

      .cf-modal-overlay data-custom-field-builder-target="modal" style="display: none;"
        .cf-modal-backdrop data-action="click->custom-field-builder#closeModal"
        .cf-modal-content
          .cf-modal-header
            h3 = t("ui.dashboard.channels.contact_form.form.add_custom_field")
            button.cf-modal-close type="button" data-action="click->custom-field-builder#closeModal" &times;
          .cf-modal-search
            input.ww-input type="text" placeholder=t("dashboard.contact_form_channels.form.search_fields") data-custom-field-builder-target="searchInput" data-action="input->custom-field-builder#filterFields"
          .cf-modal-body data-custom-field-builder-target="pool"
            - unselected_fields = @available_custom_fields.where.not(id: contact_form_channel.custom_field_ids)
            - unselected_fields.each do |field|
              .sortable-item.cf-sortable-item data-sortable-target="item" data-id="#{field.id}" data-searchable="#{field.key.downcase} #{field.entity_type.downcase}" draggable="true" data-action="dragstart->sortable#dragStart dragend->sortable#dragEnd click->custom-field-builder#addFieldFromModal"
                span.drag-handle.cf-drag-handle data-sortable-target="handle" ☰
                div.cf-item-content
                  h4 = field.key.titleize
                  p
                    - if field.mapped_to.present?
                      = t("dashboard.contact_form_channels.form.mapped_to", mapped_to: field.mapped_to)
                    - else
                      = t("dashboard.contact_form_channels.form.#{field.entity_type}_field")

                .cf-resource-config
                  label.cf-resource-checkbox
                    = check_box_tag "contact_form_channel[field_settings][#{field.id}][required_override]", "1", false, class: "cf-resource-checkbox-input"
                    = t("dashboard.contact_form_channels.form.required_label")
                  = select_tag "contact_form_channel[field_settings][#{field.id}][width]", options_for_select([[t("dashboard.contact_form_channels.form.full_width"), "full"], [t("dashboard.contact_form_channels.form.half_width"), "half"]], "full"), class: "ww-select cf-resource-select"

                span.ww-badge.ww-badge-active.cf-item-badge = field.entity_type.titleize
                button.ww-action-delete type="button" data-action="click->custom-field-builder#removeField"
                  svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
                    path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"
                = hidden_field_tag "contact_form_channel[ordered_fields][]", field.id, disabled: true, data: { custom_field_builder_target: "hiddenInput" }

  / ─── Behaviors & Spam Protection ───
  .ww-section.ui-section data-contact-form-channel-target="behaviorsSection"
    .ww-section-header data-action="click->contact-form-channel#toggleSection"
      .ww-section-title
        = inline_svg_tag("automation.svg", class: "ww-section-icon", alt: t("dashboard.contact_form_channels.form.behaviors_section"))
        span.ww-section-label = t("dashboard.contact_form_channels.form.behaviors_section")
      span.ww-section-chevron ▼
    .ww-section-body
      .ww-toggle-row
        span.ww-toggle-label = t("dashboard.contact_form_channels.form.require_login_label")
        label.ww-toggle
          = f.check_box :require_login
          span.ww-toggle-slider

      .ww-toggle-row
        span.ww-toggle-label = t("dashboard.contact_form_channels.form.allow_attachments_label")
        label.ww-toggle
          = f.check_box :allow_attachments
          span.ww-toggle-slider

      .ww-toggle-row
        span.ww-toggle-label = t("dashboard.contact_form_channels.form.send_confirmation_email_label")
        label.ww-toggle
          = f.check_box :send_confirmation_email
          span.ww-toggle-slider

      .ww-toggle-row
        span.ww-toggle-label = t("dashboard.contact_form_channels.form.spam_protection_enabled_label")
        label.ww-toggle
          = f.check_box :spam_protection_enabled
          span.ww-toggle-slider

  / ─── Translations ───
  .ww-section.ui-section data-contact-form-channel-target="translationsSection"
    .ww-section-header data-action="click->contact-form-channel#toggleSection"
      .ww-section-title
        = inline_svg_tag("t_users.svg", class: "ww-section-icon", alt: t("ui.dashboard.channels.contact_form.form.translations"))
        span.ww-section-label = t("ui.dashboard.channels.contact_form.form.translations")
      span.ww-section-chevron ▼
    .ww-section-body.channel-edit-select-surface
      p.ww-section-desc = t("dashboard.contact_form_channels.form.translations_desc", default: "Provide localized strings for your contact form. These override the default locale based on the customer's browser.")

      - current_locales = translations.map(&:locale).map(&:to_s)
      - available_locales = Core::SUPPORTED_LOCALES.map(&:to_s) - current_locales
      - available_locales_options = available_locales.map { |locale| [I18n.t("languages.#{locale.downcase}", default: locale.upcase), locale] }

      .ui-locale-editor data-controller="nested-translations locale-tabs"
        .ui-locale-tabs data-nested-translations-target="tabContainer"
          - translations.each_with_index do |translation, index|
            - locale = translation.locale.to_s
            - language_name = I18n.t("languages.#{locale.downcase}", default: locale.upcase)
            button.ui-locale-tab class=(index.zero? ? "active" : nil) type="button" data-locale=locale data-locale-tabs-target="tab" data-action="click->locale-tabs#switch"
              span.ui-locale-tab__code = locale.first(2).upcase
              span.translation-language-name = language_name
              - if locale == I18n.default_locale.to_s
                span.ui-locale-tab__meta = t("dashboard.ai_agents.form.default_language", default: "(Default)")

          .ui-locale-picker.ui-field-control
            = select_tag "new_translation_locale", options_for_select(available_locales_options), include_blank: t("forms.options.select_language", default: "Select Language"), class: "ui-select ui-control", data: { controller: "select", "nested-translations-target": "localeSelect", action: "change->nested-translations#addTranslation" }
            span.ui-locale-picker__icon aria-hidden="true"
              = image_tag("ai_agents/new_agent_add_language.svg", alt: "", width: 10.4896, height: 10.4896)

        .ui-locale-panels data-nested-translations-target="panelContainer"
          - translation_index = 0
          = f.fields_for :translations do |translation_form|
            - if translation_form.object.locale.present?
              = render "dashboard/channels/contact_form/translation_fields", f: translation_form, active: translation_index.zero?
              - translation_index += 1

        template data-nested-translations-target="tabTemplate"
          button.ui-locale-tab type="button" data-locale="NEW_LOCALE" data-locale-tabs-target="tab" data-action="click->locale-tabs#switch"
            span.ui-locale-tab__code NEW_CODE
            span.translation-language-name NEW_LANGUAGE

        template data-nested-translations-target="panelTemplate"
          = f.fields_for :translations, Channel::ContactFormTranslation.new, child_index: "NEW_RECORD" do |translation_form|
            = render "dashboard/channels/contact_form/translation_fields", f: translation_form, active: false
