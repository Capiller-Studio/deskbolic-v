- content_for :body_class, "auth-themed-body"
- content_for :themed_auth_layout, "true"

.auth-page.auth-page--password-change
  main.auth-main
    header.auth-header
      = link_to root_path, class: "auth-logo", aria: { label: "Deskbolic" } do
        = image_tag "logo.png", alt: "Deskbolic"

      .auth-header-action
        = link_to t("auth.login.submit"), new_user_session_path, class: "auth-secondary-button"

    .auth-form-wrap
      .auth-card
        .auth-card-header
          .auth-eyebrow = t("auth.passwords.change_my_password")
          h1 = t("auth.passwords.reset_title")
          p = t("auth.passwords.reset_subtitle")

        - if resource.errors.any?
          .auth-error-list role="alert"
            ul
              - resource.errors.full_messages.each do |message|
                li = message

        - password_strength_data = { turbo: false, controller: "password-strength", password_strength_match_message_value: t("auth.password_match"), password_strength_mismatch_message_value: t("auth.password_mismatch") }
        = form_with url: user_password_path, method: :put, local: true, data: password_strength_data, class: "auth-form" do |f|
          = f.hidden_field :reset_password_token, name: "user[reset_password_token]", value: params[:reset_password_token]
          - password_input_data = { password_strength_target: "password", action: "input->password-strength#validatePassword input->password-strength#validateConfirmation" }
          - confirmation_input_data = { password_strength_target: "confirmation", action: "input->password-strength#validateConfirmation" }

          .auth-field
            = f.label :password, t("auth.passwords.new_password"), class: "auth-label"
            = f.password_field "user[password]",
              autofocus: true,
              autocomplete: "new-password",
              required: true,
              data: password_input_data,
              class: "auth-input"
            .auth-password-meter aria-hidden="true"
              .auth-password-meter-fill data-password-strength-target="strengthMeter"

          .auth-field
            = f.label :password_confirmation, t("auth.passwords.confirm_new_password"), class: "auth-label"
            = f.password_field "user[password_confirmation]",
              autocomplete: "new-password",
              required: true,
              data: confirmation_input_data,
              class: "auth-input"
            p.auth-password-status data-password-strength-target="matchStatus" aria-live="polite"

          p.auth-password-hint = t("auth.password_hint")

          = f.submit t("auth.passwords.change_my_password"), data: { password_strength_target: "submitButton" }, class: "auth-primary-button"

  aside.auth-visual aria-label=t("auth.registration.marketing_text")
    .auth-visual-orb.auth-visual-orb--one
    .auth-visual-orb.auth-visual-orb--two
    .auth-visual-content
      .auth-visual-badge
        span.auth-visual-badge-dot
        = t("auth.passwords.reset_subtitle")
      = image_tag "register.png", class: "auth-visual-image", alt: "", aria: { hidden: true }
      h2 = t("auth.registration.marketing_text")
