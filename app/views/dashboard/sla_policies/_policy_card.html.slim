- response_time = policy.initial_response_time_limit ? t("general.minutes_short", count: (policy.initial_response_time_limit / 60).to_i) : t("general.none")

.ui-policy-card.ui-sla-card id="sla_policy_#{policy.id}"
  .ui-policy-card-leading-icon
    | ⏱

  .ui-policy-card-info
    .ui-policy-card-name = policy.name
    .ui-policy-card-meta
      span.ui-policy-badge.ui-policy-badge--sla
        = t("dashboard.sla_policies.policy_card.first_response", value: response_time)

      - if policy.description.present?
        span.ui-policy-card-detail — #{truncate(policy.description, length: 60)}

      - if policy.inboxes.any?
        span.ui-policy-card-detail = t("dashboard.sla_policies.policy_card.inboxes", count: policy.inboxes.size)

      - if policy.during_working_hours?
        span.ui-policy-card-detail = t("dashboard.business_hour_groups.index.title")

  .ui-policy-card-actions
    = link_to edit_sla_policy_path(policy), class: "ui-policy-action", title: t("general.edit")
      | ✎

    = button_to sla_policy_path(policy), method: :delete, class: "ui-policy-action danger", title: t("general.delete"), data: { turbo_confirm: t("shared.confirm_delete") }
      | ✕
