.dashboard-section.center-wrapper
  .dashboard-container
    .dashboard-nav
      .card
        = link_to(root_path, class: "dash-logo") do
          = image_tag('deskbolic_logo.png', alt: t("ui.dashboard.shared.dashboard_container.dashboard_logo"), class: 'dash-logo')
        ul
          .nav-menu
            / li.nav-item
            /   = link_to(agent_index_path, class: "nav-link") do
            /     = image_tag('ai_agent.png', alt: 'AI Agent', class: 'link-icon')
            - current_user&.accounts&.each do |account|
              li.nav-item class="#{current_account&.id == account.id ? 'dash-nav-active' : ''}"
                = button_to activate_workspace_path(account), method: :post, class: "nav-link", form: { data: { turbo: false } }, title: account.name do
                  = image_tag('helpdesk_icon.svg', alt: account.name, class: 'switch-icon')
            li.nav-item
              = link_to(workspace_path, class: "nav-link") do
                = inline_svg_tag("plus.svg", class:"link-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
            li.nav-item data-controller="modal-toggler frame-toggler" style="position: relative;"
              .nav-link data-action="click->modal-toggler#showModal click->frame-toggler#loadModal" data-url=notifications_path
                = inline_svg_tag("bell.svg", class:"link-icon", alt:t("ui.dashboard.shared.dashboard_container.notifications"))
              - if current_user
                = render "dashboard/notifications/badge"
              = render "dashboard/shared/modal_popper"
        
        .channel-header.list-header data-controller="accordion"
          - if current_user&.avatar&.attached?
            = image_tag(current_user.avatar, class: "account dashboard-account-avatar", alt: t("ui.dashboard.shared.dashboard_container.dashboard_logo"), data: { "action" => "click->accordion#toggleMenu" })
          - else
            .account.dashboard-account-avatar.avatar-fallback.dashboard-account-initials.f-reg-12 class=avatar_fallback_color_class(full_name(current_user)) data-action="click->accordion#toggleMenu"
              = initials(current_user)
          .menu data-accordion-target="menu"
            - if current_user
              = link_to(profile_path, class: "header profile-menu-header", data: { turbo: false }) do
                - if current_user.avatar.attached?
                  = image_tag(current_user.avatar, class:"user-img", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
                - else
                  .user-img.avatar-fallback.dashboard-user-initials.f-reg-14 class=avatar_fallback_color_class(full_name(current_user))
                    = initials(current_user)
                .details
                  h4.f-med-18 = current_user&.name 
                  - email = current_user&.email
                  - local, domain = email.to_s.split("@", 2)
                  - display_email = local.present? && domain.present? && local.length > 8 ? "#{local.first(8)}...@#{domain}" : email
                  p.f-med-16 title=email = display_email
              .account-options
                / .theme.menu-link
                /   = inline_svg_tag("theme.svg", class:"menu-icon", alt:"menu")
                /   p.f-semi-14 Theme
                /   = inline_svg_tag("light_theme.svg", class:"ml-auto", alt:"menu")
                = link_to(workspaces_path, class: "menu-link", data: { turbo: false }) do
                  p.f-semi-14 = t("dashboard.sidebar.all_workspaces")
                = link_to(help_center_path, class: "menu-link") do
                  p.f-semi-14 = t("ui.dashboard.shared.dashboard_container.help_desk_help_center")
                = link_to(community_path, class: "menu-link") do
                  p.f-semi-14 = t("ui.dashboard.shared.dashboard_container.help_desk_community_forum")
                = link_to(terms_path, class: "menu-link") do
                  p.f-semi-14 = t("ui.dashboard.shared.dashboard_container.terms_policies")
                = link_to(settings_path, class: "menu-link", data: { turbo: false }) do
                  = inline_svg_tag("settings.svg", class:"menu-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
                  p.f-semi-14 = t("dashboard.sidebar.settings.title")

              .dashboard-locale-selector.form-floating.ui-select style="border: none;"
                - locale_names = { en: "English", de: "Deutsch", es: "Español", fr: "Français", "pt-BR": "Português", ar: "العربية", ko: "한국어" }
                - locale_options = Core::SUPPORTED_LOCALES.map { |loc| [locale_names[loc.to_sym] || loc.to_s.upcase, url_for(request.params.merge(locale: (loc.to_s == I18n.default_locale.to_s ? nil : loc), only_path: true))] }
                - selected_locale_url = url_for(request.params.merge(locale: (I18n.locale.to_s == I18n.default_locale.to_s ? nil : I18n.locale), only_path: true))
                = select_tag :dashboard_locale, options_for_select(locale_options, selected_locale_url), { id: "dashboard-locale-select", class: "f-reg-14 field form-control", data: { controller: "select" }, aria: { label: t("forms.options.select_language") }, onchange: "window.location.href=this.value" }

              .logout
                = button_to(destroy_user_session_path, class: "menu-link nav-link", method: :delete) do
                  = inline_svg_tag("logout.svg", class:"link-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
                  p = t("ui.dashboard.shared.dashboard_container.sign_out")
            - else 
              .login
                p = t("ui.dashboard.shared.dashboard_container.login_here")
                = link_to new_user_ses sion_path, class: "menu-link nav-link" do
                  = inline_svg_tag("logout.svg", class:"link-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
                  p = t("ui.dashboard.shared.dashboard_container.login")
    .dashboard-body
      == yield
