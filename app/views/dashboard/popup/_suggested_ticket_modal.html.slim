.model-content-section
  .model-content
    .modal-body
      / .card.search-ticket
      /   button.accordian
      /     .main
      /       = inline_svg_tag("search.svg", alt:"menu")
      /       p.f-reg-14 Search
      .card.create-ticket data-action="click->frame-toggler#loadModal" data-popup-view="_ticket_modal"
        button.accordian
          .main
            = inline_svg_tag("ticket_no_background.svg", alt:t("ui.dashboard.agent.agent_sidebar.menu"), class:"conversation-icon")
            p.f-reg-14 = t("ui.dashboard.popup.suggested_ticket_modal.create_ticket")
          = inline_svg_tag("arrow.svg", class:"")
      .card data-action="click->frame-toggler#loadModal" data-popup-view="_fb_conv_modal"
        button.accordian.inactive
          .main
            = inline_svg_tag("messenger.svg", alt:t("ui.dashboard.agent.agent_sidebar.menu"), class:"conversation-icon")
            p.f-reg-14 = t("ui.dashboard.popup.suggested_ticket_modal.messenger")
          = inline_svg_tag("arrow.svg", class:"")
