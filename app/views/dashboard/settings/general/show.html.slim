= render("dashboard/settings/settings_sidebar", current_page: "general") do
  .ui-settings-page
    header.ui-settings-page__header
      .ui-settings-page__heading
        h1 = t("dashboard.settings.general.title", default: "General Settings")
        p = t("dashboard.settings.general.description", default: "Manage your workspace identity, localization, and lifecycle settings.")

      - if @is_owner
        button.ui-settings-page__action type="submit" form="workspace-general-form"
          = t("general.save_changes", default: "Save Changes")

    main.ui-settings-page__content
      = form_with(model: @account, url: settings_general_path, method: :patch, id: "workspace-general-form", class: "ui-settings-form") do |f|
        section.ui-form-card.ui-form-card--roomy
          .ui-form-card__header.ui-form-card__header--identity
            .ui-form-card__icon aria-hidden="true"
              = inline_svg_tag("settings.svg")
            div
              h2 = t("dashboard.settings.general.workspace_details", default: "Workspace Details")
              p = t("dashboard.settings.general.description", default: "Manage your workspace identity and localization settings.")

          - if @account.errors.any?
            .ui-form-notice
              = inline_svg_tag("info.svg", aria: { hidden: true })
              div
                h3 = t("general.validation_errors", default: "Please review the workspace details")
                p = @account.errors.full_messages.to_sentence

          .ui-form-grid.ui-form-grid--two
            .ui-field-group
              = f.label :name, t("dashboard.settings.general.name_label", default: "Workspace Name"), class: "ui-label"
              .ui-field-control
                span.ui-field-control__icon aria-hidden="true"
                  = inline_svg_tag("settings.svg")
                = f.text_field :name, class: "ui-input ui-control", placeholder: t("dashboard.settings.general.name_placeholder", default: "Acme Support"), disabled: !@is_owner, autocomplete: "organization"

            .ui-field-group
              = label_tag :workspace_subdomain, t("dashboard.settings.general.subdomain_label", default: "Workspace Subdomain"), class: "ui-label"
              .ui-field-control
                span.ui-field-control__icon aria-hidden="true"
                  = inline_svg_tag("world.svg")
                = text_field_tag :workspace_subdomain, "#{@account.identifier}.deskbolic.com", readonly: true, class: "ui-input ui-control"

            .ui-field-group
              = f.label :timezone, t("dashboard.settings.general.timezone_label", default: "Timezone"), class: "ui-label"
              .ui-field-control
                span.ui-field-control__icon aria-hidden="true"
                  = inline_svg_tag("calendar.svg")
                = f.time_zone_select :timezone,
                  nil,
                  {},
                  { class: "ui-select ui-control", disabled: !@is_owner, data: { controller: "select" } }

            .ui-field-group
              = f.label :locale, t("dashboard.settings.general.locale_label", default: "Locale"), class: "ui-label"
              .ui-field-control
                span.ui-field-control__icon aria-hidden="true"
                  = inline_svg_tag("world.svg")
                = f.select :locale,
                  Core::SUPPORTED_LOCALES.map { |locale| [I18n.t("languages.#{locale.to_s.downcase}"), locale] },
                  {},
                  { class: "ui-select ui-control", disabled: !@is_owner, data: { controller: "select" } }

      section.ui-settings-form data-controller="modal"
        .ui-form-notice.ui-form-notice--danger
          = inline_svg_tag("delete_red.svg", aria: { hidden: true })
          div
            h3 = t("dashboard.settings.general.delete_workspace_title", default: "Delete Workspace")
            p = t("dashboard.settings.general.delete_workspace_desc", default: "Request deletion of this workspace. The workspace will be deactivated immediately and billing subscriptions will be cancelled.")

          - if @is_owner
            button.ui-btn-primary.ui-form-notice__action type="button" data-action="click->modal#open"
              = t("dashboard.settings.general.request_deletion_btn", default: "Delete this Workspace")
          - else
            span.ui-field-hint
              = t("dashboard.settings.general.owner_only_notice", default: "Only the workspace owner can request workspace deletion.")

        - if @is_owner
          dialog.confirmation-dialog.confirmation-dialog--danger data-modal-target="dialog" data-action="cancel->modal#close click->modal#closeOnOutsideClick" aria-labelledby="delete-workspace-title" aria-describedby="delete-workspace-description"
            .confirmation-dialog__content
              .confirmation-dialog__icon aria-hidden="true"
                = inline_svg_tag("delete_red.svg")
              h2#delete-workspace-title.confirmation-dialog__title
                = t("dashboard.settings.general.confirm_deletion_title", default: "Confirm Workspace Deletion")
              p#delete-workspace-description.confirmation-dialog__message
                = t("dashboard.settings.general.modal_warning_desc", default: "Deleting this workspace deactivates it immediately and permanently removes active sessions and API access.")

              = form_with(url: settings_general_path, method: :delete, local: true, class: "ui-settings-form") do |delete_form|
                .ui-form-stack style="margin-top: 16px;"
                  .ui-field-group
                    = label_tag :identifier_confirmation, class: "ui-label" do
                      = t("dashboard.settings.general.confirm_subdomain_prompt_html", identifier: tag.code(@account.identifier), default: ("Type workspace subdomain %{identifier} to confirm:").html_safe)
                    .ui-field-control.ui-field-control--plain
                      = text_field_tag :identifier_confirmation, nil, required: true, class: "ui-input ui-control", placeholder: @account.identifier, autocomplete: "off"

                  .ui-field-group
                    = label_tag :password, t("auth.password", default: "Your Password"), class: "ui-label"
                    .ui-field-control.ui-field-control--plain
                      = password_field_tag :password, nil, required: true, class: "ui-input ui-control", placeholder: "••••••••", autocomplete: "current-password"

                .confirmation-dialog__actions
                  button.confirmation-dialog__button.confirmation-dialog__button--cancel type="button" data-action="click->modal#close"
                    = t("general.cancel", default: "Cancel")
                  = delete_form.submit t("dashboard.settings.general.confirm_delete_btn", default: "I understand, delete this workspace"), class: "confirmation-dialog__button confirmation-dialog__button--confirm"
