.model-content-section
  .model-content
    .modal-header
      h3.f-semi-18 Generate more by topic
      = inline_svg_tag("cross_button.svg", alt:"menu", class:"conversation-icon m-close", data: { action: "click->modal-toggler#hideModal" })
    .modal-body.channel-form
      p.f-reg-12 Generate more questions from your inbox using the selected topic, Learn More 
      = form_with(url: "#", data: {controller: "formValidation renderer", "formValidation-target" => "form"}, html: {class: "needs-validation", novalidate: true, method: :post}) do |f|
        .form-fields
          / = f.hidden_field :inbox_type, value: "email"
          / .form-floating
          /   .field-label
          /     span 1
          /     = f.label :name, "Enter name of Inbox", class: "form-label f-reg-14"
          /   = f.text_field :name, autofocus: true, class: "form-control f-reg-14", placeholder: "Channel Name", required: true
          .form-floating.ui-select
            = select_tag :channel_id, options_for_select(Channel::Email.where(account: current_account).all.map { |c| [c.name, c.id] }), data: { controller: "select" } 
        .form-actions
          = f.submit "Create Inbox", class: "submit-btn f-med-14", data: { action: "click->formValidation#validate click->modal-toggler#hideModal" }