= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "users") do
    - available_roles = @account_users.flat_map(&:roles).uniq(&:id).sort_by(&:name)

    .tm-users data-controller="filterable-collection"
      .tm-users-header
        div
          h1 = t("dashboard.popup.team.form.team_members")
          p = t("ui.dashboard.account_users.index.manage_your_workspace_members_permissions_and_invitations")
        = link_to new_invitation_path, class: "tm-users-invite"
          span.f-reg-14 = t("ui.dashboard.account_invitations.new.invite_member")
          = inline_svg_tag("plus_white.svg", class:"plus-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))

      .tm-users-body
        .tm-users-filters
          label.tm-users-search
            svg viewBox="0 0 24 24" aria-hidden="true"
              circle cx="11" cy="11" r="7"
              path d="m20 20-4-4"
            input type="search" placeholder=t("ui.dashboard.account_users.index.search_members") aria-label=t("ui.dashboard.account_users.index.search_members") data-filterable-collection-target="query" data-action="input->filterable-collection#update"

          select.tm-users-select aria-label=t("ui.dashboard.account_users.index.filter_by_role") data-filterable-collection-target="filter" data-action="change->filterable-collection#update"
            option value="" = t("ui.dashboard.account_users.index.all_roles")
            - available_roles.each do |role|
              option value=role.id = role.name

          select.tm-users-select aria-label=t("ui.dashboard.account_users.index.sort_members") data-filterable-collection-target="sort" data-action="change->filterable-collection#update"
            option value="joined:desc" = t("ui.dashboard.account_users.index.sort_newest")
            option value="joined:asc" = t("ui.dashboard.account_users.index.sort_oldest")
            option value="name:asc" = t("ui.dashboard.account_users.index.sort_name")

        - if @account_users.any?
          .tm-users-grid data-filterable-collection-target="container"
            - @account_users.each do |account_user|
              - user = account_user.user
              - member_name = full_name(user).presence || user.email
              - last_active_at = account_user.last_activity_at || user.current_sign_in_at || account_user.updated_at
              - primary_role = account_user.roles.first
              article.tm-member-card data-controller="accordion" data-filterable-collection-target="item" data-searchable="#{member_name.downcase} #{user.email.downcase}" data-filter-values=account_user.roles.map(&:id).join(",") data-joined=account_user.created_at.to_i data-name=member_name.downcase
                .tm-member-card-identity
                  - if user.avatar.attached?
                    = image_tag user.avatar, class: "tm-member-card-avatar", alt: member_name
                  - else
                    .tm-member-card-avatar.tm-member-card-avatar-fallback.avatar-fallback class=avatar_fallback_color_class(member_name)
                      = initials(user)
                  .tm-member-card-person
                    h2
                      = member_name
                      - if user == current_user
                        span.tm-member-card-you = t("dashboard.users.index.you")
                    p = user.email

                  button.tm-member-card-menu-button type="button" aria-label=t("ui.dashboard.account_users.index.member_actions") data-action="accordion#toggleMenu"
                    span
                    span
                    span

                  .tm-member-card-menu data-accordion-target="menu"
                    = link_to edit_user_path(account_user) do
                      svg viewBox="0 0 24 24" aria-hidden="true"
                        path d="m4 16-1 5 5-1L19 9l-4-4L4 16Z"
                        path d="m13 7 4 4"
                      | #{t("ui.dashboard.account_users.index.edit_role")}
                    - unless user == current_user || account_user.owner?
                      = link_to user_path(account_user), class: "tm-member-card-remove", data: { turbo_method: :delete, turbo_confirm: t("dashboard.users.index.delete_confirm") } do
                        svg viewBox="0 0 24 24" aria-hidden="true"
                          path d="M4 7h16M9 7V4h6v3M7 7l1 14h8l1-14M10 11v6M14 11v6"
                        | #{t("ui.dashboard.account_users.index.remove_member")}

                .tm-member-card-activity
                  .tm-member-card-metric
                    svg viewBox="0 0 24 24" aria-hidden="true"
                      rect x="3" y="5" width="18" height="16" rx="2"
                      path d="M16 3v4M8 3v4M3 10h18M8 14h3"
                    div
                      span = t("ui.dashboard.account_users.index.joined_on")
                      strong = account_user.created_at.strftime("%d %b %Y")
                  .tm-member-card-metric
                    svg viewBox="0 0 24 24" aria-hidden="true"
                      circle cx="12" cy="12" r="9"
                      path d="M12 7v5h4"
                    div
                      span = t("ui.dashboard.account_users.index.last_active")
                      strong class=("tm-member-card-active-time" if account_user.online?)
                        = time_ago_in_words(last_active_at)
                        | #{t("dashboard.identity_sources.index.ago")}

                .tm-member-card-footer
                  .tm-member-card-roles
                    - if primary_role
                      span class="tm-role-badge tm-role-badge-#{primary_role.identifier}" = primary_role.name
                      - if account_user.roles.size > 1
                        span.tm-role-badge.tm-role-badge-more = "+#{account_user.roles.size - 1}"
                    - else
                      span.tm-role-badge.tm-role-badge-none = t("dashboard.users.index.no_roles")
                  .tm-member-card-status class="tm-member-card-status-#{account_user.availability}"
                    i
                    = t("enums.account_user.availability.#{account_user.availability}")

          .tm-users-empty data-filterable-collection-target="empty" hidden=true
            h2 = t("ui.dashboard.account_users.index.no_matching_members")
            p = t("ui.dashboard.account_users.index.try_a_different_search_or_role_filter")
        - else
          .tm-users-empty
            h2 = t("dashboard.users.index.empty_title")
            p = t("dashboard.users.index.empty_description")
