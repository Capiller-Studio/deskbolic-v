= render("dashboard/settings/settings_sidebar", current_page: "customers") do
  .tm-invite.tm-customer-view
    header.channel-edit__header
      .channel-edit__header-main
        = link_to customers_path, class: "channel-edit__back", aria: { label: t("dashboard.customers.show.back", default: "Back to customers") } do
          = inline_svg_tag("back_arrow.svg", aria: { hidden: true })
        .channel-edit__heading
          h1 = customer_name(@customer)
          p = t("dashboard.customers.show.description", default: "Customer profile, activity, and connected channels.")
      - if can?(:edit, @customer)
        .channel-edit__header-actions
          = link_to t("dashboard.customers.show.edit", default: "Edit Customer"), edit_customer_path(@customer), class: "channel-edit__button channel-edit__button--primary"

    .tm-customer-view__content
      main.tm-customer-view__main
        section.tm-customer-profile-card
          .tm-customer-profile-card__identity
            - if @customer.avatar.attached?
              = image_tag @customer.avatar, class: "tm-customer-profile-avatar", alt: customer_name(@customer)
            - else
              .tm-customer-profile-avatar.tm-customer-avatar--fallback.avatar-fallback class=avatar_fallback_color_class(customer_name(@customer))
                = initials(@customer, limit: 2)
            div
              h2 = customer_name(@customer)
              p = customer_contact_value(@customer)
              span.tm-customer-type = customer_type_label(@customer)

        section.tm-customer-detail-card
          h2 = t("dashboard.customers.show.details", default: "Customer Details")
          dl.tm-customer-details
            - customer_detail_items(@customer).each do |label, value|
              .tm-customer-details__item
                dt = label
                dd = value.presence || t("general.not_available", default: "Not available")

        section.tm-customer-detail-card
          h2 = t("dashboard.customers.show.identities", default: "Identities")
          - if @customer.identities.any?
            .tm-customer-identities
              - @customer.identities.each do |identity|
                article.tm-customer-identity-record
                  .tm-customer-identity-record__badge aria-hidden="true"
                    = customer_identity_type_label(identity).first.upcase
                  .tm-customer-identity-record__heading
                    strong = customer_identity_name(identity)
                    span = customer_identity_type_label(identity)
                  dl.tm-customer-identity-record__details
                    div
                      dt = t("dashboard.customers.fields.source", default: "Source")
                      dd = customer_identity_source(identity)
                    div
                      dt = t("dashboard.customers.fields.identifier", default: "Identifier")
                      dd = identity.identifier
                    - if identity.external_id.present?
                      div
                        dt = t("dashboard.customers.fields.external_id", default: "External ID")
                        dd = identity.external_id
                    div
                      dt = t("dashboard.customers.fields.verified_on", default: "Added")
                      dd = l(identity.created_at.to_date, format: :long)
          - else
            p.tm-customer-empty-copy = t("dashboard.customers.show.no_identities", default: "No verified identities are connected to this customer.")

      aside.tm-customer-view__aside
        section.tm-customer-detail-card
          h2 = t("dashboard.customers.show.channels", default: "Connected Channels")
          - if customer_channel_inboxes(@customer).any?
            .tm-customer-channel-list
              - customer_channel_inboxes(@customer).each do |inbox|
                .tm-customer-channel-row
                  .tm-customer-channel-row__icon
                    = inline_svg_tag(channel_overview_icon(inbox.channel), aria: { hidden: true })
                  div
                    strong = inbox.name.presence || channel_overview_type_label(inbox.channel)
                    span = channel_overview_type_label(inbox.channel)
          - else
            p.tm-customer-empty-copy = t("dashboard.customers.show.no_channels", default: "This customer is not linked to a channel.")

        section.tm-customer-detail-card
          h2 = t("dashboard.customers.show.activity", default: "Activity")
          .tm-customer-stat
            span = t("dashboard.customers.show.conversations", default: "Conversations")
            strong = @customer.conversations.size
          .tm-customer-stat
            span = t("dashboard.customers.show.last_activity", default: "Last activity")
            strong = t("dashboard.customers.index.ago", time: time_ago_in_words(customer_last_activity(@customer)), default: "%{time} ago")
