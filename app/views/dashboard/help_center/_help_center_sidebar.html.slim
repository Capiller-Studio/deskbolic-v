- content_for :head do
  = stylesheet_link_tag "help_center_articles"

.helpdesk-section.center-wrapper.help-center-shell
  .helpdesk-container
    - help_center_nav_items = [ \
      { key: "all_articles", label: t("ui.dashboard.help_center.help_center_sidebar.all_articles_2"), path: help_center_articles_path, icon: "book.svg", active: current_page == "articles" && params[:status].blank? }, \
      { key: "published", label: t("ui.dashboard.help_center.help_center_sidebar.published_2"), path: help_center_articles_path(status: :published), icon: "book.svg", active: current_page == "articles" && params[:status] == "published" }, \
      { key: "draft", label: t("dashboard.email_builder.draft"), path: help_center_articles_path(status: :draft), icon: "pencil.svg", active: current_page == "articles" && params[:status] == "draft" }, \
      { key: "collections", label: t("dashboard.help_center.categories.index.title"), path: help_center_categories_path, icon: "tag.svg", active: current_page == "collections" }, \
      { key: "settings", label: t("dashboard.sidebar.settings.title"), path: settings_path, icon: "settings.svg", active: current_page == "settings" } \
    ]
    nav.hc-mobile-bottom-nav aria-label=t("dashboard.settings_index.help_center")
      - help_center_nav_items.each do |item|
        = link_to item[:path], class: "hc-mobile-bottom-nav__item #{item[:active] ? 'is-active' : ''}", aria: { current: (item[:active] ? "page" : nil) } do
          span.hc-mobile-bottom-nav__icon
            = inline_svg_tag(item[:icon], aria: { hidden: true })
          span = item[:label]
    .helpdesk-nav
      .card
        .header data-controller="modal-toggler frame-toggler"
          p.f-reg-14 = t("dashboard.settings_index.help_center")
          = render("dashboard/shared/modal_popper")
        ul.channel-list.st-sidebar data-controller="accordion modal-toggler frame-toggler"
          .help-nav-menu
            p.help-p.f-semi-12 = t("ui.dashboard.help_center.help_center_sidebar.articles")
            li.nav-item class="#{current_page == 'articles' && params[:status].blank? ? 'help-nav-active' : ''}"
              = link_to(help_center_articles_path, class: "nav-link", style: "height: 34px;") do
                .link-text
                  .conversation-name.inbox-conv
                    = inline_svg_tag("book.svg", class: "link-icon", alt: t("ui.dashboard.help_center.help_center_sidebar.all_articles"))
                    p.f-reg-14 = t("ui.dashboard.help_center.help_center_sidebar.all_articles_2")
            li.nav-item class="#{current_page == 'articles' && params[:status] == 'published' ? 'help-nav-active' : ''}"
              = link_to(help_center_articles_path(status: :published), class: "nav-link", style: "height: 34px;") do
                .link-text
                  .conversation-name.inbox-conv
                    = inline_svg_tag("book.svg", class: "link-icon", alt: t("ui.dashboard.help_center.help_center_sidebar.published"))
                    p.f-reg-14 = t("ui.dashboard.help_center.help_center_sidebar.published_2")
            li.nav-item class="#{current_page == 'articles' && params[:status] == 'draft' ? 'help-nav-active' : ''}"
              = link_to(help_center_articles_path(status: :draft), class: "nav-link", style: "height: 34px;") do
                .link-text
                  .conversation-name.inbox-conv
                    = inline_svg_tag("pencil.svg", class: "link-icon", alt: t("ui.dashboard.help_center.help_center_sidebar.draft"))
                    p.f-reg-14 = t("dashboard.email_builder.draft")

            p.help-p.f-semi-12 = t("ui.dashboard.help_center.help_center_sidebar.collections")
            li.nav-item class="#{current_page == 'collections' ? 'help-nav-active' : ''}"
              = link_to(help_center_categories_path, class: "nav-link", style: "height: 34px;") do
                .link-text
                  .conversation-name.inbox-conv
                    = inline_svg_tag("tag.svg", class: "link-icon", alt: t("ui.dashboard.help_center.help_center_sidebar.collections_2"))
                    p.f-reg-14 = t("dashboard.help_center.categories.index.title")
            li.nav-item class="#{current_page == 'settings' ? 'help-nav-active' : ''}"
              = link_to(settings_path, class: "nav-link", style: "height: 34px;") do
                .link-text
                  .conversation-name.inbox-conv
                    = inline_svg_tag("settings.svg", class: "link-icon", alt: t("ui.dashboard.help_center.help_center_sidebar.settings"))
                    p.f-reg-14 = t("dashboard.sidebar.settings.title")

    .helpdesk-body.settings-body
      == yield
