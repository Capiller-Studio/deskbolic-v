= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "billing") do
    .ap-index-header.ap-billing-page-header
      .ap-title-area
        h2.f-semi-24.ap-billing-page-title Billing & Subscriptions
        p.f-reg-14.ap-billing-page-subtitle Manage your subscription, wallet, and payment methods.

    .ap-billing-layout data-controller="modal-toggler"

      .ap-billing-main
        .ap-billing-primary

          / Active Subscription
          .ap-card.ap-billing-section-card.ap-billing-active-card
            .ap-card-body.ap-billing-card-body
              .ap-billing-card-top
                div
                  h3.f-semi-16.ap-billing-section-title = I18n.t("dashboard.billing.active_subscription")
                  p.f-reg-12.ap-billing-section-subtitle = I18n.t("dashboard.billing.active_subscription_desc")

                - if @active_subscription&.cancelled_at.present?
                  .ap-strategy-badge.ap-billing-badge-danger
                    = I18n.t("dashboard.billing.cancels_on", date: @active_subscription.current_period_end&.strftime("%b %d, %Y"), default: "Cancels on %{date}")
                - elsif @active_subscription&.past_due?
                  .ap-strategy-badge.ap-billing-badge-danger
                    = I18n.t("dashboard.billing.past_due")
                - elsif @active_subscription&.expired?
                  .ap-strategy-badge.ap-billing-badge-danger
                    = I18n.t("dashboard.billing.expired")

              - if @active_subscription
                .ap-billing-plan-summary
                  p.f-reg-12.ap-billing-detail-label = I18n.t("dashboard.billing.plan_label")
                  p.f-semi-20.ap-billing-plan-name = @active_subscription.plan.display_name

                - if @active_subscription.cancelled_at.present?
                  .ap-billing-actions
                    = link_to I18n.t("dashboard.billing.resume_subscription"), resume_subscription_path(@active_subscription), method: :post, data: { turbo_method: :post, turbo_confirm: I18n.t("dashboard.billing.resume_confirm", default: "Are you sure you want to resume your subscription?") }, class: "ap-btn-primary"
                - else
                  .ap-billing-actions
                    button.ap-billing-change-plan-btn type="button" data-action="click->modal-toggler#showModal"
                      = image_tag "double_arrow.svg", class: "ap-billing-action-icon", alt: ""
                      = I18n.t("dashboard.billing.change_plan")

                    div data-controller="modal"
                      button.ap-billing-manage-seats-btn data-action="click->modal#open"
                        = image_tag "users-group.svg", class: "ap-billing-action-icon", alt: ""
                        = I18n.t("dashboard.billing.manage_seats", default: "Manage Seats")

                      #manageSeatsModal.ap-billing-modal-overlay data-modal-target="dialog" data-action="click->modal#closeOnOutsideClick"
                        .ap-billing-modal-content.small
                          .ap-billing-modal-header
                            h3.f-semi-20 = I18n.t("dashboard.billing.manage_seats")
                            button.ap-action-btn data-action="click->modal#close" ✕
                          .ap-billing-modal-body
                            = form_with url: subscription_path(@active_subscription), method: :patch do |f|
                              label.f-semi-14.ap-billing-form-label = I18n.t("dashboard.billing.number_of_seats")
                              p.f-reg-13.ap-billing-form-hint
                                = I18n.t("dashboard.billing.plan_limits", min: @active_subscription.plan.min_users, max: @active_subscription.plan.unlimited?(:users_max) ? I18n.t("dashboard.billing.unlimited") : @active_subscription.plan.max_users, default: "Your plan limits: Min %{min}, Max %{max}")
                              - max_seats_val = @active_subscription.plan.unlimited?(:users_max) ? nil : @active_subscription.plan.max_users
                              = f.number_field :quantity, value: @active_subscription.quantity, min: @active_subscription.plan.min_users, max: max_seats_val, class: "ap-input ap-billing-form-input"

                              .ap-billing-modal-actions
                                button.ap-btn-secondary type="button" data-action="click->modal#close" = I18n.t("dashboard.billing.cancel", default: "Cancel")
                                - confirm_msg = @active_subscription.trialing? ? I18n.t("dashboard.billing.change_seats_trial_confirm", default: "Are you sure you want to change your seats? Your trial will continue normally, and you'll be billed for this new seat count when your trial ends.") : I18n.t("dashboard.billing.update_seats_confirm", default: "Are you sure you want to update your seats? This action will result in immediate prorated charges or wallet credits.")
                                = f.submit I18n.t("dashboard.billing.update_seats", default: "Update Seats"), class: "ap-btn-primary ap-billing-btn-danger", data: { turbo_confirm: confirm_msg }

                .ap-billing-plan-details
                  .ap-billing-detail-item
                    span.ap-billing-detail-icon-badge.ap-billing-detail-icon-badge-blue aria-hidden="true"
                      span.ap-billing-detail-icon.ap-billing-detail-users-icon
                    div
                      p.f-reg-12.ap-billing-detail-label = I18n.t("dashboard.billing.seats_label")
                      p.f-semi-16.ap-billing-detail-value = @active_subscription.quantity
                  .ap-billing-detail-item
                    span.ap-billing-detail-icon-badge.ap-billing-detail-icon-badge-blue aria-hidden="true"
                      span.ap-billing-detail-icon.ap-billing-detail-calendar-icon
                    div
                      p.f-reg-12.ap-billing-detail-label = @active_subscription.cancelled_at.present? ? I18n.t("dashboard.billing.cancels_on_label") : I18n.t("dashboard.billing.next_charge_label")
                      p.f-semi-16.ap-billing-detail-value = @active_subscription.current_period_end&.strftime("%B %d, %Y") || "N/A"
                  - if @active_subscription.trialing?
                    .ap-billing-detail-item
                      span.ap-billing-detail-icon-badge.ap-billing-detail-icon-badge-green aria-hidden="true"
                        span.ap-billing-detail-icon.ap-billing-detail-timer-icon
                      div
                        p.f-reg-12.ap-billing-detail-label = I18n.t("dashboard.billing.trial_ends_label", default: "Trial Ends In")
                        - trial_days_remaining = @active_subscription.days_until_trial_end.presence || 9
                        p.f-semi-16.ap-billing-detail-value = I18n.t("dashboard.billing.days_remaining", count: trial_days_remaining, default: "%{count} days") % { count: trial_days_remaining }
                  - else
                    .ap-billing-detail-item
                      span.ap-billing-detail-icon-badge.ap-billing-detail-icon-badge-green aria-hidden="true"
                        span.ap-billing-detail-icon.ap-billing-detail-clock-icon
                      div
                        p.f-reg-12.ap-billing-detail-label = I18n.t("dashboard.billing.billing_cycle_label", default: "Billing Cycle")
                        p.f-semi-16.ap-billing-detail-value = @active_subscription.annual? ? I18n.t("dashboard.billing.yearly", default: "Yearly") : I18n.t("dashboard.billing.monthly_label", default: "Monthly")
              - else
                .ap-billing-empty-subscription
                  p.f-reg-14.ap-billing-empty-subscription-text = I18n.t("dashboard.billing.no_active_subscription")
                  = link_to I18n.t("dashboard.billing.subscribe_now", default: "Subscribe Now"), new_subscription_path, class: "ap-btn-primary"

          / Wallet and Payment Methods (sit under Active Subscription, in the left column)
          .ap-billing-wallet-method-row
            .ap-card.ap-billing-wallet-card
              .ap-card-body.ap-billing-card-body
                .ap-billing-box-header
                  h3.f-semi-20.ap-billing-wallet-header = I18n.t("dashboard.billing.wallet")
                  span.ap-billing-box-icon.ap-billing-box-icon-blue aria-hidden="true"
                .ap-billing-wallet-balance-row
                  div
                    p.f-reg-14.ap-billing-wallet-label = I18n.t("dashboard.billing.current_balance")
                    p.f-semi-24.ap-billing-wallet-amount = ActionController::Base.helpers.number_to_currency(@wallet.balance, unit: current_account.currency.upcase + " ")
                .ap-billing-actions
                  a.ap-btn-primary.ap-billing-brand-action href="#topupWalletCard"
                    = image_tag "wallet.svg", class: "ap-billing-action-icon ap-billing-topup-action-icon", alt: ""
                    = I18n.t("dashboard.billing.top_up_balance", default: "Top-up Balance")

            .ap-card.ap-billing-payment-card
              .ap-card-body.ap-billing-card-body
                .ap-billing-box-header
                  h3.f-semi-18.ap-billing-section-title.ap-billing-wallet-header = I18n.t("dashboard.billing.payment_methods", default: "Payment Methods")
                  span.ap-billing-box-icon.ap-billing-box-icon-red aria-hidden="true"

                - if @payment_methods.any?
                  .ap-billing-pm-list
                    - @payment_methods.each do |pm|
                      .ap-billing-pm-item
                        .ap-billing-pm-details
                          .ap-billing-pm-icon 💳
                          div
                            p.f-semi-14.ap-billing-pm-brand = "#{pm.brand&.capitalize} •••• #{pm.last_four}"
                            p.f-reg-12.ap-billing-pm-expiry = I18n.t("dashboard.billing.expires", month: pm.expiry_month, year: pm.expiry_year, default: "Expires %{month}/%{year}")
                        .ap-billing-pm-actions
                          - unless pm.is_default
                            = link_to I18n.t("dashboard.billing.make_default", default: "Default"), make_default_payment_method_path(pm), data: { turbo_method: :post }, class: "f-reg-13 ap-billing-pm-default-link"
                          - else
                            span.f-reg-12.ap-billing-pm-default-badge = I18n.t("dashboard.billing.default_label", default: "Default")
                          = link_to I18n.t("dashboard.billing.remove", default: "Remove"), payment_method_path(pm), data: { turbo_method: :delete, turbo_confirm: I18n.t("dashboard.billing.are_you_sure", default: "Are you sure?") }, class: "f-reg-13 ap-billing-pm-remove"
                - else
                  p.f-reg-14.ap-billing-pm-empty = I18n.t("dashboard.billing.no_payment_methods", default: "No payment methods added yet.")

                .ap-billing-pm-bottom-action data-controller="modal stripe-elements" data-stripe-elements-client-secret-value=@setup_intent&.client_secret data-stripe-elements-publishable-key-value=@stripe_publishable_key
                  button.ap-btn-secondary.ap-billing-pm-add-btn.ap-billing-outline-action data-action="click->modal#open click->stripe-elements#mount"
                    span.ap-billing-plus-icon.ap-billing-plus-icon-blue aria-hidden="true"
                    = I18n.t("dashboard.billing.add_payment_method", default: "Add Payment Method")

                  #addCardModal.ap-billing-modal-overlay data-modal-target="dialog" data-action="click->modal#closeOnOutsideClick"
                    .ap-billing-modal-content.medium
                      .ap-billing-modal-header
                        h3.f-semi-20 = I18n.t("dashboard.billing.add_card", default: "Add Card")
                        button.ap-action-btn data-action="click->modal#close" ✕
                      .ap-billing-modal-body
                        form data-stripe-elements-target="form" data-action="submit->stripe-elements#submit"
                          div.ap-billing-stripe-element data-stripe-elements-target="element"
                          div.ap-billing-stripe-error.f-reg-13 data-stripe-elements-target="error"

                          .ap-billing-secure-notice
                            svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ap-billing-secure-icon"
                              rect x="3" y="11" width="18" height="11" rx="2" ry="2"
                              path d="M7 11V7a5 5 0 0 1 10 0v4"
                            span.f-reg-13 = I18n.t("dashboard.billing.secure_payment_notice", default: "Payments are securely processed by Stripe. Your card details are encrypted and never touch our servers.")

                          .ap-billing-modal-actions
                            button.ap-btn-secondary type="button" data-action="click->modal#close" = I18n.t("dashboard.billing.cancel", default: "Cancel")
                            button.ap-btn-primary type="submit" data-stripe-elements-target="submitButton" = I18n.t("dashboard.billing.save_card", default: "Save Card")

          .ap-card.ap-billing-tx-card
            .ap-card-body.ap-billing-card-body
              h3.f-semi-18.ap-billing-section-title = I18n.t("dashboard.billing.transaction_history", default: "Transaction History")

              - if @transactions.any?
                table.ap-billing-table
                  thead
                    tr.ap-billing-tr
                      th.f-semi-13.ap-billing-th = I18n.t("dashboard.billing.date", default: "Date")
                      th.f-semi-13.ap-billing-th = I18n.t("dashboard.billing.description", default: "Description")
                      th.f-semi-13.ap-billing-th = I18n.t("dashboard.billing.amount", default: "Amount")
                      th.f-semi-13.ap-billing-th = I18n.t("dashboard.billing.status", default: "Status")
                  tbody
                    - @transactions.each do |t|
                      tr.ap-billing-tr
                        td.f-reg-14.ap-billing-td = t.created_at.strftime("%b %d, %Y")
                        td.f-reg-14.ap-billing-td
                          - desc = t.description.to_s
                          - if desc.start_with?("billing.events.") || desc.start_with?("wallet.events.")
                            - desc = I18n.t(desc, **(t.data || {}).symbolize_keys, default: desc)
                          - else
                            - desc = desc.presence || t.transaction_type.titleize

                          - if t.provider == "wallet" && t.charge?
                            | #{I18n.t("dashboard.billing.wallet_deduction", default: "Wallet Deduction:")}
                          = desc
                        td.f-semi-14.ap-billing-td
                          - sign, amount_class = t.charge? ? ["-", "ap-billing-tx-amount-charge"] : ["+", "ap-billing-tx-amount-credit"]
                          span class=amount_class = "#{sign} #{ActionController::Base.helpers.number_to_currency(t.amount, unit: t.currency.upcase + ' ')}"
                        td.ap-billing-td
                          - status_class = t.completed? ? "ap-billing-tx-status-completed" : "ap-billing-tx-status-muted"
                          span.ap-strategy-badge class=status_class = t.status.titleize

                .mt-4
                  == pagy_nav(@pagy)
              - else
                p.f-reg-14.ap-billing-pm-empty = I18n.t("dashboard.billing.no_transactions", default: "No transactions found.")

        .ap-billing-sidebar

          #topupWalletCard.ap-card.ap-billing-inline-topup-card data-controller="wallet-topup"
            .ap-card-body.ap-billing-card-body
              .ap-billing-modal-header.ap-billing-inline-topup-header
                .ap-billing-inline-topup-title
                  = image_tag "wallet.svg", class: "ap-billing-inline-topup-title-icon", alt: ""
                  h3.f-semi-20 = I18n.t("dashboard.billing.topup_wallet", default: "Top-up Wallet")
              .ap-billing-modal-body.ap-billing-inline-topup-body
                = form_with url: topup_wallet_path, method: :post do |f|
                  .ap-billing-topup-presets
                    button.ap-btn-secondary type="button" data-action="click->wallet-topup#selectPreset" data-wallet-topup-amount-param="25" $25
                    button.ap-btn-secondary type="button" data-action="click->wallet-topup#selectPreset" data-wallet-topup-amount-param="50" $50
                    button.ap-btn-secondary type="button" data-action="click->wallet-topup#selectPreset" data-wallet-topup-amount-param="100" $100

                  label.f-semi-14.ap-billing-form-label = I18n.t("dashboard.billing.custom_amount", default: "Custom Amount")
                  = f.number_field :amount, data: { wallet_topup_target: "input" }, min: 10, max: 50000, step: "0.01", class: "ap-input ap-billing-form-input"

                  .ap-billing-modal-actions
                    button.ap-btn-secondary type="reset" = I18n.t("dashboard.billing.cancel", default: "Cancel")
                    button.ap-btn-primary.ap-billing-brand-action type="submit"
                      = image_tag "wallet.svg", class: "ap-billing-action-icon ap-billing-topup-action-icon", alt: ""
                      = I18n.t("dashboard.billing.top_up", default: "Top Up")

          - if @active_subscription && !@active_subscription.cancelled_at.present?
            #changePlanModal.ap-card.ap-billing-inline-change-plan-card data-controller="change-plan" data-modal-toggler-target="model"
              .ap-card-body.ap-billing-card-body
                .ap-billing-modal-header.ap-billing-inline-topup-header
                  h3.f-semi-18 = I18n.t("dashboard.billing.change_plan", default: "Change Plan")
                  button.ap-action-btn type="button" data-action="click->modal-toggler#hideModal" ✕
                .ap-billing-modal-body.ap-billing-inline-change-plan-body
                  = form_with url: subscription_path(@active_subscription), method: :patch, data: { controller: "plan-selector" } do |f|
                    = f.hidden_field :billing_cycle, value: (@active_subscription.annual? ? "annual" : "monthly")

                    .ap-billing-plan-grid.ap-billing-modal-plan-grid.ap-billing-inline-plan-grid
                      - @available_plans.each do |plan|
                        - selected_plan = plan.id == @active_subscription.plan_id
                        label.ap-billing-plan-option data-action="click->plan-selector#select"
                          = f.radio_button :plan_id, plan.id, class: "ap-billing-plan-radio", checked: plan.id == @active_subscription.plan_id, data: { plan_selector_target: "radio", action: "change->plan-selector#updateHighlight", min_users: plan.min_users, max_users: plan.max_users, monthly_price: plan.base_price, annual_price: plan.annual_price, currency: plan.currency }
                          .ap-billing-plan-card class=(selected_plan ? "is-selected" : "") data-plan-selector-target="card"
                            span.ap-billing-plan-radio-indicator aria-hidden="true"
                            .ap-billing-plan-card-content
                              .ap-billing-modal-plan-header
                                h4.f-semi-16 = plan.display_name
                                - if selected_plan
                                  span.f-reg-12.ap-billing-current-plan-badge = I18n.t("dashboard.billing.current_plan", default: "Current")
                              p.f-reg-12.ap-billing-plan-price data-plan-selector-target="planPrice"
                                span.ap-billing-price-amount data-plan-selector-target="priceAmount" = ActionController::Base.helpers.number_to_currency((@active_subscription.annual? ? plan.annual_price : plan.base_price), unit: plan.currency.upcase + " ")
                                span.ap-billing-price-period data-plan-selector-target="pricePeriod" = @active_subscription.annual? ? I18n.t("dashboard.billing.per_month_annual", default: " / mo (billed yearly)") : I18n.t("dashboard.billing.per_month", default: " / month")

                    .ap-billing-form-group
                      label.f-semi-14.ap-billing-form-label = I18n.t("dashboard.billing.number_of_seats", default: "Number of Agent Seats")
                      p.f-reg-13.ap-billing-form-hint data-plan-selector-target="planLimitText"
                        = I18n.t("dashboard.billing.plan_limits", min: @active_subscription.plan.min_users, max: @active_subscription.plan.unlimited?(:users_max) ? I18n.t("dashboard.billing.unlimited", default: 'Unlimited') : @active_subscription.plan.max_users, default: "Your plan limits: Min %{min}, Max %{max}")
                      - max_seats_val = @active_subscription.plan.unlimited?(:users_max) ? nil : @active_subscription.plan.max_users
                      = f.number_field :quantity, value: @active_subscription.quantity, min: [@active_subscription.plan.min_users, current_account.users_count].max, max: max_seats_val, class: "ap-input ap-billing-form-input", data: { plan_selector_target: "quantityInput", current_users: current_account.users_count }

                    .ap-billing-modal-actions
                      button.ap-btn-secondary type="reset" = I18n.t("dashboard.billing.cancel", default: "Cancel")
                      - confirm_msg = @active_subscription.trialing? ? I18n.t("dashboard.billing.change_plan_trial_confirm", default: "Are you sure you want to change your plan? Your trial will continue normally, and you'll be billed for this new plan when your trial ends.") : I18n.t("dashboard.billing.update_subscription_confirm", default: "Are you sure you want to update your subscription? This action will result in immediate prorated charges or wallet credits.")
                      = f.submit I18n.t("dashboard.billing.update_plan", default: "Update Plan"), class: "ap-btn-primary ap-billing-brand-action", data: { turbo_confirm: confirm_msg }
