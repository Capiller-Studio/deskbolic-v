= render("dashboard/shared/dashboard_container", current_page: "roles") do
  = render("dashboard/agent/agent_sidebar", current_page: "roles") do
    .agent-body-section data-controller="modalToggler frameToggler"
      .agent-header
        h2.f-semi-18 Settings
      .agent-body
        ul.agent-configs-list  data-controller="accordion modalToggler frameToggler"
          .configs-nav-menu
            .config-item
              li.config-nav-item class="" data-action="click->accordion#toggle"
                .config-nav-link
                  .link-text
                    = image_tag("agent_img.png", class:"link-icon avatar", alt:"image")
                    .left
                      p.f-semi-14 Identity
                      p.f-reg-12 Customize Fin’s Profile picture and name. this identity will also be used for bots in workfloes
                    = inline_svg_tag("arrow_down.svg", class:"team-dropdown-icon", alt:"menu")
              .config-panel.panel data-accordion-target="panel"
                .config-body
                  = form_with(url: "#", method: :patch) do |f|
                    .form-fields
                      .form-floating
                        = image_tag("agent_img.png", class:"link-icon avatar", alt:"image")
                        .form-field
                          = f.label :name, "Name", class: "form-label f-semi-14"
                          = f.text_field :name, autofocus: true, class: "form-control f-reg-14", placeholder: "Deskbolic", required: true
                    .form-actions
                      = f.submit "Save", class: "btn f-semi-14 btn-update"
            
            .config-item
              li.config-nav-item class="" data-action="click->accordion#toggle"
                .config-nav-link
                  .link-text
                    = image_tag("reply.png", class:"link-icon avatar", alt:"image")
                    .left
                      p.f-semi-14 Deskbolic’s reply buttons
                      p.f-reg-12 Choose  how fin phrases the options it presents to your customers
                    = inline_svg_tag("arrow_down.svg", class:"team-dropdown-icon", alt:"menu")
              .config-panel.panel data-accordion-target="panel"
                .config-body.replies-body
                  .widget-section
                    .f-reg-12 Wed 8:21 AM
                    .customer-text
                      = image_tag("bot.png", class:"customer-icon", alt:"menu")
                      p.f-reg-14 Hallo, ich bin FitBot! 👋 Ich bin dein persönlicher Sportassistent. Wie kann ich dir helfen?
                    .response-buttons
                      = form_with url: "#", method: :get, local: true do
                        .form-floating.reply-statuses
                          = select_tag :status, options_for_select([['Let fin decide', 'let fin decide'], ['Informal', 'informal'], ['Formal', 'formal']], params[:status]), onchange: "this.form.submit();", class: "con-statuses", data: { controller: "select" }
                      = form_with url: "#", method: :get, local: true do
                        .form-floating.reply-statuses
                          = select_tag :status, options_for_select([['Let fin decide', 'let fin decide'], ['Informal', 'informal'], ['Formal', 'formal']], params[:status]), onchange: "this.form.submit();", class: "con-statuses", data: { controller: "select" }
                    / .message-box
                    /   p.f-reg-14 message...
                    /   = inline_svg_tag("file_attach.svg", class:"resp-icon", alt:"icon")
                    /   = inline_svg_tag("emoji.svg", class:"resp-icon", alt:"icon")
                    /   = inline_svg_tag("gif.svg", class:"resp-icon", alt:"icon")
                  .description-section
                    h3.f-semi-14 Customize the reply buttons here...
                    p.f-reg-12 You can pick what works best for your audience. This will not changes what the buttons do.
                    = image_tag("big_arrow.png", class:"big-arrow", alt:"menu")
                    p.f-reg-12 Resolves the conversation
                    p.f-reg-12 Routes the customer to teammates
            
            .config-item
              li.config-nav-item class="" data-action="click->accordion#toggle"
                .config-nav-link
                  .link-text
                    = image_tag("transfer.png", class:"link-icon avatar", alt:"image")
                    .left
                      p.f-semi-14 Deskbolic’s multilingual support
                      p.f-reg-12 Control the language Fin will use to create AI answers
                    = inline_svg_tag("arrow_down.svg", class:"team-dropdown-icon", alt:"menu")
              .config-panel.panel data-accordion-target="panel"
                .config-body.lingual-support
                  p.f-semi-14 Supported Languages
                  p.f-reg-12 Fin will Automatically detect and reply to customer in the supported language you have added below. Add more language
                  li.f-semi-14 English (Default)
                  .field-group
                    label.switch
                      = check_box_tag 'toggle', 'on', true, class:'toggle-input'
                      span.slider
                    .content
                      p.f-semi-14 Real-time translation
                      p.f-reg-12 Fin will Automatically detect and reply to customer in the supported language you have added below. Add more language
                .tag Default language (English)
                span.tag Close
                span.link Multilingual Fin
            
            .config-item
              li.config-nav-item class="" data-action="click->accordion#toggle"
                .config-nav-link
                  .link-text
                    = image_tag("chat.png", class:"link-icon avatar", alt:"image")
                    .left
                      p.f-semi-14 Deskbolic’s pronoun formality
                      p.f-reg-12 Choose formal or informal pronouns(for all applicable languages)
                    = inline_svg_tag("arrow_down.svg", class:"team-dropdown-icon", alt:"menu")
              .config-panel.foramality-panel.panel data-accordion-target="panel"
                / .config-header
                /   h3.f-semi-18 Team Members
                .config-body.formality-body
                  = form_with url: "#", method: :get, local: true do
                    .form-floating.formality-statuses
                      = select_tag :status, options_for_select([['Let fin decide', 'let fin decide'], ['Informal', 'informal'], ['Formal', 'formal']], params[:status]), onchange: "this.form.submit();", class: "con-statuses", data: { controller: "select" }
                .f-reg-12.formality-text Fin will follow the same language style as the user, so if the user “du” or “tu” then Fin answer with informal pronouns. if the user uses “Sie” or “vous”.
                span.tag Close
                span.link Fin’s pronoun formality
            
