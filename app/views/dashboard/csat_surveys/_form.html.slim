- url = survey.persisted? ? csat_survey_path(survey) : csat_surveys_path
- method = survey.persisted? ? :patch : :post
- email_templates = defined?(@email_templates) && @email_templates.present? ? @email_templates : Current.account.email_templates.where(template_type: :csat_survey)
- translations = survey.translations.reject(&:marked_for_destruction?).reject { |translation| translation.locale.to_s == I18n.default_locale.to_s }
- current_locales = translations.map(&:locale).map(&:to_s)
- available_locales = Core::SUPPORTED_LOCALES.map(&:to_s) - (current_locales | [I18n.default_locale.to_s])
- available_locales_options = available_locales.map { |locale| [I18n.t("languages.#{locale.downcase}", default: locale.upcase), locale] }

= form_with(model: survey, url: url, method: method, id: "csat-survey-form", class: "ui-settings-form", html: { novalidate: true }) do |f|
  - if survey.errors.any?
    .ui-error-summary
      h3 = t("shared.error_heading", default: "Please fix the following errors")
      ul
        - survey.errors.full_messages.each do |message|
          li = message

  .ap-section
    .ap-section-header
      span.ap-section-icon
        = image_tag("document.svg", class: "ap-icon-svg", alt: "")
      span = t("dashboard.csat_surveys.form.basic_configuration", default: "Basic configuration")
    .ap-section-body.ap-policy-details-body
      .ap-field-stack
        div
          label.f-semi-13.ap-label for="csat-survey-name"
            = t("forms.labels.survey_name", default: "Survey Name")
            span.csat-required-marker *
          = f.text_field :name, class: "ap-input ui-control ui-input", id: "csat-survey-name", required: true, placeholder: t("dashboard.csat_surveys.form.name_placeholder", default: "e.g., Post Conversation Survey"), autocomplete: "off"
          p.ap-hint = t("dashboard.csat_surveys.form.name_hint", default: "The internal name for this survey.")

        div
          label.f-semi-13.ap-label for="csat-survey-prompt"
            = t("forms.labels.chat_prompt_whatsapp_widget", default: "Chat Prompt (WhatsApp, Widget)")
            span.csat-required-marker *
          = f.text_area :prompt, class: "ap-input ap-textarea", id: "csat-survey-prompt", rows: 4, required: true, placeholder: t("dashboard.csat_surveys.form.email_prompt_placeholder", default: "e.g., How was your experience?")
          p.ap-hint = t("dashboard.csat_surveys.form.default_language_hint", default: "Saved to your default language (English) as a fallback.")

        .ap-policy-details-grid.csat-form-row
          div
            label.f-semi-13.ap-label for="csat-survey-email-template"
              = t("dashboard.csat_surveys.form.assigned_email_template", default: "Assigned Email Template")
              span.ap-optional-label = t("dashboard.csat_surveys.form.optional_label", default: "(optional)")
            .ui-field-control.ui-field-control--plain
              = f.collection_select :email_template_id, email_templates, :id, :name, { include_blank: t("forms.options.use_system_default_design", default: "Use System Default Design") }, class: "ap-input ui-select ui-control", id: "csat-survey-email-template", data: { controller: "select" }
            p.ap-hint = t("dashboard.csat_surveys.form.email_template_hint", default: "This template will be used for emails.")

          div
            label.f-semi-13.ap-label for="csat-survey-portal-title"
              = t("forms.labels.portal_title_on_the_feedback_page", default: "Portal Title (on the feedback page)")
              span.csat-required-marker *
            = f.text_field :portal_title, class: "ap-input ui-control ui-input", id: "csat-survey-portal-title", required: true, placeholder: t("dashboard.csat_surveys.form.portal_title_placeholder", default: "e.g., How did we do?")
            p.ap-hint = t("dashboard.csat_surveys.form.default_language_hint", default: "Saved to your default language (English) as a fallback.")

        .ap-policy-details-grid.csat-form-row
          div
            label.f-semi-13.ap-label for="csat-survey-portal-subtitle" = t("forms.labels.portal_subtitle", default: "Portal Subtitle")
            = f.text_field :portal_subtitle, class: "ap-input ui-control ui-input", id: "csat-survey-portal-subtitle", placeholder: t("dashboard.csat_surveys.form.portal_subtitle_placeholder", default: "e.g., Your feedback helps us improve.")
            p.ap-hint = t("dashboard.csat_surveys.form.default_language_hint", default: "Saved to your default language (English) as a fallback.")

          div
            label.f-semi-13.ap-label for="csat-survey-feedback-label" = t("forms.labels.feedback_textbox_label", default: "Feedback Textbox Label")
            = f.text_field :portal_feedback_label, class: "ap-input ui-control ui-input", id: "csat-survey-feedback-label", placeholder: t("dashboard.csat_surveys.form.feedback_label_placeholder", default: "e.g., Tell us more about your experience (optional)")
            p.ap-hint = t("dashboard.csat_surveys.form.default_language_hint", default: "Saved to your default language (English) as a fallback.")

  .ap-section.csat-translation-section
    .ap-section-header
      span.ap-section-icon
        = image_tag("document.svg", class: "ap-icon-svg", alt: "")
      span = t("dashboard.csat_surveys.form.policy_details", default: "Policy Details")
    .ap-section-body data-controller="nested-translations"
      .csat-locale-tools
        .ui-field-control.ui-locale-picker.csat-locale-picker
          = select_tag "new_translation_locale", options_for_select(available_locales_options), include_blank: t("forms.options.select_language", default: "Select Language"), class: "ui-select ui-control", data: { controller: "select", "nested-translations-target": "localeSelect", action: "change->nested-translations#addTranslation" }
          span.ui-locale-picker__icon aria-hidden="true"
            = image_tag("world.svg", alt: "", width: 14, height: 14)
        button.csat-add-language type="button" data-action="click->nested-translations#addTranslation"
          span = t("dashboard.csat_surveys.form.add_language", default: "+ Add Language")

      .csat-translations-container data-nested-translations-target="container"
        - translations.each_with_index do |translation, index|
          = f.fields_for :translations, translation do |translation_form|
            = render "translation_fields", f: translation_form, active: index.zero?

      template data-nested-translations-target="template"
        = f.fields_for :translations, Csat::SurveyTranslation.new, child_index: "NEW_RECORD" do |translation_form|
          = render "translation_fields", f: translation_form, active: false
