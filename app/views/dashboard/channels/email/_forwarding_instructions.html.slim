- forwarding_verified = email_channel.forwarding_verified?

section.channel-edit-forwarding.channel-edit-card
  .channel-edit-forwarding__top
    .channel-edit-forwarding__intro
      .channel-edit-forwarding__icon
        = inline_svg_tag("envelope.svg", aria: { hidden: true })
      .channel-edit-forwarding__copy
        h2 = t("dashboard.email_channels.forwarding.title")
        p = t("dashboard.email_channels.forwarding.description")
    span.channel-edit-forwarding__status class=(forwarding_verified ? "channel-edit-forwarding__status--verified" : "channel-edit-forwarding__status--pending")
      span aria-hidden="true"
      = forwarding_verified ? t("dashboard.email_channels.forwarding.verified") : t("dashboard.email_channels.forwarding.not_verified")

  .channel-edit-forwarding__field
    label = t("dashboard.email_channels.forwarding.your_forwarding_address")
    .channel-edit-forwarding__actions
      .channel-edit-forwarding__control
        input type="text" value=email_channel.forward_email readonly=true data-email-channel-target="forwardEmail"
        button.channel-edit-forwarding__copy-button type="button" data-action="click->email-channel#copyForwardEmail" data-email=email_channel.forward_email aria-label=t("dashboard.email_channels.forwarding.copy")
          = inline_svg_tag("copy.svg", aria: { hidden: true })
      - unless forwarding_verified
        button.channel-edit-forwarding__verify type="button" data-action="click->email-channel#verifyForwarding" data-url=verify_forwarding_channels_email_path(email_channel) data-email-channel-target="verifyBtn"
          = t("dashboard.email_channels.forwarding.verify")

section.channel-edit-forwarding-guide.channel-edit-card.channel-forwarding-panel
  .channel-edit-forwarding-guide__heading
    h2 = t("dashboard.email_channels.forwarding.instructions_title")
    = inline_svg_tag("arrow_down_gray.svg", aria: { hidden: true })

  .channel-edit-forwarding-guide__tabs role="tablist"
    button.ui-tab.ui-tab--active type="button" role="tab" aria-selected="true" data-action="click->email-channel#selectTab" data-tab="gmail"
      span.channel-edit-forwarding-guide__provider.channel-edit-forwarding-guide__provider--gmail aria-hidden="true" M
      = t("dashboard.email_channels.forwarding.gmail_title")
    button.ui-tab type="button" role="tab" aria-selected="false" data-action="click->email-channel#selectTab" data-tab="outlook"
      span.channel-edit-forwarding-guide__provider.channel-edit-forwarding-guide__provider--outlook aria-hidden="true" O
      = t("dashboard.email_channels.forwarding.outlook_title")
    button.ui-tab type="button" role="tab" aria-selected="false" data-action="click->email-channel#selectTab" data-tab="yahoo"
      span.channel-edit-forwarding-guide__provider.channel-edit-forwarding-guide__provider--yahoo aria-hidden="true" Y!
      = t("dashboard.email_channels.forwarding.yahoo_title")
    button.ui-tab type="button" role="tab" aria-selected="false" data-action="click->email-channel#selectTab" data-tab="other"
      = t("dashboard.email_channels.forwarding.other_title")

  - %w[gmail outlook yahoo other].each do |provider|
    .ui-tab-content class=(provider == "gmail" ? "ui-tab-content--active" : nil) data-tab-content=provider role="tabpanel"
      ol.channel-edit-forwarding-guide__steps
        - (1..4).each do |step|
          li
            span = step
            p = t("dashboard.email_channels.forwarding.#{provider}_step_#{step}")
