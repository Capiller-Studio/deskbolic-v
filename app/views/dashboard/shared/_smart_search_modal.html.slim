.smart-search-overlay data-controller="smart-search" data-smart-search-target="modal" data-action="click->smart-search#closeOnBackdrop" data-smart-search-quick-actions-value=quick_actions.to_json data-smart-search-section-labels-value=search_sections.to_json
  .smart-search-dialog
    .smart-search-input-wrapper
      svg.smart-search-input-icon width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        circle cx="11" cy="11" r="8"
        line x1="21" y1="21" x2="16.65" y2="16.65"
      input.smart-search-input type="text" data-smart-search-target="input" data-action="input->smart-search#onInput keydown->smart-search#onKeydown" placeholder=t("dashboard.search.placeholder") autocomplete="off" spellcheck="false"
      .smart-search-shortcut
        kbd Esc

    .smart-search-results data-smart-search-target="results"
      .smart-search-loading data-smart-search-target="loading" style="display: none;"
        .smart-search-spinner
        span = t("dashboard.search.searching")

      .smart-search-empty data-smart-search-target="empty" style="display: none;"
        svg.smart-search-empty-icon width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
          circle cx="11" cy="11" r="8"
          line x1="21" y1="21" x2="16.65" y2="16.65"
        p.smart-search-empty-text = t("dashboard.search.no_results")
        p.smart-search-empty-hint = t("dashboard.search.try_different")

      .smart-search-section data-smart-search-target="quickActionResults" style="display: none;"
      .smart-search-section data-smart-search-target="conversationResults" style="display: none;"
      .smart-search-section data-smart-search-target="messageResults" style="display: none;"

    .smart-search-footer
      .smart-search-footer-hints
        span.smart-search-hint
          kbd ↑
          kbd ↓
          |  to navigate
        span.smart-search-hint
          kbd Enter
          |  to select
        span.smart-search-hint
          kbd Esc
          |  to close
