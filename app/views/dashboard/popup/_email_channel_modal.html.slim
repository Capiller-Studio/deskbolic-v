.model-content-section
  .model-content
    .modal-header
      h3.f-semi-18 Email Channel
      = inline_svg_tag("cross_button.svg", alt:"menu", class:"conversation-icon m-close", data: { action: "click->modal-toggler#hideModal" })
    .modal-body.channel-form
      = form_with(url: channels_path, data: {controller: "formValidation renderer", "formValidation-target" => "form", turbo: false}, html: {class: "needs-validation", novalidate: true, method: :post}) do |f|
        .form-fields
          = f.hidden_field :channel_type, value: "email"
          .form-floating
            .field-label
              span 1
              = f.label :name, "Enter name of channel", class: "form-label f-reg-14"
            = f.text_field :name, autofocus: true, class: "form-control f-reg-14", placeholder: "Channel Name", required: true
          .form-floating
            .field-label
              span 2
              = f.label :email, "Enter email", class: "form-label f-reg-14"
            = f.email_field :email, class: "form-control f-reg-14", placeholder: "Email", required: true
        .form-actions
          = f.submit "Create Channel", class: "submit-btn f-med-14", data: { action: "click->formValidation#validate click->modal-toggler#hideModal" }