<mjml>
  <mj-head>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text font-size="15px" color="#374151" line-height="24px" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-button background-color="#4f46e5" color="#ffffff" font-size="14px" font-weight="600" border-radius="8px" padding="16px 24px" inner-padding="12px 24px" />
    </mj-attributes>

    <mj-preview>
      New reply from [[ERB= @agent_name ]] on conversation #[[ERB= @conversation.identifier ]]
    </mj-preview>

    <mj-style>
      .reply-shell { border: 1px solid #dfe3ea; border-radius: 16px; box-shadow: 0 12px 32px rgba(15, 23, 42, 0.08); overflow: hidden; }
      .detail-label { color: #64748b; font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; width: 34%; }
      .detail-value { color: #0f172a; font-size: 14px; font-weight: 600; text-align: right; }
      .detail-table td { border-bottom: 1px solid #e5e7eb; padding: 12px 0; vertical-align: top; }
      .detail-table tr:last-child td { border-bottom: 0; }
      .message-block { background: #f8fafc; border-left: 3px solid #6366f1; border-radius: 8px; }
      .message-block p { margin: 0 0 12px 0; }
      .message-block p:last-child { margin-bottom: 0; }
      .brand-link { color: #64748b; text-decoration: none; }
      @media only screen and (max-width: 480px) { .mobile-center div { text-align: center !important; } }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f1f5f9">
    <mj-section padding="32px 16px"><mj-column><mj-spacer height="1px" /></mj-column></mj-section>

    <mj-wrapper css-class="reply-shell" background-color="#ffffff" padding="0">
      <mj-section background-color="#ffffff" padding="24px 40px" border-bottom="1px solid #e5e7eb">
        <mj-column width="62%" vertical-align="middle">
          <mj-image src="[[ERB= asset_url('logo.png', host: ENV.fetch('FRONTEND_URL', 'http://localhost:3000')) ]]" href="[[ERB= ENV.fetch('FRONTEND_URL', 'http://localhost:3000') ]]" alt="Deskbolic" width="132px" align="left" padding="0" />
        </mj-column>
        <mj-column width="38%" vertical-align="middle">
          <mj-text css-class="mobile-center" align="right" padding="0" font-size="11px" font-weight="700" color="#6366f1" letter-spacing="0.08em">CONVERSATION REPLY</mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#0f172a" padding="34px 40px 34px">
        <mj-column>
          <mj-text padding="0 0 10px" font-size="12px" font-weight="700" color="#a5b4fc" letter-spacing="0.12em">SUPPORT UPDATE &nbsp;&bull;&nbsp; #[[ERB= @conversation.identifier ]]</mj-text>
          <mj-text padding="0 0 12px" font-size="28px" line-height="36px" font-weight="700" color="#ffffff">A new reply from our team</mj-text>
          <mj-text padding="0" font-size="15px" line-height="24px" color="#cbd5e1">[[ERB= @agent_name ]] from [[ERB= @account&.name.presence || 'our team' ]] has responded to your request. Read the message below and reply directly to this email to continue the conversation.</mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#ffffff" padding="36px 40px 18px">
        <mj-column>
          <mj-text padding="0 0 14px" font-size="16px" color="#0f172a">Hello <strong>[[ERB= @conversation.customers.first&.name.presence || @conversation.customers.first&.email || 'there' ]]</strong>,</mj-text>
          <mj-text padding="0" font-size="15px" line-height="25px" color="#475569">Here is the latest update on your conversation. If you need anything else, just hit reply and our team will pick it up from where we left off.</mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#ffffff" padding="0 40px 22px">
        <mj-column background-color="#f8fafc" border="1px solid #e2e8f0" border-radius="10px" padding="8px 22px">
          <mj-table css-class="detail-table" padding="0">
            <tr>
              <td class="detail-label">Conversation</td>
              <td class="detail-value">#[[ERB= @conversation.identifier ]]</td>
            </tr>
            <tr>
              <td class="detail-label">Replied by</td>
              <td class="detail-value">[[ERB= @agent_name ]]</td>
            </tr>
            <tr>
              <td class="detail-label">Received</td>
              <td class="detail-value">[[ERB= l(@message.created_at, format: :long) ]]</td>
            </tr>
          </mj-table>
        </mj-column>
      </mj-section>

      <mj-section background-color="#ffffff" padding="0 40px 24px">
        <mj-column>
          <mj-text padding="0 0 10px" font-size="11px" font-weight="700" color="#4f46e5" letter-spacing="0.08em">MESSAGE FROM [[ERB= @agent_name.upcase ]]</mj-text>
          <mj-text css-class="message-block" padding="18px 20px" font-size="15px" line-height="24px" color="#1f2937">
            [[ERB== @content ]]
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#ffffff" padding="0 40px 36px">
        <mj-column>
          <mj-text padding="0 0 18px" font-size="13px" line-height="21px" color="#64748b">Reply directly to this email to continue the conversation. Your response will be delivered to [[ERB= @agent_name ]] and the rest of the [[ERB= @account&.name.presence || 'support' ]] team.</mj-text>
          <mj-text padding="0" font-size="13px" line-height="21px" color="#94a3b8">If your issue has been resolved, no further action is needed — thank you for choosing [[ERB= @account&.name.presence || 'Deskbolic' ]].</mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#f8fafc" padding="22px 40px" border-top="1px solid #e5e7eb">
        <mj-column>
          <mj-text align="center" padding="0 0 7px" font-size="12px" line-height="19px" color="#64748b">This email was sent to [[ERB= @conversation.customers.first&.email || @recipient&.email || @user&.email ]] regarding conversation #[[ERB= @conversation.identifier ]].</mj-text>
          <mj-text align="center" padding="0" font-size="12px" line-height="19px" color="#94a3b8">&copy; [[ERB= Time.current.year ]] [[ERB= @account&.name.presence || 'Deskbolic' ]] &nbsp;&bull;&nbsp; <a href="[[ERB= ENV.fetch('FRONTEND_URL', 'http://localhost:3000') ]]" class="brand-link">Open workspace</a></mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section padding="24px 16px 32px">
      <mj-column>
        <mj-text align="center" padding="0" font-size="11px" color="#94a3b8">Secure customer-support operations, powered by Deskbolic.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>