.auto-row-group data-automation-builder-target="conditionGroup"
  .auto-group-header
    | Group #{group_index + 1} — Match
    = select_tag "condition_group_operator_#{group_index}", options_for_select([["ALL", "AND"], ["ANY", "OR"]], group.dig("operator") || "AND"), class: "auto-row", style: "width: auto; padding: 4px 28px 4px 10px;", data: { "condition-group-operator": true }
    button.auto-remove-btn type="button" data-action="click->automation-builder#removeConditionGroup" style="margin-left: auto;" title="Remove group"
      | ✕

  div data-condition-group-rows=""
    - conditions = group.dig("conditions") || [{}]
    - conditions.each_with_index do |cond, ci|
      .auto-row data-condition-row=""
        = select_tag "cond_attr_#{group_index}_#{ci}", options_for_select(condition_attribute_options, cond["attribute"]), include_blank: "Select attribute...", class: "auto-row", data: { action: "change->automation-builder#attributeChanged", "condition-attr": true }
        = select_tag "cond_op_#{group_index}_#{ci}", options_for_select(condition_operator_options, cond["operator"]), include_blank: "Select operator...", class: "auto-row", data: { "condition-op": true }
        span data-condition-value-container="" style="display: contents;"
          = text_field_tag "cond_val_#{group_index}_#{ci}", cond["value"], placeholder: "Value...", data: { "condition-val": true }, class: "auto-row"

        button.auto-remove-btn type="button" data-action="click->automation-builder#removeCondition"
          | ✕

  button.auto-add-btn type="button" data-action="click->automation-builder#addCondition" data-group-index="#{group_index}"
    | + #{t("dashboard.automations.builder.add_condition")}
