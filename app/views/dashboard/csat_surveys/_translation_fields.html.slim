.ww-translation-card.csat-translation-panel
  .ui-locale-panel__header
    strong.f-semi-14.translation-language-name = I18n.t("languages.#{f.object.locale.to_s.downcase}", default: f.object.locale.to_s.upcase)
    button.ui-action-delete type="button" data-action="click->nested-translations#removeTranslation" title=t("general.remove_language")
      = inline_svg_tag("cross_clear.svg", aria: { hidden: true })
  = f.hidden_field :locale
  = f.hidden_field :_destroy, class: "destroy-flag"

  .ap-policy-details-grid
    div
      = f.label :prompt, t("forms.labels.chat_prompt_whatsapp_widget"), class: "f-semi-13 ap-label"
      = f.text_area :prompt, class: "ap-input ap-textarea", rows: 3, placeholder: t("dashboard.csat_surveys.form.email_prompt_placeholder")
      
    div
      = f.label :portal_title, t("forms.labels.portal_title_on_the_feedback_page"), class: "f-semi-13 ap-label"
      = f.text_field :portal_title, class: "ap-input", placeholder: t("dashboard.csat_surveys.form.portal_title_placeholder")

  .ap-policy-details-grid.csat-form-row
    div
      = f.label :portal_subtitle, t("forms.labels.portal_subtitle"), class: "f-semi-13 ap-label"
      = f.text_field :portal_subtitle, class: "ap-input", placeholder: t("dashboard.csat_surveys.form.portal_subtitle_placeholder")
      
    div
      = f.label :portal_feedback_label, t("forms.labels.feedback_textbox_label"), class: "f-semi-13 ap-label"
      = f.text_field :portal_feedback_label, class: "ap-input", placeholder: t("dashboard.csat_surveys.form.feedback_label_placeholder")
