<mjml>
  <mj-head>
    <mj-title>Unlock your account</mj-title>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="20px 0" border-radius="8px">
      <mj-column>
        <mj-text align="center" font-size="24px" font-weight="bold" color="#333333">
          Account Locked
        </mj-text>
        <mj-text align="left" font-size="16px" color="#555555" line-height="24px">
          Hello [[ERB= @resource.email ]],
        </mj-text>
        <mj-text align="left" font-size="16px" color="#555555" line-height="24px">
          Your account has been locked due to an excessive number of unsuccessful sign in attempts.
        </mj-text>
        <mj-text align="left" font-size="16px" color="#555555" line-height="24px">
          Click the link below to unlock your account:
        </mj-text>
        <mj-button background-color="#4F46E5" color="#ffffff" font-size="16px" font-weight="bold" border-radius="4px" href="[[ERB= unlock_url(@resource, unlock_token: @token, locale: I18n.locale) ]]">
          Unlock my account
        </mj-button>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
