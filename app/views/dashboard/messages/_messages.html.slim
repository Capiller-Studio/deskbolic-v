.card.conversation-card data-controller="modal-toggler frame-toggler conversation-inspector"
  = render("dashboard/shared/modal_popper")
  .chat-section
    header.header.conversation-header
      - customer = @conversation.customers.first
      button.conversation-mobile-back type="button" data-controller="section" data-action="click->section#backToList" data-url=conversations_path(resource_id: @inbox&.id, team_id: @team_id, assignee_id: @assignee_id, filter: @filter, q: @query.presence) aria-label=t('dashboard.mobile_navigation.back_to_inbox', default: 'Back to inbox')
        = inline_svg_tag('arrow.svg', aria: { hidden: true })
      .conversation-header-identity
        - if customer&.avatar&.attached?
          = image_tag(customer.avatar, class: 'conversation-header-avatar', alt: full_name(customer))
        - else
          .conversation-header-avatar.avatar-fallback class=avatar_fallback_color_class(full_name(customer))
            = initials(customer)
        .user-details
          p.conversation-header-name = full_name(customer)
          .conversation-header-meta
            span.conversation-header-email = customer&.email.presence || t('dashboard.conversation_details.no_email', default: 'No email')
            i aria-hidden="true"
            span.conversation-header-inbox = @conversation.inbox.name
            span.conversation-header-mobile-status = @conversation.active? ? t('dashboard.conversation_details.open', default: 'Open') : t("enums.conversation.status.#{@conversation.status}", default: @conversation.status.humanize)
      .actions.conversation-header-actions
        - if @conversation.resolved?
          = button_to t('dashboard.messages.reopen'), conversation_path(@conversation, conversation: { status: 'active' }), method: :patch, class: 'conversation-resolve-button conversation-resolve-button--secondary', form: { data: { turbo: false } }
        - else
          = button_to t('dashboard.messages.resolve'), conversation_path(@conversation, conversation: { status: 'resolved' }), method: :patch, class: 'conversation-resolve-button', form: { data: { turbo: false } }
        button.conversation-inspector-toggle type="button" aria-controls="conversation-details-#{@conversation.id}" aria-expanded="false" aria-label=t('dashboard.conversation_details.show_details', default: 'Show conversation details') data-action="click->conversation-inspector#toggle" data-conversation-inspector-target="toggle"
          = inline_svg_tag('panel.svg', aria: { hidden: true })
      / .actions data-controller="accordion conversations"
        = inline_svg_tag("plus.svg", class:"chat-action", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
        = inline_svg_tag("star.svg", class:"chat-action", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
        = inline_svg_tag("ticket.svg", class:"chat-action", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
        = inline_svg_tag("bell.svg", class:"chat-action", alt:t("ui.dashboard.agent.agent_sidebar.menu"), data: { action: "click->conversations#open" })
        = inline_svg_tag("close_black.svg", class:"chat-action", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
        = inline_svg_tag("dots.svg", class:"chat-action", alt:t("ui.dashboard.agent.agent_sidebar.menu"),  data: { "action" => "click->accordion#toggleMenu" })
        .menu data-accordion-target="menu"
          = link_to("#", class: "menu-link") do
            = inline_svg_tag("participent.svg", class:"menu-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
            p.f-reg-12 = t('dashboard.messages.manage_participant')
          = link_to("#", class: "menu-link") do
            = inline_svg_tag("export.svg", class:"menu-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
            p.f-reg-12 = t('dashboard.messages.export_conversation')
        
    .conversation#oppp data-controller="scroll-to-bottom mark-as-read" data-mark-as-read-url-value=mark_as_read_conversation_path(@conversation) data-conversation-id=@conversation.id
      - timeline_date = @timeline_items.first&.created_at || Time.current
      .conversation-date-divider
        span = timeline_date.strftime('%A · %d %B')
      = turbo_frame_tag "messages-page-#{@pagy.next}", src: conversation_messages_path(@conversation, page: @pagy.next), loading: :lazy if defined?(@pagy) && @pagy&.next
      - @timeline_items.each do |item|
        - if item.is_a?(Message)
          = render partial: "dashboard/messages/message", locals: { message: item }
        - elsif item.is_a?(Activity)
          = render partial: "dashboard/activities/activity", locals: { activity: item }
      
      turbo-frame#message-frame
      
    .footer data-controller="canned-responses" data-canned-responses-lexical-outlet=".note-area" data-canned-responses-conversation-id-value=@conversation.id
      .message-box data-controller="message-form"
        = form_with(model: Message.new, method: :post, class:"msg-form", multipart: true, data: { action: "turbo:submit-end->message-form#clear" }) do |f|
          .text-translation
            .response-type 
              button.f-semi-14.reply.active type="button" data-action="click->message-form#setReply" = t('dashboard.messages.reply')
              button.f-semi-14.note type="button" data-action="click->message-form#setNote" = t('dashboard.messages.note')
            .translation.f-semi-14
              = t("languages.#{I18n.locale.to_s.downcase}", default: I18n.locale.to_s)
          .note-area.menu data-controller="lexical" data-lexical-source-value=@conversation.source data-lexical-supported-formats-value="#{@conversation.inbox.channel.supported_formatting.to_json}"
            .attachment-preview data-message-form-target="preview"
            .de-emoji-picker data-message-form-target="emojiPicker" style="display: none;"
            .recording-indicator data-message-form-target="recordingIndicator" style="display: none;"
              .pulse-dot
              span.f-reg-12 = t('dashboard.messages.recording_voice')
            .mention-dropdown data-message-form-target="mentionDropdown" style="display: none; position: absolute; bottom: 100%; left: 16px; background: white; border: 1px solid #e2e8f0; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); max-height: 200px; overflow-y: auto; z-index: 50; width: 250px;"
            
            .lexical-toolbar data-lexical-target="toolbar"
              button type="button" data-action="mousedown->lexical#formatBold" data-lexical-target="boldBtn" class="format-btn" title=t('dashboard.messages.editor.bold') B
              button type="button" data-action="mousedown->lexical#formatItalic" data-lexical-target="italicBtn" class="format-btn" title=t('dashboard.messages.editor.italic') I
              button type="button" data-action="mousedown->lexical#formatStrike" data-lexical-target="strikeBtn" class="format-btn" title=t('dashboard.messages.editor.strike') S
              button type="button" data-action="mousedown->lexical#formatCode" data-lexical-target="codeBtn" class="format-btn" title=t('dashboard.messages.editor.code')
                = inline_svg_tag("code_snipet.svg", class:"action-btn", style: "width: 14px; height: 14px;")
              button type="button" data-action="mousedown->lexical#formatBulletList" data-lexical-target="ulBtn" class="format-btn" title=t('dashboard.messages.editor.ul_list')
                = inline_svg_tag("bullet_list.svg", class:"action-btn", style: "width: 14px; height: 14px;")
              button type="button" data-action="mousedown->lexical#formatNumberedList" data-lexical-target="olBtn" class="format-btn" title=t('dashboard.messages.editor.ol_list')
                = inline_svg_tag("num_list.svg", class:"action-btn", style: "width: 14px; height: 14px;")

            .lexical-editor-root data-lexical-target="editor" class="form-control f-reg-14 response-area" contenteditable="true" role="textbox" aria-label=t('dashboard.messages.response_placeholder') data-action="keyup->message-form#checkMentions click->message-form#checkMentions"
            = f.text_area :response, class: "d-none", style: "display: none;", data: { message_form_target: "textarea", lexical_target: "hiddenInput" }
            = f.hidden_field :conversation_id, value: @conversation.id
            = f.hidden_field :visibility, value: "global", data: { message_form_target: "visibility" }
            = f.file_field :attachments, multiple: true, class: "message-attachments-input", accept: "image/*,video/*,audio/*,.pdf,.doc,.docx,.txt,.zip", data: { message_form_target: "input", action: "change->message-form#previewFiles" }
          .commands
            .actions
              / .response-action
                = inline_svg_tag("menu.svg", class:"action-btn")
              .response-action
                .replies data-action="click->canned-responses#toggleMenu"
                  = inline_svg_tag("reply_star.svg", class:"action-btn")
                .menu.save-replies data-canned-responses-target="menu"
                  .menu-buttons
                    .menu-options
                      = inline_svg_tag("star_plus.svg", class:"m-btn", alt:t("ui.dashboard.agent.agent_sidebar.menu"),  data: { action: "click->modal-toggler#showModal click->frame-toggler#loadModal", popup_view:"_canned_response_modal" })
                      = link_to(canned_responses_settings_path, class: "", data: { turbo: false}) do
                        = inline_svg_tag("setting_button.svg", class:"m-btn", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
                    = image_tag("cross_btn.png", class:"m-btn", alt:t("ui.dashboard.agent.agent_sidebar.menu"), data: { action: "click->canned-responses#toggleMenu" })
                  .panels
                    .left-panel data-canned-responses-conversation-id="#{@conversation.id}"
                      .search-container style="padding: 10px; border-bottom: 1px solid #e2e8f0;"
                        input type="text" placeholder=t("dashboard.messages.search_canned_responses") data-action="input->canned-responses#searchCannedResponses keydown.enter->canned-responses#preventSubmit" style="width: 100%; padding: 6px; border: 1px solid #cbd5e1; border-radius: 4px; outline: none;" class="f-reg-12"
                      .results-container data-canned-responses-target="resultsContainer" style="max-height: 300px; overflow-y: auto;"
                        / Results will be injected here via Javascript
                    .right-panel data-canned-responses-target="response"
                      .response-description
                        p.f-semi-18.response-title
                        p.f-reg-14.response-text
                      .canned-submit.f-semi-12 type="button" data-action="click->canned-responses#switchResponse" = t('dashboard.messages.add')
              button.response-action type="button" data-action="click->message-form#openFilePicker" title=t("dashboard.messages.attach_file")
                = inline_svg_tag("file_attach.svg", class:"action-btn")
              button.response-action type="button" data-action="click->message-form#toggleEmojiPicker" title=t("dashboard.messages.add_emoji")
                = inline_svg_tag("emoji.svg", class:"size-btn")
              / .response-action
              /   = inline_svg_tag("gif.svg", class:"size-btn")
              button.response-action type="button" data-action="click->message-form#toggleVoiceRecording" data-message-form-target="voiceBtn" title=t("dashboard.messages.record_voice")
                = inline_svg_tag("mic.svg", class:"action-btn")
              .ai-assist data-controller="accordion ai-assist" data-ai-assist-summarize-url-value=summarize_conversation_ai_path(@conversation) data-ai-assist-draft-url-value=draft_reply_conversation_ai_path(@conversation) data-ai-assist-rewrite-url-value=rewrite_tone_conversation_ai_path(@conversation) data-ai-assist-grammar-url-value=fix_grammar_conversation_ai_path(@conversation) data-ai-assist-translate-url-value=translate_conversation_ai_path(@conversation) data-ai-assist-lexical-outlet=".note-area" data-ai-assist-generating-summary-value=t('dashboard.messages.ai_assist.generating_summary') data-ai-assist-summary-heading-value=t('dashboard.messages.ai_assist.summary_heading') data-ai-assist-drafting-reply-value=t('dashboard.messages.ai_assist.drafting_reply') data-ai-assist-error-prefix-value=t('dashboard.messages.ai_assist.error_prefix') data-ai-assist-credits-exhausted-value=t('dashboard.messages.ai_assist.credits_exhausted')
                .paraphrase-options data-action="click->accordion#toggleMenu"
                  = inline_svg_tag("gradient_logo.svg", class: "gpt-btn gpt-btn--desktop")
                  = image_tag("gradient_tab.svg", class: "gpt-btn gpt-btn--tab", alt: "")
                  = image_tag("gradient_mobile.svg", class: "gpt-btn gpt-btn--mobile", alt: "")
                  p.f-semi-12 = t('dashboard.messages.ai_assist.title', default: 'Boli')
                .menu.ai-assistant-menu data-accordion-target="menu" role="dialog" aria-label=t('dashboard.messages.ai_assist.assistant_title', default: 'AI Assistant')
                  button.ai-assistant-close type="button" data-action="click->accordion#toggleMenu" aria-label=t('dashboard.messages.close', default: 'Close')
                    = inline_svg_tag("ai-assistant-close.svg")

                  .ai-assistant-header
                    .ai-assistant-header-icon
                      = inline_svg_tag("ai-assistant-sparkles.svg")
                    .ai-assistant-heading
                      p.ai-assistant-title = t('dashboard.messages.ai_assist.assistant_title', default: 'AI Assistant')
                      p.ai-assistant-description = t('dashboard.messages.ai_assist.description', default: 'Use AI to improve, reply, and transform your messages.')

                  button.ai-assistant-summary type="button" data-action="click->ai-assist#summarize click->accordion#toggleMenu"
                    .ai-assistant-summary-copy
                      .ai-assistant-summary-icon
                        = image_tag("ai-assistant-disclaimer.svg", alt: "")
                      .ai-assistant-action-copy
                        span.ai-assistant-action-title = t('dashboard.messages.ai_assist.summarize_thread', default: 'Summarize Thread')
                        span.ai-assistant-action-description = t('dashboard.messages.ai_assist.summary_description', default: 'Get a quick summary of this conversation.')
                    .ai-assistant-chevron
                      = inline_svg_tag("ai-assistant-chevron.svg")

                  .ai-assistant-section.ai-assistant-draft
                    p.ai-assistant-section-title = t('dashboard.messages.ai_assist.draft_reply', default: 'Draft Reply')
                    .ai-assistant-input
                      = inline_svg_tag("ai-assistant-pencil.svg")
                      input type="text" placeholder=t('dashboard.messages.ai_assist.draft_placeholder', default: 'e.g. Tell them we will fix it by tomorrow...') data-ai-assist-target="instruction" data-action="keydown.enter->ai-assist#draftReply keydown.enter->accordion#toggleMenu" aria-label=t('dashboard.messages.ai_assist.draft_reply', default: 'Draft Reply')

                  .ai-assistant-section
                    p.ai-assistant-section-title = t('dashboard.messages.ai_assist.transform_text', default: 'Transform Current Text')
                    .ai-assistant-transform-grid
                      button.ai-assistant-transform-card.ai-assistant-transform-card--grammar type="button" data-action="click->ai-assist#fixGrammar click->accordion#toggleMenu"
                        .ai-assistant-transform-icon
                          = inline_svg_tag("ai-assistant-grammar.svg")
                        .ai-assistant-action-copy
                          span.ai-assistant-action-title = t('dashboard.messages.ai_assist.fix_grammar', default: 'Fix Grammar')
                          span.ai-assistant-action-description = t('dashboard.messages.ai_assist.grammar_description', default: 'Correct spelling and grammar')
                      button.ai-assistant-transform-card.ai-assistant-transform-card--translate type="button" data-action="click->ai-assist#translate click->accordion#toggleMenu"
                        .ai-assistant-transform-icon
                          = inline_svg_tag("ai-assistant-translate.svg")
                        .ai-assistant-action-copy
                          span.ai-assistant-action-title = t('dashboard.messages.ai_assist.translate', default: 'Translate')
                          span.ai-assistant-action-description = t('dashboard.messages.ai_assist.translate_description', default: 'Translate to another language')

                  .ai-assistant-section
                    p.ai-assistant-section-title = t('dashboard.messages.ai_assist.change_tone', default: 'Change Tone')
                    .ai-assistant-tone-grid
                      - %w[professional friendly concise formal empathetic].each do |tone|
                        button.ai-assistant-tone type="button" data-action="click->ai-assist#rewriteTone click->accordion#toggleMenu" data-ai-assist-tone-param=tone
                          .ai-assistant-tone-icon
                            = inline_svg_tag("ai-assistant-#{tone}.svg")
                          span = t("dashboard.messages.ai_assist.tones.#{tone}")

                  .ai-assistant-disclaimer
                    = image_tag("ai-assistant-disclaimer.svg", alt: "")
                    p = t('dashboard.messages.ai_assist.disclaimer', default: 'AI responses may not always be accurate. Please review before sending.')
                        
            .send-button data-controller="accordion"
              = f.submit t('dashboard.messages.send'), class: "f-semi-12", data: { turbo_submits_with: t('dashboard.messages.sending') }
              .arrow-container data-action="click->accordion#toggleMenu" 
                = inline_svg_tag("arrow_down_white.svg")

              .menu data-accordion-target="menu"
                .schedule-options 
                  / .menu-link data-action="click->modal-toggler#showModal click->frame-toggler#loadModal" data-popup-view="_schedule_modal"
                  /   = inline_svg_tag("timer.svg",class:"option-icon")
                  /   p.f-reg-14 = t('dashboard.messages.schedule')
                  button.menu-link.send-close type="submit" name="message[resolve_conversation]" value="1"
                    = inline_svg_tag("send_close.svg", class: "option-icon")
                    p.f-reg-14 = t('dashboard.messages.send_and_close')
  button.conversation-inspector-backdrop type="button" tabindex="-1" aria-label=t('dashboard.conversation_details.hide_details', default: 'Hide conversation details') data-action="click->conversation-inspector#close" data-conversation-inspector-target="backdrop"
  = render "dashboard/conversations/conversation_details"
