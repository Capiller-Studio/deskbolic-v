= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "web-widget-channels") do
    .ec-form-page style="display: flex; gap: 32px; align-items: flex-start; max-width: 1200px; margin: 0 auto; padding: 24px;"
      .form-section style="flex: 1; max-width: 800px; min-width: 0;"
        .ec-form-header
          = link_to t("dashboard.web_widget_channels.form.back"), web_widget_channels_path, class: "ec-back-link"
          h2.f-semi-32 style="margin-top: 16px; color: #0f172a;" = t("dashboard.web_widget_channels.new.title")

        .ec-form-container
          = render "form", web_widget_channel: @web_widget_channel
      
      .preview-section style="flex: 0 0 350px; position: sticky; top: 24px;"
        = render "preview", web_widget_channel: @web_widget_channel
