- content_for :body_class, "auth-themed-body"
- content_for :themed_auth_layout, "true"

.auth-page.auth-page--password-reset
  main.auth-main
    header.auth-header
      = link_to root_path, class: "auth-logo", aria: { label: "Capiller Rely" } do
        = image_tag "logo.png", alt: "Capiller Rely"

      .auth-header-action
        = link_to t("auth.login.submit"), new_user_session_path, class: "auth-secondary-button"

    .auth-form-wrap
      .auth-card
        .auth-card-header
          .auth-eyebrow = t("auth.passwords.send_instructions")
          h1 = t("auth.passwords.forgot_title")
          p = t("auth.passwords.forgot_subtitle")

        - if resource.errors.any?
          .auth-error-list role="alert"
            ul
              - resource.errors.full_messages.each do |message|
                li = message

        = form_with url: user_password_path, method: :post, local: true, data: { turbo: false }, class: "auth-form" do |f|
          .auth-field
            = f.label :email, t("auth.email"), class: "auth-label", for: "user_email"
            = f.email_field "user[email]",
              id: "user_email",
              value: resource.email,
              autofocus: true,
              autocomplete: "email",
              required: true,
              class: "auth-input",
              placeholder: t("auth.placeholders.email")

          = f.submit t("auth.passwords.send_instructions"), class: "auth-primary-button"

  aside.auth-visual aria-label=t("auth.registration.marketing_text")
    .auth-visual-orb.auth-visual-orb--one
    .auth-visual-orb.auth-visual-orb--two
    .auth-visual-content
      .auth-visual-badge
        span.auth-visual-badge-dot
        = t("auth.passwords.forgot_subtitle")
      = image_tag "register.png", class: "auth-visual-image", alt: "", aria: { hidden: true }
      h2 = t("auth.registration.marketing_text")
