.model-content-section
  .model-content
    .modal-header
      h3.f-semi-18 Messenger Channel
      = inline_svg_tag("cross_button.svg", alt:"menu", class:"conversation-icon m-close", data: { action: "click->modal-toggler#hideModal" })
    .modal-body.channel-form
      = form_with(url: "#", data: {controller: "formValidation renderer", "formValidation-target" => "form"}, html: {class: "needs-validation", novalidate: true, method: :post, remote: true}) do |f|
        .form-fields
          = f.hidden_field :channel_type, value: "facebook_page"
          .form-floating
            .field-label
              span 1
              = f.label :app_id, "Enter app id", class: "form-label f-reg-14"
            = f.text_field :app_id, autofocus: true, class: "form-control rounded-3 f-reg-14", placeholder: "App ID", required: true
        .form-actions
          p.submit-btn.f-med-14 data-controller="facebook" data-action="click->formValidation#validate click->facebook#fb_login click->modal-toggler#hideModal" data-address=facebook_page_path Continue

