= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "csat-surveys") do
    .ui-page-body
      .ui-index-header
        .ui-title-area
          h2.f-semi-32 = t("dashboard.csat_surveys.edit.title")
          p.f-reg-16 = t("dashboard.csat_surveys.edit.description")
        = link_to csat_surveys_path, class: "ui-btn-outline"
          = t("shared.back")

      .ui-card
        .ui-card-top
          .ui-card-info style="width: 100%;"
            = render "form", survey: @csat_survey
