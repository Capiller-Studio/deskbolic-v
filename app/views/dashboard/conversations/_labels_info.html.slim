- workspace_labels = current_account.labels.order(:title)
.label-comp id="conversation-labels-#{conversation.id}"
  button.inspector-accordion.inspector-label-trigger type="button" data-action="click->accordion#toggle"
    span.inspector-label-heading
      span = t('ui.dashboard.conversations.labels_info.manage_labels', default: 'Manage labels')
      = inline_svg_tag('arrow_down.svg', class: 'inspector-chevron', aria: { hidden: true })
    span.inspector-label-chips
      - conversation.labels.each do |label|
        span.inspector-label-chip style="--label-color: #{label.color.presence || '#344f8f'}" = label.title
      span.inspector-label-add = "+ #{t('general.add', default: 'Add')}"

  .panel.inspector-panel.inspector-label-options data-accordion-target="panel"
    - if workspace_labels.any?
      - workspace_labels.each do |label|
        .inspector-label-option
          span.label-color style="background-color: #{label.color.presence || '#a3aab8'}"
          span = label.title
          - if conversation.labels.include?(label)
            = button_to t('general.remove'), remove_label_conversation_path(conversation, label_id: label.id), method: :delete, class: 'label-option-action label-option-action--remove'
          - else
            = button_to t('general.add'), add_label_conversation_path(conversation, label_id: label.id), method: :post, class: 'label-option-action'
    - else
      p.inspector-empty = t('dashboard.labels.index.empty_description')
      = link_to t('dashboard.labels.index.add_new_label'), labels_path, class: 'inspector-empty-action', data: { turbo_frame: '_top' }
