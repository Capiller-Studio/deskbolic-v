/* Roles & Permissions Specific Styles */

.roles-page,
.roles-editor-page {
  width: 100%;
  height: 100vh;
  overflow-y: auto;
  background: #fff;
  color: #141b2d;
  font-family: $font-family-inter-regular;
}

.roles-icon {
  display: block;
  width: 22px;
  height: 22px;
  /* stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round; */
}

.roles-page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 28px 40px;
  border-bottom: 1px solid #e7eaf0;
}

.roles-page-heading h1,
.roles-editor-header h1 {
  margin: 0;
  color: #202124;
  font-family: $font-family-inter-semibold;
  font-size: 26px;
  font-weight: 700;
  letter-spacing: -0.5px;
  line-height: 1.25;
}

.roles-page-heading p,
.roles-editor-header p {
  margin: 7px 0 0;
  color: #929292;
  font-size: 16px;
  line-height: 1.45;
}

.roles-primary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 42px;
  padding: 0 20px;
  border: 0;
  border-radius: 10px;
  background: #202020;
  color: #fff;
  cursor: pointer;
  font-family: $font-family-inter-semibold;
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  transition: background 0.15s ease, transform 0.15s ease;
}

.roles-primary-button:hover {
  background: #050505;
  color: #fff;
  transform: translateY(-1px);
}

.roles-primary-button .roles-icon {
  width: 17px;
  height: 17px;
}

.roles-button-plus {
  width: 13px;
  height: 14px;
}

.roles-primary-button-disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

.roles-page-body {
  padding: 42px 40px 56px;
}

.roles-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 24px;
}

.roles-stat-card {
  display: flex;
  align-items: center;
  gap: 20px;
  min-height: 132px;
  padding: 24px 28px;
  border: 1px solid #dde1e8;
  border-radius: 18px;
  background: #fff;
  box-shadow: 0 2px 3px rgba(30, 41, 59, 0.08);
}

.roles-stat-icon {
  display: flex;
  flex: 0 0 64px;
  align-items: center;
  justify-content: center;
  width: 64px;
  height: 64px;
  border-radius: 16px;
}

.roles-stat-icon .roles-icon {
  width: 52px;
  height: 52px;
}

.roles-stat-icon-blue,
.roles-stat-icon-green,
.roles-stat-icon-purple,
.roles-stat-icon-orange { background: transparent; }

.roles-stat-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 6px;
}

.roles-stat-copy strong {
  color: #111827;
  font-family: $font-family-inter-semibold;
  font-size: 34px;
  font-weight: 700;
  line-height: 1;
}

.roles-stat-copy span {
  color: #465269;
  font-family: $font-family-inter-semibold;
  font-size: 15px;
  white-space: nowrap;
}

.roles-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin: 48px 0 30px;
}

.roles-toolbar-left {
  display: flex;
  align-items: center;
  gap: 16px;
}

.roles-search,
.roles-filter,
.roles-sort-select {
  display: flex;
  align-items: center;
  height: 48px;
  border: 1px solid #dce1e9;
  border-radius: 10px;
  background: #fff;
  color: #8ea0bd;
}

.roles-search {
  gap: 13px;
  width: 325px;
  padding: 0 16px;
}

.roles-search .roles-icon,
.roles-filter > .roles-icon:first-child {
  flex: 0 0 auto;
  width: 20px;
  height: 20px;
}

.roles-search input {
  min-width: 0;
  width: 100%;
  border: 0;
  outline: 0;
  background: transparent;
  color: #263248;
  font: inherit;
  font-size: 15px;
}

.roles-search input::placeholder { color: #94a3bd; }

.roles-filter {
  width: 202px;
  padding: 0 14px;
  gap: 10px;
}

.roles-filter select,
.roles-sort-select select {
  min-width: 0;
  flex: 1;
  border: 0;
  outline: 0;
  appearance: none;
  background: transparent;
  color: #465269;
  font: inherit;
  font-size: 15px;
  cursor: pointer;
}

.roles-filter > .roles-icon:last-child,
.roles-sort-select .roles-icon {
  width: 17px;
  height: 17px;
  color: #48566c;
  pointer-events: none;
}

.roles-sort {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #607089;
  font-size: 15px;
}

.roles-sort-select {
  width: 210px;
  padding: 0 14px;
}

.roles-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 30px;
}

.roles-card {
  position: relative;
  min-width: 0;
  min-height: 350px;
  padding: 30px;
  border: 1px solid #dce1e8;
  border-radius: 22px;
  background: #fff;
  box-shadow: 0 2px 3px rgba(30, 41, 59, 0.06);
  transition: box-shadow 0.18s ease, transform 0.18s ease;
}

.roles-card:hover {
  box-shadow: 0 10px 28px rgba(30, 41, 59, 0.09);
  transform: translateY(-2px);
}

.roles-card[hidden] { display: none; }

.roles-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 82px;
}

.roles-card-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70px;
  height: 70px;
  border-radius: 18px;
}

.roles-card-icon .roles-icon {
  width: 64px;
  height: 64px;
}

.roles-card-title {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 18px;
}

.roles-card-title h2 {
  overflow: hidden;
  margin: 0;
  color: #111827;
  font-family: $font-family-inter-semibold;
  font-size: 22px;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.roles-card-title h2 a {
  color: inherit;
  text-decoration: none;
}

.roles-card-title h2 a:hover { color: #425bd8; }

.roles-type-badge {
  flex: 0 0 auto;
  padding: 5px 9px;
  border-radius: 6px;
  background: #f0f5ff;
  color: #2860ef;
  font-family: $font-family-inter-semibold;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.6px;
  line-height: 1;
}

.roles-type-badge-custom { background: #eef4ff; }

.roles-card-description {
  min-height: 44px;
  margin: 12px 0 0;
  color: #667792;
  font-size: 15px;
  line-height: 1.5;
}

.roles-card-divider {
  margin: 26px 0 20px;
  border-top: 1px solid #e7ebf1;
}

.roles-card-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18px;
}

.roles-card-meta {
  display: flex;
  flex-direction: column;
  gap: 10px;
  color: #667792;
  font-size: 14px;
}

.roles-card-meta span {
  display: flex;
  align-items: center;
  gap: 8px;
  white-space: nowrap;
}

.roles-card-meta .roles-icon {
  width: 17px;
  height: 17px;
}

.roles-card-updated {
  display: flex;
  align-items: flex-end;
  flex-direction: column;
  gap: 6px;
  color: #56657c;
  font-size: 13px;
  white-space: nowrap;
}

.roles-card-updated small {
  color: #91a1bc;
  font-family: $font-family-inter-semibold;
  font-size: 10px;
  letter-spacing: 0.2px;
  text-transform: uppercase;
}

.roles-card-menu {
  position: relative;
  z-index: 3;
}

.roles-card-menu summary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 38px;
  border-radius: 8px;
  color: #93a5bf;
  cursor: pointer;
  list-style: none;
}

.roles-card-menu summary::-webkit-details-marker { display: none; }
.roles-card-menu summary:hover { background: #f4f6f9; color: #53627a; }
.roles-card-menu summary .roles-icon { width: 21px; height: 21px; }

.roles-card-menu-popover {
  position: absolute;
  top: 42px;
  right: 0;
  z-index: 10;
  width: 150px;
  overflow: hidden;
  border: 1px solid #e3e6ec;
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 12px 30px rgba(17, 24, 39, 0.16);
}

.roles-card-menu-popover a {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 13px 16px;
  color: #374151;
  font-size: 14px;
  text-decoration: none;
}

.roles-card-menu-popover a + a { border-top: 1px solid #edf0f4; }
.roles-card-menu-popover a:hover { background: #f8fafc; }
.roles-card-menu-popover a.roles-card-delete { color: #fa4040; }
.roles-card-menu-popover .roles-icon { width: 18px; height: 18px; }

.roles-empty-filter {
  display: flex;
  min-height: 260px;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 40px;
  border: 1px dashed #d8dee8;
  border-radius: 18px;
  color: #8090a8;
  text-align: center;
}

.roles-empty-filter[hidden] { display: none; }
.roles-empty-filter .roles-icon { width: 34px; height: 34px; margin-bottom: 14px; }
.roles-empty-filter h2 { margin: 0; color: #263248; font-size: 18px; }
.roles-empty-filter p { margin: 7px 0 0; font-size: 14px; }

/* Create and edit */

.roles-editor-backbar {
  padding: 36px 40px;
  border-bottom: 1px solid #e7eaf0;
}

.roles-back-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #374151;
  font-size: 16px;
  text-decoration: none;
}

.roles-back-link:hover { color: #111827; }
.roles-back-link .roles-icon { width: 20px; height: 20px; }

.roles-editor-content {
  padding: 32px 40px 64px;
}

.roles-editor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 34px;
}

.roles-editor-form { width: 100%; }

.roles-form-errors {
  margin-bottom: 20px;
  padding: 15px 18px;
  border: 1px solid #fecaca;
  border-radius: 10px;
  background: #fff5f5;
  color: #b91c1c;
  font-size: 13px;
}

.roles-form-errors ul { margin: 7px 0 0 18px; }

.roles-editor-layout {
  display: grid;
  grid-template-columns: 355px minmax(0, 1fr);
  align-items: start;
  gap: 26px;
}

.roles-editor-sidebar {
  display: flex;
  flex-direction: column;
  gap: 26px;
}

.roles-editor-card,
.roles-matrix-card {
  border: 1px solid #dce1e8;
  border-radius: 18px;
  background: #fff;
  box-shadow: 0 2px 3px rgba(30, 41, 59, 0.07);
}

.roles-editor-card { padding: 28px 26px; }

.roles-editor-card h2,
.roles-matrix-heading h2 {
  margin: 0;
  color: #273144;
  font-family: $font-family-inter-semibold;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.6px;
  text-transform: uppercase;
}

.roles-editor-card h2 small {
  display: block;
  margin-top: 3px;
  color: #91a0b8;
  font-size: 13px;
  font-weight: 500;
}

.roles-name-field {
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-top: 24px;
}

.roles-name-field label {
  color: #617089;
  font-family: $font-family-inter-semibold;
  font-size: 13px;
}

.roles-name-field input {
  width: 100%;
  height: 48px;
  padding: 0 15px;
  border: 1px solid #d8dee8;
  border-radius: 10px;
  outline: 0;
  color: #273144;
  font: inherit;
  font-size: 14px;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.roles-name-field input:focus {
  border-color: #7b91fa;
  box-shadow: 0 0 0 3px rgba(123, 145, 250, 0.13);
}

.roles-name-field input::placeholder { color: #778398; }
.roles-name-field input:disabled { background: #f5f6f8; cursor: not-allowed; }

.roles-presets > p {
  margin: 26px 0 25px;
  color: #667792;
  font-size: 13px;
  line-height: 1.5;
}

.roles-preset-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.roles-preset-option {
  position: relative;
  display: grid;
  grid-template-columns: 42px 1fr 20px;
  align-items: center;
  gap: 14px;
  cursor: pointer;
}

.roles-preset-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 10px;
  /* background: #f1f2ff; */
  color: #7286ff;
}

.roles-preset-icon .roles-icon { width: 32px; height: 32px; }

.roles-preset-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 3px;
}

.roles-preset-copy strong {
  color: #334057;
  font-family: $font-family-inter-semibold;
  font-size: 14px;
  line-height: 1.2;
}

.roles-preset-copy span {
  overflow: hidden;
  color: #91a1ba;
  font-size: 11px;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.roles-preset-option > input {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
}

.roles-preset-radio {
  position: relative;
  width: 20px;
  height: 20px;
  border: 1.5px solid #ccd3de;
  border-radius: 50%;
}

.roles-preset-option > input:checked + .roles-preset-radio {
  border-color: #798dfb;
  background: #798dfb;
}

.roles-preset-option > input:checked + .roles-preset-radio::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #fff;
  content: "";
  transform: translate(-50%, -50%);
}

.roles-preset-option > input:focus-visible + .roles-preset-radio {
  box-shadow: 0 0 0 3px rgba(121, 141, 251, 0.2);
}

.roles-matrix-card { overflow: hidden; }

.roles-matrix-heading {
  padding: 28px 26px 25px;
}

.roles-matrix-heading p {
  margin: 4px 0 0;
  color: #667792;
  font-size: 13px;
}

.roles-matrix-scroll { overflow-x: auto; }

.roles-matrix {
  min-width: 752px;
}

.roles-matrix-superheader,
.roles-matrix-actions,
.roles-matrix-row {
  display: grid;
  grid-template-columns: 220px repeat(7, minmax(76px, 1fr));
}

.roles-matrix-superheader {
  min-height: 62px;
  align-items: center;
  border-top: 1px solid #edf0f4;
  border-bottom: 1px solid #edf0f4;
  background: #f8fafc;
  color: #93a2ba;
  font-family: $font-family-inter-semibold;
  font-size: 11px;
  letter-spacing: 1.2px;
  text-transform: uppercase;
}

.roles-matrix-superheader span:first-child { padding-left: 22px; }
.roles-matrix-superheader span:last-child { grid-column: 2 / -1; padding-left: 10px; }

.roles-matrix-actions {
  min-height: 92px;
  align-items: center;
}

.roles-matrix-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8px;
  color: #455169;
  font-family: $font-family-inter-semibold;
  font-size: 11px;
}

.roles-matrix-action .roles-icon { width: 19px; height: 19px; }
.roles-matrix-action-read { color: #3bbc68; }
.roles-matrix-action-write { color: #8c56ff; }
.roles-matrix-action-delete { color: #f0643e; }
.roles-matrix-action-manage { color: #f08125; }
.roles-matrix-action-export { color: #30afd5; }
.roles-matrix-action-execute { color: #e44d94; }
.roles-matrix-action-invite { color: #405080; }
.roles-matrix-action span { color: #455169; }

.roles-matrix-row {
  min-height: 82px;
  align-items: center;
  border-top: 1px solid #edf0f4;
  transition: background 0.15s ease;
}

.roles-matrix-row:hover { background: #fbfcff; }

.roles-matrix-resource {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12px;
  padding: 0 18px;
  color: #354158;
  font-size: 14px;
}

.roles-resource-icon {
  display: flex;
  flex: 0 0 42px;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 10px;
  /* background: #f1f2ff; */
  color: #7185ff;
}

.roles-resource-icon .roles-icon { width: 32px; height: 32px; }

.roles-matrix-resource > span {
  overflow: hidden;
  flex: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.roles-matrix-resource > .roles-icon {
  width: 16px;
  height: 16px;
  color: #9babbe;
  transform: rotate(-90deg);
}

.roles-matrix-cell {
  display: flex;
  align-items: center;
  justify-content: center;
}

.pm-toggle-label {
  display: inline-flex;
  align-items: center;
  cursor: pointer;
}

.pm-toggle-input {
  position: relative;
  width: 45px;
  height: 25px;
  margin: 0;
  border: 0;
  border-radius: 999px;
  appearance: none;
  outline: 0;
  background: #e0e6ef;
  cursor: pointer;
  transition: background 0.2s ease, box-shadow 0.2s ease;
}

.pm-toggle-input::after {
  position: absolute;
  top: 4px;
  left: 4px;
  width: 17px;
  height: 17px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.12);
  content: "";
  transition: transform 0.2s ease;
}

.pm-toggle-input:checked { background: #7187f7; }
.pm-toggle-input:checked::after { transform: translateX(20px); }
.pm-toggle-input:focus-visible { box-shadow: 0 0 0 3px rgba(113, 135, 247, 0.22); }
.pm-toggle-input:disabled { cursor: not-allowed; opacity: 0.62; }

.roles-matrix-unavailable {
  width: 6px;
  height: 2px;
  border-radius: 2px;
  background: #e8ecf2;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  padding: 0;
  margin: -1px;
  border: 0;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
}

@media (max-width: 1360px) {
  .roles-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .roles-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .roles-editor-layout { grid-template-columns: minmax(280px, 310px) minmax(0, 1fr); }
}

@media (max-width: 1120px) {
  .roles-editor-layout { grid-template-columns: 1fr; }
  .roles-editor-sidebar { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .roles-editor-card { height: fit-content; }
}

@media (max-width: 900px) {
  .roles-page-header,
  .roles-page-body,
  .roles-editor-content { padding-left: 24px; padding-right: 24px; }
  .roles-editor-backbar { padding-left: 24px; padding-right: 24px; }
  .roles-toolbar { align-items: stretch; flex-direction: column; }
  .roles-toolbar-left { flex-wrap: wrap; }
  .roles-search { flex: 1 1 280px; }
  .roles-sort { align-self: flex-end; }
  .roles-grid { grid-template-columns: 1fr; }
}

@media (max-width: 640px) {
  .roles-page-header,
  .roles-editor-header { align-items: flex-start; flex-direction: column; }
  .roles-page-header .roles-primary-button,
  .roles-editor-header .roles-primary-button { width: 100%; }
  .roles-page-body { padding-top: 24px; }
  .roles-stats { grid-template-columns: 1fr; }
  .roles-stat-card { min-height: 104px; }
  .roles-toolbar { margin-top: 28px; }
  .roles-toolbar-left { align-items: stretch; flex-direction: column; }
  .roles-search,
  .roles-filter { width: 100%; flex: none; }
  .roles-sort { width: 100%; align-self: stretch; justify-content: space-between; }
  .roles-sort-select { flex: 1; }
  .roles-card { min-height: 330px; padding: 24px; }
  .roles-editor-sidebar { display: flex; }
  .roles-card-footer { align-items: flex-start; flex-direction: column; }
  .roles-card-updated { align-items: flex-start; }
}
