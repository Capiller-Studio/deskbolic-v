      .card data-controller="filterable-collection"
        .header style="margin-top: 3px;" data-controller="modal-toggler frame-toggler"
          .settings-sidebar-heading
            = link_to conversations_path, class: "settings-sidebar-back", data: { turbo: false }, aria: { label: t("dashboard.sidebar.settings.back_to_dashboard") } do
              = image_tag("dashboard_collapse.svg", class: "settings-sidebar-back-icon", alt: "", aria: { hidden: true })
            p.f-reg-14 = t('dashboard.sidebar.settings.title')
          = render("dashboard/shared/modal_popper")
        label.settings-sidebar-search
          span.settings-sidebar-search-icon aria-hidden="true"
            = inline_svg_tag("search_gray.svg")
          input.f-reg-14(
            type="search"
            placeholder=t("ui.dashboard.settings.settings_sidebar.search_placeholder")
            aria-label=t("ui.dashboard.settings.settings_sidebar.search_placeholder")
            autocomplete="off"
            data-filterable-collection-target="query"
            data-action="input->filterable-collection#update"
          )
        ul.channel-list.st-sidebar.settings-sidebar-accordion(
          data-controller="accordion modal-toggler frame-toggler"
          data-accordion-exclusive-value="true"
        )
