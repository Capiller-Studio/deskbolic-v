<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" color="#333333" line-height="24px" />
    </mj-attributes>
    <mj-style>
      .link-button { text-decoration: none; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f8fafc">
    <mj-section background-color="#ffffff" padding-bottom="0px" padding-top="20px">
      <mj-column>
        <mj-text align="center" font-size="24px" font-weight="bold" color="#0f172a">
          Deskbolic
        </mj-text>
        <mj-divider border-color="#e2e8f0" border-width="1px" padding-top="20px"></mj-divider>
      </mj-column>
    </mj-section>
    
    <mj-section background-color="#ffffff" padding-top="20px">
      <mj-column>
        <mj-text font-size="20px" font-weight="600" color="#1e293b">
          Your trial ends soon!
        </mj-text>
        <mj-text>
          Hi <%= @account.name %>,
        </mj-text>
        <mj-text>
          We hope you are enjoying your free trial of Deskbolic. Your trial for the <strong><%= @subscription.plan.name.titleize %></strong> plan will expire in <strong><%= @subscription.days_until_trial_end %> days</strong>.
        </mj-text>
        <mj-text>
          To ensure your team continues to have uninterrupted access to Deskbolic, please add a valid payment method to your billing settings.
        </mj-text>
        
        <mj-button background-color="#4f46e5" color="white" href="<%= ENV['APP_URL'] || 'https://app.deskbolic.com' %>/billing" border-radius="6px" padding="20px 0" css-class="link-button">
          Update Payment Method
        </mj-button>
        
        <mj-text>
          If you have any questions, reply directly to this email and our support team will help you out.
        </mj-text>
        <mj-text>
          Thanks,<br />
          The Deskbolic Team
        </mj-text>
      </mj-column>
    </mj-section>
    
    <mj-section>
      <mj-column>
        <mj-text align="center" font-size="12px" color="#94a3b8">
          © <%= Time.current.year %> Deskbolic. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
