section#integration-details.channel-edit-section.channel-edit-card
  .channel-edit-section__heading.channel-edit-section__heading--with-description
    .channel-edit-section__icon
      = inline_svg_tag("code_snipet.svg", aria: { hidden: true })
    .channel-edit-section__heading-copy
      h2 = t("dashboard.channels.edit.integration_details", default: "Integration Details")
      p = t("dashboard.channels.show.custom_integration_description", default: "Public endpoints used to exchange messages with your integration.")
  .channel-edit-section__body
    .channel-edit-copy-list
      .channel-edit-copy data-controller="clipboard"
        label = t("dashboard.channels.show.incoming_webhook", default: "Incoming Webhook Endpoint")
        .channel-edit-copy__control
          input type="text" value=channel.webhook_endpoint readonly=true data-clipboard-target="source"
          button.channel-edit-copy__button type="button" data-action="click->clipboard#copy" data-clipboard-target="button"
            = inline_svg_tag("copy.svg", aria: { hidden: true })
            span = t("general.copy")
      .channel-edit-copy data-controller="clipboard"
        label = t("dashboard.custom_channels.form.webhook_url", default: "Destination Webhook URL")
        .channel-edit-copy__control
          input type="text" value=channel.webhook_url readonly=true data-clipboard-target="source"
          button.channel-edit-copy__button type="button" data-action="click->clipboard#copy" data-clipboard-target="button"
            = inline_svg_tag("copy.svg", aria: { hidden: true })
            span = t("general.copy")

section.channel-edit-section.channel-edit-card
  .channel-edit-section__heading
    .channel-edit-section__icon
      = inline_svg_tag("form_fields.svg", aria: { hidden: true })
    h2 = t("dashboard.channels.edit.response_mapping", default: "Response Mapping")
  .channel-edit-section__body
    - if channel.response_mapping.present?
      dl.channel-show-details
        - channel.response_mapping.each do |deskbolic_field, json_path|
          .channel-show-details__item
            dt = deskbolic_field.to_s.humanize
            dd = json_path
    - else
      p.channel-show-empty = t("dashboard.channels.edit.no_mapping", default: "No mapping defined yet")

section.channel-edit-section.channel-edit-card
  .channel-edit-section__heading.channel-edit-section__heading--with-description
    .channel-edit-section__icon
      = inline_svg_tag("document.svg", aria: { hidden: true })
    .channel-edit-section__heading-copy
      h2 = t("dashboard.channels.edit.developer_guide", default: "Developer Guide")
      p = t("dashboard.channels.edit.developer_guide_hint", default: "Capiller Rely sends a POST request to your outbound webhook when an agent replies.")
  .channel-edit-section__body
    pre.channel-edit-code-block
      code = JSON.pretty_generate(event: "message.created", channel_id: channel.identifier, message: { id: "msg_12345", content: "Hello, how can I help you today?" })
