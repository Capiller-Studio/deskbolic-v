= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "whatsapp-channels") do
    .channel-theme-whatsapp
      .ui-page-body
        .ui-page-header
          = link_to channels_whatsapp_index_path, class: "ui-back-link"
            | ← #{t("dashboard.whatsapp_channels.form.back")}
          h2.f-semi-32 = t("dashboard.whatsapp_channels.edit.title")

        .ui-section
          .ui-section-header
            h3.f-semi-18 = t("dashboard.whatsapp_channels.edit.title")
        
          .channel-connection-card
            .channel-connection-info
              .ui-avatar-placeholder
                | 💬
              .ui-card-info
                h4.f-semi-16 = @whatsapp_channel.name || @whatsapp_channel.full_phone_number
                p.f-reg-14 
                  | #{t("ui.dashboard.channels.whatsapp.edit.phone", full_phone_number: @whatsapp_channel.full_phone_number)}
                  span.channel-page-connected
                    | #{t("ui.dashboard.channels.whatsapp.edit.waba", business_account_id: @whatsapp_channel.business_account_id)}

            - if @whatsapp_channel.reauthorization_required?
              .channel-reauth-banner
                .channel-reauth-icon ⚠️
                .channel-reauth-text
                  p.f-semi-14 = t("dashboard.whatsapp_channels.edit.reauth_title")
                  p.f-reg-12 = t("dashboard.whatsapp_channels.edit.reauth_description")
                = link_to reconnect_channels_whatsapp_path(@whatsapp_channel), method: :post, class: "channel-reconnect-btn", data: { turbo_method: :post }
                  | 🔄 #{t("dashboard.whatsapp_channels.index.reconnect")}
            - else
              .channel-status-active
                .ui-badge.ui-badge-active
                  span.ui-badge-icon 🟢
                  span = t("dashboard.whatsapp_channels.index.status_active")

        .ui-section
          .ui-section-header
            h3.f-semi-18 = t("dashboard.whatsapp_channels.edit.webhook.title")
            p.f-reg-14 style="color: var(--gray-600); margin-top: 4px;" = t("dashboard.whatsapp_channels.edit.webhook.description")

          .channel-webhook-details
            .ui-form-group
              label.ui-label = t("dashboard.whatsapp_channels.edit.webhook.url_label")
              .ui-copy-group
                input.ui-input type="text" value="#{@whatsapp_channel.webhook_url}" readonly=true
                button.ui-btn-secondary type="button" onclick="navigator.clipboard.writeText('#{@whatsapp_channel.webhook_url}')"
                  | 📋 #{t("general.copy")}

            .ui-form-group
              label.ui-label = t("dashboard.whatsapp_channels.edit.webhook.secret_label")
              .ui-copy-group
                input.ui-input type="text" value="#{@whatsapp_channel.webhook_secret}" readonly=true
                button.ui-btn-secondary type="button" onclick="navigator.clipboard.writeText('#{@whatsapp_channel.webhook_secret}')"
                  | 📋 #{t("general.copy")}

        = form_with model: @whatsapp_channel, url: channels_whatsapp_path(@whatsapp_channel), class: "ui-form-wrapper wa-wrapper" do |f|
          .ui-section.wa-section
            .ui-section-header
              h3.f-semi-18 = t("dashboard.whatsapp_channels.form.inbox_settings")
          
            .ui-form-group
              = f.label :name, t("dashboard.whatsapp_channels.form.name_label"), class: "ui-label"
              = f.text_field :name, class: "ui-input", placeholder: t("dashboard.whatsapp_channels.form.name_placeholder"), required: true
          
            .ui-form-group
              label.ui-label = t("dashboard.whatsapp_channels.form.full_phone_label")
              input.ui-input type="text" value="#{@whatsapp_channel.full_phone_number}" disabled=true style="background: var(--gray-50); color: var(--gray-500); cursor: not-allowed;"

            .ui-form-group
              = f.label :api_key, t("dashboard.whatsapp_channels.form.api_key_label"), class: "ui-label"
              = f.password_field :api_key, value: @whatsapp_channel.api_key, class: "ui-input", placeholder: t("dashboard.whatsapp_channels.form.api_key_placeholder"), required: true

          - if @whatsapp_channel.primary_inbox
            .channel-inbox-settings style="margin-top: 24px; padding: 18px 24px; border: 1px solid rgba(0, 0, 0, 5%); border-radius: 16px;"
              / h4.f-semi-14 = t("dashboard.whatsapp_channels.form.inbox_settings_title")

              = f.fields_for :primary_inbox, @whatsapp_channel.primary_inbox do |inbox|
                = inbox.hidden_field :id

                .ui-form-group.ui-checkbox-group style="margin-bottom: 12px;"
                  = inbox.check_box :csat_survey_enabled, class: "ui-checkbox"
                  = inbox.label :csat_survey_enabled, t("dashboard.whatsapp_channels.form.enable_csat"), class: "ui-checkbox-label"

                .ui-form-group
                  = inbox.label :reopen_window_seconds, t("dashboard.whatsapp_channels.form.reopen_window_label"), class: "ui-label"
                  = inbox.select :reopen_window_seconds, options_for_select([[t("forms.options.never_always_create_new"), 0], [t("forms.options.one_hour"), 3600], [t("forms.options.twelve_hours"), 43200], [t("forms.options.twenty_four_hours"), 86400], [t("forms.options.seven_days"), 604800], [t("forms.options.fourteen_days"), 1209600]], inbox.object.reopen_window_seconds), {}, class: "ui-select"

                .ui-form-group
                  = inbox.label :csat_survey_id, t("dashboard.whatsapp_channels.form.csat_survey_label"), class: "ui-label"
                  = inbox.collection_select :csat_survey_id, current_account.csat_surveys, :id, :name, { include_blank: t("forms.options.default_system_survey") }, class: "ui-select"
              
                .ui-form-group
                  = inbox.label :business_hour_group_id, t("forms.labels.business_hours"), class: "ui-label"
                  = inbox.collection_select :business_hour_group_id, current_account.business_hour_groups, :id, :name, { include_blank: t("forms.options.always_online_24_7") }, class: "ui-select"
              
                .ui-form-group
                  = inbox.label :sla_policy_ids, t("forms.labels.sla_policies"), class: "ui-label"
                  = inbox.collection_select :sla_policy_ids, current_account.sla_policies, :id, :name, {}, { multiple: true, class: "ui-select" }
        
          .ui-form-actions
            = link_to channels_whatsapp_index_path, class: "ui-btn-secondary"
              | #{t("dashboard.whatsapp_channels.form.cancel")}
            = f.submit t("dashboard.whatsapp_channels.form.save"), class: "ui-btn-primary"

        .ui-danger-zone.ui-section style="margin-top: 3rem;"
          .ui-section-header
            h3.f-semi-18 = t("dashboard.whatsapp_channels.edit.danger_title")
          p.f-reg-14 = t("dashboard.whatsapp_channels.edit.danger_description")
        
          = button_to channels_whatsapp_path(@whatsapp_channel), method: :delete, class: "ui-btn-danger", form: { data: { turbo_confirm: t("dashboard.whatsapp_channels.index.delete_confirm") } } do
            | 🗑️ #{t("dashboard.whatsapp_channels.edit.disconnect")}
