/ Assignment Policy form — used for both new and edit.
/ Sections: Details, Strategy, Capacity, Conditions, Inboxes, Business Hours, Options
= form_with(model: policy, url: (policy.persisted? ? assignment_policy_path(policy) : assignment_policies_path), data: { controller: "assignment-policy" }) do |f|

  / ── Details Section ──
  .ap-section
    .ap-section-header
      span.ap-section-icon 📝
      = t("dashboard.assignment_policies.form.details_section")
    .ap-section-body
      .ap-form-row style="flex-direction: column; align-items: stretch; gap: 16px;"
        div
          label.f-semi-13.ap-label = t("dashboard.assignment_policies.form.name_label")
          = f.text_field :name, class: "ap-input", placeholder: t("dashboard.assignment_policies.form.name_placeholder"), id: "policy-name"
        div
          label.f-semi-13.ap-label = t("dashboard.assignment_policies.form.description_label")
          = f.text_area :description, class: "ap-input ap-textarea", rows: 2, placeholder: t("dashboard.assignment_policies.form.description_placeholder"), id: "policy-description"

  / ── Strategy Section ──
  .ap-section
    .ap-section-header
      span.ap-section-icon ⚡
      = t("dashboard.assignment_policies.form.strategy_section")
    .ap-section-body
      .ap-strategy-grid data-assignment-policy-target="strategyGrid"
        - strategies = [:round_robin, :load_balanced, :skills_based, :manual]
        - strategy_colors = { round_robin: "blue", load_balanced: "purple", skills_based: "green", manual: "gray" }
        - strategies.each do |strategy|
          label.ap-strategy-card id="strategy-#{strategy}" class="#{strategy_colors[strategy]} #{policy.strategy == strategy.to_s ? 'selected' : ''}" data-action="click->assignment-policy#selectStrategy"
            = f.radio_button :strategy, strategy, class: "ap-radio-hidden", data: { "assignment-policy-target": "strategyRadio" }
            .ap-strategy-card-icon = t("dashboard.assignment_policies.strategies.#{strategy}_icon")
            .ap-strategy-card-content
              h4.f-semi-14 = t("dashboard.assignment_policies.strategies.#{strategy}")
              p.f-reg-12 = t("dashboard.assignment_policies.strategies.#{strategy}_desc")

  / ── Capacity Section ──
  .ap-section data-assignment-policy-target="capacitySection"
    .ap-section-header
      span.ap-section-icon 📊
      = t("dashboard.assignment_policies.form.capacity_section")
    .ap-section-body
      .ap-form-row
        div style="flex: 1;"
          label.f-semi-13.ap-label = t("dashboard.assignment_policies.form.max_conversations_label")
          = f.number_field :max_conversations_per_agent, class: "ap-input", min: 1, placeholder: t("dashboard.assignment_policies.form.max_conversations_placeholder"), id: "policy-max-conv"
          p.ap-hint = t("dashboard.assignment_policies.form.max_conversations_hint")

  / ── Inboxes Section ──
  .ap-section
    .ap-section-header
      span.ap-section-icon 📥
      = t("dashboard.assignment_policies.form.inboxes_section")
    .ap-section-body
      p.ap-hint style="margin-bottom: 12px;" = t("dashboard.assignment_policies.form.all_inboxes_hint")
      .ap-checkbox-grid
        - @inboxes.each do |inbox|
          label.ap-checkbox-item id="inbox-#{inbox.id}"
            = check_box_tag "assignment_policy[inbox_ids][]", inbox.id, policy.inbox_ids.include?(inbox.id), class: "ap-checkbox"
            span.f-reg-13 = inbox.name

  / ── Business Hours Section ──
  .ap-section
    .ap-section-header
      span.ap-section-icon 🕐
      = t("dashboard.assignment_policies.form.business_hours_section")
    .ap-section-body
      .ap-form-row
        .ap-toggle-row
          = f.check_box :respect_business_hours, class: "ap-checkbox", data: { action: "change->assignment-policy#toggleBusinessHours", "assignment-policy-target": "businessHoursToggle" }, id: "policy-bh-toggle"
          label.f-reg-13 for="policy-bh-toggle" = t("dashboard.assignment_policies.form.respect_business_hours")

      .ap-conditional-field data-assignment-policy-target="businessHoursField" style="#{policy.respect_business_hours? ? '' : 'display: none;'}"
        label.f-semi-13.ap-label = t("dashboard.assignment_policies.form.business_hour_group_label")
        = f.select :business_hour_group_id, options_from_collection_for_select(@business_hour_groups, :id, :name, policy.business_hour_group_id), { include_blank: t("dashboard.assignment_policies.form.business_hour_group_prompt") }, class: "ap-select", id: "policy-bh-group"

  / ── Options Section ──
  .ap-section
    .ap-section-header
      span.ap-section-icon ⚙️
      = t("dashboard.assignment_policies.form.options_section")
    .ap-section-body
      .ap-options-grid
        .ap-toggle-row
          = f.check_box :reassign_on_offline, class: "ap-checkbox", id: "policy-reassign-offline"
          label.f-reg-13 for="policy-reassign-offline" = t("dashboard.assignment_policies.form.reassign_on_offline")

        .ap-toggle-row
          = f.check_box :prioritize_by_conversation_priority, class: "ap-checkbox", id: "policy-prioritize"
          label.f-reg-13 for="policy-prioritize" = t("dashboard.assignment_policies.form.prioritize_label")
          p.ap-hint style="margin-left: 24px;" = t("dashboard.assignment_policies.form.prioritize_hint")

        .ap-toggle-row
          = f.check_box :notify_on_assignment, class: "ap-checkbox", id: "policy-notify-agent"
          label.f-reg-13 for="policy-notify-agent" = t("dashboard.assignment_policies.flags.notify_on_assignment")

        .ap-toggle-row
          = f.check_box :notify_team_leads, class: "ap-checkbox", id: "policy-notify-leads"
          label.f-reg-13 for="policy-notify-leads" = t("dashboard.assignment_policies.flags.notify_team_leads")

        .ap-toggle-row
          = f.check_box :consider_agent_skills, class: "ap-checkbox", data: { "assignment-policy-target": "skillsToggle" }, id: "policy-skills"
          label.f-reg-13 for="policy-skills" = t("dashboard.assignment_policies.flags.consider_agent_skills")

        .ap-toggle-row
          = f.check_box :allow_idle_reassignment, class: "ap-checkbox", data: { action: "change->assignment-policy#toggleIdleTimeout", "assignment-policy-target": "idleToggle" }, id: "policy-idle"
          label.f-reg-13 for="policy-idle" = t("dashboard.assignment_policies.flags.allow_idle_reassignment")

      .ap-conditional-field data-assignment-policy-target="idleTimeoutField" style="#{policy.allow_idle_reassignment? ? '' : 'display: none;'}"
        label.f-semi-13.ap-label = t("dashboard.assignment_policies.form.idle_timeout_label")
        = f.number_field :idle_timeout_minutes, class: "ap-input ap-input-sm", min: 1, placeholder: t("dashboard.assignment_policies.form.idle_timeout_placeholder"), id: "policy-idle-timeout"
        p.ap-hint = t("dashboard.assignment_policies.form.idle_timeout_hint")

  / ── Conditions Hidden Field (for future conditions builder integration) ──
  = f.hidden_field :conditions, value: policy.conditions.to_json, data: { "assignment-policy-target": "conditionsField" }

  / ── Footer ──
  .ap-form-footer
    = link_to t("dashboard.assignment_policies.form.cancel"), assignment_policies_path, class: "ap-btn-secondary"
    = f.submit t("dashboard.assignment_policies.form.save"), class: "ap-btn-primary", id: "policy-submit"
