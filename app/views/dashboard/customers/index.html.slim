= render("dashboard/settings/settings_sidebar", current_page: "customers") do
  .tm-users.tm-customers data-controller="filterable-collection"
    .tm-users-header
      div
        h1 = t("dashboard.customers.index.title", default: "Customers")
        p = t("dashboard.customers.index.description", default: "View and manage every customer who has contacted your workspace.")

    .tm-users-body
      .tm-users-filters.tm-customers-filters.ui-settings-form
        label.tm-users-search
          svg viewBox="0 0 24 24" aria-hidden="true"
            circle cx="11" cy="11" r="7"
            path d="m20 20-4-4"
          input type="search" placeholder=t("dashboard.customers.index.search_placeholder", default: "Search customers...") aria-label=t("dashboard.customers.index.search_placeholder", default: "Search customers") data-filterable-collection-target="query" data-action="input->filterable-collection#update"

        .tm-users-select.ui-field-control.ui-field-control--compact.ui-field-control--no-icon
          select.ui-select.ui-control aria-label=t("dashboard.customers.index.filter_by_channel", default: "Filter by channel") data-controller="select" data-filterable-collection-target="filter" data-action="change->filterable-collection#update"
            option value="" = t("dashboard.customers.index.all_channels", default: "All channels")
            - @channel_inboxes.each do |inbox|
              option value=inbox.id = customer_channel_label(inbox)

        .tm-users-select.ui-field-control.ui-field-control--compact.ui-field-control--no-icon
          select.ui-select.ui-control aria-label=t("dashboard.customers.index.sort_customers", default: "Sort customers") data-controller="select" data-filterable-collection-target="sort" data-action="change->filterable-collection#update"
            option value="joined:desc" = t("dashboard.customers.index.sort_newest", default: "Newest first")
            option value="joined:asc" = t("dashboard.customers.index.sort_oldest", default: "Oldest first")
            option value="name:asc" = t("dashboard.customers.index.sort_name", default: "Name A–Z")

      - if @customers.any?
        .tm-customers-table-wrap
          table.tm-customers-table
            thead
              tr
                th scope="col" = t("dashboard.customers.index.customer", default: "Customer")
                th scope="col" = t("dashboard.customers.index.contact", default: "Contact")
                th scope="col" = t("dashboard.customers.index.channels", default: "Channels")
                th scope="col" = t("dashboard.customers.index.last_activity", default: "Last activity")
                th scope="col" = t("dashboard.customers.index.joined", default: "Joined")
                th.tm-customers-table__actions-heading scope="col" = t("dashboard.customers.index.actions", default: "Actions")
            tbody data-filterable-collection-target="container"
              - @customers.each do |customer|
                tr data-filterable-collection-target="item" data-searchable=customer_searchable_text(customer) data-filter-values=customer_channel_filter_values(customer) data-joined=customer.created_at.to_i data-name=customer_name(customer).downcase
                  td data-label=t("dashboard.customers.index.customer", default: "Customer")
                    .tm-customer-identity
                      - if customer.avatar.attached?
                        = image_tag customer.avatar, class: "tm-customer-avatar", alt: customer_name(customer)
                      - else
                        .tm-customer-avatar.tm-customer-avatar--fallback.avatar-fallback class=avatar_fallback_color_class(customer_name(customer))
                          = initials(customer)
                      .tm-customer-identity__copy
                        strong = customer_name(customer)
                        span = customer_type_label(customer)
                  td data-label=t("dashboard.customers.index.contact", default: "Contact")
                    strong.tm-customer-contact = customer_contact_value(customer)
                    - if customer.email.present? && customer.full_phone_number.present?
                      span.tm-customer-secondary = customer.full_phone_number
                  td data-label=t("dashboard.customers.index.channels", default: "Channels")
                    .tm-customer-channels
                      - customer_channel_inboxes(customer).first(2).each do |inbox|
                        span.tm-customer-channel = customer_channel_label(inbox)
                      - if customer_channel_inboxes(customer).size > 2
                        span.tm-customer-channel.tm-customer-channel--more = "+#{customer_channel_inboxes(customer).size - 2}"
                      - if customer_channel_inboxes(customer).empty?
                        span.tm-customer-secondary = t("dashboard.customers.index.no_channels", default: "No channels")
                  td data-label=t("dashboard.customers.index.last_activity", default: "Last activity")
                    span.tm-customer-date = t("dashboard.customers.index.ago", time: time_ago_in_words(customer_last_activity(customer)), default: "%{time} ago")
                  td data-label=t("dashboard.customers.index.joined", default: "Joined")
                    span.tm-customer-date = l(account_time(customer.created_at).to_date, format: :long)
                  td.tm-customers-table__actions data-label=t("dashboard.customers.index.actions", default: "Actions")
                    = link_to t("dashboard.customers.index.show", default: "Show"), customer_path(customer), class: "tm-customer-action tm-customer-action--show"
                    - if can?(:edit, customer)
                      = link_to t("dashboard.customers.index.edit", default: "Edit"), edit_customer_path(customer), class: "tm-customer-action tm-customer-action--edit"

        .tm-users-empty data-filterable-collection-target="empty" hidden=true
          h2 = t("dashboard.customers.index.no_matching", default: "No matching customers")
          p = t("dashboard.customers.index.try_another_filter", default: "Try a different search or channel filter.")
      - else
        .tm-users-empty
          h2 = t("dashboard.customers.index.empty_title", default: "No customers yet")
          p = t("dashboard.customers.index.empty_description", default: "Customers will appear here after they contact your workspace.")
