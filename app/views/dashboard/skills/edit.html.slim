= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "skills") do
    .ap-form-container
      .ap-form-header
        = link_to skills_path, class: "ap-back-link"
          | #{t("ui.dashboard.skills.edit.back_to_skills")}
        h2.f-semi-24 = t("dashboard.skills.edit.title")
      = render("dashboard/skills/form", skill: @skill)
