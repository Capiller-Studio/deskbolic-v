.dashboard-section.center-wrapper
  .dashboard-container
    .dashboard-nav
      .card
        = link_to(root_path, class: "dash-logo") do
          = image_tag('deskbolic_logo.png', alt: 'dashboard logo', class: 'dash-logo')
        ul
          .nav-menu
            / li.nav-item
            /   = link_to(agent_index_path, class: "nav-link") do
            /     = image_tag('ai_agent.png', alt: 'AI Agent', class: 'link-icon')
            - current_user&.accounts&.each do |account|
              li.nav-item class="#{current_page=='help_desk' ? 'dash-nav-active' : ''}"
                = form_with url: switch_account_path(id: account.id), method: :post, class: "switch-form" do
                  = hidden_field_tag :id, account.id
                  = button_tag(type: 'submit', class: 'switch-button nav-link', style: 'border: none; background: none; padding: 0;') do
                    = image_tag('helpdesk_icon.svg', alt: 'Switch Account', class: 'switch-icon')
            li.nav-item
              = link_to(workspace_path, class: "nav-link") do
                = inline_svg_tag("plus.svg", class:"link-icon", alt:"menu")
        
        .channel-header.list-header data-controller="accordion"
          - if current_user&.avatar&.attached?
            = image_tag(current_user.avatar, class: "account dashboard-account-avatar", alt: "dashboard logo", data: { "action" => "click->accordion#toggleMenu" })
          - else
            .account.dashboard-account-avatar.avatar-fallback.dashboard-account-initials.f-reg-12 class=avatar_fallback_color_class(full_name(current_user)) data-action="click->accordion#toggleMenu"
              = initials(current_user)
          .menu data-accordion-target="menu"
            - if current_user
              = link_to(profile_path, class: "header profile-menu-header") do
                - if current_user.avatar.attached?
                  = image_tag(current_user.avatar, class:"user-img", alt:"menu")
                - else
                  .user-img.avatar-fallback.dashboard-user-initials.f-reg-14 class=avatar_fallback_color_class(full_name(current_user))
                    = initials(current_user)
                .details
                  h4.f-med-18 = current_user&.name
                  p.f-med-16 = current_user&.email
              .account-options
                / .theme.menu-link
                /   = inline_svg_tag("theme.svg", class:"menu-icon", alt:"menu")
                /   p.f-semi-14 Theme
                /   = inline_svg_tag("light_theme.svg", class:"ml-auto", alt:"menu")
                = link_to(help_center_path, class: "menu-link") do
                  p.f-semi-14 “Help desk” Help Center
                = link_to(community_path, class: "menu-link") do
                  p.f-semi-14 “Help desk” Community forum
                = link_to(terms_path, class: "menu-link") do
                  p.f-semi-14 Terms & policies
                = link_to(settings_path, class: "menu-link", data: { turbo: false }) do
                  = inline_svg_tag("settings.svg", class:"menu-icon", alt:"menu")
                  p.f-semi-14 Settings
                
              .logout
                = button_to(destroy_user_session_path, class: "menu-link nav-link", method: :delete) do
                  = inline_svg_tag("logout.svg", class:"link-icon", alt:"menu")
                  p Sign Out
            - else 
              .login
                p login Here
                = link_to new_user_ses sion_path, class: "menu-link nav-link" do
                  = inline_svg_tag("logout.svg", class:"link-icon", alt:"menu")
                  p Login
    .dashboard-body
      == yield