.team id="conversation-team-#{conversation.id}"
  p.f-semi-14 = t("dashboard.conversation_details.team")
  .card.team-info
    button.accordian data-action="click->accordion#toggle"
      - if assigned_team
        = inline_svg_tag("users.svg", class: "team-card-icon")
        p.f-reg-14 = assigned_team.name
      - else
        = inline_svg_tag("users.svg", class: "team-card-icon")
        p.f-reg-14 = t("dashboard.users.form.assign")
      = inline_svg_tag("arrow_down.svg", class: "arrow-icon ml-auto")

    .panel data-accordion-target="panel"
      - if assigned_team
        .assigned-team-row
          = inline_svg_tag("users.svg", class: "team-card-icon")
          p.f-reg-12 = assigned_team.name
          = button_to(t("general.unassign"), unassign_team_conversation_path(conversation), method: :post, class: "unassign-btn f-reg-12")
      - elsif @teams.any?
        - @teams.each do |team|
          .team-row
            = inline_svg_tag("users.svg", class: "team-card-icon")
            p.f-reg-12 = team.name
            = button_to(t("general.assign"), assign_team_conversation_path(conversation, team_id: team.id), method: :post, class: "assign-btn assign-team-btn f-reg-12")
      - else
        .details-empty-state
          p.f-reg-12 = t("dashboard.teams.index.empty_description")
          = link_to t("dashboard.teams.index.new_team"), teams_path, class: "details-empty-action f-semi-12", data: { turbo_frame: "_top" }
