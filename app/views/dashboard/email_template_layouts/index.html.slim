= render("dashboard/shared/dashboard_container", current_page: "email_templates") do
  = render("dashboard/settings/settings_sidebar", current_page: "email_templates") do
    .eb-templates
      .eb-templates__header
        div
          h2.eb-templates__title = t("dashboard.email_template_layouts.index.title")
          p.eb-templates__subtitle = t("dashboard.email_template_layouts.index.subtitle")
        .eb-templates__nav
          = link_to email_templates_path, class: "eb-btn eb-btn--outline"
            = t("dashboard.email_template_layouts.index.tab_templates")
          = link_to email_template_layouts_path, class: "eb-btn eb-btn--primary"
            = t("dashboard.email_template_layouts.index.tab_layouts")

      - if @email_template_layouts.any?
        .eb-templates__grid
          - @email_template_layouts.each do |layout|
            .eb-card
              .eb-card__body
                .eb-card__header
                  h3.eb-card__name = layout.name
                  .eb-card__badges
                    - if layout.has_unpublished_changes?
                      span.eb-badge.eb-badge--draft = t("dashboard.email_template_layouts.index.badge_draft")
                p.eb-card__description = t("dashboard.email_template_layouts.index.layout_description")

              .eb-card__footer
                span.eb-card__meta = t("dashboard.email_template_layouts.index.last_modified", time: time_ago_in_words(layout.updated_at))
                = link_to edit_email_template_layout_path(layout), class: "eb-btn eb-btn--primary"
                  = t("dashboard.email_template_layouts.index.edit_design")
      - else
        .auto-empty-state
          h3.f-semi-18 = t("dashboard.email_template_layouts.index.empty_title")
          p.f-reg-14 = t("dashboard.email_template_layouts.index.empty_description")
