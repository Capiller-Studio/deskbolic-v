.helpdesk-section.center-wrapper
  .helpdesk-container
    .helpdesk-nav
      .card
        .header data-controller="modalToggler frameToggler"
          p.f-reg-14 = t('dashboard.sidebar.settings.title')
          = render("dashboard/shared/modal_popper")
        ul.channel-list.st-sidebar  data-controller="accordion modalToggler frameToggler"
          .help-nav-menu
            li.nav-item class="" data-action="click->accordion#toggle"
              .nav-link
                = link_to(settings_path, class: "nav-link") do
                  .link-text
                    .conversation-name.inbox-conv
                      p.f-reg-14 = t('dashboard.sidebar.settings.home')
            li.nav-item class="#{current_page == 'reports' ? 'st-list-active' : ''}" data-action="click->accordion#toggle"
              .nav-link
                = link_to(reports_path, class: "nav-link", data: { turbo: false }) do
                  .link-text
                    .conversation-name.inbox-conv
                      p.f-reg-14 = t('dashboard.sidebar.reports', default: 'Reports')
            li.nav-item class="#{current_page == 'domains' ? 'st-list-active' : ''}" data-action="click->accordion#toggle"
              .nav-link
                = link_to(domains_path, class: "nav-link") do
                  .link-text
                    .conversation-name.inbox-conv
                      p.f-reg-14 = t("dashboard.domains.sidebar.label")
            li.nav-item class="#{current_page == 'teams' ? 'st-list-active' : ''}" data-action="click->accordion#toggle"
              .nav-link
                = link_to(teams_path, class: "nav-link") do
                  .link-text
                    .conversation-name.inbox-conv
                      p.f-reg-14 = t('dashboard.sidebar.settings.teams')
            li.nav-item class="#{current_page == 'users' ? 'st-list-active' : ''}" data-action="click->accordion#toggle"
              .nav-link
                = link_to(users_path, class: "nav-link") do
                  .link-text
                    .conversation-name.inbox-conv
                      p.f-reg-14 = t('dashboard.sidebar.settings.users')
            li.nav-item class="#{current_page == 'roles' ? 'st-list-active' : ''}" data-action="click->accordion#toggle"
              .nav-link
                = link_to(roles_path, class: "nav-link") do
                  .link-text
                    .conversation-name.inbox-conv
                      p.f-reg-14
                        = t('dashboard.sidebar.settings.roles')
                        = plan_upgrade_bubble(:roles)
            li.nav-item class="#{current_page == 'billing' ? 'st-list-active' : ''}" data-action="click->accordion#toggle"
              .nav-link
                = link_to(dashboard_billing_path, class: "nav-link") do
                  .link-text
                    .conversation-name.inbox-conv
                      p.f-reg-14 = t('dashboard.sidebar.settings.billing')

            li.nav-item class="#{current_page == 'notification-settings' ? 'st-list-active' : ''}" data-action="click->accordion#toggle"
              .nav-link
                = link_to(edit_settings_notification_settings_path, class: "nav-link") do
                  .link-text
                    .conversation-name.inbox-conv
                      p.f-reg-14 = t('dashboard.sidebar.settings.notifications')

            li.nav-item class="#{current_page == 'audit-logs' ? 'st-list-active' : ''}" data-action="click->accordion#toggle"
              .nav-link
                = link_to(settings_audit_logs_path, class: "nav-link") do
                  .link-text
                    .conversation-name.inbox-conv
                      p.f-reg-14
                        = t('dashboard.sidebar.settings.audit_logs')
                        = plan_upgrade_bubble(:audit_logs)
            
            / Help Center
            li.nav-item class="" data-action="click->accordion#toggle"
              .nav-link
                .link-text.conversation-padding
                  = inline_svg_tag("arrow_down.svg", class:"st-dropdown-icon", alt:"menu")
                  p.f-reg-14 = t('dashboard.sidebar.settings.help_center')
            .st-panel data-accordion-target="panel"
              ul.chats
                li.nav-item class="#{current_page == 'help-center-articles' ? 'st-list-active' : ''}"
                  = link_to(help_center_articles_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12 = t('dashboard.sidebar.settings.help_center_articles')
                li.nav-item class="#{current_page == 'help-center-portals' ? 'st-list-active' : ''}"
                  = link_to(help_center_portals_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12 = t('dashboard.sidebar.settings.all_help_centers')
                li.nav-item class="#{current_page == 'new-help-center' ? 'st-list-active' : ''}"
                  = link_to(new_help_center_portal_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12 = t('dashboard.sidebar.settings.new_help_center')
            / Channels            
            li.nav-item class="" data-action="click->accordion#toggle"
              .nav-link
                .link-text.conversation-padding
                  = inline_svg_tag("arrow_down.svg", class:"st-dropdown-icon", alt:"menu")
                  p.f-reg-14 = t('dashboard.sidebar.settings.channels')
            .st-panel data-accordion-target="panel"
              ul.chats
                li.nav-item class="#{current_page == 'email-channels' ? 'st-list-active' : ''}"
                  = link_to(channels_email_index_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12
                          = t('dashboard.sidebar.settings.email_channels')
                          = plan_upgrade_bubble('channels.email')
                li.nav-item class="#{current_page == 'web-widget-channels' ? 'st-list-active' : ''}"
                  = link_to(channels_web_widget_index_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12
                          = t('dashboard.sidebar.settings.web_widget_channels')
                          = plan_upgrade_bubble('channels.web_widget')
                li.nav-item class="#{current_page == 'contact-form-channels' ? 'st-list-active' : ''}"
                  = link_to(channels_contact_form_index_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12
                          = t('dashboard.sidebar.settings.contact_form_channels')
                          = plan_upgrade_bubble('channels.contact_form')
                li.nav-item class="#{current_page == 'facebook-channels' ? 'st-list-active' : ''}"
                  = link_to(channels_facebook_index_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12
                          = t("dashboard.facebook_channels.sidebar.label")
                          = plan_upgrade_bubble('channels.facebook')
                li.nav-item class="#{current_page == 'instagram-channels' ? 'st-list-active' : ''}"
                  = link_to(channels_instagram_index_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12
                          = t("dashboard.instagram_channels.sidebar.label")
                          = plan_upgrade_bubble('channels.instagram')
                li.nav-item class="#{current_page == 'whatsapp-channels' ? 'st-list-active' : ''}"
                  = link_to(channels_whatsapp_index_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12
                          = t("dashboard.whatsapp_channels.sidebar.label")
                          = plan_upgrade_bubble('channels.whatsapp')
                li.nav-item class="#{current_page == 'custom-channels' ? 'st-list-active' : ''}"
                  = link_to(channels_custom_index_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12
                          | Custom Channels
                          = plan_upgrade_bubble('channels.custom')
            / data
            li.nav-item class="" data-action="click->accordion#toggle"
              .nav-link
                .link-text.conversation-padding
                  = inline_svg_tag("arrow_down.svg", class:"st-dropdown-icon", alt:"menu")
                  p.f-reg-14 = t('dashboard.sidebar.settings.data')
            .st-panel data-accordion-target="panel"
              ul.chats
                li.nav-item class="#{current_page == 'assignment-policies' ? 'st-list-active' : ''}"
                  = link_to(assignment_policies_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12
                          = t("dashboard.assignment_policies.sidebar.label")
                          = plan_upgrade_bubble(:assignment_policies)
                li.nav-item class="#{current_page == 'sla-policies' ? 'st-list-active' : ''}"
                  = link_to(sla_policies_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12
                          = t('dashboard.sidebar.settings.sla_policies')
                          = plan_upgrade_bubble(:sla)
                li.nav-item class="#{current_page == 'business-hours' ? 'st-list-active' : ''}"
                  = link_to(business_hour_groups_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12
                          = t("dashboard.business_hour_groups.index.title")
                          = plan_upgrade_bubble(:business_hours)
                li.nav-item class="#{current_page == 'skills' ? 'st-list-active' : ''}"
                  = link_to(skills_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12
                          = t("dashboard.skills.sidebar.label")
                          = plan_upgrade_bubble(:assignment_policies)
                li.nav-item class="#{current_page == 'custom-fields' ? 'st-list-active' : ''}"
                  = link_to(custom_fields_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12
                          = t('dashboard.sidebar.settings.custom_fields')
                          = plan_upgrade_bubble(:custom_fields)
                li.nav-item class="#{current_page == 'csat-surveys' ? 'st-list-active' : ''}"
                  = link_to(csat_surveys_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12
                          = t('dashboard.sidebar.settings.csat_surveys')
                li.nav-item class="#{current_page == 'identity-sources' ? 'st-list-active' : ''}"
                  = link_to(identity_sources_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12
                          = t("dashboard.identity_sources.sidebar.label")
                          = plan_upgrade_bubble(:identity_sources)
                li.nav-item class="#{current_page == 'canned-responses' ? 'st-list-active' : ''}"
                  = link_to(canned_responses_settings_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12 = t('dashboard.sidebar.settings.canned_responses')
                li.nav-item class="#{current_page == 'labels' ? 'st-list-active' : ''}"
                  = link_to(labels_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12 = t('dashboard.sidebar.settings.labels', default: "Labels")
                li.nav-item class="#{current_page == 'macros' ? 'st-list-active' : ''}"
                  = link_to(macros_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12
                          = t('dashboard.sidebar.settings.macros')
                          = plan_upgrade_bubble(:macros_enabled)
                li.nav-item class="#{current_page == 'automations' ? 'st-list-active' : ''}"
                  = link_to(automations_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12
                          = t('dashboard.sidebar.settings.automations')
                          = plan_upgrade_bubble(:automations_enabled)
                li.nav-item class="#{current_page == 'email_templates' ? 'st-list-active' : ''}"
                  = link_to(email_templates_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-12 
                          = t("dashboard.email_templates.sidebar.label")
                          = plan_upgrade_bubble(:custom_email_templates)

            li.nav-item class="#{current_page == 'api-keys' ? 'st-list-active' : ''}" data-action="click->accordion#toggle"
              .nav-link
                = link_to(settings_api_keys_path, class: "nav-link") do
                  .link-text
                    .conversation-name.inbox-conv
                      p.f-reg-14
                        | Developer API Keys
                        = plan_upgrade_bubble(:api_access)
                        
            - if policy(:integration).index?
              li.nav-item class="#{current_page == 'integrations' ? 'st-list-active' : ''}" data-action="click->accordion#toggle"
                .nav-link
                  = link_to(integrations_path, class: "nav-link") do
                    .link-text
                      .conversation-name.inbox-conv
                        p.f-reg-14 = t('dashboard.sidebar.settings.integrations', default: 'Integrations')

    .helpdesk-body.settings-body
      turbo-frame#conversations-frame[data-turbo-permanent]
      == yield
