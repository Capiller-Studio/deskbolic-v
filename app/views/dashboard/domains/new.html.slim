= render("dashboard/shared/dashboard_container", current_page: "domains") do
  = render("dashboard/settings/settings_sidebar", current_page: "domains") do
    .body-section.domains-body
      .domains-header
        div
          h1 = t("dashboard.domains.new.title")
          p = t("dashboard.domains.new.subtitle", default: "Add a custom domain to your help center.")
        .domains-header-actions
          = link_to domains_path, class: "back-link"
            span = t("dashboard.domains.new.back")

      .domain-form-container
        - if current_account.feature_enabled?(:custom_domains)
          = form_with(model: @domain, url: domains_path, method: :post, class: "domain-form") do |f|
            = f.hidden_field :domain_type, value: "custom"

            - if @domain.errors.any?
              .alert.alert-red
                p.f-semi-14 = t("dashboard.domains.errors.fix_errors")
                ul
                  - @domain.errors.full_messages.each do |message|
                    li.f-reg-12 = message

            .domain-form-layout
              .domain-form-main
                .form-section
                  h3.f-semi-14 = t("dashboard.domains.new.section_title")

                  .form-group
                    = f.label :name, class: "f-semi-12"
                      = t("dashboard.domains.new.name_label")
                    = f.text_field :name, class: "form-input", placeholder: t("dashboard.domains.new.name_placeholder"), autocomplete: "off"
                    p.form-hint.f-reg-12 = t("dashboard.domains.new.name_hint")

                  .form-group
                    = f.label :value, class: "f-semi-12"
                      = t("dashboard.domains.new.value_label")
                    = f.text_field :value, class: "form-input", placeholder: t("dashboard.domains.new.value_placeholder"), autocomplete: "off", required: true
                    p.form-hint.f-reg-12 = t("dashboard.domains.new.value_hint")

                .form-actions
                  = f.submit t("dashboard.domains.new.submit"), class: "btn-primary"
                  = link_to t("dashboard.domains.new.cancel"), domains_path, class: "btn-secondary"

              .form-section.cname-info-box
                h3.f-semi-14 = t("dashboard.domains.new.after_adding_title")
                p.f-reg-12 = t("dashboard.domains.new.after_adding_desc")
                .cname-record
                  .cname-field
                    span.f-reg-12.cname-label = t("dashboard.domains.index.cname_instructions.cname_type")
                    span.f-semi-12 CNAME
                  .cname-field
                    span.f-reg-12.cname-label = t("dashboard.domains.index.cname_instructions.cname_host")
                    span.f-semi-12 = t("dashboard.domains.new.cname_host_value")
                  .cname-field
                    span.f-reg-12.cname-label = t("dashboard.domains.index.cname_instructions.cname_target")
                    span.f-semi-12 = Domain::CNAME_TARGET
                p.f-reg-12 = t("dashboard.domains.new.after_adding_note")
        - else
          .domain-empty
            h3.f-semi-16 = t("dashboard.domains.custom_domain_not_supported", default: "Custom domains are not supported on your current plan.")
            p.f-reg-14 = t("dashboard.domains.upgrade_plan_desc", default: "Upgrade your plan to add custom domains to your help center.")
            = link_to "Upgrade Plan", dashboard_billing_path, class: "add-domain-link"