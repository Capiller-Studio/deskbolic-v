<mjml>
  <mj-head>
    <mj-title>Reset your password</mj-title>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="20px 0" border-radius="8px">
      <mj-column>
        <mj-text align="center" font-size="24px" font-weight="bold" color="#333333">
          Password Reset Request
        </mj-text>
        <mj-text align="left" font-size="16px" color="#555555" line-height="24px">
          Hello [[ERB= @resource.email ]],
        </mj-text>
        <mj-text align="left" font-size="16px" color="#555555" line-height="24px">
          Someone has requested a link to change your password. You can do this through the link below.
        </mj-text>
        <mj-button background-color="#4F46E5" color="#ffffff" font-size="16px" font-weight="bold" border-radius="4px" href="[[ERB= edit_password_url(@resource, reset_password_token: @token, locale: I18n.locale) ]]">
          Change my password
        </mj-button>
        <mj-text align="left" font-size="14px" color="#999999" line-height="20px" padding-top="20px">
          If you didn't request this, please ignore this email. Your password won't change until you access the link above and create a new one.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
