= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "contact-form-channels") do
    .channel-theme-contact-form
      .ww-page
        .ww-header
          div
            h1 = t("dashboard.contact_form_channels.index.title")
            p = t("dashboard.contact_form_channels.index.subtitle")
          .ww-header-actions
            = link_to t("dashboard.contact_form_channels.index.new_button"), new_channels_contact_form_path, class: "ww-btn-primary"

        .ww-content
          - if @contact_form_channels.any?
            - @contact_form_channels.each do |channel|
              - contact_form_url = "#{ENV['WIDGET_APP_URL'] || 'https://widget.deskbolic.com'}/f/#{current_account.id}/#{channel.id}"
              .ww-card id=dom_id(channel)
                .ww-card-top
                  .ww-card-info
                    h3 = channel.name
                    p.ww-card-subtitle = channel.submit_redirect_url.presence || t("dashboard.contact_form_channels.index.no_redirect_url", default: "No redirect URL set")
                  .ww-card-actions
                    = link_to edit_channels_contact_form_path(channel), class: "ww-action-btn cf-icon-action", title: "Edit"
                      = inline_svg_tag("edit.svg", class: "ww-action-icon cf-action-icon cf-action-icon--edit", alt: "Edit")
                    = link_to channels_contact_form_path(channel), data: { turbo_method: :delete, turbo_confirm: t("dashboard.contact_form_channels.index.confirm_delete", default: "Are you sure?") }, class: "ww-action-btn ww-action-delete", title: "Delete"
                      = inline_svg_tag("delete_red.svg", class: "ww-action-icon cf-action-icon", alt: "Delete")

                .ww-card-meta
                  - if channel.require_login?
                    .ww-badge.ww-badge-active
                      = inline_svg_tag("lock.svg", class: "ww-badge-icon", alt: t("dashboard.contact_form_channels.index.login_required", default: "Login required"))
                      span = t("dashboard.contact_form_channels.index.login_required", default: "Login required")
                  - else
                    .ww-badge.ww-badge-disconnected
                      = inline_svg_tag("user.svg", class: "ww-badge-icon", alt: t("dashboard.contact_form_channels.index.public_submissions", default: "Public submissions"))
                      span = t("dashboard.contact_form_channels.index.public_submissions", default: "Public submissions")

                  - if channel.allow_attachments?
                    .ww-badge.ww-badge-active
                      = inline_svg_tag("mail.svg", class: "ww-badge-icon", alt: t("dashboard.contact_form_channels.index.attachments_allowed", default: "Attachments allowed"))
                      span = t("dashboard.contact_form_channels.index.attachments_allowed", default: "Attachments allowed")

                  .ww-meta-tag
                    = inline_svg_tag("inboxes.svg", class: "ww-meta-tag-icon", alt: t("dashboard.contact_form_channels.index.inboxes_count", count: channel.inboxes.size, default: "Inboxes: #{channel.inboxes.size}"))
                    span = t("dashboard.contact_form_channels.index.inboxes_count", count: channel.inboxes.size, default: "Inboxes: #{channel.inboxes.size}")

                  .ww-meta-tag
                    = inline_svg_tag("clock.svg", class: "ww-meta-tag-icon", alt: t("dashboard.contact_form_channels.index.created_ago", time: time_ago_in_words(channel.created_at), default: "Created #{time_ago_in_words(channel.created_at)} ago"))
                    span = t("dashboard.contact_form_channels.index.created_ago", time: time_ago_in_words(channel.created_at), default: "Created #{time_ago_in_words(channel.created_at)} ago")

                - embed_script = "<script src=\"#{contact_form_url}/embed.js\"></script>"
                .ww-embed-row.cf-index-embed-row data-controller="contact-form-channel"
                  span.ww-embed-label EMBED
                  .ww-embed-code
                    input.ww-embed-input type="text" readonly=true value=embed_script
                  button.ww-copy-btn.ww-index-copy-btn.cf-index-copy-btn data-action="click->contact-form-channel#copyEmbedCode" data-code=embed_script
                    span Copy
          - else
            .ww-empty-state
              .ww-empty-icon
                = inline_svg_tag("ch_form.svg", class: "ww-empty-icon-svg", alt: t("dashboard.contact_form_channels.index.empty_title"))
              h3 = t("dashboard.contact_form_channels.index.empty_title")
              p = t("dashboard.contact_form_channels.index.empty_subtitle")
              = link_to t("dashboard.contact_form_channels.index.new_button"), new_channels_contact_form_path, class: "ww-btn-primary"