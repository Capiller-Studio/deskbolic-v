= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "api-keys") do
    .body-container
      .ui-index-header
        .ui-title-area
          h2.f-semi-32 = t("dashboard.settings.api_keys.index.title")
          p.f-reg-16 = t("dashboard.settings.api_keys.index.description")

        = button_to settings_api_keys_path, method: :post, class: "ui-btn-primary" do
          | + #{t("dashboard.settings.api_keys.index.generate")}

      .ui-list
        - if @api_keys.any?
          - @api_keys.each do |api_key|
            div.ui-card id=dom_id(api_key)
              .ui-card-top
                .ui-card-info
                  .channel-page-avatar-placeholder
                    | 🔑
                  .channel-page-details
                    h3.f-semi-16 = t("dashboard.settings.api_keys.index.key_title")
                    p.channel-page-id style="user-select: all;"
                      | #{t("ui.dashboard.settings.api_keys.index.text", token: api_key.token)}

                .ui-card-actions
                  = button_to settings_api_key_path(api_key), method: :delete, data: { turbo_confirm: t("dashboard.settings.api_keys.index.revoke_confirm") }, class: "ui-btn-danger" do
                    | #{t("general.revoke")}
              
              .ui-card-meta
                .ui-meta-tag
                  span.ui-meta-tag-icon 🕐
                  span = t("dashboard.settings.api_keys.index&.created_ago", time: time_ago_in_words(api_key.created_at))

        - else
          .ui-empty-state
            .ui-empty-icon 🔑
            h3.f-semi-18 = t("dashboard.settings.api_keys.index.empty_title")
            p.f-reg-14 = t("dashboard.settings.api_keys.index.empty")
            = button_to settings_api_keys_path, method: :post, class: "ui-btn-primary ui-btn-sm" do
              | + #{t("dashboard.settings.api_keys.index.generate")}
