= render("dashboard/settings/settings_sidebar", current_page: "general") do
  .ui-settings-page
    header.ui-settings-page__header
      .ui-settings-page__heading
        h1 = t("dashboard.settings.general.title", default: "General Settings")
        p = t("dashboard.settings.general.description", default: "Manage your workspace identity, localization, and lifecycle settings.")

      - if @is_owner
        button.ui-settings-page__action type="submit" form="workspace-general-form"
          = t("general.save_changes", default: "Save Changes")

    main.ui-settings-page__content
      .profile-layout
        .profile-card
          .profile-card-header
            h3 = t("dashboard.settings.general.workspace_details", default: "Workspace Details")

          = form_with(model: @account, url: settings_general_path, method: :patch, id: "workspace-general-form", class: "profile-form") do |f|
            .profile-details
              .profile-row
                .profile-row-icon-cell
                  = inline_svg_tag("settings.svg", class: "profile-icon", alt: "")
                .profile-row-content
                  label.profile-field-label for="account_name" = t("dashboard.settings.general.name_label", default: "Workspace Name")
                  = f.text_field :name, class: "profile-input", placeholder: "Acme Support", disabled: !@is_owner

              .profile-row
                .profile-row-icon-cell
                  = inline_svg_tag("world.svg", class: "profile-icon", alt: "")
                .profile-row-content.profile-readonly
                  span = t("dashboard.settings.general.subdomain_label", default: "Workspace Subdomain")
                  p = "#{@account.identifier}.deskbolic.com"

              .profile-row
                .profile-row-icon-cell
                  = inline_svg_tag("calendar.svg", class: "profile-icon", alt: "")
                .profile-row-content
                  label.profile-field-label for="account_timezone" = t("dashboard.settings.general.timezone_label", default: "Timezone")
                  = f.time_zone_select :timezone, nil, {}, { class: "ui-select ui-control", disabled: !@is_owner }

              .profile-row
                .profile-row-icon-cell
                  = inline_svg_tag("world.svg", class: "profile-icon", alt: "")
                .profile-row-content
                  label.profile-field-label for="account_locale" = t("dashboard.settings.general.locale_label", default: "Locale")
                  = f.select :locale,
                    Core::SUPPORTED_LOCALES.map { |l| [l.to_s.upcase, l] },
                    {},
                    { class: "ui-select ui-control", disabled: !@is_owner }

        / Danger Zone
        .profile-card data-controller="modal" style="border: 1px solid #fee2e2; background-color: #fffaf0;"
          .profile-card-header style="border-bottom: 1px solid #fee2e2;"
            h3 style="color: #b91c1c;" = t("dashboard.settings.general.danger_zone", default: "Danger Zone")

          .profile-details style="padding: 1.5rem;"
            .danger-zone-content
              h4 style="margin: 0 0 0.5rem 0; font-size: 1rem; color: #111827; font-weight: 600;"
                = t("dashboard.settings.general.delete_workspace_title", default: "Delete Workspace")
              p style="margin: 0 0 1rem 0; font-size: 0.875rem; color: #6b7280; line-height: 1.4;"
                = t("dashboard.settings.general.delete_workspace_desc", default: "Request deletion of this workspace. The workspace will be deactivated immediately and billing subscriptions will be cancelled. As soon as deletion is requested, active devices, sessions, and API tokens are permanently lost. Staff members will review and do manual verifications, then permanently delete channels and workspace data.")

              - if @is_owner
                button.btn.btn-danger type="button" data-action="click->modal#open" style="background-color: #dc2626; color: white; border: none; padding: 0.625rem 1.25rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer;"
                  = t("dashboard.settings.general.request_deletion_btn", default: "Delete this Workspace")
              - else
                .alert.alert-warning style="padding: 0.75rem; border-radius: 0.375rem; background: #fffbeb; color: #92400e; font-size: 0.875rem;"
                  = t("dashboard.settings.general.owner_only_notice", default: "Only the workspace owner can request workspace deletion.")

          / Deletion Confirmation Modal
          - if @is_owner
            .modal-backdrop#delete-workspace-modal data-modal-target="dialog" data-action="click->modal#closeOnOutsideClick" style="display: none; position: fixed; inset: 0; background-color: rgba(0, 0, 0, 0.5); z-index: 9999; align-items: center; justify-content: center;"
              .modal-dialog style="max-width: 480px; width: 90%; margin: auto; background: white; border-radius: 0.75rem; padding: 1.5rem; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);"
                .modal-header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;"
                  h3 style="margin: 0; color: #b91c1c; font-size: 1.25rem; font-weight: 700;"
                    = t("dashboard.settings.general.confirm_deletion_title", default: "Confirm Workspace Deletion")
                  button.modal-close type="button" data-action="click->modal#close" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #6b7280; line-height: 1;" &times;

                = form_with(url: settings_general_path, method: :delete, local: true) do |f|
                  .modal-body style="font-size: 0.875rem; color: #374151; margin-bottom: 1.5rem;"
                    .alert.alert-warning style="padding: 0.875rem 1rem; border-radius: 0.5rem; background: #fffbeb; border: 1px solid #fef3c7; border-left: 4px solid #f59e0b; color: #92400e; margin-bottom: 1rem;"
                      strong style="display: block; font-weight: 600; margin-bottom: 0.375rem;"
                        = t("dashboard.settings.general.modal_warning_title", default: "Warning: Immediate Deactivation & Manual Verification")
                      p style="margin: 0; font-size: 0.8125rem; line-height: 1.45;"
                        = t("dashboard.settings.general.modal_warning_desc", default: "Deleting this workspace deactivates it immediately. As soon as deletion is requested, active devices, sessions, and API access tokens are permanently lost. Active subscriptions will be cancelled and custom domains disabled. Staff members will review and do manual verifications, then permanently delete channels, inboxes, and workspace data.")
                    
                    .form-group style="margin-bottom: 1rem;"
                      label style="display: block; font-weight: 600; margin-bottom: 0.375rem;"
                        = t("dashboard.settings.general.confirm_subdomain_prompt_html", identifier: tag.code(@account.identifier, style: "background: #f3f4f6; padding: 0.125rem 0.375rem; border-radius: 0.25rem; color: #b91c1c;"), default: ("Type workspace subdomain %{identifier} to confirm:").html_safe)
                      = text_field_tag :identifier_confirmation, nil, required: true, class: "profile-input", placeholder: @account.identifier, style: "width: 100%; border: 1px solid #d1d5db; padding: 0.5rem 0.75rem; border-radius: 0.375rem;"

                    .form-group style="margin-bottom: 1rem;"
                      label style="display: block; font-weight: 600; margin-bottom: 0.375rem;"
                        = t("auth.password", default: "Your Password")
                      = password_field_tag :password, nil, required: true, class: "profile-input", placeholder: "••••••••", style: "width: 100%; border: 1px solid #d1d5db; padding: 0.5rem 0.75rem; border-radius: 0.375rem;"

                  .modal-footer style="display: flex; justify-content: flex-end; gap: 0.75rem;"
                    button.btn type="button" data-action="click->modal#close" style="padding: 0.5rem 1rem; border: 1px solid #d1d5db; border-radius: 0.375rem; background: white; cursor: pointer; font-weight: 500;"
                      = t("general.cancel", default: "Cancel")
                    = f.submit t("dashboard.settings.general.confirm_delete_btn", default: "I understand, delete this workspace"), class: "btn btn-danger", style: "background: #dc2626; color: white; border: none; padding: 0.5rem 1rem; border-radius: 0.375rem; font-weight: 600; cursor: pointer;"
