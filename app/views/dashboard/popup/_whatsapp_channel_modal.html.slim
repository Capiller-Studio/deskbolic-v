.model-content-section
  .model-content
    .modal-header
      h3.f-semi-18 = t("ui.dashboard.popup.whatsapp_channel_modal.whatsapp_channel")
      = inline_svg_tag("cross_button.svg", alt:t("ui.dashboard.agent.agent_sidebar.menu"), class:"conversation-icon m-close", data: { action: "click->modal-toggler#hideModal" })
    .modal-body.channel-form
      = form_with(url: channels_path, data: {controller: "form-validation renderer", "form-validation-target" => "form", turbo: false}, html: {class: "needs-validation", novalidate: true, method: :post}) do |f|
        .form-fields
          = f.hidden_field :channel_type, value: "whatsapp"
          .form-floating
            .field-label
              span 1
              = f.label :name, t("forms.labels.enter_channel_name"), class: "form-label f-reg-14"
            = f.text_field :name, class: "form-control f-reg-14", placeholder: t("dashboard.email_channels.form.name_label"), required: true
          .form-floating
            .field-label
              span 2
              = f.label :api_key, t("forms.labels.api_key"), class: "form-label f-reg-14"
            = f.text_field :api_key, class: "form-control f-reg-14", placeholder: t("ui.dashboard.popup.whatsapp_channel_modal.api_key"), required: true
          .form-floating
            .field-label
              span 3
              = f.label :full_phone_number, t("forms.labels.full_phone_number"), class: "form-label f-reg-14"
            = f.text_field :full_phone_number, class: "form-control f-reg-14", placeholder: t("ui.dashboard.popup.whatsapp_channel_modal.phone_number_id"), required: true
          .form-floating
            .field-label
              span 4
              = f.label :phone_number_id, t("forms.labels.phone_number_id"), class: "form-label f-reg-14"
            = f.text_field :phone_number_id, class: "form-control f-reg-14", placeholder: t("ui.dashboard.popup.whatsapp_channel_modal.phone_number_id"), required: true
          .form-floating
            .field-label
              span 5
              = f.label :business_account_id, t("forms.labels.business_account_id"), class: "form-label f-reg-14"
            = f.text_field :business_account_id, class: "form-control f-reg-14", placeholder: t("ui.dashboard.popup.whatsapp_channel_modal.business_account_id"), required: true
        .form-actions
          = f.submit t("dashboard.custom_channels.new.submit"), class: "submit-btn f-med-14", data: { action: "click->form-validation#validate click->modal-toggler#hideModal" }