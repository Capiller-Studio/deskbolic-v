.model-content-section
  .model-content.notifications-slide-over
    .notifications-header
      .notifications-heading
        h3 = t("notifications.title")
      .notifications-header-actions
        = button_to t("notifications.mark_all_as_read"), mark_all_read_notifications_path, method: :post, class: "mark-all-btn", data: { turbo: true }
        button.notifications-close type="button" aria-label=t("ui.dashboard.notifications.index.close") data-action="click->modal-toggler#hideModal"
          = inline_svg_tag("cross.svg", aria: { hidden: true })
    .notifications-body
      turbo-frame id="notifications-list"
        = render partial: "dashboard/notifications/list", locals: { notifications: @notifications }
