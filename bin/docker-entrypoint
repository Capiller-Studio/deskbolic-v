#!/bin/bash -e

# Remove stale pids
rm -f /rails/tmp/pids/server.pid /rails/tmp/pids/sidekiq.pid /rails/tmp/pids/anycable.pid

# Prepare primary and regional shard databases on web server startup
if [ "${RUN_MIGRATIONS}" = "true" ] || ([ "${1}" == "./bin/rails" ] && [ "${2}" == "server" ]) || ([ "${1}" == "bundle" ] && [ "${2}" == "exec" ] && [ "${3}" == "puma" ]); then
  echo "==> Preparing primary database and running migrations..."
  ./bin/rails db:prepare || true
  
  echo "==> Running regional shard migrations..."
  ./bin/rails db:migrate:de || true

  if [ "${RUN_SEEDS}" = "true" ]; then
    echo "==> Running initial seeds..."
    ./bin/rails db:seed || true
  fi
fi

exec "${@}"
