<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" color="#333333" line-height="24px" />
    </mj-attributes>
    <mj-style>
      .link-button { text-decoration: none; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f8fafc">
    <mj-section background-color="#ffffff" padding-bottom="0px" padding-top="20px">
      <mj-column>
        <mj-text align="center" font-size="24px" font-weight="bold" color="#0f172a">
          Deskbolic
        </mj-text>
        <mj-divider border-color="#e2e8f0" border-width="1px" padding-top="20px"></mj-divider>
      </mj-column>
    </mj-section>
    
    <mj-section background-color="#ffffff" padding-top="20px">
      <mj-column>
        <mj-text font-size="20px" font-weight="600" color="#991b1b">
          Subscription Payment Failed
        </mj-text>
        <mj-text>
          Hi <%= @account.name %>,
        </mj-text>
        <mj-text>
          We were unable to process the payment for your Deskbolic subscription. As a result, your account status is currently <strong>Past Due</strong>.
        </mj-text>
        <mj-text>
          To restore full access to your workspace, please update your payment method. We will automatically retry the charge once your payment information is updated.
        </mj-text>
        
        <mj-button background-color="#dc2626" color="white" href="<%= ENV['APP_URL'] || 'https://app.deskbolic.com' %>/billing" border-radius="6px" padding="20px 0" css-class="link-button">
          Update Payment Method
        </mj-button>
        
        <mj-text>
          If you believe this is an error or need assistance, reply to this email and our support team will be happy to help.
        </mj-text>
        <mj-text>
          Thanks,<br />
          The Deskbolic Team
        </mj-text>
      </mj-column>
    </mj-section>
    
    <mj-section>
      <mj-column>
        <mj-text align="center" font-size="12px" color="#94a3b8">
          © <%= Time.current.year %> Deskbolic. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
