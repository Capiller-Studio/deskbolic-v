# ============================================================================
# Deskbolic — Self-Hosted Environment Variables (.env)
# ============================================================================
# Copy this file to .env before starting containers:
#   cp .env.example .env

# ─── Rails Application ───────────────────────────────────────────────────────
RAILS_ENV=production
SECRET_KEY_BASE=f9cdf6c8bb10c77492d4a72b9577913c594ea3b2c5ed4aea3791b4a7192931f2663d54639d1ffadf5c6b074cbe015b0dee18ad7114c13e7a5f9e0af027d7e052
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_TO_STDOUT=true
RAILS_LOG_LEVEL=info

# ─── Hosts & Domains (Docker & Caddy Ingress) ────────────────────────────────
# In local development, modern browsers resolve *.localhost automatically to 127.0.0.1
APP_DOMAIN=rely.capiller.com
MAIN_DOMAIN=capiller.com
WORKSPACE_ADMIN_URL=https://admin-rely.capiller.com
CAPILLER_INTERNAL_SECRET=
DB_NAME=deskbolic_production
WIDGET_DOMAIN=widget-rely.capiller.com
HELP_DOMAIN=help-rely.capiller.com
API_DOMAIN=api-rely.capiller.com
WS_DOMAIN=ws-rely.capiller.com

# ─── SSL Configuration ───────────────────────────────────────────────────────
# Local (APP_DOMAIN=localhost): keep both false so the browser stays on http://localhost:3001.
# Production behind Caddy: set both true so links and redirects use https.
FORCE_SSL=false
ASSUME_SSL=false

# ─── Default Super Admin (Created during initial db:seed) ───────────────────
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=ChangeMe123#
ADMIN_DEFAULT_NAME=Capiller Rely Admin
RUN_SEEDS=true

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL=10

# ─── Redis (Cache, Queues, AnyCable Pub/Sub) ─────────────────────────────────
REDIS_URL=redis://redis:6379/0
SIDEKIQ_REDIS_URL=redis://redis:6379/1
ANYCABLE_REDIS_URL=redis://redis:6379/2

# ─── Real-Time WebSockets (AnyCable) ─────────────────────────────────────────
ANYCABLE_RPC_HOST=anycable-rpc:50051
ACTION_CABLE_URL=ws://localhost:8080/cable

# ─── File Uploads (Active Storage) ───────────────────────────────────────────
# Options: local (Docker storage volume) or amazon (AWS S3 / Cloudflare R2 / MinIO)
ACTIVE_STORAGE_SERVICE=local

# ─── AI Assistance (Optional) ────────────────────────────────────────────────
# Required for AI summaries, agent copilot, and message draft generation
# OPENAI_ACCESS_TOKEN=sk-...

# ─── Full-Text Search (Elasticsearch - Optional) ─────────────────────────────
# ELASTICSEARCH_URL=http://elasticsearch:9200

# ─── Real-time Translation (LibreTranslate - Optional) ───────────────────────
# OS_TRANSLATOR_URL=http://libretranslate:5000/translate

# ─── Transactional SMTP Email (Optional) ─────────────────────────────────────
# SMTP_ADDRESS=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your_api_key
