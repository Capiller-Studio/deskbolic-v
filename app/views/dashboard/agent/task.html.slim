                      p.f-semi-14 Process a refund
                      p.f-reg-12 Use this workflow to process refund request from users, Always prioritize this workflow over any other action that might be available
                    = inline_svg_tag("arrow_down.svg", class:"team-dropdown-icon", alt:"menu")
              .config-panel.panel data-accordion-target="panel"
                .config-body
                  .f-semi-12 Not designed yet
            
            .config-item
              li.config-nav-item class="" data-action="click->accordion#toggle"
