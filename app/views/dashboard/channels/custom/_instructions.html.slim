- payload = JSON.pretty_generate(event: "message.created", channel_id: custom_channel.identifier, message: { id: "msg_12345", content: "Hello, how can I help you today?" })

section.channel-edit-side-card.channel-edit-card
  h2 = t("dashboard.channels.edit.developer_guide", default: "Developer Guide")
  p = t("dashboard.channels.edit.developer_guide_hint", default: "When an agent replies to a conversation in Deskbolic, we will send a POST request to your Outbound Webhook URL with the following JSON payload:")
  pre.channel-edit-code-block
    code = payload
  = link_to "#webhook-settings", class: "channel-edit-side-card__button" do
    span = t("dashboard.channels.edit.view_documentation", default: "View Full Documentation")
    span aria-hidden="true" →
