= render("dashboard/shared/dashboard_container", current_page: "team-inboxes") do
  = render("dashboard/settings/settings_sidebar", current_page: "team-inboxes") do
    .body-section.team-inboxes-body data-controller="modal-toggler frame-toggler"
      .team-inboxes-header
        h2.f-semi-18 = t("ui.dashboard.settings.team_inboxes.team_inboxes")
        .new-inbox data-action="click->modal-toggler#showModal click->frame-toggler#loadModal" data-popup-view="_team_inbox_modal"
          span.f-reg-14 = t("ui.dashboard.settings.team_inboxes.add_new_inbox")
          = inline_svg_tag("plus_white.svg", class:"plus-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
      .team-inboxes-body
        ul.team-inboxes-list  data-controller="accordion modal-toggler frame-toggler"
          .teams-nav-menu
            - @teams.each do |team|            
              li.team-nav-item class="" data-action="click->accordion#toggle"
                .team-nav-link
                  .link-text
                    = image_tag(team.avatar, class:"team-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
                    .left
                      p.f-reg-14 = team.name.upcase
                      span.f-reg-12 = "#{team.team_users.count} members"
                    = inline_svg_tag("arrow_down.svg", class:"team-dropdown-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
              .members-panel.panel data-accordion-target="panel"
                .members-header
                  h3.f-semi-18 = t("dashboard.popup.team.form.team_members")
