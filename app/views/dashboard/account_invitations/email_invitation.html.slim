.email-joining-container.center-wrapper
  .header
    .logo
      = image_tag("logo.png", alt: t("ui.dashboard.account_invitations.email_invitation.deskbolic_logo"))
  = form_for(:user, url: email_invitation_path(invitation_token: @invitation.token), html: {method: :post, class: "js-form-wizard form-wizard needs-validation", novalidate: true}) do |f|
    = hidden_field_tag :invitation_token, @invitation.token

    fieldset
      .view-workspace-container
        .joining-card
          .logo
            = image_tag("deskbolic_icon_v.png", alt: t("ui.dashboard.account_invitations.email_invitation.deskbolic_logo"))
          p = t("auth.workspace.email_invitation.description")
          .joining-sub-container
            .joining-sub-card
              .joining-header
                = image_tag("email_join_icon.png", class: "community-logo", alt: t("ui.dashboard.account_invitations.email_invitation.email_joining_icon"))
                .community-details
                  p.workspace-name = @account.name
                  - if @role_names.any?
                    p.members = t("auth.workspace.email_invitation.members", count: @role_names.length)
              p.description = t("auth.workspace.email_invitation.description")
              button.join-btn type="button" onclick="this.closest('form').querySelectorAll('fieldset').forEach(function(fs, i){ if(i===1) fs.style.display='block'; else fs.style.display='none'; });"
                = t("auth.workspace.email_invitation.join_button")

    fieldset style="display: none;"
      .join-workspace-container
        .joining-card
          = image_tag("email_join_icon.png", alt: t("ui.dashboard.account_invitations.email_invitation.community_icon"), class: "community-logo")
          p.title = @account.name
          - if @role_names.any?
            p.members = t("auth.workspace.email_invitation.members", count: @role_names.length)
          .header-line
            p = t("auth.workspace.email_invitation.joining_header")
            p.workspace = t("auth.workspace.email_invitation.workspace_name")
          .form-fields
            .name
              .form-floating
                = f.label :first_name, t("auth.workspace.email_invitation.form.first_name"), class: "f-semi-14 form-label"
                = f.text_field :first_name, autofocus: true, class: "f-reg-14 form-control", placeholder: t("auth.workspace.email_invitation.form.first_name"), required: true
              .form-floating
                = f.label :last_name, t("auth.workspace.email_invitation.form.last_name"), class: "f-semi-14 form-label"
                = f.text_field :last_name, class: "f-reg-14 form-control", placeholder: t("auth.workspace.email_invitation.form.last_name"), required: true
            .form-floating
              = f.label :email, t("auth.workspace.email_invitation.form.email"), class: "f-semi-14 form-label"
              = f.email_field :email, class: "f-reg-14 form-control", placeholder: t("auth.workspace.email_invitation.form.email"), readonly: true, value: @invitation.email
            div data-controller="password-strength"
              .password-section.name
                .form-floating
                  = f.label :password, t("auth.workspace.email_invitation.form.password"), class: "f-semi-14 form-label"
                  = f.password_field :password, class: "f-reg-14 form-control", required: true, data: { password_strength_target: "password", action: "input->password-strength#validatePassword input->password-strength#validateConfirmation" }, placeholder: "••••••••"
                .form-floating
                  = label_tag :confirm_password, t("auth.workspace.email_invitation.form.confirm_password"), class: "f-semi-14 form-label"
                  = password_field_tag :confirm_password, "", class: "f-reg-14 form-control", required: true, data: { password_strength_target: "confirmation", action: "input->password-strength#validateConfirmation" }, placeholder: "••••••••"
                  p data-password-strength-target="matchStatus" style="font-size: 12px; margin-top: 4px;"
              .password-rules style="margin-top: 15px; margin-bottom: 20px; font-size: 13px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px;"
                div data-password-strength-target="ruleLength" style="color: #9ca3af; display: flex; align-items: center; gap: 6px; transition: color 0.3s;"
                  svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"
                    path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"
                  span = t("auth.password_rules.length")
                div data-password-strength-target="ruleUpper" style="color: #9ca3af; display: flex; align-items: center; gap: 6px; transition: color 0.3s;"
                  svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"
                    path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"
                  span = t("auth.password_rules.uppercase")
                div data-password-strength-target="ruleNumber" style="color: #9ca3af; display: flex; align-items: center; gap: 6px; transition: color 0.3s;"
                  svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"
                    path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"
                  span = t("auth.password_rules.number")
                div data-password-strength-target="ruleSpecial" style="color: #9ca3af; display: flex; align-items: center; gap: 6px; transition: color 0.3s;"
                  svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"
                    path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"
                  span = t("auth.password_rules.special")
            .actions
              = f.submit t("auth.workspace.email_invitation.form.submit"), class: "f-semi-15 button", data: { password_strength_target: "submitButton" }

