          .main
            = inline_svg_tag("envelope.svg", alt:t("ui.dashboard.agent.agent_sidebar.menu"), class:"conversation-icon")
            p.f-reg-14 = t("dashboard.profile.index.email")
          = inline_svg_tag("arrow.svg", class:"")
