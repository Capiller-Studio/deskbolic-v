/* Roles & Permissions Specific Styles */

.pm-matrix-title {
  margin-top: 2rem;
  margin-bottom: 0.5rem;
}

.pm-matrix-desc {
  color: #6B7280;
  margin-bottom: 1.5rem;
}

/* Container for the matrix */
.pm-matrix {
  border: 1px solid var(--border-color, #E5E7EB);
  border-radius: 8px;
  background: #FFFFFF;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.pm-header {
  display: grid;
  grid-template-columns: 280px 1fr;
  background: var(--bg-surface-secondary, #F9FAFB);
  padding: 14px 24px;
  border-bottom: 1px solid var(--border-color, #E5E7EB);
}

.pm-header-col {
  font-weight: 600;
  font-size: 13px;
  color: #6B7280;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.pm-row {
  display: grid;
  grid-template-columns: 280px 1fr;
  padding: 20px 24px;
  border-bottom: 1px solid var(--border-color, #E5E7EB);
  align-items: center;
  transition: background-color 0.2s ease;
}

.pm-row:hover {
  background-color: var(--bg-surface-secondary, #F9FAFB);
}

.pm-row:last-child {
  border-bottom: none;
}

.pm-resource {
  font-weight: 600;
  font-size: 14px;
  color: #111827;
}

/* Toggles layout */
.pm-toggles-row {
  display: flex;
  gap: 2rem;
  flex-wrap: wrap;
}

/* Custom Toggle Switch */
.pm-toggle-label {
  display: flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
  user-select: none;
}

.pm-toggle-input {
  appearance: none;
  -webkit-appearance: none;
  width: 36px;
  height: 20px;
  background-color: #D1D5DB;
  border-radius: 20px;
  position: relative;
  cursor: pointer;
  transition: background-color 0.3s ease;
  flex-shrink: 0;
  outline: none;
  margin: 0;
}

.pm-toggle-input::after {
  content: '';
  position: absolute;
  top: 2px;
  left: 2px;
  width: 16px;
  height: 16px;
  background-color: #FFFFFF;
  border-radius: 50%;
  transition: transform 0.3s cubic-bezier(0.4, 0.0, 0.2, 1);
  box-shadow: 0 1px 2px rgba(0,0,0,0.15);
}

.pm-toggle-input:checked {
  background-color: var(--primary, #0052CC);
}

.pm-toggle-input:checked::after {
  transform: translateX(16px);
}

.pm-toggle-input:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.pm-toggle-label span {
  color: #374151;
  font-weight: 500;
}

.pm-form-actions {
  margin-top: 2rem;
  display: flex;
  gap: 1rem;
}

.pm-badge-role {
  margin-left: 12px;
  font-size: 11px;
}
