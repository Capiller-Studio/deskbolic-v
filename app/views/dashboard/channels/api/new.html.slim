= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "api-channels") do
    .api-new-header
      = link_to channels_api_index_path, class: "api-back-link"
        | ← #{t("general.back", default: "Back")}
      .api-title-area
        h2.f-semi-32 = t("dashboard.api_channels.new.title", default: "Connect API Channel")
        p.f-reg-16 = t("dashboard.api_channels.new.description", default: "Create a new API channel to integrate a custom system.")

    .api-connect-container
      .api-step
        = form_with model: @api_channel, url: channels_api_index_path, local: true, class: "api-config-form", data: { turbo: false } do |f|
          .api-form-group
            = f.label :name, t("dashboard.api_channels.form.name_label", default: "Channel Name"), class: "api-label"
            = f.text_field :name, class: "api-input", placeholder: t("dashboard.api_channels.form.name_placeholder", default: "e.g. Acme CRM Integration"), required: true
            p.f-reg-12.text-gray-500.mt-1 = t("dashboard.api_channels.form.name_hint", default: "A recognizable name for this channel.")

          .api-form-group
            = f.label :description, t("dashboard.api_channels.form.description_label", default: "Description"), class: "api-label"
            = f.text_area :description, class: "api-input", placeholder: t("dashboard.api_channels.form.description_placeholder", default: "Optional details about this integration.")

          .api-form-group
            = f.label :webhook_url, t("dashboard.api_channels.form.webhook_url_label", default: "Outbound Webhook URL"), class: "api-label"
            = f.text_field :webhook_url, class: "api-input", placeholder: "https://..."
            p.f-reg-12.text-gray-500.mt-1 = t("dashboard.api_channels.form.webhook_url_hint", default: "We will POST events to this URL when a reply is sent from this channel.")

          .api-form-actions
            = link_to t("general.cancel", default: "Cancel"), channels_api_index_path, class: "api-btn-secondary"
            = f.submit t("general.create", default: "Create Channel"), class: "api-btn-primary"
