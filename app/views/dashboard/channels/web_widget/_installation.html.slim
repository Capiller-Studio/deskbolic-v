.ww-section.ui-section.ui-section--open data-web-widget-channel-target="installationSection"
  .ww-section-header data-action="click->web-widget-channel#toggleSection"
    .ww-section-title
      = inline_svg_tag("code_snipet.svg", class: "ww-section-icon", alt: t("dashboard.web_widget_channels.form.installation_section"))
      span.ww-section-label = t("dashboard.web_widget_channels.form.installation_section")
    span.ww-section-chevron ▼
  .ww-section-body
    .ww-credentials-grid
      .ww-credential-box
        h4 = t("dashboard.web_widget_channels.form.hmac_secret_key")
        .ww-copy-group
          input type="password" class="ww-input" value="#{web_widget_channel.hmac_token}" readonly=true
          button.ww-copy-btn type="button" data-action="click->web-widget-channel#copyEmbedCode" data-code="#{web_widget_channel.hmac_token}" = t("ui.dashboard.channels.web_widget.installation.copy")

    p.ww-section-desc
      | #{t("ui.dashboard.channels.web_widget.installation.embed_the_deskbolic_widget_into_your_website_or_web_app")}

    .ww-snippet-block
      .ww-snippet-header
        h4 = t("ui.dashboard.channels.web_widget.installation.standard_html")
      pre.ww-code-block
        code
          | &#60;script
          br
          |   src="#{ENV['WIDGET_APP_URL'] || 'https://widget.deskbolic.com'}/w/#{current_account.id}/#{web_widget_channel.id}/embed.js"
          br
          |   data-locale="#{I18n.locale}"&#62;
          br
          | &#60;/script&#62;

    .ww-snippet-block
      .ww-snippet-header
        h4 = t("ui.dashboard.channels.web_widget.installation.react_next_js")
      pre.ww-code-block
        code
          | import { useEffect } from 'react';
          br
          br
          | export default function DeskbolicWidget() {
          br
          |   useEffect(() =&#62; {
          br
          |     const script = document.createElement('script');
          br
          |     script.src = "#{ENV['WIDGET_APP_URL'] || 'https://widget.deskbolic.com'}/w/#{current_account.id}/#{web_widget_channel.id}/embed.js";
          br
          |     script.setAttribute('data-locale', '#{I18n.locale}');
          br
          |     document.body.appendChild(script);
          br
          |   }, []);
          br
          |   return null;
          br
          | }

    h4.ww-params-title = t("dashboard.web_widget_channels.form.supported_parameters", default: "Supported Parameters (Data Attributes)")
    p.ww-section-desc = t("dashboard.web_widget_channels.form.supported_parameters_desc", default: "Pass these attributes directly to the script tag to identify users or customize behavior.")

    .ww-table-responsive
      table.ww-table
        thead
          tr
            th = t("dashboard.web_widget_channels.form.attribute_header")
            th = t("dashboard.web_widget_channels.form.table_description_header")
        tbody
          tr
            td.ww-code-cell data-identifier
            td = t("dashboard.web_widget_channels.form.param_identifier_desc", default: "Your system's unique user ID (e.g., database ID). Required for Identity Verification.")
          tr
            td.ww-code-cell data-signature
            td = t("dashboard.web_widget_channels.form.param_signature_desc", default: "HMAC SHA-256 signature generated using your secret key. Required if Secure Identity is enforced.")
          tr
            td.ww-code-cell data-email
            td = t("dashboard.web_widget_channels.form.param_email_desc", default: "The customer's email address.")
          tr
            td.ww-code-cell data-name
            td = t("dashboard.web_widget_channels.form.param_name_desc", default: "The customer's full name.")
          tr
            td.ww-code-cell data-locale
            td = t("dashboard.web_widget_channels.form.param_locale_desc", default: "Force a specific language locale (e.g., \"en\", \"fr\"). Overrides browser default.")
          tr
            td.ww-code-cell data-position
            td = t("dashboard.web_widget_channels.form.param_position_desc", default: "Position of the launcher. Options: right (default) or left.")

    - if web_widget_channel.secure_identity_enforced?
      .ww-alert
        h4 = t("dashboard.web_widget_channels.form.hmac_signature_example", default: "HMAC Signature Example (Ruby)")
        p.ww-section-desc = t("dashboard.web_widget_channels.form.secure_identity_instruction")
        pre.ww-code-block
          code
            | require 'openssl'
            br
            | require 'base64'
            br
            br
            | secret_key = "#{web_widget_channel.hmac_token}"
            br
            | identifier = current_user.id.to_s
            br
            | signature = OpenSSL::HMAC.hexdigest('SHA256', secret_key, identifier)
