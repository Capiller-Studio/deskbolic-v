= form_with(model: survey, url: (survey.persisted? ? csat_survey_path(survey) : csat_surveys_path), local: true, class: "settings-form form-fields") do |f|
  - if survey.errors.any?
    .ui-error-summary
      h3 = t("shared.error_heading")
      ul
        - survey.errors.full_messages.each do |message|
          li = message

  .ui-section.ui-section--always-open
    .ui-section-header
      .ui-section-title
        span.ui-section-icon ⚙️
        span.ui-section-label = t("ui.dashboard.csat_surveys.form.basic_configuration")
    .ui-section-body
      .ui-form-row
        div
          = f.label :name, t("forms.labels.survey_name"), class: "ui-label"
          = f.text_field :name, class: "ui-input", required: true, placeholder: t("dashboard.csat_surveys.form.name_placeholder")
          p.f-reg-12.text-muted style="margin-top: 4px;" The internal name for this survey.
        
        div
          = f.label :email_template_id, t("forms.labels.assigned_email_template_optional"), class: "ui-label"
          = f.collection_select :email_template_id, Current.account.email_templates.where(template_type: :csat_survey), :id, :name, { include_blank: t("forms.options.use_system_default_design") }, class: "ui-select"

      .ui-form-row style="margin-top: 16px;"
        div
          = f.label :prompt, t("forms.labels.chat_prompt_whatsapp_widget"), class: "ui-label"
          = f.text_field :prompt, class: "ui-input", placeholder: t("dashboard.csat_surveys.form.email_prompt_placeholder")
          p.f-reg-12.text-muted style="margin-top: 4px;" 
            | #{t("ui.dashboard.csat_surveys.form.the_question_asked_in_chat_channels_emails_use_the_assigned")}
            br
            | #{t("ui.dashboard.csat_surveys.form.saved_to_your_default_language_english_as_a_fallback")}
        div
          = f.label :portal_title, t("forms.labels.portal_title_on_the_feedback_page"), class: "ui-label"
          = f.text_field :portal_title, class: "ui-input", placeholder: t("dashboard.csat_surveys.form.portal_title_placeholder")
          p.f-reg-12.text-muted style="margin-top: 4px;" Saved to your default language (English) as a fallback.

      .ui-form-row style="margin-top: 16px;"
        div
          = f.label :portal_subtitle, t("forms.labels.portal_subtitle"), class: "ui-label"
          = f.text_field :portal_subtitle, class: "ui-input", placeholder: t("dashboard.csat_surveys.form.portal_subtitle_placeholder")
          p.f-reg-12.text-muted style="margin-top: 4px;" Saved to your default language (English) as a fallback.
        div
          = f.label :portal_feedback_label, t("forms.labels.feedback_textbox_label"), class: "ui-label"
          = f.text_field :portal_feedback_label, class: "ui-input", placeholder: t("dashboard.csat_surveys.form.feedback_label_placeholder")
          p.f-reg-12.text-muted style="margin-top: 4px;" Saved to your default language (English) as a fallback.

  .ui-section.ui-section--always-open
    .ui-section-header
      .ui-section-title
        span.ui-section-icon 🌐
        span.ui-section-label = t("ui.dashboard.csat_surveys.form.localized_content")
    .ui-section-body
      div data-controller="nested-translations"
        p.text-muted style="margin-bottom: 16px; font-size: 13px;" Provide localized strings for your CSAT survey. These will override the default locale based on the customer's browser.
        
        .cf-translations-container data-nested-translations-target="container"
          = f.fields_for :translations do |tf|
            = render "dashboard/csat_surveys/translation_fields", f: tf

        template data-nested-translations-target="template"
          = f.fields_for :translations, Csat::SurveyTranslation.new, child_index: 'NEW_RECORD' do |tf|
            = render "dashboard/csat_surveys/translation_fields", f: tf
        
        - current_locales = survey.translations.reject(&:marked_for_destruction?).map(&:locale).map(&:to_s)
        - available_locales = Core::SUPPORTED_LOCALES.map(&:to_s) - current_locales
        - available_locales_options = available_locales.map { |l| [I18n.t("languages.#{l.downcase}"), l] }
        
        div style="display: flex; gap: 12px; align-items: center; margin-top: 16px; padding-top: 16px; border-top: 1px solid #f1f5f9;"
          = select_tag "new_locale", options_for_select(available_locales_options), include_blank: t("forms.options.select_language"), class: "ui-select", data: { "nested-translations-target": "localeSelect" }, style: "width: 200px;"
          button.ui-btn-secondary type="button" data-action="click->nested-translations#addTranslation"
            | #{t("ui.dashboard.channels.contact_form.form.add_language")}

  .form-actions style="margin-top: 24px; display: flex; justify-content: flex-end;"
    = f.submit t("ui.dashboard.csat_surveys.form.save_survey"), class: "ui-btn-primary"
