            = link_to("Invited", "#", class: "tab f-reg-16")
            / .tab.f-reg-16.active-tab Invited
            / = link_to("Roles", roles_settings_path, class: "tab f-reg-16")
            .tab.f-reg-16.active-tab Roles
            = link_to("Activity Logs", "#", class: "tab f-reg-16")
            / .tab.f-reg-16.active-tab Activity Logs
      .roles-container
