= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "skills") do
    .body-container  
      .ap-index-header
        .ap-title-area
          h2.f-semi-32 = t("dashboard.skills.index.title")
          p.f-reg-16 = t("dashboard.skills.index.description")
        = link_to new_skill_path, class: "ap-btn-primary", id: "new-skill"
          | + #{t("dashboard.skills.index.new_skill")}

      .ap-tabs
        = link_to skills_path, class: "ap-tab #{params[:type].blank? ? 'active' : ''}"
          = t("dashboard.skills.index.tab_all")
        - Skill.skill_types.each_key do |skill_type|
          = link_to skills_path(type: skill_type), class: "ap-tab #{params[:type] == skill_type ? 'active' : ''}"
            = t("dashboard.skills.types.#{skill_type}")

      - if @skills.any?
        .sk-list
          - @skills.each do |skill|
            .sk-card id="skill_#{skill.id}"
              .sk-card-body
                .sk-card-info
                  h4.f-semi-14.sk-card-name = skill.name
                  - if skill.description.present?
                    p.f-reg-12.sk-card-desc = truncate(skill.description, length: 60)

                .sk-card-meta
                  .sk-type-badge class="sk-type-#{skill.skill_type}"
                    = t("dashboard.skills.types.#{skill.skill_type}")

                  .sk-status-dot class="#{skill.active? ? 'active' : 'inactive'}"

                .sk-card-actions
                  = link_to edit_skill_path(skill), class: "ap-action-btn", title: t("dashboard.skills.index.edit")
                    | ✏️
                  = link_to skill_path(skill), method: :delete, class: "ap-action-btn ap-action-delete", data: { turbo_method: :delete, turbo_confirm: t("dashboard.skills.index.delete_confirm") }, title: t("dashboard.skills.index.delete")
                    | 🗑️
      - else
        .ap-empty-state
          .ap-empty-icon 🎯
          h3.f-semi-18 = t("dashboard.skills.index.empty_title")
          p.f-reg-14 = t("dashboard.skills.index.empty_description")
          = link_to new_skill_path, class: "ap-btn-primary ap-btn-sm"
            | + #{t("dashboard.skills.index.new_skill")}
