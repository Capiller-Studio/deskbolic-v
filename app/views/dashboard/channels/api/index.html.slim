= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "api-channels") do
    .api-index-header
      .api-title-area
        h2.f-semi-32 = t("dashboard.api_channels.index.title", default: "API Channels")
        p.f-reg-16 = t("dashboard.api_channels.index.description", default: "Connect custom systems and platforms through our robust API.")
      = link_to new_channels_api_path, class: "api-btn-primary"
        | + #{t("dashboard.api_channels.index.connect_channel", default: "New API Channel")}

    .api-list
      - if @api_channels.any?
        - @api_channels.each do |channel|
          div.api-card id=dom_id(channel)
            .api-card-top
              .api-card-info
                .api-page-avatar-placeholder
                  | 🔌
                .api-page-details
                  h3.f-semi-16 = channel.name || channel.identifier
                  p.api-page-id
                    | ID: #{channel.identifier}

              .api-card-actions
                = link_to edit_channels_api_path(channel), class: "api-action-btn", title: t("general.edit", default: "Edit")
                  | ✏️
                = link_to channels_api_path(channel), method: :delete, class: "api-action-btn api-action-delete", data: { turbo_method: :delete, turbo_confirm: t("dashboard.api_channels.index.delete_confirm", default: "Are you sure?") }, title: t("general.delete", default: "Delete")
                  | 🗑️

            .api-card-meta
              - if channel.active?
                .api-badge.api-badge-active
                  span.api-badge-icon 🟢
                  span = t("dashboard.api_channels.index.status_active", default: "Active")
              - else
                .api-badge.api-badge-disconnected
                  span.api-badge-icon 🔴
                  span = t("dashboard.api_channels.index.status_disconnected", default: "Disconnected")

              .api-meta-tag
                span.api-meta-tag-icon 📬
                span = t("dashboard.api_channels.index.inboxes_count", count: channel.inboxes.size, default: "#{channel.inboxes.size} inboxes")

              .api-meta-tag
                span.api-meta-tag-icon 🕐
                span = t("dashboard.api_channels.index.created_ago", time: time_ago_in_words(channel.created_at), default: "Created #{time_ago_in_words(channel.created_at)} ago")

      - else
        .api-empty-state
          .api-empty-icon 🔌
          h3.f-semi-18 = t("dashboard.api_channels.index.empty_title", default: "No API Channels Yet")
          p.f-reg-14 = t("dashboard.api_channels.index.empty_description", default: "Create an API channel to build custom integrations.")
          = link_to new_channels_api_path, class: "api-btn-primary api-btn-sm"
            | + #{t("dashboard.api_channels.index.connect_channel", default: "New API Channel")}
