= render("dashboard/shared/dashboard_container", current_page: "skills") do
  = render("dashboard/settings/settings_sidebar", current_page: "skills") do
    .ap-form-container
      .ap-form-header
        .ap-form-header-copy
          = link_to skills_path, class: "ap-header-back-link", aria: { label: t("ui.dashboard.skills.edit.back_to_skills") }
            = image_tag("back_arrow.svg", class: "ap-back-arrow-icon", alt: "")
          div
            h2.f-semi-24 = t("dashboard.skills.new.title")
            p.f-reg-14 = t("dashboard.skills.new.description")
        .ap-form-header-actions
          = link_to t("dashboard.skills.form.cancel"), skills_path, class: "ap-btn-secondary"
          button.ap-btn-save-header type="submit" form="skill-form"
            = image_tag("mark.svg", class: "ap-save-mark-icon", alt: "")
            span = t("dashboard.skills.form.create")
      = render("dashboard/skills/form", skill: @skill)
