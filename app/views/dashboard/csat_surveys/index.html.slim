= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "csat-surveys") do
    .body-container
      .ui-index-header
        .ui-title-area
          h2.f-semi-32 = t("dashboard.csat_surveys.index.title")
          p.f-reg-16 = t("dashboard.csat_surveys.index.description")
        = link_to new_csat_survey_path, class: "ui-btn-primary"
          | + #{t("dashboard.csat_surveys.index.new_survey")}

      - if @csat_surveys.any?
        .ui-list
          - @csat_surveys.each do |survey|
            .ui-card
              .ui-card-top
                .ui-card-info
                  .ui-avatar-placeholder ⭐
                  div
                    h3.f-semi-18 = survey.name
                    p.f-reg-14
                      strong = t("dashboard.csat_surveys.index.prompt_label") 
                      = survey.prompt.presence || t("dashboard.csat_surveys.index.default_prompt")
                    p.f-reg-14 style="margin-top: 4px;"
                      - if survey.email_template
                        span.ui-badge = t("dashboard.csat_surveys.index.uses_template", name: survey.email_template.name)
                      - else
                        span.ui-badge = t("dashboard.csat_surveys.index.default_template")
                .ui-card-actions
                  = link_to edit_csat_survey_path(survey), class: "ui-action-btn", title: t("shared.edit")
                    | ✏️
                  = button_to csat_survey_path(survey), method: :delete, class: "ui-action-btn ui-action-delete", form: { class: 'd-inline' }, data: { turbo_confirm: t("dashboard.csat_surveys.index.delete_confirm") }, title: t("shared.delete")
                    | 🗑️
      - else
        .ui-empty-state
          .ui-empty-icon ⭐
          h3.f-semi-18 = t("dashboard.csat_surveys.index.empty_title")
          p.f-reg-14 = t("dashboard.csat_surveys.index.empty_description")
          = link_to new_csat_survey_path, class: "ui-btn-primary"
            | + #{t("dashboard.csat_surveys.index.new_survey")}
