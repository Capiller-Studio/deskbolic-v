/ = render("dashboard/shared/dashboard_container", current_page: "settings") do
= render("dashboard/settings/settings_sidebar", current_page: "custom-fields") do
  .ui-settings-editor.ap-settings-editor
    header.ui-settings-editor__header
      = link_to custom_fields_path, class: "ui-settings-editor__back", aria: { label: t("dashboard.custom_fields.form.back_to_custom_fields", default: "Back to custom fields") } do
        = inline_svg_tag("back_arrow.svg", aria: { hidden: true })
      .ui-settings-editor__heading
        h1 = t("dashboard.custom_fields.form.page_title", default: "Field Details")
        p = t("dashboard.custom_fields.form.page_description", default: "Create and configure a custom field to capture structured customer and conversation data.")
      .ui-settings-editor__header-actions
        = link_to t("dashboard.custom_fields.form.cancel", default: "Cancel"), custom_fields_path, class: "ui-btn-secondary"
        button.ap-btn-save-header type="submit" form="custom-field-form"
          = image_tag("mark.svg", class: "ap-save-mark-icon", alt: "")
          span = t("ui.dashboard.custom_fields.form.save_custom_field")

    .ui-settings-editor__body
      = render "form", custom_field: @custom_field
