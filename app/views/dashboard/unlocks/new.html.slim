.user-login-container.center-wrapper
  .form-section
    .form-header
      .logo
        = link_to root_path do
          = image_tag "logo.png", alt: "Deskbolic"
      = link_to t("auth.login.submit", default: "Sign in"), new_user_session_path, class: "join-btn"

  .login-container
    .login-card
      h2 style="font-size: 24px; font-weight: 600; margin-bottom: 10px;" = t("auth.unlocks.title", default: "Resend unlock instructions")
      p = t("auth.unlocks.subtitle", default: "Enter your email address to receive unlock instructions.")

      .form-fields
        = form_with url: user_unlock_path, method: :post, local: true do |f|
          .form-floating
            = f.label :email, t("auth.email", default: "Email"), class: "form-label"
            = f.email_field "user[email]", autofocus: true, autocomplete: "email", required: true, class: "form-control", placeholder: "you@example.com"

          .actions
            = f.submit t("auth.unlocks.resend", default: "Resend unlock instructions"), class: "button"
