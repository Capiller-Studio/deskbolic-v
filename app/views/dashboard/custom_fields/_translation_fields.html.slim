.ww-translation-card style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin-bottom: 16px; position: relative; box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);"
  .ww-translation-header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid #f1f5f9;"
    div style="display: flex; align-items: center; gap: 8px;"
      span.f-semi-14 = I18n.t("languages.#{f.object.locale.to_s.downcase}")
      = f.hidden_field :locale
    button.ui-action-delete type="button" data-action="click->nested-translations#removeTranslation" title=t("general.remove_language")
      svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
        path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"
    = f.hidden_field :_destroy, class: "destroy-flag"

  - trans_idx = f.index

  .ui-form-row
    div
      = f.label :label, t("forms.labels.field_label"), class: "ui-label"
      = f.text_field :label, class: "ui-input", placeholder: t("dashboard.custom_fields.form.label_placeholder")

    div
      = f.label :placeholder, t("forms.labels.placeholder"), class: "ui-label"
      = f.text_field :placeholder, class: "ui-input", placeholder: t("ui.dashboard.custom_fields.translation_fields.e_g_1_10_employees")

  .ui-form-row style="margin-top: 12px;"
    div style="width: 100%;"
      = f.label :description, t("forms.labels.description_helper_text"), class: "ui-label"
      = f.text_area :description, class: "ui-input", placeholder: t("dashboard.custom_fields.form.description_placeholder"), rows: 2

  .cf-options-section data-controller="custom-field-options" class="cf-hidden" style="margin-top: 16px;"
    .cf-options-header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; padding: 12px; background: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0;"
      h4.f-semi-14 style="margin: 0;" Dropdown Options
      button type="button" data-action="click->custom-field-options#addOption" class="ui-btn-secondary" style="padding: 4px 12px; font-size: 13px;"
        | #{t("ui.dashboard.custom_fields.translation_fields.add_option")}

    .options-container data-custom-field-options-target="container" style="display: flex; flex-direction: column; gap: 12px; padding: 16px; background: white; border: 1px solid #e2e8f0; border-radius: 0 0 8px 8px; border-top: none;"
      - (f.object.options || []).each_with_index do |opt, opt_idx|
        .option-row style="display: flex; align-items: center; gap: 12px;"
          = text_field_tag "custom_field[translations_attributes][#{trans_idx}][options][#{opt_idx}][value]", opt["value"], placeholder: t("dashboard.custom_fields.form.options.value_placeholder"), class: "ui-input", style: "flex: 1; margin: 0;"
          = text_field_tag "custom_field[translations_attributes][#{trans_idx}][options][#{opt_idx}][label]", opt["label"], placeholder: t("dashboard.custom_fields.form.options.label_placeholder"), class: "ui-input", style: "flex: 1; margin: 0;"
          button type="button" data-action="click->custom-field-options#removeOption" class="ui-action-delete" title=t("general.remove_option")
            svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
              path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"

    template data-custom-field-options-target="template"
      .option-row style="display: flex; align-items: center; gap: 12px; margin-top: 12px;"
        = text_field_tag "custom_field[translations_attributes][#{trans_idx}][options][NEW_RECORD][value]", nil, placeholder: t("dashboard.custom_fields.form.options.value_placeholder"), class: "ui-input", style: "flex: 1; margin: 0;"
        = text_field_tag "custom_field[translations_attributes][#{trans_idx}][options][NEW_RECORD][label]", nil, placeholder: t("dashboard.custom_fields.form.options.label_placeholder"), class: "ui-input", style: "flex: 1; margin: 0;"
        button type="button" data-action="click->custom-field-options#removeOption" class="ui-action-delete" title=t("general.remove_option")
          svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
            path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"
