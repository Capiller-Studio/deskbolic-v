<mjml>
  <mj-head>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text font-size="15px" color="#374151" line-height="24px" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-button background-color="#3b82f6" color="#ffffff" font-size="14px" font-weight="600" border-radius="8px" padding="16px 24px" inner-padding="12px 24px" />
    </mj-attributes>

    <mj-preview>
      Reset your Capiller Rely password
    </mj-preview>

    <mj-style>
      .reset-shell { border: 1px solid #dfe3ea; border-radius: 16px; box-shadow: 0 12px 32px rgba(15, 23, 42, 0.08); overflow: hidden; }
      .brand-link { color: #64748b; text-decoration: none; }
      @media only screen and (max-width: 480px) { .mobile-center div { text-align: center !important; } }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f1f5f9">
    <mj-section padding="32px 16px"><mj-column><mj-spacer height="1px" /></mj-column></mj-section>

    <mj-wrapper css-class="reset-shell" background-color="#ffffff" padding="0">
      <mj-section background-color="#ffffff" padding="24px 40px" border-bottom="1px solid #e5e7eb">
        <mj-column width="62%" vertical-align="middle">
          <mj-image src="[[ERB= asset_url('logo.png', host: ENV.fetch('FRONTEND_URL', 'http://localhost:3000')) ]]" href="[[ERB= ENV.fetch('FRONTEND_URL', 'http://localhost:3000') ]]" alt="Capiller Rely" width="132px" align="left" padding="0" />
        </mj-column>
        <mj-column width="38%" vertical-align="middle">
          <mj-text css-class="mobile-center" align="right" padding="0" font-size="11px" font-weight="700" color="#6366f1" letter-spacing="0.08em">PASSWORD RESET</mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#0f172a" padding="34px 40px 34px">
        <mj-column>
          <mj-text padding="0 0 10px" font-size="12px" font-weight="700" color="#a5b4fc" letter-spacing="0.12em">SECURITY NOTICE</mj-text>
          <mj-text padding="0 0 12px" font-size="28px" line-height="36px" font-weight="700" color="#ffffff">Reset your password</mj-text>
          <mj-text padding="0" font-size="15px" line-height="24px" color="#cbd5e1">We received a request to reset the password for your Capiller Rely account. Click the button below to create a new password.</mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#ffffff" padding="36px 40px 18px">
        <mj-column>
          <mj-text padding="0 0 14px" font-size="16px" color="#0f172a">Hi <strong>[[ERB= @resource.email ]]</strong>,</mj-text>
          <mj-text padding="0" font-size="15px" line-height="25px" color="#475569">Someone has requested a link to change your password. You can do this through the link below. If you didn't make this request, you can safely ignore this email.</mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#ffffff" padding="0 40px 24px">
        <mj-column background-color="#f8fafc" border="1px solid #e2e8f0" border-radius="10px" padding="18px 22px">
          <mj-text padding="0 0 6px" font-size="11px" font-weight="700" color="#3b82f6" letter-spacing="0.08em">ACCOUNT DETAILS</mj-text>
          <mj-text padding="0" font-size="14px" line-height="22px" color="#334155">Email: <strong>[[ERB= @resource.email ]]</strong></mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#ffffff" padding="0 40px 36px">
        <mj-column>
          <mj-button align="left" href="[[ERB= edit_password_url(@resource, reset_password_token: @token, locale: I18n.locale) ]]" background-color="#3b82f6" border-radius="8px" padding="0 0 20px" inner-padding="14px 24px" font-size="15px">
            Change my password &nbsp;&rarr;
          </mj-button>
          <mj-text padding="0" font-size="13px" line-height="21px" color="#64748b">Your password won't change until you access the link above and create a new one. This link will expire in 6 hours.</mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#f8fafc" padding="22px 40px" border-top="1px solid #e5e7eb">
        <mj-column>
          <mj-text align="center" padding="0 0 7px" font-size="12px" line-height="19px" color="#64748b">This password reset was requested for [[ERB= @resource.email ]]. Please do not reply to this automated message.</mj-text>
          <mj-text align="center" padding="0" font-size="12px" line-height="19px" color="#94a3b8">&copy; [[ERB= Time.current.year ]] Capiller Rely &nbsp;&bull;&nbsp; <a href="[[ERB= ENV.fetch('FRONTEND_URL', 'http://localhost:3000') ]]" class="brand-link">Open workspace</a></mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section padding="24px 16px 32px">
      <mj-column>
        <mj-text align="center" padding="0" font-size="11px" color="#94a3b8">Secure customer-support operations, powered by Capiller Rely.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>