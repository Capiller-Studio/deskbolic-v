.model-content-section
  .model-content
    .modal-header
      h3.f-semi-18 Widget Channel
      = inline_svg_tag("cross_button.svg", alt:"menu", class:"conversation-icon m-close", data: { action: "click->modal-toggler#hideModal" })
    .modal-body.channel-form
      = form_with(url: channels_path, data: {controller: "formValidation renderer", "formValidation-target" => "form", turbo: false}, html: {class: "needs-validation", novalidate: true, method: :post}) do |f|
        .form-fields
          = f.hidden_field :channel_type, value: "widget"
          .form-floating
            .field-label
              span 1
              = f.label :name, "Enter Channel Name", class: "form-label f-reg-14"
            = f.text_field :name, class: "form-control f-reg-14", placeholder: "Channel Name", required: true
          .form-floating
            .field-label
              span 2
              = f.label :secret, "Secret", class: "form-label f-reg-14"
            = f.text_field :secret, class: "form-control f-reg-14", placeholder: "Secret", required: true
          .form-floating
            .field-label
              span 3
              = f.label :website_url, "Enter Website Url", class: "form-label f-reg-14"
            = f.text_field :website_url, class: "form-control f-reg-14", placeholder: "https://example.com", required: true
          / .form-floating
          /   .field-label
          /     span 4
          /     = f.label :phone_number_id, "Phone number id", class: "form-label f-reg-14"
          /   = f.text_field :phone_number_id, class: "form-control f-reg-14", placeholder: "phone number id", required: true
          / .form-floating
          /   .field-label
          /     span 5
          /     = f.label :business_account_id, "Business account id", class: "form-label f-reg-14"
          /   = f.text_field :business_account_id, class: "form-control f-reg-14", placeholder: "business account id", required: true
        .form-actions
          = f.submit "Create Channel", class: "submit-btn f-med-14", data: { action: "click->formValidation#validate click->modal-toggler#hideModal" }