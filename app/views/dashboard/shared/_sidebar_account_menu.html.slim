.sidebar-user data-controller="accordion"
  button.sidebar-user-main.sidebar-user-trigger type="button" aria-haspopup="menu" aria-expanded="false" data-action="click->accordion#toggleMenu"
    - if current_user.avatar&.attached?
      = image_tag(current_user.avatar, class: "sidebar-user-avatar", alt: current_user.display_name)
    - else
      .sidebar-user-avatar.avatar-fallback class=avatar_fallback_color_class(full_name(current_user))
        = initials(current_user)
    .sidebar-user-copy
      strong = current_user.display_name
      span.sidebar-presence
        i aria-hidden="true"
        = t("dashboard.sidebar.available", default: "Available")

  .menu.sidebar-account-menu data-accordion-target="menu" role="menu"
    .sidebar-account-switcher
      h2 = t("ui.dashboard.shared.dashboard_container.switch_account")
      .sidebar-account-list
        - current_user.accounts.sort_by { |account| account == current_account ? 0 : 1 }.each do |account|
          - active_account = account == current_account
          = link_to root_url(subdomain: account.identifier), class: "sidebar-workspace #{active_account ? 'is-active' : ''}", role: "menuitem", data: { turbo: false } do
            .sidebar-workspace-avatar.avatar-fallback class=avatar_fallback_color_class(account.name)
              = initials(account, limit: 2)
            .sidebar-workspace-details
              strong = account.name
              span title=(account.email.presence || current_user.email) = account.email.presence || current_user.email
            - if active_account
              span.sidebar-workspace-check aria-hidden="true"
                svg viewBox="0 0 20 20" fill="none"
                  path d="M4 10.5 8 14l8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"

      = link_to workspaces_url(subdomain: ""), class: "sidebar-create-account", role: "menuitem", data: { turbo: false } do
        span = t("dashboard.sidebar.all_workspaces")
      = link_to workspace_path(subdomain: ""), class: "sidebar-create-account", role: "menuitem", data: { turbo: false } do
        = inline_svg_tag("plus_black.svg", class: "sidebar-create-account-icon", alt: "", aria: { hidden: true })
        span = t("auth.login.create_account")

    .sidebar-account-options
      = link_to profile_path, class: "menu-link", role: "menuitem", data: { turbo: false } do
        = inline_svg_tag("account.svg", class: "menu-icon", alt: "", aria: { hidden: true })
        span = t("dashboard.profile.index.title")
      - if local_assigns.fetch(:show_settings, true)
        = link_to settings_path, class: "menu-link", role: "menuitem", data: { turbo: false } do
          = inline_svg_tag("settings.svg", class: "menu-icon", alt: "", aria: { hidden: true })
          span = t("dashboard.sidebar.settings.title")

    .sidebar-account-locale
      span.sidebar-account-locale-icon aria-hidden="true"
        = inline_svg_tag("world.svg")
      - locale_names = { en: "English", de: "Deutsch", es: "Español", fr: "Français", "pt-BR": "Português", ar: "العربية", ko: "한국어" }
      - locale_options = Core::SUPPORTED_LOCALES.map { |loc| [locale_names[loc.to_sym] || loc.to_s.upcase, url_for(request.params.merge(locale: (loc.to_s == I18n.default_locale.to_s ? nil : loc), only_path: true))] }
      - selected_locale_url = url_for(request.params.merge(locale: (I18n.locale.to_s == I18n.default_locale.to_s ? nil : I18n.locale), only_path: true))
      .sidebar-account-locale-picker
        = select_tag local_assigns.fetch(:locale_field, :dashboard_locale), options_for_select(locale_options, selected_locale_url), id: local_assigns.fetch(:locale_id, "dashboard-sidebar-locale-select"), class: "sidebar-account-locale-select", data: { controller: "select" }, aria: { label: t("forms.options.select_language") }, onchange: "window.location.href=this.value"

    .sidebar-account-logout
      = button_to destroy_user_session_path, method: :delete, class: "menu-link", role: "menuitem" do
        = inline_svg_tag("logout.svg", class: "menu-icon", alt: "", aria: { hidden: true })
        span = t("ui.dashboard.shared.dashboard_container.sign_out")
