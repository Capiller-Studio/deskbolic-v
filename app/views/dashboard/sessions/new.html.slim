- content_for :body_class, "auth-themed-body"
- content_for :themed_auth_layout, "true"

.auth-page.auth-page--login
  main.auth-main
    header.auth-header
      = link_to root_path, class: "auth-logo", aria: { label: "Capiller Rely" } do
        = image_tag "logo.png", alt: "Capiller Rely"

    .auth-form-wrap
      .auth-card
        .auth-card-header
          .auth-eyebrow = t("auth.login.submit")
          h1 = t("auth.login.title")
          p = t("auth.login.subtitle")

        .auth-social-buttons
          / = button_to user_google_oauth2_omniauth_authorize_path, method: :post, data: { turbo: false }, class: "auth-social-button auth-social-button--google" do
          /   svg.auth-social-icon viewBox="0 0 24 24" width="18" height="18"
          /     path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
          /     path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
          /     path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
          /     path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
          /   span = t("auth.login.continue_with_google", default: "Continue with Google")

          / = button_to user_facebook_omniauth_authorize_path, method: :post, data: { turbo: false }, class: "auth-social-button auth-social-button--facebook" do
          /   svg.auth-social-icon viewBox="0 0 24 24" width="18" height="18" fill="#1877F2"
          /     path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
          /   span = t("auth.login.continue_with_facebook", default: "Continue with Facebook")

          = link_to auth_saml_initiate_path(email: params[:email]), class: "auth-social-button auth-social-button--sso", style: "text-decoration: none;" do
            svg.auth-social-icon viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#4f46e5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              circle cx="12" cy="12" r="10"
              line x1="2" y1="12" x2="22" y2="12"
              path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
            span = t("auth.login.continue_with_sso", default: "Single Sign-On (SSO)")

        .auth-divider
          span = t("auth.login.or_email", default: "or continue with email")

        = form_with url: user_session_path, method: :post, local: true, data: { turbo: false }, class: "auth-form" do |f|
          - if params[:bypass_sso] == "true"
            = hidden_field_tag :bypass_sso, "true"
            .auth-bypass-badge style="margin-bottom: 12px; padding: 6px 12px; background: #fef3c7; border: 1px solid #fde68a; border-radius: 6px; font-size: 12px; color: #92400e; font-weight: 500;"
              | ⚠️ Emergency Owner Break-Glass Bypass

          - if params[:email].present? && flash[:alert]&.include?("Single Sign-On")
            .auth-sso-cta style="margin-bottom: 16px; padding: 14px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; text-align: center;"
              p style="font-size: 13px; color: #1e40af; margin-bottom: 10px; font-weight: 500;"
                = flash[:alert]
              = link_to auth_saml_initiate_path(email: params[:email]), class: "auth-primary-button", style: "display: inline-block; width: auto; padding: 8px 18px; text-decoration: none; font-size: 13px;" do
                | #{t("auth.login.sign_in_with_sso", default: "Sign in with SSO")} →

          .auth-field
            = f.label :email, t("auth.email"), class: "auth-label", for: "user_email"
            = f.email_field "user[email]", id: "user_email", value: params[:email], autofocus: true, autocomplete: "email", required: true, class: "auth-input", placeholder: t("auth.placeholders.email")

          .auth-field
            = f.label :password, t("auth.password"), class: "auth-label", for: "user_password"
            = f.password_field "user[password]", id: "user_password", autocomplete: "current-password", required: true, class: "auth-input", placeholder: "••••••••"

          .auth-form-options
            .auth-checkbox
              = f.check_box "user[remember_me]", id: "user_remember_me"
              = f.label "user[remember_me]", t("auth.login.remember_me"), for: "user_remember_me"

            = link_to t("auth.login.forgot_password"), new_user_password_path, class: "auth-text-link"

          = f.submit t("auth.login.submit"), class: "auth-primary-button"

        .auth-card-footer
          = link_to t("auth.login.resend_confirmation"), new_user_confirmation_path, class: "auth-muted-link"

  aside.auth-visual aria-label=t("auth.registration.marketing_text")
    .auth-visual-orb.auth-visual-orb--one
    .auth-visual-orb.auth-visual-orb--two
    .auth-visual-content
      .auth-visual-badge
        span.auth-visual-badge-dot
        = t("auth.login.subtitle")
      = image_tag "register.png", class: "auth-visual-image", alt: "", aria: { hidden: true }
      h2 = t("auth.registration.marketing_text")
