.model-content-section
  .model-content
    .modal-header
      h3.f-semi-18 = t("ui.dashboard.popup.topic_questions_modal.generate_more_by_topic")
      = inline_svg_tag("cross_button.svg", alt:t("ui.dashboard.agent.agent_sidebar.menu"), class:"conversation-icon m-close", data: { action: "click->modal-toggler#hideModal" })
    .modal-body.channel-form
      p.f-reg-12 = t("ui.dashboard.popup.topic_questions_modal.generate_more_questions_from_your_inbox_using_the_selected_topic")
      = form_with(url: "#", data: {controller: "form-validation renderer", "form-validation-target" => "form"}, html: {class: "needs-validation", novalidate: true, method: :post}) do |f|
        .form-fields
          / = f.hidden_field :inbox_type, value: "email"
          / .form-floating
          /   .field-label
          /     span 1
          /     = f.label :name, t("forms.labels.enter_name_of_inbox"), class: "form-label f-reg-14"
          /   = f.text_field :name, autofocus: true, class: "form-control f-reg-14", placeholder: "Channel Name", required: true
          .form-floating.ui-select
            = select_tag :channel_id, options_for_select(Channel::Email.where(account: current_account).all.map { |c| [c.name, c.id] }), data: { controller: "select" } 
        .form-actions
          = f.submit t("ui.dashboard.popup.email_inbox_modal.create_inbox"), class: "submit-btn f-med-14", data: { action: "click->form-validation#validate click->modal-toggler#hideModal" }