- permission_columns = [{ key: "read", label: "Read", actions: %w[read view], icon: "read.svg" }, { key: "write", label: "Write", actions: %w[write], icon: "write.svg" }, { key: "delete", label: "Delete", actions: %w[delete remove], icon: "delete.svg" }, { key: "manage", label: "Manage", actions: %w[manage], icon: "setting_orange.svg" }, { key: "export", label: "Export", actions: %w[export], icon: "export_blue.svg" }, { key: "execute", label: "Execute", actions: %w[execute], icon: "execute.svg" }, { key: "invite", label: "Invite", actions: %w[invite], icon: "invite.svg" }]
- schema = ::Access::Role::PERMISSION_SCHEMA
- resource_icons = { "conversations" => "message.svg", "inboxes" => "inboxes.svg", "teams" => "team.svg", "agents" => "team.svg", "customers" => "team.svg", "automations" => "automation.svg", "macros" => "macros.svg", "reports" => "reports.svg", "settings" => "setting.svg", "assignment_policies" => "setting.svg", "custom_fields" => "fields.svg", "sla_policies" => "timer.svg", "integrations" => "setting.svg", "billing" => "billing.svg", "roles" => "roles.svg", "skills" => "skills.svg", "email_templates" => "mail.svg", "identity_sources" => "identity.svg", "domains" => "domain.svg", "labels" => "label.svg", "business_hours" => "clock.svg", "csat_surveys" => "permission.svg" }
- all_permissions = schema.transform_values { |actions| actions.index_with { true } }
- manager_permissions = schema.transform_values { |actions| actions.select { |action| %w[read view write manage export].include?(action) }.index_with { true } }.reject { |_resource, actions| actions.empty? }
- support_resources = %w[conversations inboxes teams macros customers labels]
- support_permissions = schema.slice(*support_resources).transform_values { |actions| actions.select { |action| %w[read view write manage execute].include?(action) }.index_with { true } }.reject { |_resource, actions| actions.empty? }
- read_only_permissions = schema.transform_values { |actions| actions.select { |action| %w[read view].include?(action) }.index_with { true } }.reject { |_resource, actions| actions.empty? }
- presets = [{ key: "administrator", name: "Administrator", description: "Full system access", icon: "shieldsvg.svg", permissions: all_permissions }, { key: "manager", name: "Manager", description: "Access to manage and view", icon: "manager.svg", permissions: manager_permissions }, { key: "support_agent", name: "Support Agent", description: "Limited access for support", icon: "support_agent.svg", permissions: support_permissions }, { key: "read_only", name: "Read Only", description: "View-only access", icon: "read_only.svg", permissions: read_only_permissions }, { key: "scratch", name: "Start From Scratch", description: "Custom permissions", icon: "custom.svg", permissions: {} }]

= form_with model: role, url: role.new_record? ? roles_path : role_path(role), id: dom_id(role, :form), local: true, data: { controller: "role-permissions" }, class: "roles-editor-form" do |f|
  - if role.errors.any?
    .roles-form-errors
      strong = t("dashboard.roles.form.errors_found", count: role.errors.count)
      ul
        - role.errors.full_messages.each do |msg|
          li = msg

  = f.hidden_field :permissions, data: { role_permissions_target: "jsonOutput" }

  .roles-editor-layout
    aside.roles-editor-sidebar
      section.roles-editor-card
        h2 = t("dashboard.roles.form.role_details", default: "Role Details")
        .roles-name-field
          = f.label :name, t("dashboard.roles.form.name_label")
          = f.text_field :name, placeholder: t("ui.dashboard.roles.form.e_g_billing_manager"), disabled: role.system_provided?, autofocus: role.new_record?

      - if role.new_record?
        section.roles-editor-card.roles-presets
          h2
            = t("dashboard.roles.form.permission_preset", default: "Permission Preset")
            small = t("dashboard.roles.form.optional", default: "(Optional)")
          p = t("dashboard.roles.form.preset_description", default: "Choose a preset to get started quickly.")
          .roles-preset-list
            - presets.each do |preset|
              label.roles-preset-option
                .roles-preset-icon
                  = inline_svg_tag(preset[:icon], class: "roles-icon")
                .roles-preset-copy
                  strong = preset[:name]
                  span = preset[:description]
                input type="radio" name="permission_preset" value=preset[:key] checked=(preset[:key] == "scratch") data-role-permissions-target="preset" data-permissions=preset[:permissions].to_json data-action="change->role-permissions#applyPreset"
                span.roles-preset-radio aria-hidden="true"

    section.roles-matrix-card
      .roles-matrix-heading
        h2 = t("dashboard.roles.form.permissions_matrix")
        p = t("dashboard.roles.form.permissions_desc")
      .roles-matrix-scroll
        .roles-matrix
          .roles-matrix-superheader
            span = t("ui.dashboard.roles.form.resource")
            span = t("ui.dashboard.roles.form.permissions")
          .roles-matrix-actions
            .roles-matrix-action-spacer
            - permission_columns.each do |column|
              .roles-matrix-action class="roles-matrix-action-#{column[:key]}"
                = inline_svg_tag(column[:icon], class: "roles-icon")
                span = column[:label]
          - schema.each do |resource, actions|
            - resource_icon = resource_icons.fetch(resource, "permission.svg")
            .roles-matrix-row
              .roles-matrix-resource
                .roles-resource-icon
                  = inline_svg_tag(resource_icon, class: "roles-icon")
                span = resource.humanize.titleize
                = inline_svg_tag("dropdown.svg", class: "roles-icon")
              - permission_columns.each do |column|
                - actual_action = column[:actions].find { |candidate| actions.include?(candidate) }
                .roles-matrix-cell
                  - if actual_action
                    - is_checked = role.permissions.dig(resource, actual_action) == true || role.permissions.dig(resource, actual_action) == "true"
                    label.pm-toggle-label title="#{column[:label]} #{resource.humanize}"
                      input.pm-toggle-input type="checkbox" checked=is_checked disabled=role.system_provided? data-role-permissions-target="checkbox" data-action="change->role-permissions#toggle" data-resource=resource data-permission-action=actual_action
                      span.sr-only = "#{column[:label]} #{resource.humanize}"
                  - else
                    span.roles-matrix-unavailable aria-hidden="true"
