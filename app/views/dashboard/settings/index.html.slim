            = link_to("#", class:"card") do
              = inline_svg_tag("green_grid.svg", class:"card-icon", alt:"icon")
              .card-desc
                h4.f-semi-14  All Help Center
                p.f-reg-12 Manage all help centers created for this workspace.
            = link_to(roles_settings_path, class:"card") do
              = inline_svg_tag("green_plus.svg", class:"card-icon", alt:"icon")
              .card-desc
                h4.f-semi-14  New Help Center
                / p.f-reg-12 Add new help center.
            
              
