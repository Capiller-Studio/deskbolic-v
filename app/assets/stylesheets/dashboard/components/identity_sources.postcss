
.ui-settings-page .ui-card-grid.is-source-card-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.is-source-card {
  height: auto;
  min-height: 0;
  gap: 16px;
}

.is-source-card .ai-agent-card-identity {
  min-width: 0;
}

.is-source-card-avatar {
  --ai-agent-avatar-filter: none;
  background: rgba(119, 141, 255, 0.1);
}

.is-source-card-avatar img {
  filter: none;
}

.is-source-card-title {
  min-width: 0;
}

.is-source-card-title h2 {
  overflow: visible;
  text-overflow: clip;
  white-space: normal;
}

.is-source-card-title p {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.is-source-card .ai-agent-card-menu summary,
.is-source-card .ai-agent-card-menu summary:hover,
.is-source-card .ai-agent-card-menu summary:focus {
  border: 0;
  outline: 0;
  background: transparent;
  box-shadow: none;
}

.is-source-details {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.is-source-detail {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 6px;
}

.is-source-detail-label {
  color: #94a3b8;
  font-family: $font-family-inter-medium;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.04em;
  line-height: 14px;
  text-transform: uppercase;
}

.is-source-type-pill {
  display: inline-flex;
  width: fit-content;
  max-width: 100%;
  align-items: center;
  gap: 5px;
  padding: 3px 10px;
  border-radius: 999px;
  background: rgba(119, 141, 255, 0.1);
  color: $secondary-purple;
  font-family: $font-family-inter-medium;
  font-size: 12px;
  line-height: 16px;
}

.is-source-type-pill-icon {
  width: 12px;
  height: 12px;
  flex: 0 0 12px;
  object-fit: contain;
}

.is-source-url {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 6px;
  color: #334155;
  font-size: 13px;
  line-height: 18px;
}

.is-source-url-icon {
  width: 14px;
  height: 14px;
  flex: 0 0 14px;
  object-fit: contain;
  color: #64748b;
}

.is-source-url-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.is-source-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  padding-top: 14px;
  border-top: 1px solid #f3f4f6;
}

.is-source-stat {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  text-align: center;
}

.is-source-stat-icon {
  width: 16px;
  height: 16px;
  object-fit: contain;
}

.is-source-stat--headers .is-source-stat-icon {
  color: $secondary-purple;
}

.is-source-stat--params .is-source-stat-icon {
  color: #15803d;
}

.is-source-stat--mappings .is-source-stat-icon {
  color: #c2410c;
}

.is-source-stat strong {
  color: #111827;
  font-family: $font-family-inter-semibold;
  font-size: 14px;
  line-height: 20px;
}

.is-source-stat span {
  color: #6b7280;
  font-size: 12px;
  line-height: 16px;
}

.is-source-footer {
  gap: 8px;
  margin-top: 0;
}

.is-source-created {
  display: inline-flex;
  min-width: 0;
  align-items: center;
  gap: 6px;
  color: #6b7280;
  font-size: 13px;
  line-height: 18px;
}

.is-source-created-icon {
  width: 14px;
  height: 14px;
  flex: 0 0 14px;
  object-fit: contain;
}

.is-source-created span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.is-section-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 24px 24px 0;
}

.is-section-header-row .ap-section-header {
  padding: 0;
}

.is-section-add-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  border: 1px solid $black-10;
  border-radius: 8px;
  background: $white;
  color: #334155;
  cursor: pointer;
  font-family: $font-family-inter-medium;
  font-size: 13px;
  line-height: 18px;
  text-decoration: none;
  transition: all 0.15s ease;

  &:hover {
    background: $black-2;
    border-color: $black-20;
  }
}

.is-section-add-btn-icon {
  width: 12px;
  height: 12px;
  object-fit: contain;
}

.is-kv-table {
  width: 100%;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  overflow: hidden;
}

.is-kv-table--hidden,
.is-kv-empty--hidden {
  display: none;
}

.is-kv-table-header {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) 64px;
  gap: 12px;
  padding: 10px 14px;
  border-bottom: 1px solid #e2e8f0;
  border-radius: 10px 10px 0 0;
  background: #f8fafc;
}

.is-kv-table-header span {
  color: #64748b;
  font-family: $font-family-inter-medium;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.04em;
  line-height: 14px;
  text-transform: uppercase;
}

.is-kv-table-header span:last-child {
  text-align: center;
}

.is-kv-table-body {
  display: flex;
  flex-direction: column;
}

.is-kv-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) 64px;
  gap: 12px;
  align-items: center;
  padding: 10px 14px;
  border-bottom: 1px solid #f1f5f9;

  &:last-child {
    border-bottom: 0;
  }
}

.is-kv-row .ap-input {
  padding: 8px 12px;
  font-size: 13px;
}

.is-kv-row-actions {
  display: flex;
  align-items: center;
  justify-content: center;
}

.is-kv-remove-btn {
  display: inline-flex;
  width: 28px;
  height: 28px;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: #94a3b8;
  cursor: pointer;
  font-size: 16px;
  line-height: 1;
  transition: all 0.15s ease;

  &:hover {
    background: #fef2f2;
    color: #dc2626;
  }
}

.is-kv-empty {
  display: flex;
  min-height: 160px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 24px;
  border: 1px dashed #d8dee8;
  border-radius: 10px;
  text-align: center;
}

.is-kv-empty-icon {
  width: 36px;
  height: 36px;
  margin-bottom: 4px;
  color: #94a3b8;
  object-fit: contain;
}

.is-kv-empty strong {
  color: #334155;
  font-family: $font-family-inter-semibold;
  font-size: 14px;
  line-height: 20px;
}

.is-kv-empty p {
  margin: 0;
  color: #94a3b8;
  font-size: 13px;
  line-height: 18px;
}

.is-variables-picker {
  margin-top: 14px;
  padding: 12px 14px;
  border-radius: 10px;
  background: #f8fafc;
}

.is-variables-picker-label {
  display: block;
  margin-bottom: 8px;
  color: #334155;
  font-family: $font-family-inter-semibold;
  font-size: 13px;
  line-height: 18px;
}

.is-variables-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.is-variable-chip {
  display: inline-flex;
  align-items: center;
  padding: 4px 10px;
  border: 1px solid #e2e8f0;
  border-radius: 999px;
  background: $white;
  color: $secondary-purple;
  cursor: pointer;
  font-family: $font-family-inter-medium;
  font-size: 12px;
  line-height: 16px;
  transition: all 0.15s ease;

  &:hover {
    border-color: rgba(119, 141, 255, 0.45);
    background: rgba(119, 141, 255, 0.08);
  }
}

.is-btn-test-icon {
  width: 14px;
  height: 14px;
  object-fit: contain;
}

@media (max-width: 840px) {
  .ui-settings-page .ui-card-grid.is-source-card-grid {
    grid-template-columns: 1fr;
  }

  .is-source-details {
    grid-template-columns: 1fr;
  }
}
.ap-section.is-overflow-card {
  position: relative;
  z-index: 2;
  overflow: visible;
}

.ap-section.is-overflow-card:has(.choices.is-open) {
  z-index: 30;
}

.is-kv-table:has(.choices.is-open) {
  overflow: visible;
}
