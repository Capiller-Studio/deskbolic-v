= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "roles") do
    .ui-index-header
      .ui-title-area
        h2.f-semi-32 = t("dashboard.roles.index.title", default: "Roles & Permissions")
        p.f-reg-16 = t("dashboard.roles.index.description", default: "Manage access levels and granular permissions for your teammates.")
      
      = link_to new_role_path, class: "ui-btn-primary"
        - if can?(:create, Access::Role)
          | + #{t("dashboard.roles.index.new_role", default: "Create New Role")}
        - else
          span.ui-badge-icon 🔒
          | #{t("dashboard.roles.index.new_role", default: "Create New Role")}

    .ui-list
      - if @system_roles.any? || @custom_roles.any?
        - @system_roles.each do |role|
          div.ui-card id=dom_id(role)
            .ui-card-top
              .ui-card-info
                h3.f-semi-16
                  = role.name
                  span.ui-badge.ui-badge-verified.ui-badge-role
                    span.ui-badge-icon 🛡️
                    span System Default
                p.ui-card-email = role.identifier.humanize
              .ui-card-actions
                - if can?(:update, role)
                  = link_to edit_role_path(role), class: "ui-action-btn", title: "View Permissions"
                    | 👁️

            .ui-card-meta
              .ui-meta-tag
                span.ui-meta-tag-icon 👥
                span = t("dashboard.roles.index.users_count", count: role.account_user_roles.count, default: "%{count} Users")

        - @custom_roles.each do |role|
          div.ui-card id=dom_id(role)
            .ui-card-top
              .ui-card-info
                h3.f-semi-16 = role.name
                p.ui-card-email = role.identifier.humanize
              .ui-card-actions
                - if can?(:update, role)
                  = link_to edit_role_path(role), class: "ui-action-btn", title: "Edit"
                    | ✏️
                - if can?(:destroy, role)
                  = link_to role_path(role), method: :delete, class: "ui-action-btn ui-action-delete", data: { turbo_method: :delete, turbo_confirm: t("dashboard.roles.index.delete_confirm", default: "Are you sure you want to delete this custom role?") }, title: "Delete"
                    | 🗑️

            .ui-card-meta
              .ui-meta-tag
                span.ui-meta-tag-icon 👥
                span = t("dashboard.roles.index.users_count", count: role.account_user_roles.count, default: "%{count} Users")
              .ui-meta-tag
                span.ui-meta-tag-icon 🕐
                span = t("dashboard.roles.index.created_ago", time: time_ago_in_words(role.created_at), default: "Created %{time} ago")
      - else
        .ui-empty-state
          .ui-empty-icon 🛡️
          h3.f-semi-18 = t("dashboard.roles.index.empty_title", default: "No Roles Found")
          p.f-reg-14 = t("dashboard.roles.index.empty_description", default: "There are no roles configured for this account.")
