= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "api-channels") do
    .channel-theme-api
      .ui-index-header
        .ui-title-area
          h2.f-semi-32 = t("dashboard.api_channels.index.title", default: "API Channels")
          p.f-reg-16 = t("dashboard.api_channels.index.description", default: "Connect custom systems and platforms through our robust API.")
        = link_to new_channels_api_path, class: "ui-btn-primary"
          | + #{t("dashboard.api_channels.index.connect_channel", default: "New API Channel")}

      .ui-list
        - if @api_channels.any?
          - @api_channels.each do |channel|
            div.ui-card id=dom_id(channel)
              .ui-card-top
                .ui-card-info
                  .ui-avatar-placeholder
                    svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="var(--channel-brand, #0f172a)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      polyline points="16 18 22 12 16 6"
                      polyline points="8 6 2 12 8 18"
                  .ui-card-info
                    h3.f-semi-16 = channel.name || channel.identifier
                    p.ui-subtitle
                      | ID: #{channel.identifier}

                .ui-card-actions
                  = link_to edit_channels_api_path(channel), class: "ui-action-btn", title: t("general.edit", default: "Edit")
                    | ✏️
                  = link_to channels_api_path(channel), method: :delete, class: "ui-action-btn ui-action-delete", data: { turbo_method: :delete, turbo_confirm: t("dashboard.api_channels.index.delete_confirm", default: "Are you sure?") }, title: t("general.delete", default: "Delete")
                    | 🗑️

              .ui-card-meta
                - if channel.active?
                  .ui-badge.ui-badge-active
                    span.ui-badge-icon 🟢
                    span = t("dashboard.api_channels.index.status_active", default: "Active")
                - else
                  .ui-badge.ui-badge-disconnected
                    span.ui-badge-icon 🔴
                    span = t("dashboard.api_channels.index.status_disconnected", default: "Disconnected")

                .ui-meta-tag
                  span.ui-meta-tag-icon 📬
                  span = t("dashboard.api_channels.index.inboxes_count", count: channel.inboxes.size, default: "#{channel.inboxes.size} inboxes")

                .ui-meta-tag
                  span.ui-meta-tag-icon 🕐
                  span = t("dashboard.api_channels.index.created_ago", time: time_ago_in_words(channel.created_at), default: "Created #{time_ago_in_words(channel.created_at)} ago")

        - else
          .ui-empty-state
            .ui-empty-icon
              svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="var(--channel-brand, #0f172a)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                polyline points="16 18 22 12 16 6"
                polyline points="8 6 2 12 8 18"
            h3.f-semi-18 = t("dashboard.api_channels.index.empty_title", default: "No API Channels Yet")
            p.f-reg-14 = t("dashboard.api_channels.index.empty_description", default: "Create an API channel to build custom integrations.")
            = link_to new_channels_api_path, class: "ui-btn-primary ui-btn-sm"
              | + #{t("dashboard.api_channels.index.connect_channel", default: "New API Channel")}
