.model-content-section
  .model-content
    .modal-header
      h3.f-semi-18 = t("ui.dashboard.popup.canned_response_modal.create_a_new_reply")
      = inline_svg_tag("cross_button.svg", alt:t("ui.dashboard.agent.agent_sidebar.menu"), class:"conversation-icon m-close", data: { action: "click->modal-toggler#hideModal" })
    .modal-body.canned-response-modal
      = form_with(model: CannedResponse.new, data: {controller: "form-validation renderer accordion", "form-validation-target" => "form"}, html: {class: "needs-validation", novalidate: true, method: :post}) do |f|
        .form-fields
          .form-floating
            = f.text_field :name, autofocus: true, class: "form-control rounded-3 f-reg-14", placeholder: t("dashboard.popup.canned_response.form.title_placeholder"), required: true
          .tags-list
            - tags = [ { name: 'customer_name', value: '{{ customer.name }}' }, { name: 'customer_email', value: '{{ customer.email }}' }, { name: 'customer_first_name', value: '{{ customer.first_name }}' } ]
            - tags.each do |tag|
              .tag data-value=tag[:value] data-action="click->accordion#addTag" 
                = tag[:name]
          .form-floating
            = f.text_area :description, class: "form-control f-reg-14", placeholder: t("dashboard.popup.canned_response.form.description_placeholder"), data: { accordion_target: "response" }, required: true
        .form-actions
          button.button.f-med-14 type="button" data-action="click->modal-toggler#hideModal" = t("dashboard.popup.canned_response.form.cancel")
          = f.submit t("dashboard.popup.canned_response.form.save"), class: "submit-btn f-med-14", data: { action: "click->form-validation#validate click->modal-toggler#hideModal" }
