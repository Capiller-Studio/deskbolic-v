/ = render("dashboard/shared/dashboard_container", current_page: "teams") do
= render("dashboard/settings/settings_sidebar", current_page: "teams") do
  .tm-users.tm-teams data-controller="modal-toggler frame-toggler"
    = render("dashboard/shared/modal_popper")
    .tm-users-header
      div
        h1 = t("dashboard.teams.index.title")
        p = t("dashboard.teams.index.manage_description")
      .tm-users-header-actions
        button.tm-users-invite.tm-team-modal-button type="button" data-action="click->modal-toggler#showModal click->frame-toggler#loadModal" data-popup-view="_team_modal"
          span = t("dashboard.teams.index.new_team")
          = inline_svg_tag("plus_white.svg", class:"plus-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))

    .tm-users-body
      - if @teams.any?
        .tm-users-grid.tm-teams-grid
          - @teams.each do |team|
            article.tm-member-card.tm-team-card
              .tm-team-card-header
                h2 = team.name
                button.tm-team-card-settings type="button" data-action="click->modal-toggler#showModal click->frame-toggler#loadModal" data-popup-view="_team_modal" data-item-id=team.id
                  = inline_svg_tag("settings.svg", alt: t("ui.dashboard.agent.guidance.icon"))
              p.tm-team-card-description = team.description.presence || t("dashboard.teams.index.no_description")

              .tm-team-card-members
                .tm-team-card-avatars
                  - team.users.limit(3).each_with_index do |team_user, idx|
                    - if team_user.avatar.attached?
                      = image_tag(team_user.avatar, class: "tm-team-card-avatar tm-team-card-avatar-#{idx + 1}", alt: team_user.display_name)
                    - else
                      .tm-team-card-avatar.tm-team-card-avatar-fallback.avatar-fallback class="tm-team-card-avatar-#{idx + 1} #{avatar_fallback_color_class(full_name(team_user))}"
                        = initials(team_user)
                button.tm-team-card-add type="button" data-action="click->modal-toggler#showModal click->frame-toggler#loadModal" data-popup-view="_team_modal" data-item-id=team.id
                  = inline_svg_tag("plus_blue.svg", class:"plus-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
                  span = t("dashboard.teams.index.add_teammates")

              .tm-team-card-status
                span = team.created_at.strftime("%d %b %Y")
                .tm-member-card-status class="bg-#{team_status_class(team.status)}"
                  .bullet
                  span = team.status.capitalize
      - else
        .tm-users-empty.tm-teams-empty
          = image_tag("empity_tag.png", class:"tm-teams-empty-image", alt:t("ui.dashboard.channels.channels.img"))
          h2 = t("dashboard.teams.index.empty_title")
          p = t("dashboard.teams.index.empty_description")
          button.tm-users-invite.tm-team-modal-button.tm-teams-empty-action type="button" data-action="click->modal-toggler#showModal click->frame-toggler#loadModal" data-popup-view="_team_modal"
            span = t("dashboard.teams.index.new_team")
            = inline_svg_tag("plus_white.svg", class:"plus-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
