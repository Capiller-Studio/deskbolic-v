turbo-frame id="notification-badge" style="position: relative;"
  - unread = current_user.notifications.unread.count
  - if unread > 0
    .unread-badge style="position: absolute; top: -26px; right: 5px; background: red; color: white; border-radius: 50%; font-size: 10px; padding: 2px 5px; width: 20px; height: 20px; display: flex; justify-content: center; align-items: center;"
      = unread > 99 ? "99+" : unread
