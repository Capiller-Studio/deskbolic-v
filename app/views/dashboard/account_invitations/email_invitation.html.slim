- content_for :body_class, "auth-themed-body auth-register-body auth-invitation-body"
- content_for :themed_auth_layout, "true"
- content_for :embedded_auth_locale_picker, "true"

.auth-page.auth-page--register.auth-page--invitation
  .form-section.auth-main
    header.auth-header
      = link_to root_path, class: "auth-logo", aria: { label: "Deskbolic" } do
        = image_tag "logo.png", alt: "Deskbolic"
      - if @existing_user.blank?
        = link_to t("auth.login.submit"), new_user_session_path, class: "auth-secondary-button"

    = form_for(:user, url: accept_invite_path(token: @invitation.token), html: { method: :post, class: "auth-register-form auth-invitation-form", novalidate: true, data: { turbo: false, controller: "form-wizard" } }) do |f|
      = hidden_field_tag :token, @invitation.token

      fieldset.auth-invitation-step--overview style=(@existing_user.blank? && params[:user].present? ? "display: none;" : "")
        .set-header
          h2 = t("auth.workspace.email_invitation.title")
          p = t("auth.workspace.email_invitation.description")

        .auth-invitation-summary
          .auth-invitation-workspace-identity
            .auth-workspace-avatar aria-hidden="true"
              = @account.name.first(2).upcase
            .auth-invitation-workspace-copy
              h3 = @account.name
              - if @role_names.any?
                p = t("auth.workspace.email_invitation.members", count: @role_names.length)

          - if @existing_user.present?
            button.cont-btn type="submit"
              = t("auth.workspace.email_invitation.join_button")
          - else
            button.cont-btn type="button" data-action="click->form-wizard#nextEmailStep"
              = t("auth.workspace.email_invitation.join_button")

      - if @existing_user.blank?
        fieldset.auth-invitation-step--details style=(params[:user].present? ? "" : "display: none;") data-controller="password-strength" data-password-strength-match-message-value=t("auth.password_match") data-password-strength-mismatch-message-value=t("auth.password_mismatch")
          .set-header
            h2 = t("auth.workspace.email_invitation.joining_header")
            p = @account.name

          .auth-invitation-workspace-banner
            .auth-workspace-avatar aria-hidden="true"
              = @account.name.first(2).upcase
            .auth-invitation-workspace-copy
              h3 = @account.name
              - if @role_names.any?
                p = t("auth.workspace.email_invitation.members", count: @role_names.length)

          .form-fields
            .name-section
              .form-wrapper
                = f.label :first_name, t("auth.workspace.email_invitation.form.first_name"), class: "form-label"
                = f.text_field :first_name, autofocus: true, class: "form-control", placeholder: t("auth.workspace.email_invitation.form.first_name"), required: true
              .form-wrapper
                = f.label :last_name, t("auth.workspace.email_invitation.form.last_name"), class: "form-label"
                = f.text_field :last_name, class: "form-control", placeholder: t("auth.workspace.email_invitation.form.last_name"), required: true

            .form-wrapper
              = f.label :email, t("auth.workspace.email_invitation.form.email"), class: "form-label"
              = f.email_field :email, class: "form-control", placeholder: t("auth.workspace.email_invitation.form.email"), readonly: true, value: @invitation.email

            .password-section
              .form-wrapper
                = f.label :password, t("auth.workspace.email_invitation.form.password"), class: "form-label"
                = f.password_field :password, class: "form-control", required: true, data: { password_strength_target: "password", action: "input->password-strength#validatePassword input->password-strength#validateConfirmation" }, placeholder: "••••••••"
                .auth-password-meter
                  .auth-password-meter__fill data-password-strength-target="strengthMeter"
              .form-wrapper
                = label_tag :confirm_password, t("auth.workspace.email_invitation.form.confirm_password"), class: "form-label"
                = password_field_tag :confirm_password, "", class: "form-control", required: true, data: { password_strength_target: "confirmation", action: "input->password-strength#validateConfirmation" }, placeholder: "••••••••"
                p.auth-password-match data-password-strength-target="matchStatus"

            .password-rules
              div data-password-strength-target="ruleLength"
                svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"
                  path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"
                span = t("auth.password_rules.length")
              div data-password-strength-target="ruleUpper"
                svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"
                  path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"
                span = t("auth.password_rules.uppercase")
              div data-password-strength-target="ruleNumber"
                svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"
                  path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"
                span = t("auth.password_rules.number")
              div data-password-strength-target="ruleSpecial"
                svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"
                  path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"
                span = t("auth.password_rules.special")

            .registration-actions
              = f.submit t("auth.workspace.email_invitation.form.submit"), class: "cont-btn", data: { password_strength_target: "submitButton" }

    .auth-register-locale-row
      = render("layouts/auth_locale_picker")

  .image-section.auth-visual
    = image_tag "register.png", class: "register-img", alt: t("ui.dashboard.registrations.new.graphic")
    = image_tag "register-back.png", class: "back-img", alt: t("ui.dashboard.registrations.new.background")
    p = t("auth.registration.marketing_text")
