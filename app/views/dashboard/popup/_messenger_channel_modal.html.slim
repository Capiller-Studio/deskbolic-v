.model-content-section
  .model-content
    .modal-header
      h3.f-semi-18 = t("ui.dashboard.popup.messenger_channel_modal.messenger_channel")
      = inline_svg_tag("cross_button.svg", alt:t("ui.dashboard.agent.agent_sidebar.menu"), class:"conversation-icon m-close", data: { action: "click->modal-toggler#hideModal" })
    .modal-body.channel-form
      = form_with(url: "#", data: {controller: "form-validation renderer", "form-validation-target" => "form"}, html: {class: "needs-validation", novalidate: true, method: :post, remote: true}) do |f|
        .form-fields
          = f.hidden_field :channel_type, value: "facebook_page"
          .form-floating
            .field-label
              span 1
              = f.label :app_id, t("forms.labels.enter_app_id"), class: "form-label f-reg-14"
            = f.text_field :app_id, autofocus: true, class: "form-control rounded-3 f-reg-14", placeholder: t("dashboard.popup.messenger_channel.form.app_id_placeholder"), required: true
        .form-actions
          p.submit-btn.f-med-14 data-controller="facebook" data-action="click->form-validation#validate click->facebook#fb_login click->modal-toggler#hideModal" data-address=facebook_page_path Continue

