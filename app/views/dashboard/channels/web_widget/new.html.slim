= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "web-widget-channels") do
    .channel-theme-web-widget
      .ww-page
        .ww-header
          div
            h1 = t("dashboard.web_widget_channels.new.title")
            p = t("dashboard.web_widget_channels.new.subtitle", default: "Create a new web widget for your website.")
          .ww-header-actions
            = link_to t("dashboard.web_widget_channels.form.back"), channels_web_widget_index_path, class: "ww-back-link"

        .ww-page-body
          .ww-form-layout
            .ww-form-main
              .ww-form-wrapper
                = render "form", web_widget_channel: @web_widget_channel

            .ww-preview-section
              = render "preview", web_widget_channel: @web_widget_channel