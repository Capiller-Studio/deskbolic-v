- customer = conversation.customers.first
- unread_count = @unread_counts&.dig(:conversations, conversation.id).to_i
- active_conversation = @active_conversation_id.to_s == conversation.id.to_s || @conversation&.id == conversation.id
- last_activity = conversation.last_message&.created_at || conversation.last_activity_at
- display_time = conversation_list_time(last_activity)

article.conversation-list-item id=dom_id(conversation) class=(active_conversation ? 'is-active' : '')
  .conversation-list-link data-controller="section" data-action="click->section#toggleSection" data-url=conversation_path(conversation, resource_id: @inbox&.id, team_id: @team_id, assignee_id: @assignee_id, filter: @filter, q: @query.presence)
    - if customer&.avatar&.attached?
      = image_tag(customer.avatar, class: 'conversation-avatar', alt: full_name(customer))
    - else
      .conversation-avatar.avatar-fallback class=avatar_fallback_color_class(full_name(customer))
        = initials(customer)

    .conversation-list-copy
      .conversation-list-row
        h2 = full_name(customer)
      p.conversation-preview id="conversation-#{conversation.id}-preview"
        - if conversation.last_message&.attachments&.any?
          span.conversation-preview-attachment
            = inline_svg_tag('file_attach.svg', class: 'conversation-preview-attachment-icon', aria: { hidden: true })
            span = t('dashboard.conversations.attachment')
        - else
          = conversation.last_message_preview.presence || t('dashboard.conversation_details.no_messages', default: 'No messages yet')
      .conversation-list-meta
        span.conversation-source class="conversation-source--#{inbox_channel_tag_type(conversation.inbox)}" title=conversation.inbox.name
          span.conversation-source-icon = inbox_icon(conversation.inbox)
          = inbox_channel_tag_label(conversation.inbox)

    .conversation-list-actions
      time id="conversation-#{conversation.id}-date" datetime=last_activity&.iso8601 = display_time
      .conversation-unread data-controller="unread-badge" data-action="deskbolic:unread-counts-updated@window->unread-badge#update" data-unread-badge-id-value=conversation.id data-unread-badge-type-value="conversation" style=(unread_count.positive? ? nil : 'display: none')
        span data-unread-badge-target="count" = unread_count
