doctype html
html lang=I18n.locale dir=(I18n.locale.to_s.match?(/^(ar|he|fa|ur)/i) ? "rtl" : "ltr")
  head
    title Capiller Rely - Authentication
    meta content="text/html; charset=UTF-8" http-equiv="Content-Type"
    meta[name="viewport" content="width=device-width,initial-scale=1"]
    = csrf_meta_tags
    = csp_meta_tag
    = favicon_link_tag(image_path("fav_icon.png"))
    = stylesheet_link_tag "auth", "data-turbo-track": "reload"
    = javascript_include_tag "auth", "data-turbo-track": "reload", defer: true
  body class=content_for(:body_class)
    - unless content_for?(:embedded_auth_locale_picker)
      = render("layouts/auth_locale_picker", custom: content_for?(:themed_auth_layout))
    = render("layouts/dashboard/flash_message")
    == yield
