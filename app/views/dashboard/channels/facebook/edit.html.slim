= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "facebook-channels") do
    .fb-edit-header
      = link_to channels_facebook_index_path, class: "fb-back-link"
        | ← #{t("dashboard.facebook_channels.form.back")}
      h2.f-semi-32 = t("dashboard.facebook_channels.edit.title")

    .fb-edit-container
      /! Connection Status Section
      .fb-section
        .fb-section-header
          h3.f-semi-18 = t("dashboard.facebook_channels.form.connection_section")

        .fb-connection-card
          .fb-connection-info
            - if @facebook_channel.avatar_url.present?
              img.fb-page-avatar src=@facebook_channel.avatar_url alt=@facebook_channel.name
            - else
              .fb-page-avatar-placeholder
                | 📘
            .fb-page-details
              h3.f-semi-16 = @facebook_channel.name || @facebook_channel.page_identifier
              p.fb-page-id
                | Page ID: #{@facebook_channel.page_identifier}

          - if @facebook_channel.reauthorization_required?
            .fb-reauth-banner
              .fb-reauth-icon ⚠️
              .fb-reauth-text
                p.f-semi-14 = t("dashboard.facebook_channels.edit.reauth_title")
                p.f-reg-12 = t("dashboard.facebook_channels.edit.reauth_description")
              = link_to reconnect_channels_facebook_path(@facebook_channel), method: :post, class: "fb-reconnect-btn", data: { turbo_method: :post }
                | 🔄 #{t("dashboard.facebook_channels.index.reconnect")}
          - elsif @facebook_channel.active?
            .fb-status-active
              span.fb-badge.fb-badge-active
                span.fb-badge-icon 🟢
                span = t("dashboard.facebook_channels.index.status_active")

      /! Inbox Configuration Section
      .fb-section
        .fb-section-header
          h3.f-semi-18 = t("dashboard.facebook_channels.form.inbox_section")

        = form_with model: @facebook_channel, url: channels_facebook_path(@facebook_channel), method: :patch, class: "fb-edit-form" do |f|
          .fb-form-group
            = f.label :name, t("dashboard.facebook_channels.new.name_label"), class: "fb-label"
            = f.text_field :name, class: "fb-input", placeholder: t("dashboard.facebook_channels.new.name_placeholder")

          - if @facebook_channel.primary_inbox
            .fb-inbox-settings
              h4.f-semi-14 = t("dashboard.facebook_channels.edit.inbox_settings_title")

              = f.fields_for :primary_inbox, @facebook_channel.primary_inbox do |inbox|
                = inbox.hidden_field :id

                .fb-form-group.fb-checkbox-group
                  = inbox.check_box :csat_survey_enabled, class: "fb-checkbox"
                  = inbox.label :csat_survey_enabled, t("dashboard.facebook_channels.edit.csat_enabled"), class: "fb-checkbox-label"

                .fb-form-group
                  = inbox.label :csat_survey_id, "CSAT Survey", class: "fb-label"
                  = inbox.collection_select :csat_survey_id, current_account.csat_surveys, :id, :name, { include_blank: "Default System Survey" }, class: "fb-select"
                
                .fb-form-group
                  = inbox.label :sla_policy_ids, "SLA Policies", class: "fb-label"
                  = inbox.collection_select :sla_policy_ids, current_account.sla_policies, :id, :name, {}, { multiple: true, class: "fb-select" }

          .fb-form-actions
            = link_to channels_facebook_index_path, class: "fb-btn-secondary"
              | #{t("dashboard.facebook_channels.form.cancel")}
            = f.submit t("dashboard.facebook_channels.form.save"), class: "fb-btn-primary"

      /! Danger Zone
      .fb-section.fb-danger-zone
        .fb-section-header
          h3.f-semi-18 = t("dashboard.facebook_channels.edit.danger_title")
        p.f-reg-14 = t("dashboard.facebook_channels.edit.danger_description")
        = link_to channels_facebook_path(@facebook_channel), method: :delete, class: "fb-btn-danger", data: { turbo_method: :delete, turbo_confirm: t("dashboard.facebook_channels.index.delete_confirm") }
          | #{t("dashboard.facebook_channels.edit.disconnect")}
