- customer = @conversation.customers.first
- csat_response = @conversation.csat_survey_responses.last
- active_sla = @conversation.conversation_slas.active.first
- recent_conversations = customer ? customer.conversations.where.not(id: @conversation.id).order(created_at: :desc).limit(5) : []
- status_label = @conversation.active? ? t('dashboard.conversation_details.open', default: 'Open') : t("enums.conversation.status.#{@conversation.status}", default: @conversation.status.humanize)

aside.details-section.conversation-inspector id="conversation-details-#{@conversation.id}" aria-labelledby="conversation-details-title-#{@conversation.id}" data-controller="accordion" data-conversation-inspector-target="panel"
  header.inspector-drawer-header
    h2 id="conversation-details-title-#{@conversation.id}" = t('dashboard.conversation_details.title', default: 'Details')
    button.inspector-drawer-close type="button" aria-label=t('dashboard.conversation_details.hide_details', default: 'Hide conversation details') data-action="click->conversation-inspector#close" data-conversation-inspector-target="close"
      = inline_svg_tag('arrow_left.svg', aria: { hidden: true })
  .inspector-scroll
    section.inspector-section.inspector-assignment
      .inspector-section-heading
        h2 = t('dashboard.conversation_details.assignment', default: 'Assignment')
        span.inspector-status-badge class="status-#{@conversation.status}" = status_label
      .assignment-fields
        = render partial: 'dashboard/conversations/agent_info', locals: { conversation: @conversation }
        = render partial: 'dashboard/conversations/team_info', locals: { conversation: @conversation, assigned_team: @conversation.team }

    section.inspector-section.inspector-labels
      = render partial: 'dashboard/conversations/labels_info', locals: { conversation: @conversation }

    section.inspector-section.ticket-info
      button.inspector-accordion.active-accordian type="button" data-action="click->accordion#toggle" aria-expanded="true"
        span = t('dashboard.conversation_details.ticket_info')
        = inline_svg_tag('arrow_down.svg', class: 'inspector-chevron', aria: { hidden: true })
      .panel.inspector-panel.visible data-accordion-target="panel"
        .inspector-data-row
          span = t('dashboard.conversation_details.ticket_id', default: 'Ticket')
          strong = "##{@conversation.identifier}"
        .inspector-data-row
          span = t('dashboard.conversation_details.created')
          strong = @conversation.created_at.strftime('%d %b %H:%M')
        .inspector-data-row
          span = t('dashboard.conversation_details.priority')
          = form_with model: @conversation, url: conversation_path(@conversation), method: :patch do |f|
            = f.select :priority, Conversation.priorities.keys.map { |priority| [t("enums.conversation.priority.#{priority}", default: priority.humanize), priority] }, {}, class: 'inspector-inline-select', onchange: 'this.form.requestSubmit()'
        .inspector-data-row
          span = t('dashboard.conversation_details.status')
          = form_with model: @conversation, url: conversation_path(@conversation), method: :patch do |f|
            = f.select :status, Conversation.statuses.keys.map { |status| [t("enums.conversation.status.#{status}", default: status.humanize), status] }, {}, class: 'inspector-inline-select', onchange: 'this.form.requestSubmit()'

    - if @conversation.ai_metadata.present? && (@conversation.ai_metadata['sentiment'].present? || @conversation.ai_metadata['category'].present?)
      section.inspector-section
        button.inspector-accordion type="button" data-action="click->accordion#toggle"
          span = t('dashboard.conversation_details.ai_insights')
          = inline_svg_tag('arrow_down.svg', class: 'inspector-chevron', aria: { hidden: true })
        .panel.inspector-panel data-accordion-target="panel"
          - if @conversation.ai_metadata['sentiment'].present?
            .inspector-data-row
              span = t('dashboard.conversation_details.sentiment')
              strong = @conversation.ai_metadata['sentiment'].titleize
          - if @conversation.ai_metadata['category'].present?
            .inspector-data-row
              span = t('dashboard.conversation_details.category')
              strong = @conversation.ai_metadata['category'].titleize

    section.inspector-section
      button.inspector-accordion type="button" data-action="click->accordion#toggle"
        span = t('dashboard.conversation_details.sla_status')
        small = active_sla.present? ? t('dashboard.conversation_details.on_track', default: 'On track') : t('dashboard.conversation_details.not_applicable')
        = inline_svg_tag('arrow_down.svg', class: 'inspector-chevron', aria: { hidden: true })
      .panel.inspector-panel data-accordion-target="panel"
        .inspector-data-row
          span = t('dashboard.conversation_details.next_target')
          strong = active_sla&.target_next_response_at&.strftime('%d %b %H:%M') || t('dashboard.conversation_details.not_applicable')

    section.inspector-section
      button.inspector-accordion type="button" data-action="click->accordion#toggle"
        span = t('dashboard.conversation_details.csat_rating')
        small = csat_response&.rating ? "#{csat_response.rating} / 5" : t('dashboard.conversation_details.no_rating_yet', default: 'No rating yet')
        = inline_svg_tag('arrow_down.svg', class: 'inspector-chevron', aria: { hidden: true })
      .panel.inspector-panel data-accordion-target="panel"
        .inspector-data-row
          span = t('dashboard.conversation_details.rating')
          strong = csat_response&.rating ? "#{csat_response.rating} / 5" : t('dashboard.conversation_details.pending')

    section.inspector-section
      button.inspector-accordion type="button" data-action="click->accordion#toggle"
        span = t('dashboard.conversation_details.verified_identities')
        small = customer&.identities&.count.to_i
        = inline_svg_tag('arrow_down.svg', class: 'inspector-chevron', aria: { hidden: true })
      .panel.inspector-panel data-accordion-target="panel"
        - if customer && customer.identities.any?
          - customer.identities.includes(:identity_source).each do |identity|
            .inspector-data-row
              span = identity.identity_source&.name || identity.identity_type.titleize
              strong = identity.identifier
        - else
          p.inspector-empty = t('dashboard.conversation_details.no_identities')

    section.inspector-section
      button.inspector-accordion type="button" data-action="click->accordion#toggle"
        span = t('dashboard.conversation_details.customer_data')
        = inline_svg_tag('arrow_down.svg', class: 'inspector-chevron', aria: { hidden: true })
      .panel.inspector-panel data-accordion-target="panel"
        - if customer
          .inspector-customer
            - if customer.avatar&.attached?
              = image_tag(customer.avatar, class: 'inspector-customer-avatar', alt: full_name(customer))
            - else
              .inspector-customer-avatar.avatar-fallback class=avatar_fallback_color_class(full_name(customer))
                = initials(customer)
            strong = full_name(customer)
          .inspector-data-row
            span = t('dashboard.conversation_details.customer_id')
            strong = customer.id.last(10)
          .inspector-data-row
            span = t('dashboard.conversation_details.email')
            strong = customer.email.presence || '—'
        - else
          p.inspector-empty = t('dashboard.conversation_details.no_customer', default: 'No customer data')

    section.inspector-section.user-notes
      button.inspector-accordion type="button" data-action="click->accordion#toggle"
        span = t('dashboard.conversation_details.user_notes')
        small = @notes.count
        = inline_svg_tag('plus_black.svg', class: 'inspector-add-icon', data: { action: 'click->accordion#toggleNote' }, aria: { hidden: true })
        = inline_svg_tag('arrow_down.svg', class: 'inspector-chevron', aria: { hidden: true })
      .panel.inspector-panel data-accordion-target="panel" id="conversation-notes"
        - @notes.each do |note|
          = render 'dashboard/notes/note', note: note
      .panel.note-panel data-accordion-target="npanel"
        = form_with model: Note.new, url: notes_path, class: 'new-note', html: { novalidate: true }, data: { action: 'submit->accordion#preventBlankNote turbo:submit-end->accordion#clearNote' } do |f|
          = f.text_area :content, class: 'note-field', placeholder: t('dashboard.conversation_details.add_new_note'), required: true, data: { action: 'input->accordion#clearNoteValidation' }
          = f.hidden_field :resource_type, value: 'Conversation'
          = f.hidden_field :resource_id, value: @conversation.id
          .note-actions
            button type="button" data-action="click->accordion#toggleNote" = t('general.cancel', default: 'Cancel')
            = f.submit t('general.add', default: 'Add')

    section.inspector-section
      button.inspector-accordion type="button" data-action="click->accordion#toggle"
        span = t('dashboard.conversation_details.recent_chats')
        small = recent_conversations.count
        = inline_svg_tag('arrow_down.svg', class: 'inspector-chevron', aria: { hidden: true })
      .panel.inspector-panel data-accordion-target="panel"
        - if recent_conversations.any?
          - recent_conversations.each do |recent|
            = link_to conversation_path(recent), class: 'recent-conversation-link' do
              strong = recent.title.presence || "##{recent.identifier}"
              span = truncate(recent.last_message_preview, length: 42)
        - else
          p.inspector-empty = t('dashboard.conversation_details.no_recent_chats')
