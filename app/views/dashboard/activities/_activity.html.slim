.timeline-activity id="activity_#{activity.id}" style="display: flex; justify-content: center; margin: 16px 0; clear: both; width: 100%;"
  .activity-content style="background: #f9f9f9; padding: 6px 12px; border-radius: 12px; font-size: 11px; color: #666; display: flex; align-items: center; gap: 8px; border: 1px solid #eee;"
    - if activity.actor.try(:avatar)&.attached?
      = image_tag(activity.actor.avatar, class: "account dashboard-account-avatar", style: "width: 16px; height: 16px; border-radius: 50%;")
    - else
      .avatar-fallback style="width: 16px; height: 16px; border-radius: 50%; background: #ccc; display: flex; align-items: center; justify-content: center; font-size: 8px; color: white;"
        = initials(activity.actor) || "S"
    
    span = activity.translated_description
    
    span.time style="color: #999;"
      = l(account_time(activity.created_at), format: :short)
