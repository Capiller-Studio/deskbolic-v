- show_unread_divider = (defined?(@unread_start_message_id) && @unread_start_message_id == message.id) || (defined?(show_divider) && show_divider && message.incoming?)
- if show_unread_divider
  .unread-divider data-controller="fade-out" style="text-align: center; margin: 15px 0; position: relative; clear: both; width: 100%; display: block;"
    span.f-med-12 style="background: #eef2f6; padding: 4px 12px; border-radius: 12px; color: #5a6a85;" = t('dashboard.messages.new_messages')

- if message.sender_type == "Customer"
  .user-response.response id=dom_id(message) data-controller="translator" data-translator-translate-url-value=translate_message_path(message) data-translator-target="response"
    .text-content
      .chat-user
        - customer = message.sender
        - if customer.avatar.attached?
          = image_tag(customer.avatar, class:"img", alt:"menu")
        - else
          .img.avatar-fallback.customer-message-initials-avatar.f-reg-12 class=avatar_fallback_color_class(full_name(customer))
            = initials(customer)
      .user-text
        - if message.content.present?
          - if single_emoji_message?(message.content)
            .original.single-emoji-message data-translator-target="original"
              = message.content.strip
          - else
            .original.f-reg-14 data-translator-target="original"
              == sanitize(message.content, tags: Parser::MailParser::ALLOWED_TAGS, attributes: Parser::MailParser::ALLOWED_ATTRIBUTES)
            .translate-text
              button.f-light-italic-10 data-action="click->translator#toggle_translate" = t('dashboard.messages.translate')
            .translated-text.d-none
              h5.f-med-10 = t('dashboard.messages.translation_header')
              div
                .translation.f-light-italic-12 data-translator-target="translation" style="display: inline-block; margin-right: 8px;"
                span.f-med-10.close-translation data-action="click->translator#toggle" style="cursor: pointer; text-decoration: underline;" = t('dashboard.messages.close')
        - if message.attachments.any?
          .msg-attachments
            - message.attachments.each do |attachment|
              - if attachment.audio? && attachment.file.attached?
                .msg-attachment-audio
                  audio controls=true preload="metadata" src=rails_blob_path(attachment.file)
              - elsif attachment.image? && attachment.file.attached?
                .msg-attachment-img
                  = image_tag(attachment.file, class: "attachment-image")
              - elsif attachment.file.attached?
                a.msg-attachment-file href=rails_blob_path(attachment.file, disposition: "attachment") target="_blank"
                  span.file-icon 📄
                  span.file-name = attachment.file.filename

- if message.sender_type == "User"
  - is_private = message.personal?
  .agent-response.response id=dom_id(message) data-controller="translator" data-translator-translate-url-value=translate_message_path(message) data-translator-target="response"
    .agent-text class=(is_private ? "private-note-bg" : "") style=(is_private ? "background-color: #fefce8; border: 1px solid #fef08a;" : "")
      - if is_private
        .private-note-label style="font-size: 10px; color: #ca8a04; text-transform: uppercase; font-weight: 700; margin-bottom: 6px; display: flex; align-items: center; gap: 4px;"
          svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
            rect x="3" y="11" width="18" height="11" rx="2" ry="2"
            path d="M7 11V7a5 5 0 0 1 10 0v4"
          = t('dashboard.messages.private_note', default: 'Private Message')
      - if message.content.present?
        - if single_emoji_message?(message.content)
          .original.single-emoji-message data-translator-target="original"
            = message.content.strip
            span.message-status-container style="display: inline-block; margin-left: 4px; vertical-align: bottom; height: 14px; font-size: 14px; line-height: 1;"
              - if message.failed?
                span.status-tooltip style="color: #ef4444; display: flex;" data-tooltip=t('dashboard.messages.status.failed')
                  svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                    circle cx="12" cy="12" r="10"
                    line x1="15" y1="9" x2="9" y2="15"
                    line x1="9" y1="9" x2="15" y2="15"
              - elsif message.read?
                span.status-tooltip style="color: #3b82f6; display: flex;" data-tooltip=t('dashboard.messages.status.read')
                  svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                    polyline points="18 6 7 17 2 12"
                    polyline points="22 10 11 21 6 16"
              - elsif message.delivered?
                span.status-tooltip style="color: #9ca3af; display: flex;" data-tooltip=t('dashboard.messages.status.delivered')
                  svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                    polyline points="18 6 7 17 2 12"
                    polyline points="22 10 11 21 6 16"
              - else
                span.status-tooltip style="color: #9ca3af; display: flex;" data-tooltip=t('dashboard.messages.status.sent')
                  svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                    polyline points="20 6 9 17 4 12"
        - else
          .original.f-reg-14 data-translator-target="original"
            span == sanitize(message.content, tags: Parser::MailParser::ALLOWED_TAGS, attributes: Parser::MailParser::ALLOWED_ATTRIBUTES)
            span.message-status-container style="display: inline-block; margin-left: 8px; vertical-align: text-bottom; height: 14px; margin-bottom: -2px;"
              - if message.failed?
                span.status-tooltip style="color: #ef4444; display: flex;" data-tooltip="Failed to send"
                  svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                    circle cx="12" cy="12" r="10"
                    line x1="15" y1="9" x2="9" y2="15"
                    line x1="9" y1="9" x2="15" y2="15"
              - elsif message.read?
                span.status-tooltip style="color: #3b82f6; display: flex;" data-tooltip="Read"
                  svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                    polyline points="18 6 7 17 2 12"
                    polyline points="22 10 11 21 6 16"
              - elsif message.delivered?
                span.status-tooltip style="color: #9ca3af; display: flex;" data-tooltip="Delivered"
                  svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                    polyline points="18 6 7 17 2 12"
                    polyline points="22 10 11 21 6 16"
              - else
                span.status-tooltip style="color: #9ca3af; display: flex;" data-tooltip="Sent"
                  svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                    polyline points="20 6 9 17 4 12"
                    
          .translate-text
            button.f-light-italic-10 data-action="click->translator#toggle_translate" = t('dashboard.messages.translate')
          .translated-text.d-none style="margin-bottom: 4px;"
            h5.f-med-10 = t('dashboard.messages.translation_header')
            div
              .translation.f-light-italic-12 data-translator-target="translation" style="display: inline-block; margin-right: 8px;"
              span.f-med-10.close-translation data-action="click->translator#toggle" style="cursor: pointer; text-decoration: underline;" = t('dashboard.messages.close')
      - if message.attachments.any?
        .msg-attachments
          - message.attachments.each do |attachment|
            - if attachment.audio? && attachment.file.attached?
              .msg-attachment-audio
                audio controls=true preload="metadata" src=rails_blob_path(attachment.file)
            - elsif attachment.image? && attachment.file.attached?
              .msg-attachment-img
                = image_tag(attachment.file, class: "attachment-image")
            - elsif attachment.file.attached?
              a.msg-attachment-file href=rails_blob_path(attachment.file, disposition: "attachment") target="_blank"
                span.file-icon 📄
                span.file-name = attachment.file.filename

      - if message.content.blank?
        .message-status-container style="align-self: flex-end; margin-top: 4px; display: flex; align-items: center;"
          - if message.failed?
            span.status-tooltip style="color: #ef4444; display: flex;" data-tooltip="Failed to send"
              svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                circle cx="12" cy="12" r="10"
                line x1="15" y1="9" x2="9" y2="15"
                line x1="9" y1="9" x2="15" y2="15"
          - elsif message.read?
            span.status-tooltip style="color: #3b82f6; display: flex;" data-tooltip="Read"
              svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                polyline points="18 6 7 17 2 12"
                polyline points="22 10 11 21 6 16"
          - elsif message.delivered?
            span.status-tooltip style="color: #9ca3af; display: flex;" data-tooltip="Delivered"
              svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                polyline points="18 6 7 17 2 12"
                polyline points="22 10 11 21 6 16"
          - else
            span.status-tooltip style="color: #9ca3af; display: flex;" data-tooltip="Sent"
              svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                polyline points="20 6 9 17 4 12"