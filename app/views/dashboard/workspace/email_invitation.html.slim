.email-joining-container.center-wrapper data-controller="renderer form-wizard"
  .header
    .logo
      = image_tag("logo.png", alt: t("ui.dashboard.account_invitations.email_invitation.deskbolic_logo"))
  = form_for(:user, url: "#", data: {controller: "form-validation renderer form-wizard", "form-validation-target" => "form"}, html: {class: "js-form-wizard form-wizard needs-validation", novalidate: true, method: :post}) do |f|   
    fieldset
      .view-workspace-container
        .joining-card
          .logo
            = image_tag("deskbolic_icon_v.png", alt: t("ui.dashboard.account_invitations.email_invitation.deskbolic_logo"))
          p = t("dashboard.workspace.email_invitation.description")

          .joining-sub-container
            .joining-sub-card
              .joining-header
                = image_tag("email_join_icon.png", class: "community-logo", alt: t("ui.dashboard.account_invitations.email_invitation.email_joining_icon"))
                .community-details
                  p.workspace-name = @workspace.name
                  p.members = t("dashboard.workspace.email_invitation.members", count: @workspace.users.count)
              p.description = t("dashboard.workspace.email_invitation.description")
              button.join-btn.js-next-button.f-med-12 type="button" data-action="click->form-wizard#nextEmailStep" = t("dashboard.workspace.email_invitation.join_button")

    fieldset
      .join-workspace-container
        .joining-card
          = image_tag("email_join_icon.png", alt: t("ui.dashboard.account_invitations.email_invitation.community_icon"),class: "community-logo")
          p.title = @workspace.name
          p.members = t("dashboard.workspace.email_invitation.members", count: @workspace.users.count)

          .header-line
            p = t("dashboard.workspace.email_invitation.joining_header")
            p.workspace = t("dashboard.workspace.email_invitation.workspace_name")

          .form-fields
            .name
              .form-floating
                  = f.label :first_name, t("dashboard.workspace.email_invitation.form.first_name") , class: "f-semi-14 form-label"
                  = f.text_field :first_name, autofocus: true, class: "f-reg-14 form-control", placeholder: t("dashboard.workspace.email_invitation.form.first_name"), disabled: true, required: true
              .form-floating
                  = f.label :last_name, t("dashboard.workspace.email_invitation.form.last_name") , class: "f-semi-14 form-label"
                  = f.text_field :last_name, class: "f-reg-14 form-control", placeholder: t("dashboard.workspace.email_invitation.form.last_name"), required: true
            .form-floating
              = f.label :email, t("dashboard.workspace.email_invitation.form.email"), class: "f-semi-14 form-label"
              = f.email_field :email, class: "f-reg-14 form-control", placeholder: t("auth.placeholders.email"), readonly: true
            .form-floating
              = f.label :password, t("dashboard.workspace.email_invitation.form.password"), class: "f-semi-14 form-label"
              = f.password_field :password, class: "f-reg-14 form-control", required: true
            .form-floating
              = label_tag :confirm_password, t("dashboard.workspace.email_invitation.form.confirm_password"), class: "f-semi-14 form-label"
              = password_field_tag :confirm_password, "", class: "f-reg-14 form-control", required: true
            .actions
              = f.submit t("dashboard.workspace.email_invitation.form.submit"), class: "f-semi-15 button", data: { action: "click->form-validation#validate" }


















