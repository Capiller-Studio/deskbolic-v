- description_length = identity_source.description.to_s.length
- response_mapping = identity_source.response_mapping || {}
- attribute_options = %w[first_name middle_name last_name name identifier external_id administration_url]

= form_with(model: identity_source, id: "identity-source-form", class: "ui-settings-form", data: { controller: "assignment-policy" }) do |f|
  - if identity_source.errors.any?
    .ap-error-summary
      h3 = t("dashboard.identity_sources.form.error_heading", count: identity_source.errors.count)
      ul
        - identity_source.errors.full_messages.each do |message|
          li = message

  .ap-section
    .ap-section-header
      span.ap-section-icon
        = image_tag("pencil_blue.svg", class: "ap-icon-svg", alt: "")
      span = t("dashboard.identity_sources.form.details_section")
    .ap-section-body.ap-policy-details-body
      .ap-policy-details-grid
        div
          label.f-semi-13.ap-label for="identity-source-name"
            = t("dashboard.identity_sources.form.name")
            span.ap-required-marker *
          .ui-field-control.ui-field-control--plain class=("ui-field-control--invalid" if identity_source.errors[:name].any?)
            = f.text_field :name, class: "ap-input ui-control ui-input", placeholder: t("dashboard.identity_sources.form.name_placeholder"), id: "identity-source-name", autocomplete: "off", required: true
          p.ap-hint = t("dashboard.identity_sources.form.name_hint", default: "Choose a clear and descriptive name for this skill.")
        div
          .ap-label-row
            label.f-semi-13.ap-label for="identity-source-description"
              = t("dashboard.identity_sources.form.description")
              span.ap-optional-label = t("dashboard.identity_sources.form.optional_label", default: "(Optional)")
            span.ap-character-counter data-assignment-policy-target="descriptionCounter" = "#{description_length} / 500"
          = f.text_area :description, class: "ap-input ap-textarea", rows: 4, maxlength: 500, placeholder: t("dashboard.identity_sources.form.description_placeholder"), id: "identity-source-description", data: { "assignment-policy-target": "descriptionInput", action: "input->assignment-policy#updateDescriptionCounter" }

  .ap-section
    .ap-section-header
      span.ap-section-icon
        = image_tag("chain_link.svg", class: "ap-icon-svg", alt: "")
      span = t("dashboard.identity_sources.form.source_section")
    .ap-section-body
      .ap-field-stack
        div
          label.f-semi-13.ap-label for="identity-source-source-type"
            = t("dashboard.identity_sources.form.source_type")
          .ui-field-control.ui-field-control--plain
            = f.select :source_type, IdentitySource.source_types.keys.map { |k| [k.titleize, k] }, { include_blank: t("dashboard.identity_sources.form.select_placeholder", default: "Select") }, class: "ui-select ui-control", id: "identity-source-source-type", data: { controller: "select" }
        div
          label.f-semi-13.ap-label for="identity-source-source-url"
            = t("dashboard.identity_sources.form.source_url")
            span.ap-required-marker *
          = f.text_field :source_url, class: "ap-input", required: true, placeholder: "sources.url.com{{ customer.email }}", id: "identity-source-source-url", data: { "key-value-builder-target": "valueInput", "action": "focus->key-value-builder#setFocus" }
          p.ap-hint = t("dashboard.identity_sources.form.liquid_help")

          .is-variables-picker
            span.is-variables-picker-label = t("dashboard.identity_sources.form.insert_variable")
            .is-variables-chips
              - ["{{ customer.email }}", "{{ customer.phone_number }}", "{{ customer.name }}"].each do |var|
                button.is-variable-chip type="button" data-action="mousedown->key-value-builder#preventFocus click->key-value-builder#insertVariable" data-variable=var = var

  .ap-section data-key-value-builder-section=true
    = render("dashboard/identity_sources/key_value_table",
        section_title: t("dashboard.identity_sources.form.headers"),
        section_icon: "document.svg",
        add_label: t("dashboard.identity_sources.form.add_header"),
        empty_title: t("dashboard.identity_sources.form.no_headers_title", default: "No headers added yet"),
        empty_desc: t("dashboard.identity_sources.form.no_headers_desc", default: "Add headers to include in your API request."),
        field_name: "identity_source[headers]",
        rows: identity_source.headers,
        key_placeholder: t("dashboard.identity_sources.form.key_placeholder"),
        value_placeholder: t("dashboard.identity_sources.form.value_placeholder"),
        value_list: nil,
        show_variables: true)

  .ap-section data-key-value-builder-section=true
    = render("dashboard/identity_sources/key_value_table",
        section_title: t("dashboard.identity_sources.form.params"),
        section_icon: "sliders.svg",
        add_label: t("dashboard.identity_sources.form.add_param"),
        empty_title: t("dashboard.identity_sources.form.no_params_title", default: "No parameters added yet"),
        empty_desc: t("dashboard.identity_sources.form.no_params_desc", default: "Add query parameters to include in your API request."),
        field_name: "identity_source[params]",
        rows: identity_source.params,
        key_placeholder: t("dashboard.identity_sources.form.key_placeholder"),
        value_placeholder: t("dashboard.identity_sources.form.value_placeholder"),
        value_list: nil,
        show_variables: true)

  .ap-section.is-overflow-card data-key-value-builder-section=true
    .is-section-header-row
      .ap-section-header
        span.ap-section-icon
          = image_tag("round_robbin.svg", class: "ap-icon-svg", alt: "")
        span = t("dashboard.identity_sources.form.response_mapping")
      button.is-section-add-btn type="button" data-action="click->key-value-builder#addRow"
        = inline_svg_tag("plus_white.svg", class: "is-section-add-btn-icon", aria: { hidden: true })
        span = t("dashboard.identity_sources.form.add_mapping")
    .ap-section-body
      p.ap-hint.ap-card-hint = t("dashboard.identity_sources.form.response_mapping_desc")
      .is-kv-table class=("is-kv-table--hidden" unless response_mapping.any?)
        .is-kv-table-header
          span = t("dashboard.identity_sources.form.key_column", default: "Key")
          span = t("dashboard.identity_sources.form.value_column", default: "Value")
          span = t("dashboard.identity_sources.form.actions_column", default: "Actions")
        .is-kv-table-body data-key-value-builder-target="container"
          - if response_mapping.any?
            - response_mapping.each_with_index do |(k, v), index|
              .is-kv-row
                = text_field_tag "identity_source[response_mapping][#{index}][key]", k, class: "ap-input", placeholder: t("dashboard.identity_sources.form.json_path_placeholder"), data: { "key-value-builder-target": "valueInput", "action": "focus->key-value-builder#setFocus" }
                .ui-field-control.ui-field-control--plain.ui-field-control--compact
                  = select_tag "identity_source[response_mapping][#{index}][value]", options_for_select((attribute_options | [v].compact.reject(&:blank?)), v), include_blank: t("dashboard.identity_sources.form.select_placeholder", default: "Select"), class: "ui-select ui-control", data: { controller: "select" }
                .is-kv-row-actions
                  button.is-kv-remove-btn type="button" data-action="click->key-value-builder#removeRow" aria-label=t("dashboard.identity_sources.form.remove_row", default: "Remove row") &times;

      .is-kv-empty class=("is-kv-empty--hidden" if response_mapping.any?)
        = image_tag("box.svg", class: "is-kv-empty-icon", alt: "", aria: { hidden: true })
        strong = t("dashboard.identity_sources.form.no_mappings_title", default: "No mappings added yet")
        p = t("dashboard.identity_sources.form.no_mappings_desc", default: "Map JSON response paths to Deskbolic customer attributes.")

      template data-key-value-builder-target="template"
        .is-kv-row
          = text_field_tag "identity_source[response_mapping][NEW_RECORD][key]", nil, class: "ap-input", placeholder: t("dashboard.identity_sources.form.json_path_placeholder"), data: { "key-value-builder-target": "valueInput", "action": "focus->key-value-builder#setFocus" }
          .ui-field-control.ui-field-control--plain.ui-field-control--compact
            = select_tag "identity_source[response_mapping][NEW_RECORD][value]", options_for_select(attribute_options), include_blank: t("dashboard.identity_sources.form.select_placeholder", default: "Select"), class: "ui-select ui-control", data: { controller: "select" }
          .is-kv-row-actions
            button.is-kv-remove-btn type="button" data-action="click->key-value-builder#removeRow" aria-label=t("dashboard.identity_sources.form.remove_row", default: "Remove row") &times;

      .is-variables-picker
        span.is-variables-picker-label = t("dashboard.identity_sources.form.insert_variable")
        .is-variables-chips
          - ["{{ customer.email }}", "{{ customer.phone_number }}", "{{ customer.name }}"].each do |var|
            button.is-variable-chip type="button" data-action="mousedown->key-value-builder#preventFocus click->key-value-builder#insertVariable" data-variable=var = var

  .ap-test-result data-key-value-builder-target="testResult" style="margin-top: 16px; display: none;"
