- url = contact_form_channel.persisted? ? channels_contact_form_path(contact_form_channel) : channels_contact_form_index_path
- method = contact_form_channel.persisted? ? :patch : :post

= form_with(model: contact_form_channel, scope: :contact_form_channel, url: url, method: method, data: { controller: "contact-form-channel" }) do |f|
  - if contact_form_channel.errors.any?
    .ui-error-summary
      h3 = t("dashboard.contact_form_channels.form.error_heading")
      ul
        - contact_form_channel.errors.full_messages.each do |message|
          li = message

  / ─── Basic Details & Inbox ───
  .ui-section.ui-section--always-open
    .ui-section-header
      .ui-section-title
        span.ui-section-icon 📝
        span.ui-section-label = t("dashboard.contact_form_channels.form.basic_section")
    .ui-section-body
      .ui-form-row
        div
          = f.label :name, t("dashboard.contact_form_channels.form.name_label"), class: "ui-label"
          = f.text_field :name, class: "ui-input", required: true, placeholder: t("dashboard.contact_form_channels.form.name_placeholder")
        div
          = f.label :submit_redirect_url, t("dashboard.contact_form_channels.form.redirect_url_label"), class: "ui-label"
          = f.url_field :submit_redirect_url, class: "ui-input", placeholder: t("dashboard.contact_form_channels.form.redirect_url_placeholder"), pattern: "https?://.+", title: t("dashboard.channels.contact_form.form.valid_url_hint")

      .ui-form-row style="margin-top: 16px;"
        div
          = f.label :outbound_channel_id, t("forms.labels.outbound_channel"), class: "ui-label"
          p.text-muted style="font-size: 12px; margin-bottom: 4px;" Select an Email Channel to send replies from.
          = f.collection_select :outbound_channel_id, @email_channels, :id, :name, { include_blank: t("forms.options.select_email_channel") }, class: "ui-select"
          = f.hidden_field :outbound_channel_type, value: "Channel::Email"
        div

      - if contact_form_channel.primary_inbox
        .ui-section style="margin-top: 24px; padding: 16px; background: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0; margin-bottom: 0;"
          h3.f-semi-16 style="margin-bottom: 8px;" Inbox Settings
          p.f-reg-14.text-muted style="margin-bottom: 16px;" Configure SLA policies and custom reply templates for submissions.
          
          = f.fields_for :primary_inbox do |inbox_f|
            .ui-toggle-row style="margin-bottom: 16px; display: flex; gap: 24px;"
              div style="display: flex; align-items: center; gap: 8px;"
                span.ui-toggle-label = t("ui.dashboard.channels.contact_form.form.auto_assign_conversations")
                label.ui-toggle
                  = inbox_f.check_box :auto_assign
                  span.ui-toggle-slider
              div style="display: flex; align-items: center; gap: 8px;"
                span.ui-toggle-label = t("ui.dashboard.channels.contact_form.form.enable_csat_survey")
                label.ui-toggle
                  = inbox_f.check_box :csat_survey_enabled
                  span.ui-toggle-slider
            
            .ui-form-row
              div
                = inbox_f.label :conversation_reply_template_id, t("forms.labels.custom_reply_template"), class: "ui-label"
                = inbox_f.collection_select :conversation_reply_template_id, current_account.email_templates, :id, :name, { include_blank: t("forms.options.default_mailer_view") }, class: "ui-select"
              div
                = inbox_f.label :business_hour_group_id, t("forms.labels.business_hours"), class: "ui-label"
                = inbox_f.collection_select :business_hour_group_id, current_account.business_hour_groups, :id, :name, { include_blank: t("forms.options.always_online_24_7") }, class: "ui-select"
            
            .ui-form-row style="margin-top: 16px;"
              div
                = inbox_f.label :sla_policy_ids, t("forms.labels.sla_policies"), class: "ui-label"
                = inbox_f.collection_select :sla_policy_ids, current_account.sla_policies, :id, :name, {}, { multiple: true, class: "ui-select" }
              div
                = inbox_f.label :csat_survey_id, t("forms.labels.csat_survey"), class: "ui-label"
                = inbox_f.collection_select :csat_survey_id, @csat_surveys, :id, :name, { include_blank: t("forms.options.default_survey") }, class: "ui-select"

  / ─── Appearance & Branding ───
  .ui-section data-contact-form-channel-target="appearanceSection"
    .ui-section-header data-action="click->contact-form-channel#toggleSection"
      .ui-section-title
        span.ui-section-icon 🎨
        span.ui-section-label = t("dashboard.contact_form_channels.form.appearance_section")
      span.ui-section-chevron ▼
    .ui-section-body
      .ui-form-row
        div
          label.ui-label = t("dashboard.contact_form_channels.form.theme_color_label")
          .ww-color-picker-row
            = color_field_tag "contact_form_channel[ui_configurations][theme_color]", contact_form_channel.ui_configurations&.dig("theme_color") || "#0f172a", class: "ww-color-swatch", data: { "contact-form-channel-target": "colorSwatch", "action": "input->contact-form-channel#syncColor" }
            = text_field_tag "contact_form_channel[ui_configurations][theme_color]", contact_form_channel.ui_configurations&.dig("theme_color") || "#0f172a", class: "ui-input", style: "flex: 1;", data: { "contact-form-channel-target": "colorInput", "action": "input->contact-form-channel#syncSwatch" }
        div
          label.ui-label = t("dashboard.contact_form_channels.form.position_label")
          = select_tag "contact_form_channel[ui_configurations][position]", options_for_select([[t("forms.options.left_aligned"), "left"], [t("forms.options.center_aligned"), "center"], [t("forms.options.right_aligned"), "right"]], contact_form_channel.ui_configurations&.dig("position") || "left"), class: "ui-select"

  / ─── Custom Fields Builder ───
  .ui-section data-contact-form-channel-target="integrationsSection"
    .ui-section-header data-action="click->contact-form-channel#toggleSection"
      .ui-section-title
        span.ui-section-icon 📋
        span.ui-section-label = t("dashboard.contact_form_channels.form.fields_section")
      span.ui-section-chevron ▼
    .ui-section-body data-controller="custom-field-builder"
      p.f-reg-14.text-muted style="margin-bottom: 16px;" Select and drag-and-drop the custom fields you want to display on this contact form.
      
      div data-controller="sortable" data-sortable-handle-value=".drag-handle" class="cf-sortable-list" data-custom-field-builder-target="list"
        - if contact_form_channel.custom_field_resources.any?
          - contact_form_channel.custom_field_resources.order(position: :asc).each do |resource|
            - field = resource.custom_field
            .sortable-item.cf-sortable-item data-sortable-target="item" data-id="#{field.id}" draggable="true" data-action="dragstart->sortable#dragStart dragend->sortable#dragEnd"
              span.drag-handle.cf-drag-handle data-sortable-target="handle" ☰
              div.cf-item-content
                h4.f-semi-14 = field.key.titleize
                p.f-reg-12.text-muted 
                  - if field.mapped_to.present?
                    = t("dashboard.contact_form_channels.form.mapped_to", mapped_to: field.mapped_to)
                  - else
                    = t("dashboard.contact_form_channels.form.entity_field", entity_type: field.entity_type.titleize)
              
              .cf-resource-config
                label.cf-resource-checkbox
                  = check_box_tag "contact_form_channel[field_settings][#{field.id}][required_override]", "1", resource.required_override, class: "cf-resource-checkbox-input"
                  = t("dashboard.contact_form_channels.form.required_label")
                = select_tag "contact_form_channel[field_settings][#{field.id}][width]", options_for_select([[t("dashboard.contact_form_channels.form.full_width"), "full"], [t("dashboard.contact_form_channels.form.half_width"), "half"]], resource.configurations["width"]), class: "ui-select cf-resource-select"

              span.ui-badge.ui-badge--secondary.cf-item-badge = field.entity_type.titleize
              button.ui-action-delete type="button" data-action="click->custom-field-builder#removeField"
                svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
                  path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"
              = hidden_field_tag "contact_form_channel[ordered_fields][]", field.id, data: { custom_field_builder_target: "hiddenInput" }

      .cf-add-field-row data-custom-field-builder-target="addButtonRow"
        button.ui-btn-secondary.cf-add-field-btn type="button" data-action="click->custom-field-builder#openModal"
          svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
            path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"
          | #{t("ui.dashboard.channels.contact_form.form.add_field")}

      .cf-modal-overlay data-custom-field-builder-target="modal" style="display: none;"
        .cf-modal-backdrop data-action="click->custom-field-builder#closeModal"
        .cf-modal-content
          .cf-modal-header
            h3.f-semi-16 = t("ui.dashboard.channels.contact_form.form.add_custom_field")
            button.cf-modal-close type="button" data-action="click->custom-field-builder#closeModal" &times;
          .cf-modal-search
            input.ui-input type="text" placeholder=t("dashboard.contact_form_channels.form.search_fields") data-custom-field-builder-target="searchInput" data-action="input->custom-field-builder#filterFields"
          .cf-modal-body data-custom-field-builder-target="pool"
            - unselected_fields = @available_custom_fields.where.not(id: contact_form_channel.custom_field_ids)
            - unselected_fields.each do |field|
              .sortable-item.cf-sortable-item data-sortable-target="item" data-id="#{field.id}" data-searchable="#{field.key.downcase} #{field.entity_type.downcase}" draggable="true" data-action="dragstart->sortable#dragStart dragend->sortable#dragEnd click->custom-field-builder#addFieldFromModal"
                span.drag-handle.cf-drag-handle data-sortable-target="handle" ☰
                div.cf-item-content
                  h4.f-semi-14 = field.key.titleize
                  p.f-reg-12.text-muted 
                    - if field.mapped_to.present?
                      = t("dashboard.contact_form_channels.form.mapped_to", mapped_to: field.mapped_to)
                    - else
                      = t("dashboard.contact_form_channels.form.#{field.entity_type}_field")
                
                .cf-resource-config
                  label.cf-resource-checkbox
                    = check_box_tag "contact_form_channel[field_settings][#{field.id}][required_override]", "1", false, class: "cf-resource-checkbox-input"
                    = t("dashboard.contact_form_channels.form.required_label")
                  = select_tag "contact_form_channel[field_settings][#{field.id}][width]", options_for_select([[t("dashboard.contact_form_channels.form.full_width"), "full"], [t("dashboard.contact_form_channels.form.half_width"), "half"]], "full"), class: "ui-select cf-resource-select"

                span.ui-badge.ui-badge--secondary.cf-item-badge = field.entity_type.titleize
                button.ui-action-delete type="button" data-action="click->custom-field-builder#removeField"
                  svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
                    path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"
                = hidden_field_tag "contact_form_channel[ordered_fields][]", field.id, disabled: true, data: { custom_field_builder_target: "hiddenInput" }

  / ─── Behaviors & Spam Protection ───
  .ui-section data-contact-form-channel-target="behaviorsSection"
    .ui-section-header data-action="click->contact-form-channel#toggleSection"
      .ui-section-title
        span.ui-section-icon ⚙️
        span.ui-section-label = t("dashboard.contact_form_channels.form.behaviors_section")
      span.ui-section-chevron ▼
    .ui-section-body
      .ui-toggle-row style="margin-bottom: 12px;"
        span.ui-toggle-label = t("dashboard.contact_form_channels.form.require_login_label")
        label.ui-toggle
          = f.check_box :require_login
          span.ui-toggle-slider

      .ui-toggle-row style="margin-bottom: 12px;"
        span.ui-toggle-label = t("dashboard.contact_form_channels.form.allow_attachments_label")
        label.ui-toggle
          = f.check_box :allow_attachments
          span.ui-toggle-slider
          
      .ui-toggle-row style="margin-bottom: 12px;"
        span.ui-toggle-label = t("dashboard.contact_form_channels.form.send_confirmation_email_label")
        label.ui-toggle
          = f.check_box :send_confirmation_email
          span.ui-toggle-slider
          
      .ui-toggle-row style="margin-bottom: 24px;"
        span.ui-toggle-label = t("dashboard.contact_form_channels.form.spam_protection_enabled_label")
        label.ui-toggle
          = f.check_box :spam_protection_enabled
          span.ui-toggle-slider


  / ─── Translations ───
  .ui-section data-contact-form-channel-target="translationsSection"
    .ui-section-header data-action="click->contact-form-channel#toggleSection"
      .ui-section-title
        span.ui-section-icon 🌐
        span.ui-section-label = t("ui.dashboard.channels.contact_form.form.translations")
      span.ui-section-chevron ▼
    .ui-section-body data-controller="nested-translations"
      p.text-muted style="margin-bottom: 16px; font-size: 13px;" Provide localized strings for your contact form. These override the default locale based on the customer's browser.
      
      .ww-translations-container data-nested-translations-target="container"
        = f.fields_for :translations do |tf|
          = render "dashboard/channels/contact_form/translation_fields", f: tf

      template data-nested-translations-target="template"
        = f.fields_for :translations, Channel::ContactFormTranslation.new, child_index: 'NEW_RECORD' do |tf|
          = render "dashboard/channels/contact_form/translation_fields", f: tf
      
      - current_locales = contact_form_channel.translations.reject(&:marked_for_destruction?).map(&:locale).map(&:to_s)
      - available_locales = Core::SUPPORTED_LOCALES.map(&:to_s) - current_locales
      - available_locales_options = available_locales.map { |l| [I18n.t("languages.#{l.downcase}"), l] }
      
      .ww-add-locale-wrapper style="margin-top: 16px; display: flex; gap: 8px; align-items: center;"
        = select_tag "new_locale", options_for_select(available_locales_options), include_blank: t("forms.options.select_language"), class: "ui-select", data: { "nested-translations-target": "localeSelect" }, style: "width: 200px;"
        button.ui-btn-secondary type="button" data-action="click->nested-translations#addTranslation" style="display: inline-flex; align-items: center; gap: 6px;" 
          span +
          | #{t("ui.dashboard.channels.contact_form.form.add_language")}

  / ─── Form Actions ───
  .ui-form-actions style="margin-top: 24px;"
    - if contact_form_channel.persisted?
      = f.submit t("dashboard.contact_form_channels.form.update"), class: "ui-btn-primary"
    - else
      = f.submit t("dashboard.contact_form_channels.form.save"), class: "ui-btn-primary"
    = link_to t("dashboard.contact_form_channels.form.cancel"), channels_contact_form_index_path, class: "ui-btn-secondary"
