= form_with(model: custom_field, local: true, class: "settings-form form-fields") do |f|
  .card.form-card.cf-card
    .form-section.cf-section
      h3.f-semi-18.cf-section-title Basic Configuration
      
      .cf-grid
        .form-group
          = f.label :key, "Field Key", class: "cf-label"
          = f.text_field :key, class: "cf-input", placeholder: "e.g. company_size", disabled: custom_field.persisted?
          p.f-reg-12.text-muted.cf-hint-text The unique identifier for this field.

        .form-group
          = f.label :entity_type, "Belongs To", class: "cf-label"
          = f.select :entity_type, CustomField.entity_types.keys.map { |k| [k.titleize, k] }, {}, class: "cf-select"

        .form-group style="grid-column: span 2;"
          = f.label :field_type, "Input Type", class: "cf-label"
          = f.select :field_type, CustomField.field_types.keys.map { |k| [k.titleize, k] }, {}, class: "cf-select cf-half-select", id: "custom_field_field_type_select", data: { action: "change->custom-field-options#checkFieldType" }

    / Localized Content with Tabs
    .form-section.cf-section
      h3.f-semi-18.cf-section-title Localized Content
      
      .cf-tabs-container data-controller="locale-tabs"
        .cf-tabs-header
          - ["en", "fr", "es", "de"].each_with_index do |locale, idx|
            button type="button" class="cf-tab-link #{idx == 0 ? 'active' : ''}" data-locale-tabs-target="tab" data-locale="#{locale}" data-action="click->locale-tabs#switch"
              = locale.upcase

        .cf-tabs-content
          - ["en", "fr", "es", "de"].each_with_index do |locale, idx|
            .cf-tab-panel class="#{idx == 0 ? '' : 'cf-hidden'}" data-locale-tabs-target="panel" data-locale="#{locale}"
              - translation = custom_field.translations.detect { |t| t.locale.to_s == locale } || custom_field.translations.build(locale: locale)
              = f.fields_for :translations, translation do |tf|
                = tf.hidden_field :locale, value: locale
                - trans_idx = tf.index
                
                .cf-grid
                  .form-group
                    = tf.label :label, "Field Label (#{locale.upcase})", class: "cf-label"
                    = tf.text_field :label, class: "cf-input", placeholder: "e.g. Company Size"

                  .form-group
                    = tf.label :placeholder, "Placeholder (#{locale.upcase})", class: "cf-label"
                    = tf.text_field :placeholder, class: "cf-input", placeholder: "e.g. 1-10 employees"

                / Options Management (Stimulus handles visibility)
                .cf-options-section data-controller="custom-field-options" class="cf-hidden"
                  .cf-options-header
                    h4.f-semi-14.cf-options-title Dropdown Options
                    button type="button" data-action="click->custom-field-options#addOption" class="cf-btn-secondary cf-btn-small"
                      | + Add Option

                  .options-container data-custom-field-options-target="container"
                    - (tf.object.options || []).each_with_index do |opt, opt_idx|
                      .cf-option-row
                        = text_field_tag "custom_field[translations_attributes][#{trans_idx}][options][#{opt_idx}][value]", opt["value"], placeholder: "Value", class: "cf-input"
                        = text_field_tag "custom_field[translations_attributes][#{trans_idx}][options][#{opt_idx}][label]", opt["label"], placeholder: "Label", class: "cf-input"
                        button type="button" data-action="click->custom-field-options#removeOption" class="cf-btn-icon"
                          = inline_svg_tag("trash.svg", class: "cf-icon-18")

                  template data-custom-field-options-target="template"
                    .cf-option-row
                      = text_field_tag "custom_field[translations_attributes][#{trans_idx}][options][NEW_RECORD][value]", nil, placeholder: "Value", class: "cf-input"
                      = text_field_tag "custom_field[translations_attributes][#{trans_idx}][options][NEW_RECORD][label]", nil, placeholder: "Label", class: "cf-input"
                      button type="button" data-action="click->custom-field-options#removeOption" class="cf-btn-icon"
                        = inline_svg_tag("trash.svg", class: "cf-icon-18")

    / Validations & Advanced Config
    .form-section.cf-section
      h3.f-semi-18.cf-section-title Validations & Rules
      
      .cf-grid-3
        .form-group
          = f.label :validations_min_length, "Min Length", class: "cf-label"
          = text_field_tag "custom_field[validations][min_length]", custom_field.validations["min_length"], class: "cf-input", type: "number"
        
        .form-group
          = f.label :validations_max_length, "Max Length", class: "cf-label"
          = text_field_tag "custom_field[validations][max_length]", custom_field.validations["max_length"], class: "cf-input", type: "number"

        .form-group
          = f.label :validations_pattern, "Regex Pattern", class: "cf-label"
          = text_field_tag "custom_field[validations][pattern]", custom_field.validations["pattern"], class: "cf-input", placeholder: "^[A-Z]"

    .cf-actions
      = link_to "Cancel", custom_fields_path, class: "cf-btn-secondary"
      = f.submit "Save Custom Field", class: "cf-btn-primary"
