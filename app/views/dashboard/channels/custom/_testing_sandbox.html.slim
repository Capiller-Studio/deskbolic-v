section.channel-edit-side-card.channel-edit-card data-controller="test-webhook" data-test-webhook-outgoing-url-value=test_outgoing_webhook_channels_custom_path(id: custom_channel.id) data-test-webhook-incoming-url-value=test_incoming_webhook_channels_custom_path(id: custom_channel.id)
  h2 = t("dashboard.channels.edit.testing_tools", default: "Testing Tools")
  p = t("dashboard.channels.edit.testing_tools_hint", default: "Use these tools to verify that your Outbound Webhook URL is receiving payloads correctly.")

  .channel-edit-test-tool
    h3 = t("dashboard.custom_channels.testing.test_outbound")
    p = t("ui.dashboard.channels.custom.testing_sandbox.sends_a_mock_message_created_payload_to_your_configured_webhook")
    input.channel-edit-test-input type="text" value=custom_channel.webhook_url readonly=true
    button.channel-edit-test-button type="button" data-action="click->test-webhook#fireOutbound" data-test-webhook-target="outboundBtn"
      | ⚡ #{t("dashboard.custom_channels.testing.fire_outbound")}
    .channel-edit-test-result data-test-webhook-target="outboundResult"
      .channel-edit-test-result__label
        span = t("dashboard.custom_channels.testing.response")
        span.channel-edit-test-status data-test-webhook-target="outboundStatus"
      pre
        code data-test-webhook-target="outboundBody" = t("dashboard.channels.edit.no_response", default: "No response yet")

  .channel-edit-test-divider

  .channel-edit-test-tool
    h3 = t("dashboard.custom_channels.testing.test_inbound")
    p = t("ui.dashboard.channels.custom.testing_sandbox.paste_a_sample_json_payload_that_your_server_would_send")
    textarea.channel-edit-code-input rows="6" data-test-webhook-target="inboundInput" = JSON.pretty_generate(data: { user: { id: "123" } })
    button.channel-edit-test-button type="button" data-action="click->test-webhook#testInbound" data-test-webhook-target="inboundBtn"
      | → #{t("dashboard.custom_channels.testing.test_mapping")}
    .channel-edit-test-result data-test-webhook-target="inboundResult"
      span = t("dashboard.custom_channels.testing.mapped_attributes")
      pre
        code data-test-webhook-target="inboundMapped" = t("dashboard.channels.edit.no_mapping", default: "No mapping defined yet")
