= form_with(model: custom_channel, url: channels_custom_path(custom_channel), data: { controller: "key-value-builder" }) do |f|
  - if custom_channel.errors.any?
    .ui-error-summary
      h3 = t("dashboard.custom_channels.form.error_heading", count: custom_channel.errors.count)
      ul
        - custom_channel.errors.full_messages.each do |message|
          li = message

  .ui-section.ui-section--always-open
    .ui-section-header
      .ui-section-title
        span.ui-section-icon 📝
        span.ui-section-label = t("dashboard.custom_channels.form.details_section")
    .ui-section-body
      .ui-form-row-col
        div
          = f.label :name, t("dashboard.custom_channels.form.name"), class: "ui-label"
          = f.text_field :name, class: "ui-input", required: true
        
        div
          = f.label :description, t("dashboard.custom_channels.form.description"), class: "ui-label"
          = f.text_area :description, class: "ui-input", rows: 3

      - if custom_channel.primary_inbox
        .ui-section.ui-section--always-open.ui-section-inbox
          h3.f-semi-16.ui-inbox-heading = t("dashboard.custom_channels.form.inbox_settings")
          p.f-reg-14.text-muted.ui-inbox-desc = t("dashboard.custom_channels.form.inbox_desc")
          
          = f.fields_for :primary_inbox do |inbox_f|
            .ui-toggle-row style="margin-bottom: 16px;"
              span.ui-toggle-label = t("dashboard.custom_channels.form.enable_csat")
              label.ui-toggle
                = inbox_f.check_box :csat_survey_enabled
                span.ui-toggle-slider
            
            .ui-form-row
              div class="ui-kv-key"
                = inbox_f.label :csat_survey_id, t("dashboard.custom_channels.form.csat_survey"), class: "ui-label"
                = inbox_f.collection_select :csat_survey_id, current_account.csat_surveys, :id, :name, { include_blank: t("dashboard.custom_channels.form.csat_default") }, class: "ui-select"
              div class="ui-kv-key"

              div
                = inbox_f.label :conversation_reply_template_id, t("forms.labels.custom_reply_template"), class: "ui-label"
                = inbox_f.collection_select :conversation_reply_template_id, current_account.email_templates, :id, :name, { include_blank: t("forms.options.default_email_view") }, class: "ui-select"
            
            .ui-form-row
              div
                = inbox_f.label :business_hour_group_id, t("forms.labels.business_hours"), class: "ui-label"
                = inbox_f.collection_select :business_hour_group_id, current_account.business_hour_groups, :id, :name, { include_blank: t("forms.options.always_online_24_7") }, class: "ui-select"

              div
                = inbox_f.label :sla_policy_ids, t("dashboard.custom_channels.form.sla_policies"), class: "ui-label"
                = inbox_f.collection_select :sla_policy_ids, current_account.sla_policies, :id, :name, {}, { multiple: true, class: "ui-select" }

  .ui-section data-controller="ui-section"
    .ui-section-header data-action="click->ui-section#toggle"
      .ui-section-title
        span.ui-section-icon 🚀
        span.ui-section-label = t("dashboard.custom_channels.form.outbound_section")
    .ui-section-body
      p.f-reg-14 style="color: #64748b; margin-bottom: 16px;" = t("dashboard.custom_channels.form.outbound_desc")
      
      .ui-form-row-col
        div
          = f.label :webhook_url, t("dashboard.custom_channels.form.webhook_url"), class: "ui-label"
          = f.url_field :webhook_url, class: "ui-input", required: true, placeholder: "https://api.example.com/webhooks/deskbolic"

        div
          = f.label :headers, t("dashboard.custom_channels.form.headers"), class: "ui-label"
          p.f-reg-12 style="color: #64748b; margin-bottom: 8px;" = t("dashboard.custom_channels.form.headers_help")
          
          .ui-kv-builder data-key-value-builder-target="container"
            - custom_channel.headers.each_with_index do |(k, v), index|
              .kv-row class="ui-kv-row"
                = text_field_tag "channel_custom[headers][#{index}][key]", k, class: "ui-input", placeholder: t("dashboard.custom_channels.form.header_name_placeholder"), style: "flex: 1;"
                = text_field_tag "channel_custom[headers][#{index}][value]", v, class: "ui-input", placeholder: t("dashboard.custom_channels.form.header_value_placeholder"), style: "flex: 2;"
                button.ui-btn-secondary type="button" data-action="click->key-value-builder#removeRow" class="ui-kv-remove" &times;
          
          template data-key-value-builder-target="template"
            .kv-row class="ui-kv-row"
              = text_field_tag "channel_custom[headers][NEW_RECORD][key]", nil, class: "ui-input", placeholder: t("dashboard.custom_channels.form.header_name_placeholder"), style: "flex: 1;"
              = text_field_tag "channel_custom[headers][NEW_RECORD][value]", nil, class: "ui-input", placeholder: t("dashboard.custom_channels.form.header_value_placeholder"), style: "flex: 2;"
              button.ui-btn-secondary type="button" data-action="click->key-value-builder#removeRow" class="ui-kv-remove" &times;
          
          button.ui-btn-secondary type="button" data-action="click->key-value-builder#addRow" = t("dashboard.custom_channels.form.add_header")

  .ui-section data-controller="ui-section"
    .ui-section-header data-action="click->ui-section#toggle"
      .ui-section-title
        span.ui-section-icon 📥
        span.ui-section-label = t("dashboard.custom_channels.form.inbound_section")
    .ui-section-body
      p.f-reg-14 style="color: #64748b; margin-bottom: 16px;" = t("dashboard.custom_channels.form.inbound_desc")
      
      datalist id="deskbolic-custom-attributes"
        option value="identifier"
        option value="name"
        option value="email"
        option value="phone_number"
      .ui-kv-builder data-key-value-builder-target="container"
        - custom_channel.response_mapping.each_with_index do |(k, v), index|
          .kv-row class="ui-kv-row"
            = select_tag "channel_custom[response_mapping][#{index}][key]", grouped_options_for_select(custom_channel_response_mapping_options(current_account), k), class: "ui-select", style: "flex: 1;", prompt: t("forms.options.select_deskbolic_attribute")
            = text_field_tag "channel_custom[response_mapping][#{index}][value]", v, class: "ui-input", placeholder: t("ui.dashboard.channels.custom.form.json_path_e_g_data_user_id"), style: "flex: 2;"
            button.ui-btn-secondary type="button" data-action="click->key-value-builder#removeRow" class="ui-kv-remove" &times;
      
      template data-key-value-builder-target="template"
        .kv-row class="ui-kv-row"
          = select_tag "channel_custom[response_mapping][NEW_RECORD][key]", grouped_options_for_select(custom_channel_response_mapping_options(current_account)), class: "ui-select", style: "flex: 1;", prompt: t("forms.options.select_deskbolic_attribute")
          = text_field_tag "channel_custom[response_mapping][NEW_RECORD][value]", nil, class: "ui-input", placeholder: t("ui.dashboard.channels.custom.form.json_path_e_g_data_user_id"), style: "flex: 2;"
          button.ui-btn-secondary type="button" data-action="click->key-value-builder#removeRow" class="ui-kv-remove" &times;
      
      button.ui-btn-secondary type="button" data-action="click->key-value-builder#addRow" = t("dashboard.custom_channels.form.add_mapping")

  - if custom_channel.persisted?
    = render "testing_sandbox", custom_channel: custom_channel

  .ui-form-actions 
    = f.submit t("dashboard.custom_channels.form.save"), class: "ui-btn-primary"
