= turbo_frame_tag "note_#{note.id}" do
  .note-edit
    .f-reg-12 = note.content
    = link_to edit_note_path(note), data: { turbo_frame: "response_#{note.id}" }, class: "note-edit__button", aria: { label: t("dashboard.notes.edit", default: "Edit note") } do
      = image_tag("edit_note.png", class: "note-edit__icon", alt: "")
