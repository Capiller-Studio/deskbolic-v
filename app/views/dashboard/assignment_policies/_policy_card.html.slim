- strategy_class = "ui-policy-badge--#{policy.strategy.dasherize}"
- toggle_label = policy.active? ? t("general.deactivate") : t("general.activate")

div id="policy_#{policy.id}" class="ui-policy-card #{policy.active? ? '' : 'inactive'}" data-sortable-target="item" data-id="#{policy.id}" draggable="true"
  .ui-policy-drag-handle data-action="dragstart->sortable#dragStart dragend->sortable#dragEnd" data-sortable-target="handle"
    | ⠿

  .ui-policy-card-info
    .ui-policy-card-name = policy.name
    .ui-policy-card-meta
      span class="ui-policy-badge #{strategy_class}"
        = t("dashboard.assignment_policies.strategies.#{policy.strategy}")

      - if policy.description.present?
        span.ui-policy-card-detail — #{truncate(policy.description, length: 60)}

      - if policy.max_conversations_per_agent.present?
        span.ui-policy-card-detail = t("dashboard.assignment_policies.max_per_agent", count: policy.max_conversations_per_agent)

      - if policy.respect_business_hours?
        span.ui-policy-card-detail = t("ui.dashboard.assignment_policies.policy_card.business_hours")

      - if policy.reassign_on_offline?
        span.ui-policy-card-detail = t("ui.dashboard.assignment_policies.policy_card.auto_reassign")

      - if policy.prioritize_by_conversation_priority?
        span.ui-policy-card-detail = t("ui.dashboard.assignment_policies.policy_card.priority_routing")

      - inbox_count = policy.inboxes.size
      - if inbox_count > 0
        span.ui-policy-card-detail = t("dashboard.assignment_policies.inboxes", count: inbox_count)

  .ui-policy-card-actions
    = button_to toggle_assignment_policy_path(policy), method: :patch, class: "ui-policy-toggle #{policy.active? ? 'active' : ''}", title: toggle_label, aria: { label: toggle_label }, data: { turbo_frame: "_top" } do
      / The switch is drawn with CSS.

    = link_to edit_assignment_policy_path(policy), class: "ui-policy-action", title: t("dashboard.skills.index.edit")
      | ✎

    = button_to assignment_policy_path(policy), method: :delete, class: "ui-policy-action danger", title: t("dashboard.skills.index.delete"), data: { turbo_confirm: t("ui.dashboard.assignment_policies.policy_card.are_you_sure_you_want_to_delete_this_policy") }
      | ✕
