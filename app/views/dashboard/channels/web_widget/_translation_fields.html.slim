- locale = f.object.locale.to_s
- active = local_assigns.fetch(:active, false)

.ww-translation-card.ui-locale-panel class=(active ? nil : "cf-hidden") data-locale=locale data-locale-tabs-target="panel"
  = f.hidden_field :locale
  = f.hidden_field :_destroy, class: "destroy-flag"

  - unless locale == I18n.default_locale.to_s
    .ui-locale-panel__header
      strong.translation-language-name = locale.present? ? I18n.t("languages.#{locale.downcase}", default: locale.upcase) : ""
      button.ui-action-delete type="button" data-action="click->nested-translations#removeTranslation" title=t("general.remove_translation")
        = inline_svg_tag("cross_clear.svg", aria: { hidden: true })

  .ww-form-row
    div
      = f.label :welcome_title, t("dashboard.web_widget_channels.form.welcome_title_label"), class: "ww-label"
      = f.text_field :welcome_title, class: "ww-input", placeholder: t('dashboard.web_widget_channels.translations.eg_welcome_title')
    div
      = f.label :welcome_tagline, t("dashboard.web_widget_channels.form.welcome_tagline_label"), class: "ww-label"
      = f.text_field :welcome_tagline, class: "ww-input", placeholder: t('dashboard.web_widget_channels.translations.eg_welcome_tagline')

  .ww-form-row
    div
      = f.label :launcher_text, t("ui.dashboard.channels.web_widget.translation_fields.launcher_text"), class: "ww-label"
      = f.text_field :launcher_text, class: "ww-input", placeholder: t('dashboard.web_widget_channels.translations.eg_launcher_text')
    div
      = f.label :reply_time_text, t("ui.dashboard.channels.web_widget.translation_fields.reply_time_text"), class: "ww-label"
      = f.text_field :reply_time_text, class: "ww-input", placeholder: t('dashboard.web_widget_channels.translations.eg_reply_time_text')

  .ww-form-row
    div
      = f.label :pre_chat_title, t("ui.dashboard.channels.web_widget.translation_fields.pre_chat_title"), class: "ww-label"
      = f.text_field :pre_chat_title, class: "ww-input", placeholder: t('dashboard.web_widget_channels.translations.eg_pre_chat_title')
    div
      = f.label :pre_chat_subtitle, t("ui.dashboard.channels.web_widget.translation_fields.pre_chat_subtitle"), class: "ww-label"
      = f.text_field :pre_chat_subtitle, class: "ww-input", placeholder: t('dashboard.web_widget_channels.translations.eg_pre_chat_subtitle')