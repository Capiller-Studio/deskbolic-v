.ww-translation-card
  .ww-translation-header
    div
      span.ww-translation-locale = I18n.t("languages.#{f.object.locale.to_s.downcase}")
      = f.hidden_field :locale
    button.ww-action-delete type="button" data-action="click->nested-translations#removeTranslation" title=t("general.remove_translation")
      svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
        path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"
    = f.hidden_field :_destroy, class: "destroy-flag"

  .ww-form-row
    div
      = f.label :title, t("forms.labels.form_title"), class: "ww-label"
      = f.text_field :title, class: "ww-input", placeholder: t("ui.dashboard.channels.contact_form.translation_fields.e_g_contact_support")
    div
      = f.label :subtitle, t("forms.labels.form_subtitle"), class: "ww-label"
      = f.text_field :subtitle, class: "ww-input", placeholder: t("ui.dashboard.channels.contact_form.translation_fields.e_g_we_will_reply_as_soon_as_possible")

  .ww-form-row
    div
      = f.label :success_message, t("forms.labels.success_message"), class: "ww-label"
      = f.text_area :success_message, class: "ww-input channel-textarea", rows: 2, placeholder: t("ui.dashboard.channels.contact_form.translation_fields.e_g_thanks_for_reaching_out_we_ve_received_your")
    div
      = f.label :submit_button_text, t("forms.labels.submit_button_text"), class: "ww-label"
      = f.text_field :submit_button_text, class: "ww-input", placeholder: t("ui.dashboard.channels.contact_form.translation_fields.e_g_send_message")