- form_url = article.persisted? ? help_center_article_path(id: article.id) : help_center_articles_path
- form_method = article.persisted? ? :patch : :post
- locale = params[:article_locale].presence || article.portal&.default_locale.presence || @selected_portal&.default_locale.presence || I18n.locale.to_s
- translation = article.translations.find { |item| item.locale.to_s == locale.to_s } || article.translations.first || article.translations.build(locale: locale)

- if @portals.blank?
  .hc-form-empty
    h3.f-semi-18 = I18n.t("dashboard.articles.no_portal_found", default: "No help center portal found")
    p.f-reg-14.text-muted = I18n.t("dashboard.articles.create_portal_first", default: "Create a help center portal before adding articles, because every article must belong to a portal.")
- else
  = form_with(model: article, scope: :article, url: form_url, method: form_method, local: true, html: { multipart: true, id: "article-form", class: "hc-article-form", data: { controller: "help-center--article" } }) do |f|
    - all_errors = article.errors.full_messages + article.translations.flat_map { |item| item.errors.full_messages }
    - if all_errors.any?
      .hc-error-summary
        h3 = I18n.t("dashboard.articles.fix_errors", default: "Please fix the following errors:")
        ul
          - all_errors.uniq.each do |message|
            li = message

    .hc-form-grid
      .hc-form-left
        .hc-form-card
          .hc-form-card-body
            = f.fields_for :translations, translation, child_index: 0 do |tf|
              = tf.hidden_field :id if translation.persisted?
              = tf.hidden_field :locale, value: translation.locale.presence || locale
              / = tf.label :title, "Title", class: "hc-label"
              = tf.text_field :title, class: "hc-title-input", placeholder: I18n.t("dashboard.articles.untitled_placeholder", default: "Untitled Article "), required: true, value: (defined?(draft_title) && draft_title.present? ? draft_title : translation.title), data: { help_center__article_editor_target: "titleInput" }
        .hc-form-card
          .hc-form-card-body
            .hc-form-row-4
              div
                = f.label :article_type, "Article Type", class: "hc-label"
                = f.select :article_type, ::HelpCenter::Article.article_types.keys.map { |at| [at.humanize, at] }, {}, class: "hc-select", data: { action: "change->help-center--article#toggleType" }
              div data-controller="help-center--category"
                = f.label :primary_category_id, I18n.t("dashboard.articles.select_category_label", default: "Select Category"), class: "hc-label"
                .hc-category-picker
                  = f.hidden_field :primary_category_id, data: { help_center__category_target: "hiddenInput" }
                  .hc-category-picker-trigger data-action="click->help-center--category#toggle"
                    span.hc-category-picker-selected data-help-center--category-target="selected"
                      - selected_cat = @categories.find { |c| c.id.to_s == article.primary_category_id.to_s }
                      = selected_cat ? (selected_cat.name.presence || I18n.t("dashboard.articles.untitled", default: "Untitled")) : I18n.t("dashboard.articles.select_category", default: "Select category")
                    span.hc-category-picker-arrow ▾
                  .hc-category-picker-dropdown style="display: none;" data-help-center--category-target="dropdown"
                    .hc-category-picker-search
                      input.hc-category-picker-input type="text" placeholder=I18n.t("dashboard.articles.search_categories", default: "Search categories...") data-action="input->help-center--category#search" data-help-center--category-target="searchInput"
                    .hc-category-picker-list data-help-center--category-target="list"
                      - @categories.each do |cat|
                        button.hc-category-picker-item type="button" data-value=cat.id data-action="click->help-center--category#select"
                          = cat.name.presence || I18n.t("dashboard.articles.untitled", default: "Untitled")
                    .hc-category-picker-create
                      button.hc-category-picker-create-btn type="button" data-action="click->help-center--category#openCreateModal"
                        | + Create new category
              div
                = f.label :visibility, "Visibility", class: "hc-label"
                = f.select :visibility, ::HelpCenter::Article.visibilities.keys.map { |v| [v.humanize, v] }, {}, class: "hc-select"
              div
                = f.label :portal_id, "Portal", class: "hc-label"
                = f.select :portal_id, @portals.map { |portal| [portal.name.presence || portal.id, portal.id] }, {}, class: "hc-select", required: true, disabled: article.persisted?

        .hc-form-card
          .hc-form-card-header
            h3 Content
          .hc-form-card-body
            = f.fields_for :translations, translation, child_index: 0 do |tf|
              .ae-editor-content data-help-center--article-editor-target="editorContainer" data-action="help-center--article-editor:open-youtube@window->help-center--article-editor#openYoutubePopover"
              = tf.text_area :content, class: "hc-richtext-source ae-hidden-input", rows: 18, value: (defined?(draft_content) && draft_content.present? ? draft_content : translation.content), data: { help_center__article_editor_target: "contentInput" }, style: "display:none;"

            /! ─── Bubble Menu ───
            .hc-bubble-menu data-help-center--article-editor-target="bubbleMenu"
              button.hc-bubble-btn type="button" data-action="click->help-center--article-editor#toggleBold" data-help-center--article-editor-target="toolbar" data-format="bold" title="Bold (Cmd+B)" B
              button.hc-bubble-btn type="button" data-action="click->help-center--article-editor#toggleItalic" data-help-center--article-editor-target="toolbar" data-format="italic" title="Italic (Cmd+I)" I
              button.hc-bubble-btn type="button" data-action="click->help-center--article-editor#toggleStrike" data-help-center--article-editor-target="toolbar" data-format="strike" title="Strikethrough (Cmd+Shift+S)" S
              .hc-bubble-divider
              button.hc-bubble-btn type="button" data-action="click->help-center--article-editor#toggleCode" data-help-center--article-editor-target="toolbar" data-format="code" title="Code (Cmd+E)" <>
              button.hc-bubble-btn type="button" data-action="click->help-center--article-editor#toggleLink" data-help-center--article-editor-target="toolbar" data-format="link" title="Link (Cmd+K)" 🔗

            /! ─── Plus Menu (Block Inserter) ───
            button.hc-plus-menu type="button" data-help-center--article-editor-target="plusMenu" data-action="click->help-center--article-editor#insertSlashCommand" title="Click to add a block" +

            /! ─── Table Context Menu ───
            .hc-bubble-menu.hc-table-menu data-help-center--article-editor-target="tableMenu"
              button.hc-bubble-btn type="button" data-action="click->help-center--article-editor#tableAddColumnBefore" title="Add Column Before" +C←
              button.hc-bubble-btn type="button" data-action="click->help-center--article-editor#tableAddColumnAfter" title="Add Column After" →C+
              button.hc-bubble-btn.hc-bubble-btn--danger type="button" data-action="click->help-center--article-editor#tableDeleteColumn" title="Delete Column" -C
              .hc-bubble-divider
              button.hc-bubble-btn type="button" data-action="click->help-center--article-editor#tableAddRowBefore" title="Add Row Before" +R↑
              button.hc-bubble-btn type="button" data-action="click->help-center--article-editor#tableAddRowAfter" title="Add Row After" ↓R+
              button.hc-bubble-btn.hc-bubble-btn--danger type="button" data-action="click->help-center--article-editor#tableDeleteRow" title="Delete Row" -R
              .hc-bubble-divider
              button.hc-bubble-btn.hc-bubble-btn--danger type="button" data-action="click->help-center--article-editor#tableDelete" title="Delete Table" 🗑️

            /! ─── Image Popover ───
            .hc-image-popover data-help-center--article-editor-target="imagePopover"
              .hc-image-form data-action="keydown.enter->help-center--article-editor#saveImageProperties"
                .hc-form-row
                  label Alt Text
                  input type="text" data-help-center--article-editor-target="imageAltInput" placeholder="Describe the image"
                .hc-form-row.hc-form-row--split
                  div
                    label Width
                    input type="text" data-help-center--article-editor-target="imageWidthInput" placeholder="e.g. 100% or 400px"
                  div
                    label Height
                    input type="text" data-help-center--article-editor-target="imageHeightInput" placeholder="e.g. auto or 300px"
                .hc-form-actions
                  button.ae-btn.ae-btn--primary.ae-btn--sm type="button" data-action="click->help-center--article-editor#saveImageProperties" Save

            /! ─── Link Popover ───
            .hc-image-popover data-help-center--article-editor-target="linkPopover"
              .hc-image-form data-action="keydown.enter->help-center--article-editor#saveLink"
                .hc-form-row
                  label Link URL
                  input type="text" data-help-center--article-editor-target="linkUrlInput" placeholder="https://example.com"
                .hc-form-actions
                  button.ae-btn.ae-btn--ghost.ae-btn--sm type="button" data-action="click->help-center--article-editor#removeLink" Remove
                  button.ae-btn.ae-btn--primary.ae-btn--sm type="button" data-action="click->help-center--article-editor#saveLink" Save

            /! ─── Youtube Popover ───
            .hc-image-popover data-help-center--article-editor-target="youtubePopover"
              .hc-image-form data-action="keydown.enter->help-center--article-editor#saveYoutube"
                .hc-form-row
                  label YouTube Video URL
                  input type="text" data-help-center--article-editor-target="youtubeUrlInput" placeholder="https://www.youtube.com/watch?v=..."
                .hc-form-actions
                  button.ae-btn.ae-btn--ghost.ae-btn--sm type="button" data-action="click->help-center--article-editor#cancelYoutube" Cancel
                  button.ae-btn.ae-btn--primary.ae-btn--sm type="button" data-action="click->help-center--article-editor#saveYoutube" Embed

            /! ─── Accordion Context Menu ───
            .hc-bubble-menu.hc-accordion-menu data-help-center--article-editor-target="accordionMenu"
              button.hc-bubble-btn.hc-bubble-btn--danger type="button" data-action="click->help-center--article-editor#accordionDelete" title="Delete Accordion" 🗑️ Delete

            /! Hidden file inputs for image/file uploads
            input.ae-hidden-input type="file" accept="image/png, image/jpeg, image/gif, image/webp" multiple=true data-help-center--article-editor-target="imageInput" data-action="change->help-center--article-editor#insertImages"
            input.ae-hidden-input type="file" accept=".pdf,.doc,.docx,.xls,.xlsx,.zip,.txt,.csv" data-help-center--article-editor-target="fileInput" data-action="change->help-center--article-editor#insertFile"

            div data-help-center--article-target="externalUrlField" style="display: none;"
              = label_tag "article[configurations][external_url]", "External URL", class: "hc-label"
              = text_field_tag "article[configurations][external_url]", article.configurations["external_url"], class: "hc-input", placeholder: "https://example.com/article"

      .hc-form-right
        .hc-form-sidebar-card
          .hc-form-sidebar-card-header
            h3 Publishing
          .hc-form-sidebar-card-body.hc-form-sidebar-card-body--row
            = f.label :status, "Status", class: "hc-label"
            span.hc-status-pill class="hc-status-pill--#{article.status || 'draft'}"
              = (article.status || "draft").humanize

        .hc-form-sidebar-card
          .hc-form-sidebar-card-body.hc-form-sidebar-card-body--row
            strong.hc-form-sidebar-label table of contents
            label.hc-toggle
              = check_box_tag "article[configurations][show_table_of_contents]", "1", article.configurations.fetch("show_table_of_contents", true)
              span.hc-toggle-slider
        .hc-form-sidebar-card
          .hc-form-sidebar-card-body.hc-form-sidebar-card-body--row
            span.hc-form-sidebar-label Read Time
            .hc-stepper-control data-controller="help-center--article"
              button.hc-stepper-btn type="button" data-action="help-center--article#decrease" -
              span.hc-stepper-value data-help-center--article-target="value"
                = article.configurations["estimated_read_time"].presence || "5"
              button.hc-stepper-btn type="button" data-action="help-center--article#increase" +
              = number_field_tag "article[configurations][estimated_read_time]", (article.configurations["estimated_read_time"] || 5), class: "hc-stepper-input", min: 0, data: { help_center__article_target: "input" }

        .hc-form-sidebar-card
          .hc-form-sidebar-card-header
            h3 Banner Image
          .hc-form-sidebar-card-body
            label.hc-file-upload data-help-center--article-target="bannerPreview" data-help-center--article-existing-banner-url-value="#{url_for(article.banner_image) if article.banner_image.attached?}"
              = f.file_field :banner_image, accept: "image/png, image/jpeg, image/gif, image/webp", data: { help_center__article_target: "bannerInput", action: "change->help-center--article#previewBanner" }
              span.hc-file-upload-icon data-help-center--article-target="bannerIcon"
                = inline_svg_tag("export.svg", alt: "")
              .hc-file-upload-preview
                img.hc-file-upload-preview-image data-help-center--article-target="bannerPreviewImage" alt=""
              span.hc-file-upload-text
                strong data-help-center--article-target="bannerTitle" Upload banner
                small data-help-center--article-target="bannerSubtitle" PNG, JPG, or WebP works best.

        .hc-form-sidebar-card
          .hc-form-sidebar-card-header
            h3 Organization
          .hc-form-sidebar-card-body
            = f.label :position, "Sort Order", class: "hc-label"
            = f.number_field :position, class: "hc-input", min: 0, placeholder: "  1"

        .hc-form-sidebar-card
          .hc-form-sidebar-card-header
            h3 SEO Settings
          .hc-form-sidebar-card-body
            = f.fields_for :translations, translation, child_index: 0 do |tf|
              .hc-seo-field
                = tf.label :slug, "Slug", class: "hc-label"
                = tf.text_field :slug, class: "hc-input", placeholder: " Getting-Started"
              .hc-seo-field
                = tf.label :meta_title, "Meta Title", class: "hc-label"
                = tf.text_field :meta_title, class: "hc-input", placeholder: " Optimal 60 character..."
              .hc-seo-field
                = tf.label :meta_description, "Meta Description", class: "hc-label"
                = tf.text_area :meta_description, class: "hc-input", rows: 3, placeholder: "  Brief SEO description"
              / .hc-seo-field
              /   = tf.label :meta_keywords, "Meta Keywords", class: "hc-label"
              /   = tf.text_field :meta_keywords, value: Array(translation.meta_keywords).join(", "), class: "hc-input", placeholder: "e.g. support, setup"
              / .hc-seo-field
              /   = tf.label :search_excerpt, "Search Excerpt", class: "hc-label"
              /   = tf.text_field :search_excerpt, class: "hc-input", placeholder: "Short preview for search results"

  / New Category Modal (inside form so it can access the category-picker controller)
  div data-controller="help-center--category"
    #article-new-category-modal.modal-popper-container style="display: none;" data-help-center--category-target="modal"
      .model-content-section
        .model-content.hc-category-modal-content
          .hc-category-modal-header
            .hc-category-modal-header-text
              h3.f-semi-18 Add New Category
              p.f-reg-14.hc-category-modal-subtitle Create a new category to organize your article
          .hc-category-form-body
            = form_with url: help_center_categories_path, scope: :category, method: :post, html: { multipart: true, class: "hc-category-form", data: { action: "submit->help-center--category#submit" } } do |f|
              = f.hidden_field :portal_id, value: @selected_portal&.id
              .hc-category-form-fields
                .hc-category-form-floating
                  = f.label :name, class: "hc-category-form-label f-reg-14" do
                    | Category name
                    span.required-star *
                  = f.text_field :name, class: "hc-category-form-control f-reg-14", placeholder: "e.g. Getting Started", required: true

                .hc-category-form-floating
                  = f.label :image, "Icon", class: "hc-category-form-label f-reg-14"
                  label.hc-file-upload data-help-center--category-target="iconPreview"
                    = f.file_field :image, accept: "image/png, image/jpeg, image/gif, image/webp", data: { help_center__category_target: "iconInput", action: "change->help-center--category#previewIcon" }
                    span.hc-file-upload-icon data-help-center--category-target="iconIcon"
                      = inline_svg_tag("export.svg", alt: "")
                    .hc-file-upload-preview
                      img.hc-file-upload-preview-image data-help-center--category-target="iconPreviewImage" alt=""
                    span.hc-file-upload-text
                      strong data-help-center--category-target="iconTitle" Upload icon
                      small data-help-center--category-target="iconSubtitle" PNG, JPG, or WebP works best.

                .hc-category-form-floating
                  = f.label :description, class: "hc-category-form-label f-reg-14" do
                    | Description
                  = f.text_area :description, class: "hc-category-form-control hc-category-form-textarea f-reg-14", placeholder: "Brief description of this category", rows: 3

                .hc-category-form-floating.hc-category-selects-row
                  .hc-category-form-group
                    = f.label :parent_id, "Parent category", class: "hc-category-form-label f-reg-14"
                    = f.select :parent_id, @categories.map { |cat| [cat.name.presence || cat.id, cat.id] }, { include_blank: "None" }, class: "hc-category-form-select f-reg-14"
                  .hc-category-form-group
                    = f.label :visibility, "Visibility", class: "hc-category-form-label f-reg-14"
                    = f.select :visibility, ::HelpCenter::Category.visibilities.keys.map { |v| [v.humanize, v] }, {}, class: "hc-category-form-select f-reg-14"

              .hc-category-form-actions
                button.hc-category-cancel-btn.f-med-14.close-modal-btn type="button" data-action="click->help-center--category#close" Cancel
                = f.submit "Create Category", class: "hc-category-submit-btn f-med-14"