.model-content-section
  .model-content
    .modal-header
      h3.f-semi-18 = t("ui.dashboard.popup.widget_channel_modal.widget_channel")
      = inline_svg_tag("cross_button.svg", alt:t("ui.dashboard.agent.agent_sidebar.menu"), class:"conversation-icon m-close", data: { action: "click->modal-toggler#hideModal" })
    .modal-body.channel-form
      = form_with(url: channels_path, data: {controller: "form-validation renderer", "form-validation-target" => "form", turbo: false}, html: {class: "needs-validation", novalidate: true, method: :post}) do |f|
        .form-fields
          = f.hidden_field :channel_type, value: "widget"
          .form-floating
            .field-label
              span 1
              = f.label :name, t("forms.labels.enter_channel_name"), class: "form-label f-reg-14"
            = f.text_field :name, class: "form-control f-reg-14", placeholder: t("dashboard.email_channels.form.name_label"), required: true
          .form-floating
            .field-label
              span 2
              = f.label :secret, t("forms.labels.secret"), class: "form-label f-reg-14"
            = f.text_field :secret, class: "form-control f-reg-14", placeholder: t("dashboard.popup.widget_channel.form.secret_label"), required: true
          .form-floating
            .field-label
              span 3
              = f.label :allowed_hosts, t("forms.labels.enter_website_url"), class: "form-label f-reg-14"
            .ww-tags-input-container.form-control.f-reg-14 data-controller="tags-input" data-action="click->tags-input#focusInput" style="height: auto; min-height: 44px; padding: 4px 12px; display: flex; flex-wrap: wrap; gap: 4px; align-items: center;"
              = hidden_field_tag "web_widget_channel[allowed_hosts][]", "", data: { "tags-input-target": "hiddenInput" }
              .ww-tags-list data-tags-input-target="tagsContainer" style="display: flex; flex-wrap: wrap; gap: 4px;"
              input.ww-tags-input-field type="text" data-tags-input-target="input" data-action="keydown->tags-input#handleKeydown blur->tags-input#addTag" placeholder="https://example.com" style="border: none; outline: none; background: transparent; flex-grow: 1; min-width: 100px;" required=true
          / .form-floating
          /   .field-label
          /     span 4
          /     = f.label :phone_number_id, t("forms.labels.phone_number_id"), class: "form-label f-reg-14"
          /   = f.text_field :phone_number_id, class: "form-control f-reg-14", placeholder: "phone number id", required: true
          / .form-floating
          /   .field-label
          /     span 5
          /     = f.label :business_account_id, t("forms.labels.business_account_id"), class: "form-label f-reg-14"
          /   = f.text_field :business_account_id, class: "form-control f-reg-14", placeholder: "business account id", required: true
        .form-actions
          = f.submit t("dashboard.custom_channels.new.submit"), class: "submit-btn f-med-14", data: { action: "click->form-validation#validate click->modal-toggler#hideModal" }