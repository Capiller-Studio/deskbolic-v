- help_center_open = %w[help-center-articles help-center-portals new-help-center].include?(current_page)
- channels_open = %w[all-channels email-channels web-widget-channels contact-form-channels facebook-channels instagram-channels whatsapp-channels custom-channels].include?(current_page)
