.modal-popper-container data-conversations-target="modal" style="display: none;"
  .model-content-section 
    .model-content
      .modal-header
        h3.f-semi-18 = t("ui.dashboard.conversations.snooz_conv_modal.snooze_conversation")
        = inline_svg_tag("cross_button.svg", alt:t("ui.dashboard.agent.agent_sidebar.menu"), class:"conversation-icon m-close", data: { action: "click->conversations#close" })
      .modal-body.snooz-conv-modal
        = form_with url: snooz_conversation_conversation_path(@conversation), method: :patch do |f|
          .card
            p.f-reg-14 = t("dashboard.popup.schedule.snooze_until")
            = f.datetime_field :snooze_until, class: "form-control", placeholder: t("dashboard.conversations.snooze.pick_datetime"), required: true
            button.f-semi-14.apply-btn type="submit" data-action="click->conversations#close" = t("dashboard.conversations.snooze.apply")
