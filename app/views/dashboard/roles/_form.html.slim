= form_with model: role, url: role.new_record? ? roles_path : role_path(role), local: true, data: { controller: "role-permissions" }, class: "channel-form" do |f|
  - if role.errors.any?
    .channel-form-errors
      h4 = t("dashboard.roles.form.errors_found", count: role.errors.count, default: "%{count} errors prohibited this role from being saved:")
      ul
        - role.errors.full_messages.each do |msg|
          li = msg

  .ui-form-group
    = f.label :name, t("dashboard.roles.form.name_label", default: "Role Name"), class: "ui-label"
    = f.text_field :name, class: "ui-input", placeholder: "e.g., Billing Manager", disabled: role.system_provided?

  / We use a hidden field to store the serialized JSON string from Stimulus
  = f.hidden_field :permissions, data: { role_permissions_target: "jsonOutput" }

  h3.f-semi-20.pm-matrix-title = t("dashboard.roles.form.permissions_matrix", default: "Permissions Matrix")
  p.f-reg-14.pm-matrix-desc = t("dashboard.roles.form.permissions_desc", default: "Toggle the granular permissions below for this role.")

  .pm-matrix
    .pm-header
      .pm-header-col Resource
      .pm-header-col Permissions
      
    - ::Access::Role::PERMISSION_SCHEMA.each do |resource, actions|
      .pm-row
        .pm-resource = resource.humanize.titleize
        .pm-toggles-row
          - actions.each do |action|
            - is_checked = role.permissions.dig(resource, action) == true || role.permissions.dig(resource, action) == "true"
            label.pm-toggle-label
              input.pm-toggle-input type="checkbox" checked=is_checked disabled=role.system_provided? data-role-permissions-target="checkbox" data-action="change->role-permissions#toggle" data-resource=resource data-permission-action=action
              span = action.humanize.titleize

  .ui-form-actions.pm-form-actions
    - unless role.system_provided?
      = f.submit t("dashboard.roles.form.save", default: "Save Role"), class: "ui-btn-primary"
    = link_to t("dashboard.roles.form.cancel", default: "Cancel"), roles_path, class: "ui-btn-secondary"
