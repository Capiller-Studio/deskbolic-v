/ Smart Search Modal — Cmd+K overlay
- navigation_actions = [%i[navigation conversations conversations_path], %i[navigation reports reports_path], %i[navigation settings settings_path], %i[navigation profile profile_path]]
- settings_actions = [%i[settings teams teams_path], %i[settings team_members users_path], %i[settings roles roles_path], %i[settings billing dashboard_billing_path], %i[settings domains domains_path], %i[settings notification_settings edit_settings_notifications_path], %i[settings audit_logs settings_audit_logs_path], %i[settings api_keys settings_api_keys_path], %i[settings integrations integrations_path]]
- channel_actions = [%i[channels email_channels channels_email_index_path], %i[channels web_widget_channels channels_web_widget_index_path], %i[channels contact_form_channels channels_contact_form_index_path], %i[channels facebook_channels channels_facebook_index_path], %i[channels instagram_channels channels_instagram_index_path], %i[channels whatsapp_channels channels_whatsapp_index_path], %i[channels custom_channels channels_custom_index_path]]
- channel_create_actions = [%i[channels_create create_email_channel new_channels_email_path], %i[channels_create create_web_widget new_channels_web_widget_path], %i[channels_create create_contact_form new_channels_contact_form_path], %i[channels_create create_facebook_channel new_channels_facebook_path], %i[channels_create create_instagram_channel new_channels_instagram_path], %i[channels_create create_whatsapp_channel new_channels_whatsapp_path], %i[channels_create create_custom_channel new_channels_custom_path]]
- help_center_actions = [%i[help_center help_center_articles help_center_articles_path], %i[help_center help_center_portals help_center_portals_path], %i[help_center create_new_portal new_help_center_portal_path], %i[help_center create_new_article new_help_center_article_path]]
- automation_actions = [%i[data_automation assignment_policies assignment_policies_path], %i[data_automation sla_policies sla_policies_path], %i[data_automation business_hours business_hour_groups_path], %i[data_automation skills skills_path], %i[data_automation custom_fields custom_fields_path], %i[data_automation csat_surveys csat_surveys_path], %i[data_automation identity_sources identity_sources_path], %i[data_automation canned_responses canned_responses_path], %i[data_automation labels labels_path], %i[data_automation macros macros_path], %i[data_automation automations automations_path], %i[data_automation ai_agents ai_agents_path], %i[data_automation email_templates email_templates_path]]
- create_actions = [%i[create invite_team_member new_invitation_path], %i[create create_new_team new_team_path], %i[create create_new_label new_label_path], %i[create create_new_automation new_automation_path], %i[create create_new_role new_role_path]]
- quick_action_links = navigation_actions + settings_actions + channel_actions + channel_create_actions + help_center_actions + automation_actions + create_actions
- quick_actions = quick_action_links.map { |category, action, route| { category: t("dashboard.search.categories.#{category}"), label: t("dashboard.search.quick_actions.#{action}"), keywords: t("dashboard.search.quick_actions.#{action}_keywords"), url: public_send(route) } }
- search_sections = { quick_actions: t("dashboard.search.section_quick_actions"), conversations: t("dashboard.search.section_conversations"), messages: t("dashboard.search.section_messages"), unknown_customer: t("dashboard.search.unknown_customer"), unknown_sender: t("dashboard.search.unknown_sender") }

.smart-search-overlay data-controller="smart-search" data-smart-search-target="modal" data-action="click->smart-search#closeOnBackdrop click->smart-search#onResultClick" data-smart-search-quick-actions-value=quick_actions.to_json data-smart-search-section-labels-value=search_sections.to_json
  .smart-search-dialog
    .smart-search-input-wrapper
      svg.smart-search-input-icon width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        circle cx="11" cy="11" r="8"
        line x1="21" y1="21" x2="16.65" y2="16.65"
      input.smart-search-input type="text" data-smart-search-target="input" data-action="input->smart-search#onInput keydown->smart-search#onKeydown" placeholder=t("dashboard.search.placeholder") autocomplete="off" spellcheck="false"
      .smart-search-shortcut
        kbd Esc

    .smart-search-results data-smart-search-target="results"
      .smart-search-loading data-smart-search-target="loading" style="display: none;"
        .smart-search-spinner
        span = t("dashboard.search.searching")

      .smart-search-empty data-smart-search-target="empty" style="display: none;"
        svg.smart-search-empty-icon width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
          circle cx="11" cy="11" r="8"
          line x1="21" y1="21" x2="16.65" y2="16.65"
        p.smart-search-empty-text = t("dashboard.search.no_results")
        p.smart-search-empty-hint = t("dashboard.search.try_different")

      .smart-search-section data-smart-search-target="quickActionResults" style="display: none;"
      .smart-search-section data-smart-search-target="conversationResults" style="display: none;"
      .smart-search-section data-smart-search-target="messageResults" style="display: none;"

    .smart-search-footer
      .smart-search-footer-hints
        span.smart-search-hint
          kbd ↑
          kbd ↓
          |  to navigate
        span.smart-search-hint
          kbd Enter
          |  to select
        span.smart-search-hint
          kbd Esc
          |  to close
