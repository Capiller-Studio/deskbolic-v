/* ═══════════════════════════════════════════════════════════════════════
   Email Builder — Drag & Drop Editor UI
   ═══════════════════════════════════════════════════════════════════════ */
@import 'grapesjs/dist/css/grapes.min.css';

/* ─── Design Tokens ──────────────────────────────────────────────────── */
:root {
  --eb-primary: #2563eb;
  --eb-primary-hover: #1d4ed8;
  --eb-primary-light: #dbeafe;
  --eb-success: #059669;
  --eb-success-light: #d1fae5;
  --eb-danger: #dc2626;
  --eb-danger-light: #fee2e2;
  --eb-warning: #d97706;
  --eb-warning-light: #fef3c7;
  --eb-info: #0284c7;
  --eb-info-light: #e0f2fe;

  --eb-bg-primary: #ffffff;
  --eb-bg-secondary: #f8fafc;
  --eb-bg-tertiary: #f1f5f9;
  --eb-bg-sidebar: #1e293b;
  --eb-bg-sidebar-hover: #334155;

  --eb-text-primary: #0f172a;
  --eb-text-secondary: #475569;
  --eb-text-muted: #94a3b8;
  --eb-text-inverse: #f8fafc;

  --eb-border: #e2e8f0;
  --eb-border-focus: #2563eb;

  --eb-radius-sm: 6px;
  --eb-radius-md: 8px;
  --eb-radius-lg: 12px;
  --eb-radius-xl: 16px;

  --eb-shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
  --eb-shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
  --eb-shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.05);
  --eb-shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);

  --eb-transition: 200ms cubic-bezier(0.4, 0, 0.2, 1);
  --eb-sidebar-width: 300px;
  --eb-toolbar-height: 60px;
}

/* ─── Editor Layout (Full Viewport) ──────────────────────────────────── */
.eb-editor, .gjs-editor {
  /* GrapeJS Native Theme Overrides (Light Mode) */
  --gjs-primary-color: #0f172a;
  --gjs-secondary-color: #ffffff;
  --gjs-tertiary-color: #f1f5f9;
  --gjs-quaternary-color: #2563eb;
  --gjs-font-color: #0f172a;
  --gjs-font-color-active: #2563eb;
  --gjs-main-color: #f1f5f9;
}

.eb-editor {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100vw;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 1000;
  background: var(--eb-bg-secondary);
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

/* ─── Top Toolbar ────────────────────────────────────────────────────── */
.eb-toolbar {
  display: flex;
  align-items: center;
  height: var(--eb-toolbar-height);
  padding: 0 20px;
  background: var(--eb-bg-primary);
  border-bottom: 1px solid var(--eb-border);
  box-shadow: var(--eb-shadow-sm);
  z-index: 10;
  gap: 12px;
  flex-shrink: 0;
}

.eb-toolbar__back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: var(--eb-radius-sm);
  border: none;
  background: transparent;
  color: var(--eb-text-secondary);
  cursor: pointer;
  transition: all var(--eb-transition);
  text-decoration: none;

  &:hover {
    background: var(--eb-bg-tertiary);
    color: var(--eb-text-primary);
  }
}

.eb-toolbar__back svg {
  width: 20px;
  height: 20px;
}

.eb-toolbar__title {
  font-size: 16px;
  font-weight: 600;
  color: var(--eb-text-primary);
  margin-right: auto;
  display: flex;
  align-items: center;
  gap: 10px;
}

.eb-toolbar__divider {
  width: 1px;
  height: 28px;
  background: var(--eb-border);
  margin: 0 4px;
}

.eb-toolbar__group {
  display: flex;
  align-items: center;
  gap: 8px;
}

.eb-toolbar__select {
  height: 36px;
  padding: 0 12px;
  border: 1px solid var(--eb-border);
  border-radius: var(--eb-radius-sm);
  background: var(--eb-bg-primary);
  color: var(--eb-text-primary);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: border-color var(--eb-transition);
  outline: none;
  font-family: inherit;

  &:hover { border-color: var(--eb-text-muted); }
  &:focus { border-color: var(--eb-border-focus); box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1); }
}

.eb-toolbar__label {
  font-size: 12px;
  font-weight: 500;
  color: var(--eb-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.eb-toolbar__devices {
  display: flex;
  gap: 2px;
  background: var(--eb-bg-tertiary);
  border-radius: var(--eb-radius-sm);
  padding: 2px;
}

.eb-toolbar__device {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border: none;
  background: transparent;
  border-radius: 4px;
  color: var(--eb-text-muted);
  cursor: pointer;
  transition: all var(--eb-transition);

  &:hover { color: var(--eb-text-primary); }
}

.eb-toolbar__device svg { width: 16px; height: 16px; }

.eb-toolbar__device--active {
  background: var(--eb-bg-primary);
  color: var(--eb-primary);
  box-shadow: var(--eb-shadow-sm);
}

/* ─── Buttons ────────────────────────────────────────────────────────── */
.eb-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 36px;
  padding: 0 16px;
  border-radius: var(--eb-radius-sm);
  font-size: 13px;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  transition: all var(--eb-transition);
  border: 1px solid transparent;
  white-space: nowrap;
  text-decoration: none;
}

.eb-btn svg { width: 16px; height: 16px; }

.eb-btn--primary {
  background: var(--eb-primary);
  color: white;

  &:hover { background: var(--eb-primary-hover); }
  &:disabled { opacity: 0.5; cursor: not-allowed; }
}

.eb-btn--success {
  background: var(--eb-success);
  color: white;

  &:hover { background: #047857; }
}

.eb-btn--danger {
  background: transparent;
  color: var(--eb-danger);
  border-color: var(--eb-danger);

  &:hover { background: var(--eb-danger-light); }
}

.eb-btn--outline {
  background: transparent;
  color: var(--eb-text-primary);
  border-color: var(--eb-border);

  &:hover { background: var(--eb-bg-tertiary); border-color: var(--eb-text-muted); }
}

.eb-btn--ghost {
  background: transparent;
  color: var(--eb-text-secondary);
  border: none;
  padding: 0 10px;

  &:hover { background: var(--eb-bg-tertiary); color: var(--eb-text-primary); }
}

/* ─── Badge ──────────────────────────────────────────────────────────── */
.eb-badge {
  display: inline-flex;
  align-items: center;
  padding: 3px 10px;
  border-radius: 100px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.eb-badge--draft {
  background: var(--eb-warning-light);
  color: var(--eb-warning);
}

.eb-badge--published,
.eb-badge--active {
  background: var(--eb-success-light);
  color: var(--eb-success);
}

.eb-badge--inactive {
  background: var(--eb-bg-tertiary);
  color: var(--eb-text-muted);
}

/* ─── Main Content Area ──────────────────────────────────────────────── */
.eb-main {
  display: flex;
  flex: 1;
  overflow: hidden;
}

/* ─── Canvas ─────────────────────────────────────────────────────────── */
.eb-canvas {
  flex: 1;
  position: relative;
  background: var(--eb-bg-secondary);
}

.eb-canvas .gjs-cv-canvas {
  top: 0;
  width: 100%;
  height: 100%;
}

.eb-canvas .gjs-frame-wrapper {
  padding: 20px;
}

/* ─── Right Sidebar ──────────────────────────────────────────────────── */
.eb-sidebar {
  width: var(--eb-sidebar-width);
  background: var(--eb-bg-primary);
  border-left: 1px solid var(--eb-border);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  flex-shrink: 0;
}

.eb-sidebar__tabs {
  display: flex;
  border-bottom: 1px solid var(--eb-border);
  flex-shrink: 0;
  overflow-x: auto;
  scrollbar-width: none; /* Firefox */
}

.eb-sidebar__tabs::-webkit-scrollbar {
  display: none; /* Chrome, Safari */
}

.eb-sidebar__tab {
  flex: 1 0 auto;
  padding: 12px 12px;
  font-size: 13px;
  font-weight: 600;
  color: var(--eb-text-muted);
  text-align: center;
  cursor: pointer;
  border: none;
  background: transparent;
  border-bottom: 2px solid transparent;
  transition: all var(--eb-transition);
  font-family: inherit;

  &:hover { color: var(--eb-text-primary); }
}

.eb-sidebar__tab--active {
  color: var(--eb-primary);
  border-bottom-color: var(--eb-primary);
}

.eb-sidebar__panel {
  flex: 1;
  overflow-y: auto;
  display: none;
  padding: 16px;
}

.eb-sidebar__panel--active { display: block; }

.eb-sidebar__section-title {
  font-size: 11px;
  font-weight: 700;
  color: var(--eb-text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
  padding: 8px 0;
  margin-top: 12px;
}

.eb-sidebar__section-title:first-child { margin-top: 0; }

/* ─── Block Manager Overrides ────────────────────────────────────────── */
.eb-sidebar .gjs-blocks-cs {
  padding: 0;
}

.eb-sidebar .gjs-block-categories {
  font-family: inherit;
}

.eb-sidebar .gjs-block-category {
  border: none !important;
}

.eb-sidebar .gjs-block-category .gjs-title {
  font-size: 11px;
  font-weight: 700;
  color: var(--eb-text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
  padding: 12px 0 8px;
  background: transparent !important;
  border: none !important;
}

.eb-sidebar .gjs-block {
  width: calc(50% - 4px);
  min-height: 72px;
  padding: 12px 8px;
  margin: 2px;
  border: 1px solid var(--eb-border);
  border-radius: var(--eb-radius-md);
  background: var(--eb-bg-primary);
  box-shadow: none;
  transition: all var(--eb-transition);
  cursor: grab;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;

  &:hover {
    border-color: var(--eb-primary);
    background: var(--eb-primary-light);
    box-shadow: var(--eb-shadow-sm);
    transform: translateY(-1px);
  }

  &:active {
    cursor: grabbing;
    transform: scale(0.97);
  }
}

.gjs-block .gjs-block-svg {
  width: 24px !important;
  height: 24px !important;
  color: var(--eb-text-secondary);
}

.gjs-block .gjs-block-label {
  font-size: 11px;
  font-weight: 600;
  color: var(--eb-text-secondary);
  font-family: inherit;
}

/* ─── Style Manager Overrides ────────────────────────────────────────── */
.eb-sidebar .gjs-sm-sectors {
  font-family: inherit;
}

.eb-sidebar .gjs-sm-sector {
  border: none;
}

.eb-sidebar .gjs-sm-sector .gjs-sm-sector-title {
  font-size: 12px;
  font-weight: 600;
  color: var(--eb-text-primary);
  padding: 10px 0;
  background: transparent;
  border-bottom: 1px solid var(--eb-border);
}

.eb-sidebar .gjs-sm-property {
  font-family: inherit;
}

.eb-sidebar .gjs-sm-property .gjs-sm-label {
  font-size: 12px;
  color: var(--eb-text-secondary);
}

.eb-sidebar .gjs-sm-property .gjs-field {
  background: var(--eb-bg-secondary);
  border: 1px solid var(--eb-border);
  border-radius: var(--eb-radius-sm);
  padding: 6px 10px;
  font-family: inherit;
  font-size: 13px;
  transition: border-color var(--eb-transition);

  &:focus-within {
    border-color: var(--eb-border-focus);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }
}

/* ─── Variables Panel ────────────────────────────────────────────────── */
.eb-variables__group {
  margin-bottom: 16px;
}

.eb-variables__group-title {
  font-size: 12px;
  font-weight: 600;
  color: var(--eb-text-primary);
  margin-bottom: 8px;
  text-transform: capitalize;
}

.eb-variables__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.eb-variables__chip {
  display: inline-flex;
  align-items: center;
  padding: 5px 12px;
  border-radius: 100px;
  font-size: 12px;
  font-weight: 500;
  font-family: "SF Mono", "Fira Code", monospace;
  color: var(--eb-primary);
  background: var(--eb-primary-light);
  border: 1px solid transparent;
  cursor: pointer;
  transition: all var(--eb-transition);
  user-select: none;

  &:hover {
    background: var(--eb-primary);
    color: white;
    transform: translateY(-1px);
    box-shadow: var(--eb-shadow-sm);
  }

  &:active { transform: scale(0.95); }
}

/* ─── Preview Modal ──────────────────────────────────────────────────── */
.eb-modal {
  position: fixed;
  inset: 0;
  z-index: 2000;
  display: none;
  align-items: center;
  justify-content: center;
}

.eb-modal--open {
  display: flex;
}

.eb-modal__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
}

.eb-modal__content {
  position: relative;
  width: 90vw;
  max-width: 800px;
  height: 85vh;
  background: var(--eb-bg-primary);
  border-radius: var(--eb-radius-lg);
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: modalIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.eb-modal__content--small {
  max-width: 480px;
  height: auto;
}

.eb-modal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 24px;
  border-bottom: 1px solid var(--eb-border);
}

.eb-modal__title {
  font-size: 16px;
  font-weight: 600;
  color: var(--eb-text-primary);
}

.eb-modal__body {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: var(--eb-bg-secondary);
  overflow: hidden;
}

.eb-modal__footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 16px 24px;
  border-top: 1px solid var(--eb-border);
  gap: 12px;
}

.eb-modal__close {
  width: 32px;
  height: 32px;
  border-radius: var(--eb-radius-sm);
  border: none;
  background: transparent;
  color: var(--eb-text-muted);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--eb-transition);

  &:hover { background: var(--eb-bg-tertiary); color: var(--eb-text-primary); }
}

.eb-modal__close svg { width: 18px; height: 18px; }

/* ─── Preview Frame ──────────────────────────────────────────────────── */
.eb-preview__frame {
  width: 100%;
  max-width: 100%;
  height: 100%;
  border: none;
  background: white;
  border-radius: var(--eb-radius-md);
  box-shadow: var(--eb-shadow-lg);
  transition: max-width var(--eb-transition);
  margin: 0 auto;
  display: block;
}

.eb-preview__devices {
  display: flex;
  gap: 4px;
}

.eb-preview__device {
  width: 32px;
  height: 32px;
  border: 1px solid var(--eb-border);
  border-radius: var(--eb-radius-sm);
  background: transparent;
  color: var(--eb-text-muted);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--eb-transition);

  &:hover { border-color: var(--eb-primary); color: var(--eb-primary); }
}

.eb-preview__device svg { width: 16px; height: 16px; }

.eb-preview__device--active {
  background: var(--eb-primary);
  border-color: var(--eb-primary);
  color: white;
}

/* ─── Toast Notifications ────────────────────────────────────────────── */
.eb-toast {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 3000;
  min-width: 280px;
  max-width: 420px;
  padding: 14px 20px;
  border-radius: var(--eb-radius-md);
  font-size: 14px;
  font-weight: 500;
  font-family: inherit;
  box-shadow: var(--eb-shadow-lg);
  transform: translateY(20px);
  opacity: 0;
  transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

.eb-toast--visible {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.eb-toast--success {
  background: var(--eb-success);
  color: white;
}

.eb-toast--error {
  background: var(--eb-danger);
  color: white;
}

.eb-toast--info {
  background: var(--eb-info);
  color: white;
}

.eb-toast--warning {
  background: var(--eb-warning);
  color: white;
}

/* ─── Index Page (Template Cards) ────────────────────────────────────── */
.eb-templates {
  max-width: 1200px;
  margin: 0 auto;
  padding: 40px 24px;
}

.eb-templates__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32px;
}

.eb-templates__title {
  font-size: 24px;
  font-weight: 700;
  color: var(--eb-text-primary);
}

.eb-templates__subtitle {
  font-size: 14px;
  color: var(--eb-text-secondary);
  margin-top: 4px;
}

.eb-templates__nav {
  display: flex;
  gap: 8px;
}

.eb-templates__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 20px;
}

/* ─── Template/Layout Card ───────────────────────────────────────────── */
.eb-card {
  background: var(--eb-bg-primary);
  border: 1px solid var(--eb-border);
  border-radius: var(--eb-radius-lg);
  overflow: hidden;
  transition: all var(--eb-transition);
  position: relative;

  &:hover {
    border-color: var(--eb-primary);
    box-shadow: var(--eb-shadow-md);
    transform: translateY(-2px);
  }
}

.eb-card__body {
  padding: 20px;
}

.eb-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.eb-card__name {
  font-size: 15px;
  font-weight: 600;
  color: var(--eb-text-primary);
}

.eb-card__description {
  font-size: 13px;
  color: var(--eb-text-secondary);
  line-height: 1.5;
  margin-bottom: 16px;
}

.eb-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px;
  border-top: 1px solid var(--eb-border);
  background: var(--eb-bg-secondary);
}

.eb-card__meta {
  font-size: 12px;
  color: var(--eb-text-muted);
}

.eb-card__badges {
  display: flex;
  gap: 6px;
}

/* ─── GrapeJS Global Overrides ───────────────────────────────────────── */

/* Editor root — fills parent, no default chrome */
.gjs-editor {
  font-family: inherit !important;
  background: transparent !important;
  border: none !important;
}

/* Canvas container — fills all available space */
.gjs-cv-canvas {
  background: var(--eb-bg-secondary) !important;
}

/* Canvas frame wrapper — add padding around the email preview */
.gjs-frame-wrapper {
  padding: 24px !important;
  box-sizing: border-box !important;
}

/* The actual iframe */
.gjs-frame {
  background: white !important;
  box-shadow: var(--eb-shadow-md) !important;
  border-radius: var(--eb-radius-md) !important;
}

/* Hide all default GrapeJS panels — we use our own */
.gjs-pn-panels,
.gjs-pn-views-container,
.gjs-pn-options,
.gjs-pn-commands,
.gjs-pn-devices-c {
  display: none !important;
}

/* ─── Block Manager ──────────────────────────────────────────────────── */
.eb-sidebar .gjs-blocks-cs {
  padding: 0;
}

.eb-sidebar .gjs-block-categories {
  font-family: inherit;
  background: var(--eb-bg-primary) !important;
}

.eb-sidebar .gjs-block-category {
  border: none !important;
  background: var(--eb-bg-primary) !important;
}

.eb-sidebar .gjs-block-category .gjs-title {
  font-size: 11px;
  font-weight: 700;
  color: var(--eb-text-secondary) !important;
  text-transform: uppercase;
  letter-spacing: 1px;
  padding: 12px 10px 8px 10px !important;
  background: var(--eb-bg-secondary) !important;
  border-bottom: 1px solid var(--eb-border) !important;
  margin-bottom: 10px;
}

/* Caret icon in category */
.eb-sidebar .gjs-block-category .gjs-caret-icon {
  color: var(--eb-text-muted);
}

/* Block grid layout — 2 columns */
.eb-sidebar .gjs-blocks-c {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  padding: 10px;
  background: var(--eb-bg-primary) !important;
}

.eb-sidebar .gjs-block {
  width: calc(50% - 5px) !important;
  min-height: 72px;
  padding: 12px 8px;
  margin: 0 !important;
  border: 1px solid var(--eb-border);
  border-radius: var(--eb-radius-md);
  background: var(--eb-bg-primary);
  box-shadow: none;
  transition: all var(--eb-transition);
  cursor: grab;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;

  &:hover {
    border-color: var(--eb-primary);
    background: var(--eb-primary-light);
    box-shadow: var(--eb-shadow-sm);
    transform: translateY(-1px);
  }

  &:active {
    cursor: grabbing;
    transform: scale(0.97);
  }
}

.gjs-block svg {
  width: 24px !important;
  height: 24px !important;
  color: var(--eb-text-secondary);
}

.gjs-block .gjs-block-label {
  font-size: 11px;
  font-weight: 600;
  color: var(--eb-text-secondary);
  font-family: inherit;
}

/* ─── Style Manager — Light Theme Override ───────────────────────────── */
.eb-sidebar .gjs-sm-sectors {
  font-family: inherit;
  background: var(--eb-bg-primary) !important;
}

.eb-sidebar .gjs-sm-sector {
  border: none !important;
  background: var(--eb-bg-primary) !important;
}

.eb-sidebar .gjs-sm-sector-title {
  font-size: 12px !important;
  font-weight: 600 !important;
  color: var(--eb-text-primary) !important;
  padding: 10px 0 !important;
  background: var(--eb-bg-secondary) !important;
  border-bottom: 1px solid var(--eb-border) !important;
  border-top: 1px solid var(--eb-border) !important;
  cursor: pointer;
}

/* Caret icon in sectors */
.eb-sidebar .gjs-sm-sector .gjs-sm-sector-caret {
  color: var(--eb-text-muted) !important;
}

/* Sector content area */
.eb-sidebar .gjs-sm-properties {
  padding: 8px 0 !important;
  background: var(--eb-bg-primary) !important;
}

.eb-sidebar .gjs-sm-property {
  font-family: inherit;
  color: var(--eb-text-primary) !important;
}

.eb-sidebar .gjs-sm-property__name, .eb-sidebar .gjs-sm-label {
  color: var(--eb-text-secondary) !important;
}

.eb-sidebar .gjs-field {
  background: var(--eb-bg-secondary) !important;
  border: 1px solid var(--eb-border) !important;
  border-radius: var(--eb-radius-sm) !important;
  padding: 6px 10px !important;
  font-family: inherit !important;
  font-size: 13px !important;
  color: var(--eb-text-primary) !important;
  transition: border-color var(--eb-transition);

  &:focus-within {
    border-color: var(--eb-border-focus) !important;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1) !important;
  }
}

/* Input fields in style manager */
.eb-sidebar .gjs-field input,
.eb-sidebar .gjs-field select,
.eb-sidebar .gjs-field textarea {
  color: var(--eb-text-primary) !important;
  background: transparent !important;
}

/* Color indicator */
.eb-sidebar .gjs-field-color .gjs-field-colorp {
  border-radius: 4px;
  overflow: hidden;
}

/* Dropdown arrows */
.eb-sidebar .gjs-d-s-arrow {
  color: var(--eb-text-muted) !important;
}

/* Composite properties */
.eb-sidebar .gjs-sm-composite {
  background: transparent !important;
  border: none !important;
}

/* ─── Rich Text Editor Toolbar ───────────────────────────────────────── */
.gjs-rte-toolbar {
  border-radius: var(--eb-radius-md) !important;
  box-shadow: var(--eb-shadow-lg) !important;
  border: 1px solid var(--eb-border) !important;
  background: var(--eb-bg-primary) !important;
}

.custom-rte-link-popup {
  position: absolute;
  top: 100%;
  left: 0;
  margin-top: 5px;
  background: var(--eb-bg-primary) !important;
  border: 1px solid var(--eb-border) !important;
  border-radius: var(--eb-radius-md) !important;
  padding: 8px !important;
  box-shadow: var(--eb-shadow-lg) !important;
  z-index: 100 !important;
  display: flex;
  gap: 8px;
  align-items: center;
}

.custom-rte-link-popup input {
  color: var(--eb-text-primary) !important;
  background: var(--eb-bg-secondary) !important;
  border: 1px solid var(--eb-border) !important;
  padding: 6px 10px !important;
  border-radius: var(--eb-radius-sm) !important;
  font-size: 13px !important;
  outline: none;
  min-width: 200px;
}

.custom-rte-link-popup input:focus {
  border-color: var(--eb-primary) !important;
}

.custom-rte-link-popup button {
  background: var(--eb-primary) !important;
  color: #fff !important;
  border: none !important;
  padding: 6px 12px !important;
  border-radius: var(--eb-radius-sm) !important;
  cursor: pointer;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-rte-link-popup button:hover {
  opacity: 0.9;
}

.gjs-rte-action {
  border-right: 1px solid var(--eb-border) !important;
  padding: 6px 10px !important;
  color: var(--eb-text-secondary) !important;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.gjs-rte-action:hover {
  color: var(--eb-primary) !important;
  background: var(--eb-bg-secondary) !important;
}

.gjs-rte-action.gjs-rte-active {
  color: var(--eb-primary) !important;
  background: var(--eb-bg-secondary) !important;
}

/* Bypass GrapeJS DOMPurify stripping SVGs by using CSS masks */
.eb-rte-icon {
  width: 14px;
  height: 14px;
  min-width: 14px;
  min-height: 14px;
  flex-shrink: 0;
  display: block;
  background-color: currentColor;
  -webkit-mask-size: contain;
  -webkit-mask-position: center;
  -webkit-mask-repeat: no-repeat;
  mask-size: contain;
  mask-position: center;
  mask-repeat: no-repeat;
}

.eb-rte-icon-align-left { -webkit-mask-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3 21h18v-2H3v2zm0-4h12v-2H3v2zm0-4h18v-2H3v2zm0-4h12V7H3v2zm0-6v2h18V3H3z'/%3E%3C/svg%3E"); mask-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3 21h18v-2H3v2zm0-4h12v-2H3v2zm0-4h18v-2H3v2zm0-4h12V7H3v2zm0-6v2h18V3H3z'/%3E%3C/svg%3E"); }
.eb-rte-icon-align-center { -webkit-mask-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3 21h18v-2H3v2zm4-4h10v-2H7v2zm-4-4h18v-2H3v2zm4-4h10V7H7v2zm-4-6v2h18V3H3z'/%3E%3C/svg%3E"); mask-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3 21h18v-2H3v2zm4-4h10v-2H7v2zm-4-4h18v-2H3v2zm4-4h10V7H7v2zm-4-6v2h18V3H3z'/%3E%3C/svg%3E"); }
.eb-rte-icon-align-right { -webkit-mask-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3 21h18v-2H3v2zm6-4h12v-2H9v2zm-6-4h18v-2H3v2zm6-4h12V7H9v2zm-6-6v2h18V3H3z'/%3E%3C/svg%3E"); mask-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3 21h18v-2H3v2zm6-4h12v-2H9v2zm-6-4h18v-2H3v2zm6-4h12V7H9v2zm-6-6v2h18V3H3z'/%3E%3C/svg%3E"); }
.eb-rte-icon-align-justify { -webkit-mask-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3 21h18v-2H3v2zm0-4h18v-2H3v2zm0-4h18v-2H3v2zm0-4h18V7H3v2zm0-6v2h18V3H3z'/%3E%3C/svg%3E"); mask-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3 21h18v-2H3v2zm0-4h18v-2H3v2zm0-4h18v-2H3v2zm0-4h18V7H3v2zm0-6v2h18V3H3z'/%3E%3C/svg%3E"); }
.eb-rte-icon-link { -webkit-mask-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z'/%3E%3C/svg%3E"); mask-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z'/%3E%3C/svg%3E"); }
.eb-rte-icon-unlink { -webkit-mask-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M17 7h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1 0 1.43-.98 2.63-2.31 2.98l1.46 1.46C20.88 15.61 22 13.95 22 12c0-2.76-2.24-5-5-5zm-3.19 5.09L12 10.3V9h-2v.11l-3 3V13h1.89l3.1-3.1 3.19-3.1zm1.2 5.09c-.31.3-.82.6-1.5.76l1.37 1.37c1.37-.38 2.45-1.28 2.92-2.13h-2.79zM2.27 3L1 4.27 4.73 8H2v4h4.73l3 3H12v-1.73l5.27 5.27L18.54 21 2.27 3zm5.73 10H5.1c0-.75.25-1.42.66-1.97L8 13.27V15H5.1v-2zM12 17H9.27l-3-3H4v-1.9h2.27L12 17z'/%3E%3C/svg%3E"); mask-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M17 7h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1 0 1.43-.98 2.63-2.31 2.98l1.46 1.46C20.88 15.61 22 13.95 22 12c0-2.76-2.24-5-5-5zm-3.19 5.09L12 10.3V9h-2v.11l-3 3V13h1.89l3.1-3.1 3.19-3.1zm1.2 5.09c-.31.3-.82.6-1.5.76l1.37 1.37c1.37-.38 2.45-1.28 2.92-2.13h-2.79zM2.27 3L1 4.27 4.73 8H2v4h4.73l3 3H12v-1.73l5.27 5.27L18.54 21 2.27 3zm5.73 10H5.1c0-.75.25-1.42.66-1.97L8 13.27V15H5.1v-2zM12 17H9.27l-3-3H4v-1.9h2.27L12 17z'/%3E%3C/svg%3E"); }
.eb-rte-icon-wrap { -webkit-mask-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M7 14c-1.66 0-3 1.34-3 3 0 1.31 1.16 2 2 2 .92 1.22 2.49 2 4 2 2.21 0 4-1.79 4-4 0-1.66-1.34-3-3-3zm13.71-9.37l-1.34-1.34c-.39-.39-1.02-.39-1.41 0L9 12.25 11.75 15l8.96-8.96c.39-.39 .39-1.02 0-1.41z'/%3E%3C/svg%3E"); mask-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M7 14c-1.66 0-3 1.34-3 3 0 1.31 1.16 2 2 2 .92 1.22 2.49 2 4 2 2.21 0 4-1.79 4-4 0-1.66-1.34-3-3-3zm13.71-9.37l-1.34-1.34c-.39-.39-1.02-.39-1.41 0L9 12.25 11.75 15l8.96-8.96c.39-.39 .39-1.02 0-1.41z'/%3E%3C/svg%3E"); }

/* ─── Component Selection ────────────────────────────────────────────── */
.gjs-selected {
  outline: 2px solid var(--eb-primary) !important;
  outline-offset: -2px;
}

.gjs-hovered {
  outline: 1px dashed var(--eb-primary) !important;
  outline-offset: -1px;
}

/* ─── Removed conflicting toolbar overrides ─── */

/* ─── Copy Locale Button ─────────────────────────────────────────────── */
.eb-toolbar__add-locale {
  position: relative;
  display: inline-flex;
}

.eb-toolbar__copy-locale {
  position: relative;
  display: inline-flex;
}

.eb-toolbar__copy-menu {
  display: none;
  position: absolute;
  top: 100%;
  right: 0;
  margin-top: 4px;
  background: var(--eb-bg-primary);
  border: 1px solid var(--eb-border);
  border-radius: var(--eb-radius-md);
  box-shadow: var(--eb-shadow-lg);
  min-width: 180px;
  z-index: 100;
  padding: 4px;
}

.eb-toolbar__copy-menu--open {
  display: block;
}

.eb-toolbar__copy-menu-item {
  display: block;
  width: 100%;
  padding: 8px 14px;
  border: none;
  background: transparent;
  text-align: left;
  font-size: 13px;
  font-weight: 500;
  color: var(--eb-text-primary);
  cursor: pointer;
  border-radius: var(--eb-radius-sm);
  font-family: inherit;

  &:hover {
    background: var(--eb-primary-light);
    color: var(--eb-primary);
  }
}

/* ─── Trait Manager (Settings Tab) ─────────────────────────────────────── */
.eb-settings-form {
  padding: 16px;
  border-bottom: 1px solid var(--eb-border);
}

.eb-form-input {
  width: 100%;
  padding: 8px 12px;
  background: var(--eb-bg-secondary);
  border: 1px solid var(--eb-border);
  border-radius: 4px;
  color: var(--eb-text-primary);
  font-family: inherit;
  font-size: 13px;
  margin-top: 8px;
}
.eb-form-input:focus {
  outline: none;
  border-color: var(--eb-primary);
}

.eb-sidebar__panel[data-panel="settings"] > div,
.eb-sidebar__panel[data-panel="settings"] .gjs-traits-c,
.eb-sidebar__panel[data-panel="settings"] .gjs-trt-traits,
.eb-sidebar__panel[data-panel="settings"] .gjs-one-bg,
.eb-sidebar__panel[data-panel="settings"] .gjs-two-bg,
.eb-sidebar__panel[data-panel="settings"] .gjs-three-bg {
  background: var(--eb-bg-primary) !important;
  color: var(--eb-text-primary) !important;
}

.eb-sidebar__panel[data-panel="settings"] .gjs-trt-traits {
  padding: 10px;
}

.eb-sidebar__panel[data-panel="settings"] .gjs-trt-trait {
  background: transparent !important;
  border-bottom: none !important;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  border-radius: 0 !important;
}

.eb-sidebar__panel[data-panel="settings"] .gjs-label-wrp {
  flex: 0 0 35%;
}

.eb-sidebar__panel[data-panel="settings"] .gjs-label {
  color: var(--eb-text-secondary) !important;
  font-weight: 500;
  font-size: 13px;
  padding: 8px 10px !important;
  background: transparent !important;
  border: none !important;
}

.eb-sidebar__panel[data-panel="settings"] .gjs-field-wrp {
  flex: 1;
}

.eb-sidebar__panel[data-panel="settings"] .gjs-field {
  background: var(--eb-bg-secondary) !important;
  color: var(--eb-text-primary) !important;
  border: 1px solid var(--eb-border) !important;
  border-radius: var(--eb-radius-sm);
  box-shadow: none !important;
  display: flex;
  align-items: center;
}

.eb-sidebar__panel[data-panel="settings"] .gjs-field input,
.eb-sidebar__panel[data-panel="settings"] .gjs-field select,
.eb-sidebar__panel[data-panel="settings"] .gjs-field textarea {
  color: var(--eb-text-primary) !important;
  background: transparent !important;
  padding: 8px 12px;
  border: none !important;
  width: 100%;
  font-family: inherit;
  font-size: 13px;
}

.eb-sidebar__panel[data-panel="settings"] .gjs-field-checkbox {
  border: none !important;
  background: transparent !important;
}

.eb-sidebar__panel[data-panel="settings"] .gjs-field-checkbox input {
  width: auto;
  margin-left: 10px;
}

