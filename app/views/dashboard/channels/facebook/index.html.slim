= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "facebook-channels") do
    .fb-index-header
      .fb-title-area
        h2.f-semi-32 = t("dashboard.facebook_channels.index.title")
        p.f-reg-16 = t("dashboard.facebook_channels.index.description")
      = link_to new_channels_facebook_path, class: "fb-btn-primary"
        | + #{t("dashboard.facebook_channels.index.connect_page")}

    .fb-list
      - if @facebook_channels.any?
        - @facebook_channels.each do |channel|
          div.fb-card id=dom_id(channel)
            .fb-card-top
              .fb-card-info
                - if channel.avatar_url.present?
                  img.fb-page-avatar src=channel.avatar_url alt=channel.name
                - else
                  .fb-page-avatar-placeholder
                    | 📘
                .fb-page-details
                  h3.f-semi-16 = channel.name || channel.page_identifier
                  p.fb-page-id
                    | Page ID: #{channel.page_identifier}
              .fb-card-actions
                = link_to edit_channels_facebook_path(channel), class: "fb-action-btn", title: "Edit"
                  | ✏️
                = link_to channels_facebook_path(channel), method: :delete, class: "fb-action-btn fb-action-delete", data: { turbo_method: :delete, turbo_confirm: t("dashboard.facebook_channels.index.delete_confirm") }, title: "Delete"
                  | 🗑️

            .fb-card-meta
              - if channel.reauthorization_required?
                .fb-badge.fb-badge-reauth
                  span.fb-badge-icon ⚠️
                  span = t("dashboard.facebook_channels.index.status_reauth")
                = link_to reconnect_channels_facebook_path(channel), method: :post, class: "fb-reconnect-btn", data: { turbo_method: :post }
                  | 🔄 #{t("dashboard.facebook_channels.index.reconnect")}
              - elsif channel.active?
                .fb-badge.fb-badge-active
                  span.fb-badge-icon 🟢
                  span = t("dashboard.facebook_channels.index.status_active")
              - else
                .fb-badge.fb-badge-disconnected
                  span.fb-badge-icon 🔴
                  span = t("dashboard.facebook_channels.index.status_disconnected")

              .fb-meta-tag
                span.fb-meta-tag-icon 📬
                span = t("dashboard.facebook_channels.index.inboxes_count", count: channel.inboxes.size)

              .fb-meta-tag
                span.fb-meta-tag-icon 🕐
                span = t("dashboard.facebook_channels.index.created_ago", time: time_ago_in_words(channel.created_at))

      - else
        .fb-empty-state
          .fb-empty-icon 📘
          h3.f-semi-18 = t("dashboard.facebook_channels.index.empty_title")
          p.f-reg-14 = t("dashboard.facebook_channels.index.empty_description")
          = link_to new_channels_facebook_path, class: "fb-btn-primary fb-btn-sm"
            | + #{t("dashboard.facebook_channels.index.connect_page")}
