<mjml>
  <mj-include path="./shared/_head.mjml" />
  
  <mj-body background-color="#f3f4f6">
    <mj-section padding="40px 20px">
      <mj-column css-class="email-container">
        
        <mj-include path="./shared/_header.mjml" />

        <mj-section background-color="#ffffff" padding="20px 40px 40px 40px">
          <mj-column>
            <!-- Warning Icon / Header -->
            <mj-text align="center" padding-bottom="24px">
              <!-- Using a standard emoji for the warning icon to keep it simple and external dependency free -->
              <span style="font-size: 48px;">⚠️</span>
            </mj-text>

            <mj-text align="center" font-size="22px" font-weight="700" color="#111827" padding-bottom="16px">
              Action Required: Reauthorize Channel
            </mj-text>

            <mj-text align="left" padding-bottom="16px">
              Hello,
            </mj-text>

            <mj-text align="left" padding-bottom="16px">
              Your <strong>[[ERB= @channel.routing_type.capitalize ]]</strong> channel (<strong>[[ERB= @channel.name ]]</strong>) has been temporarily suspended due to consecutive API errors.
            </mj-text>

            <mj-text align="left" padding-bottom="24px">
              To resume sending and receiving messages, please re-authenticate your channel in the Deskbolic dashboard.
            </mj-text>

            <mj-button href="[[ERB= ENV.fetch('FRONTEND_URL', 'http://localhost:3000') ]]/settings/channels">
              Manage Channels
            </mj-button>

            <mj-text align="left" font-size="14px" color="#6b7280" padding-top="32px">
              If you need assistance, please contact our support team.
            </mj-text>
          </mj-column>
        </mj-section>

        <mj-include path="./shared/_footer.mjml" />

      </mj-column>
    </mj-section>
    
    <!-- Bottom spacing outside the white container -->
    <mj-section padding="24px 0">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#9ca3af">
          <a href="[[ERB= ENV.fetch('FRONTEND_URL', 'http://localhost:3000') ]]" class="footer-link">deskbolic.com</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
