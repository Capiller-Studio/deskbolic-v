/ = render("dashboard/shared/dashboard_container", current_page: "email_templates") do
= render("dashboard/settings/settings_sidebar", current_page: "email_templates") do
  .ui-settings-editor.ui-email-template-editor
    header.ui-settings-editor__header
      = link_to email_templates_path, class: "ui-settings-editor__back", aria: { label: t("shared.back") } do
        = inline_svg_tag("back-arrow.svg", aria: { hidden: true })

      .ui-settings-editor__heading
        h1 = t("dashboard.email_templates.new.title")
        p = t("dashboard.email_templates.new.subtitle")

      .ui-settings-editor__header-actions
        = button_tag type: "submit", form: "new-email-template-form", class: "ui-btn-primary" do
          span = t("ui.dashboard.email_templates.new.create_template")

    = form_with model: @email_template,
      url: email_templates_path,
      method: :post,
      local: true,
      id: "new-email-template-form",
      class: "ui-settings-form ui-settings-editor__form" do |f|
      .ui-settings-editor__body
        .ui-form-card.ui-form-card--roomy.ui-email-template-form
          .ui-form-stack
            .ui-field-group
              = f.label :name, t("forms.labels.template_name"), class: "ui-label"
              .ui-field-control.ui-field-control--plain
                = f.text_field :name,
                  class: "ui-input ui-control",
                  required: true,
                  placeholder: t("ui.dashboard.email_templates.new.e_g_my_custom_reply")

            .ui-field-group
              = f.label :template_type, t("forms.labels.template_type"), class: "ui-label"
              .ui-field-control.ui-field-control--plain.ui-field-control--compact.ui-field-control--no-icon
                = f.select :template_type,
                  EmailTemplate.template_types.slice("conversation_reply", "csat_survey").keys.map { |type| [t("enums.email_template.template_type.#{type}"), type] },
                  {},
                  class: "ui-select ui-control",
                  data: { controller: "select" }
