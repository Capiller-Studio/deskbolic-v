- url = web_widget_channel.persisted? ? channels_web_widget_path(web_widget_channel) : channels_web_widget_index_path
- method = web_widget_channel.persisted? ? :patch : :post
- translations = web_widget_channel.translations.reject(&:marked_for_destruction?).select { |translation| translation.locale.present? }
- translations = [web_widget_channel.translations.build(locale: I18n.default_locale)] if translations.empty?

= form_with(model: web_widget_channel, scope: :web_widget_channel, url: url, method: method, id: "web-widget-channel-form", class: "ui-settings-form", data: { controller: "web-widget-channel" }) do |f|
  - if web_widget_channel.errors.any?
    .ww-error-summary
      h3 = t("dashboard.web_widget_channels.form.error_heading")
      ul
        - web_widget_channel.errors.full_messages.each do |message|
          li = message

  / ─── Basic Details & Inbox ───
  .ww-section.ui-section.ui-section--always-open
    .ww-section-header
      .ww-section-title
        = inline_svg_tag("message.svg", class: "ww-section-icon", alt: t("dashboard.web_widget_channels.form.basic_section"))
        span.ww-section-label = t("dashboard.web_widget_channels.form.basic_section")
    .ww-section-body.channel-edit-select-surface
      .ww-form-row
        div
          = f.label :name, t("dashboard.web_widget_channels.form.name_label"), class: "ww-label"
          = f.text_field :name, class: "ww-input", required: true, placeholder: t("dashboard.web_widget_channels.form.name_placeholder")
        div
          = f.label :allowed_hosts, t("dashboard.web_widget_channels.form.website_url_label"), class: "ww-label"
          .ww-tags-input-container.ww-input data-controller="tags-input" data-action="click->tags-input#focusInput"
            = hidden_field_tag "web_widget_channel[allowed_hosts][]", web_widget_channel.allowed_hosts&.join(", "), data: { "tags-input-target": "hiddenInput" }
            .ww-tags-list data-tags-input-target="tagsContainer"
            input.ww-tags-input-field type="text" data-tags-input-target="input" data-action="keydown->tags-input#handleKeydown blur->tags-input#addTag" placeholder=t("dashboard.web_widget_channels.form.website_url_placeholder")

      .ww-form-row
        div
          = f.label :default_locale, t("forms.labels.default_locale"), class: "ww-label"
          .channel-edit-select.ui-field-control.ui-field-control--no-icon
            = f.select :default_locale, Core::SUPPORTED_LOCALES.map { |l| [I18n.t("languages.#{l.to_s.downcase}"), l] }, {}, { class: "ui-select ui-control", data: { controller: "select" } }

      - if web_widget_channel.primary_inbox
        = render "dashboard/channels/shared/inbox_settings", form: f

  / ─── Appearance & Branding ───
  .ww-section.ui-section data-web-widget-channel-target="appearanceSection"
    .ww-section-header data-action="click->web-widget-channel#toggleSection"
      .ww-section-title
        = inline_svg_tag("setting.svg", class: "ww-section-icon", alt: t("dashboard.web_widget_channels.form.appearance_section"))
        span.ww-section-label = t("dashboard.web_widget_channels.form.appearance_section")
      span.ww-section-chevron
        = inline_svg_tag("dropdown.svg", aria: { hidden: true })
    .ww-section-body.channel-edit-select-surface
      .ww-form-row
        div
          label.ww-label = t("dashboard.web_widget_channels.form.theme_color_label")
          .ww-color-picker-row
            = color_field_tag "web_widget_channel[ui_configurations][theme_color]", web_widget_channel.ui_configurations&.dig("theme_color") || "#0f172a", class: "ww-color-swatch", data: { "web-widget-channel-target": "colorSwatch", "action": "input->web-widget-channel#syncColor" }
            = text_field_tag "web_widget_channel[ui_configurations][theme_color]", web_widget_channel.ui_configurations&.dig("theme_color") || "#0f172a", class: "ww-input", style: "flex: 1;", data: { "web-widget-channel-target": "colorInput", "action": "input->web-widget-channel#syncSwatch" }
        div
          label.ww-label = t("dashboard.web_widget_channels.form.position_label")
          .channel-edit-select.ui-field-control.ui-field-control--no-icon
            = select_tag "web_widget_channel[ui_configurations][position]", options_for_select([[t("dashboard.web_widget_channels.form.position_bottom_right"), "right"], [t("dashboard.web_widget_channels.form.position_bottom_left"), "left"]], web_widget_channel.ui_configurations&.dig("position") || "right"), class: "ui-select ui-control", data: { controller: "select" }

      .ww-toggle-row
        span.ww-toggle-label = t("ui.dashboard.channels.web_widget.form.custom_branding")
        label.ww-toggle
          - if current_account.feature_enabled?(:custom_branding)
            = hidden_field_tag "web_widget_channel[custom_branding]", "0"
            = check_box_tag "web_widget_channel[custom_branding]", "1", web_widget_channel.custom_branding, data: { action: "change->web-widget-channel#toggleCustomBranding" }
            span.ww-toggle-slider
          - else
            = check_box_tag "locked_branding", "0", false, disabled: true
            span.ww-toggle-slider style="background-color: #e2e8f0; cursor: not-allowed;"
            span.ww-locked-badge 🔒 #{t("dashboard.web_widget_channels.form.upgrade_plan")}

      - if current_account.feature_enabled?(:custom_branding)
        .ww-custom-branding-fields data-web-widget-channel-target="customBrandingFields" style="display: #{web_widget_channel.custom_branding ? 'block' : 'none'}; padding-top: 8px;"
          .ww-form-row
            div
              label.ww-label = t("ui.dashboard.channels.web_widget.form.widget_header_logo")
              .ww-dropzone data-controller="dropzone" data-dropzone-max-file-size="2" data-dropzone-max-files="1" data-dropzone-accepted-files=".jpeg,.jpg,.png,.svg"
                = f.file_field :logo, direct_upload: true, "data-dropzone-target" => "input"
                .ww-dropzone-msg.dz-message.needsclick
                  h3 = t("ui.dashboard.channels.web_widget.form.drop_logo_here_or_click_to_upload")
              - if web_widget_channel.logo.attached?
                .ww-uploaded-preview
                  = image_tag web_widget_channel.scaled_logo, class: "ww-uploaded-img"

            div
              label.ww-label = t("ui.dashboard.channels.web_widget.form.chat_bubble_icon_launcher")
              .ww-dropzone data-controller="dropzone" data-dropzone-max-file-size="2" data-dropzone-max-files="1" data-dropzone-accepted-files=".jpeg,.jpg,.png,.svg"
                = f.file_field :launcher_icon, direct_upload: true, "data-dropzone-target" => "input"
                .ww-dropzone-msg.dz-message.needsclick
                  h3 = t("ui.dashboard.channels.web_widget.form.drop_icon_here_or_click_to_upload")
              - if web_widget_channel.launcher_icon.attached?
                .ww-uploaded-preview
                  = image_tag web_widget_channel.scaled_launcher_icon, class: "ww-uploaded-img ww-uploaded-img--round"

          .ww-form-row
            div style="width: 100%;"
              label.ww-label = t("dashboard.popup.ticket.form.custom_footer_label")
              = text_field_tag "web_widget_channel[ui_configurations][footer_text]", web_widget_channel.ui_configurations&.dig("footer_text"), class: "ww-input", placeholder: t("dashboard.channels.web_widget.form.footer_text_placeholder")

  / ─── Module Integrations ───
  .ww-section.ui-section data-web-widget-channel-target="integrationsSection"
    .ww-section-header data-action="click->web-widget-channel#toggleSection"
      .ww-section-title
        = inline_svg_tag("automation.svg", class: "ww-section-icon", alt: t("dashboard.web_widget_channels.form.integrations_section"))
        span.ww-section-label = t("dashboard.web_widget_channels.form.integrations_section")
      span.ww-section-chevron
        = inline_svg_tag("dropdown.svg", aria: { hidden: true })
    .ww-section-body.channel-edit-select-surface
      .ww-form-row
        div
          = f.label :portal_id, t("dashboard.web_widget_channels.form.portal_label"), class: "ww-label"
          .channel-edit-select.ui-field-control.ui-field-control--no-icon
            = f.collection_select :portal_id, @portals, :id, :name, { include_blank: t("forms.options.no_help_center_linked") }, { class: "ui-select ui-control", data: { controller: "select" } }
        div
          label.ww-label = t("ui.dashboard.channels.web_widget.form.pre_chat_form")
          .channel-edit-select.ui-field-control.ui-field-control--no-icon
            = f.collection_select :pre_chat_form_id, @contact_forms, :id, :name, { include_blank: t("forms.options.no_pre_chat_form_linked") }, { class: "ui-select ui-control", data: { controller: "select" } }
      .ww-toggle-row
        span.ww-toggle-label = t("dashboard.web_widget_channels.form.help_center_enabled_label", default: "Enable Help Center")
        label.ww-toggle
          = f.check_box :help_center_enabled
          span.ww-toggle-slider
      .ww-form-row
        div
          label.ww-label = t("dashboard.ai_agents.index.title", default: "AI Agent")
          .channel-edit-select.ui-field-control.ui-field-control--no-icon
            = select_tag "web_widget_channel[primary_inbox_attributes][ai_agent_id]", options_from_collection_for_select(Ai::Agent.active, :id, :name, web_widget_channel.primary_inbox&.ai_agent_id), include_blank: t("forms.options.no_ai_agent_linked", default: "No AI Agent linked"), class: "ui-select ui-control", data: { controller: "select" }
        div
      .ww-form-row
        div
          label.ww-label = t("ui.dashboard.channels.web_widget.form.offline_email_channel")
          = f.hidden_field :fallback_channel_type, value: "Channel::Email"
          .channel-edit-select.ui-field-control.ui-field-control--no-icon
            = f.collection_select :fallback_channel_id, @email_channels, :id, :name, { include_blank: t("forms.options.no_email_channel_linked") }, { class: "ui-select ui-control", data: { controller: "select" } }
        div

  / ─── Widget Behaviors ───
  .ww-section.ui-section data-web-widget-channel-target="behaviorsSection"
    .ww-section-header data-action="click->web-widget-channel#toggleSection"
      .ww-section-title
        = inline_svg_tag("sliders.svg", class: "ww-section-icon", alt: t("dashboard.web_widget_channels.form.behaviors_section"))
        span.ww-section-label = t("dashboard.web_widget_channels.form.behaviors_section")
      span.ww-section-chevron
        = inline_svg_tag("dropdown.svg", aria: { hidden: true })
    .ww-section-body
      .ww-toggle-row
        span.ww-toggle-label = t("dashboard.web_widget_channels.form.anonymous_allowed_label")
        label.ww-toggle
          = f.check_box :anonymous_allowed
          span.ww-toggle-slider

      .ww-toggle-row
        span.ww-toggle-label = t("ui.dashboard.channels.web_widget.form.enforce_secure_identity_hmac")
        label.ww-toggle
          = check_box_tag "web_widget_channel[secure_identity_enforced]", "1", web_widget_channel.secure_identity_enforced?
          span.ww-toggle-slider

  / ─── Translations ───
  .ww-section.ui-section data-web-widget-channel-target="translationsSection"
    .ww-section-header data-action="click->web-widget-channel#toggleSection"
      .ww-section-title
        = inline_svg_tag("translate.svg", class: "ww-section-icon", alt: t("ui.dashboard.channels.contact_form.form.translations"))
        span.ww-section-label = t("ui.dashboard.channels.contact_form.form.translations")
      span.ww-section-chevron
        = inline_svg_tag("dropdown.svg", aria: { hidden: true })
    .ww-section-body.channel-edit-select-surface
      p.ww-section-desc = t("dashboard.web_widget_channels.form.translations_desc", default: "Provide localized strings for your web widget. These will automatically override the default locale based on the customer's browser.")

      - current_locales = translations.map(&:locale).map(&:to_s)
      - available_locales = Core::SUPPORTED_LOCALES.map(&:to_s) - current_locales
      - available_locales_options = available_locales.map { |locale| [I18n.t("languages.#{locale.downcase}", default: locale.upcase), locale] }

      .ui-locale-editor data-controller="nested-translations locale-tabs"
        .ui-locale-tabs data-nested-translations-target="tabContainer"
          - translations.each_with_index do |translation, index|
            - locale = translation.locale.to_s
            - language_name = I18n.t("languages.#{locale.downcase}", default: locale.upcase)
            button.ui-locale-tab class=(index.zero? ? "active" : nil) type="button" data-locale=locale data-locale-tabs-target="tab" data-action="click->locale-tabs#switch"
              span.ui-locale-tab__code = locale.first(2).upcase
              span.translation-language-name = language_name
              - if locale == I18n.default_locale.to_s
                span.ui-locale-tab__meta = t("dashboard.ai_agents.form.default_language", default: "(Default)")

          .ui-locale-picker.ui-field-control
            = select_tag "new_translation_locale", options_for_select(available_locales_options), include_blank: t("forms.options.select_language", default: "Select Language"), class: "ui-select ui-control", data: { controller: "select", "nested-translations-target": "localeSelect", action: "change->nested-translations#addTranslation" }
            span.ui-locale-picker__icon aria-hidden="true"
              = image_tag("ai_agents/new_agent_add_language.svg", alt: "", width: 10.4896, height: 10.4896)

        .ui-locale-panels data-nested-translations-target="panelContainer"
          - translation_index = 0
          = f.fields_for :translations do |translation_form|
            - if translation_form.object.locale.present?
              = render "dashboard/channels/web_widget/translation_fields", f: translation_form, active: translation_index.zero?
              - translation_index += 1

        template data-nested-translations-target="tabTemplate"
          button.ui-locale-tab type="button" data-locale="NEW_LOCALE" data-locale-tabs-target="tab" data-action="click->locale-tabs#switch"
            span.ui-locale-tab__code NEW_CODE
            span.translation-language-name NEW_LANGUAGE

        template data-nested-translations-target="panelTemplate"
          = f.fields_for :translations, Channel::WebWidgetTranslation.new, child_index: "NEW_RECORD" do |translation_form|
            = render "dashboard/channels/web_widget/translation_fields", f: translation_form, active: false
  / ─── Installation & Setup ───
  - if web_widget_channel.persisted?
    = render "dashboard/channels/web_widget/installation", web_widget_channel: web_widget_channel
