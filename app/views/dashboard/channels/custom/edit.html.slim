= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "custom-channels") do
    .channel-theme-custom
      .ui-page-body
        .form-section style="max-width: 800px; margin: 0 auto;"
          .ui-page-header
            = link_to t("dashboard.custom_channels.edit.back"), channels_custom_index_path, class: "ui-back-link"
            
            h2.f-semi-24 style="color: #0f172a; margin-top: 12px;" = @custom_channel.name
            p.f-reg-14 style="color: #64748b; margin-top: 4px;" = @custom_channel.identifier

          = render "instructions", custom_channel: @custom_channel
          = render "form", custom_channel: @custom_channel
