- url = email_channel.persisted? ? channels_email_path(email_channel) : channels_email_index_path
- method = email_channel.persisted? ? :patch : :post

= form_with(model: email_channel, scope: :email_channel, url: url, method: method, id: "email-channel-form", class: "channel-edit__form ui-settings-form", data: { controller: "email-channel" }) do |f|
  - if email_channel.errors.any?
    .ui-error-summary
      h3 = t("dashboard.email_channels.form.error_heading")
      ul
        - email_channel.errors.full_messages.each do |message|
          li = message

  / ─── Basic Details ───
  .ui-section.ui-section--always-open
    .ui-section-header
      .ui-section-title
        = inline_svg_tag("mail.svg", class: "ww-section-icon", alt: t("dashboard.email_channels.form.basic_section"))
        span.ui-section-label = t("dashboard.email_channels.form.basic_section")
    .ui-section-body.channel-edit-select-surface
      .ui-form-row
        div
          = f.label :email, t("dashboard.email_channels.form.email_label"), class: "ui-label"
          = f.email_field :email, class: "ui-input", placeholder: t("ui.dashboard.channels.email.form.support_yourcompany_com")

      - if email_channel.primary_inbox
        .ui-section.channel-edit-select-surface style="margin-top: 24px; margin-bottom: 24px; padding: 16px; background: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0;"
          h3.f-semi-16 style="margin-bottom: 8px;" = t("dashboard.channels.edit.inbox_settings")
          p.f-reg-14.text-muted style="margin-bottom: 16px;" = t("dashboard.email_channels.form.inbox_settings_description")
          
          = f.fields_for :primary_inbox do |inbox_f|
            .ui-toggle-row style="margin-bottom: 16px;"
              span.ui-toggle-label = t("dashboard.custom_channels.form.enable_csat")
              label.ui-toggle
                = inbox_f.check_box :csat_survey_enabled
                span.ui-toggle-slider
            
            .ui-form-row
              div
                = inbox_f.label :csat_survey_id, t("forms.labels.csat_survey"), class: "ui-label"
                .channel-edit-select.ui-field-control.ui-field-control--no-icon
                  = inbox_f.collection_select :csat_survey_id, current_account.csat_surveys, :id, :name, { include_blank: t("forms.options.default_system_survey") }, { class: "ui-select ui-control", data: { controller: "select" } }

              div
                = inbox_f.label :conversation_reply_template_id, t("forms.labels.custom_reply_template"), class: "ui-label"
                .channel-edit-select.ui-field-control.ui-field-control--no-icon
                  = inbox_f.collection_select :conversation_reply_template_id, current_account.email_templates, :id, :name, { include_blank: t("forms.options.default_mailer_view") }, { class: "ui-select ui-control", data: { controller: "select" } }
            
            .ui-form-row
              div
                = inbox_f.label :business_hour_group_id, t("forms.labels.business_hours"), class: "ui-label"
                .channel-edit-select.ui-field-control.ui-field-control--no-icon
                  = inbox_f.collection_select :business_hour_group_id, current_account.business_hour_groups, :id, :name, { include_blank: t("forms.options.always_online_24_7") }, { class: "ui-select ui-control", data: { controller: "select" } }

              div
                = inbox_f.label :sla_policy_ids, t("forms.labels.sla_policies"), class: "ui-label"
                .channel-edit-select.ui-field-control.ui-field-control--no-icon
                  = select_tag "#{inbox_f.object_name}[sla_policy_ids][]", options_from_collection_for_select(current_account.sla_policies, :id, :name, inbox_f.object.sla_policy_ids), multiple: true, class: "ui-select ui-control", data: { controller: "select" }

            = render "dashboard/channels/shared/collaborators_fields", inbox_f: inbox_f

      .ui-form-row
        div
          = f.label :name, t("dashboard.email_channels.form.name_label"), class: "ui-label"
          = f.text_field :name, class: "ui-input", required: true, placeholder: t("dashboard.email_channels.form.name_placeholder")

  / ─── SMTP Configuration ───
  .ui-section data-email-channel-target="smtpSection"
    .ui-section-header data-action="click->email-channel#toggleSection"
      .ui-section-title
        = inline_svg_tag("export.svg", class: "ww-section-icon", alt: t("dashboard.email_channels.form.smtp_section"))
        span.ui-section-label = t("dashboard.email_channels.form.smtp_section")
      span.ui-section-chevron
        = inline_svg_tag("dropdown.svg", aria: { hidden: true })
    .ui-section-body.channel-edit-select-surface
      p.ui-input-hint style="margin-bottom: 16px;" = t("dashboard.email_channels.form.smtp_section_desc")

      .ui-toggle-row style="margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid #e2e8f0;"
        span.ui-toggle-label = t("dashboard.email_channels.form.enable_smtp")
        label.ui-toggle
          = f.check_box :smtp_enabled
          span.ui-toggle-slider

      .ui-form-row
        div
          label.ui-label = t("dashboard.email_channels.form.smtp_address")
          = f.text_field :smtp_address, name: "email_channel[smtp_configurations][address]", value: email_channel.smtp_configurations&.dig("address"), class: "ui-input", placeholder: t("dashboard.email_channels.form.smtp_address_placeholder")
        div
          label.ui-label = t("dashboard.email_channels.form.smtp_port")
          = f.number_field :smtp_port, name: "email_channel[smtp_configurations][port]", value: email_channel.smtp_configurations&.dig("port") || 587, class: "ui-input", placeholder: t("dashboard.email_channels.form.smtp_port_placeholder")

      .ui-form-row
        div
          label.ui-label = t("dashboard.email_channels.form.smtp_username")
          = f.text_field :smtp_username, name: "email_channel[smtp_configurations][username]", value: email_channel.smtp_configurations&.dig("username"), class: "ui-input", placeholder: t("dashboard.email_channels.form.smtp_username_placeholder")
        div
          label.ui-label = t("dashboard.email_channels.form.smtp_password")
          .ui-password-wrapper
            = f.password_field :smtp_password, name: "email_channel[smtp_configurations][password]", class: "ui-input", placeholder: email_channel.smtp_configurations&.dig("password").present? ? "••••••••" : t("dashboard.email_channels.form.smtp_password_placeholder"), autocomplete: "new-password", data: { "email-channel-target": "passwordField" }
            button.ui-password-toggle type="button" data-action="click->email-channel#togglePassword" aria-label=t("dashboard.channels.edit.toggle_token_visibility") aria-pressed="false"
              = inline_svg_tag("password_show.svg", class: "ui-password-toggle__icon ui-password-toggle__icon--show", aria: { hidden: true })
              = inline_svg_tag("password_hide.svg", class: "ui-password-toggle__icon ui-password-toggle__icon--hide", aria: { hidden: true })
          - if email_channel.smtp_configurations&.dig("password").present?
            p.ui-input-hint style="margin-top: 4px;" = t("dashboard.email_channels.form.password_keep_hint", default: "Leave blank to keep existing password.")

      .ui-form-row
        div
          label.ui-label = t("dashboard.email_channels.form.smtp_domain")
          = f.text_field :smtp_domain, name: "email_channel[smtp_configurations][domain]", value: email_channel.smtp_configurations&.dig("domain"), class: "ui-input", placeholder: t("dashboard.email_channels.form.smtp_domain_placeholder")
        div
          label.ui-label = t("dashboard.email_channels.form.smtp_authentication")
          .channel-edit-select.ui-field-control.ui-field-control--no-icon
            = f.select :smtp_authentication, [["Plain", "plain"], ["Login", "login"], ["CRAM-MD5", "cram_md5"]], { selected: email_channel.smtp_configurations&.dig("authentication") || "plain" }, { name: "email_channel[smtp_configurations][authentication]", class: "ui-select ui-control", data: { controller: "select" } }

      .ui-toggle-row
        span.ui-toggle-label = t("dashboard.email_channels.form.smtp_starttls")
        label.ui-toggle
          = f.check_box :smtp_enable_starttls, { checked: email_channel.smtp_configurations&.dig("enable_starttls") != false, name: "email_channel[smtp_configurations][enable_starttls]" }, "true", "false"
          span.ui-toggle-slider

      - if email_channel.persisted?
        div style="display: flex; align-items: center; margin-top: 8px;"
          button.channel-test-btn type="button" data-action="click->email-channel#testSmtp" data-url=test_smtp_channels_email_path(email_channel) data-original-text=t("dashboard.email_channels.form.test_smtp")
            | 🔌 #{t("dashboard.email_channels.form.test_smtp")}
          span.channel-test-result data-email-channel-target="smtpResult" style="display: none;"

  / ─── IMAP Configuration ───
  .ui-section data-email-channel-target="imapSection"
    .ui-section-header data-action="click->email-channel#toggleSection"
      .ui-section-title
        = inline_svg_tag("inbox.svg", class: "ww-section-icon", alt: t("dashboard.email_channels.form.imap_section"))
        span.ui-section-label = t("dashboard.email_channels.form.imap_section")
      span.ui-section-chevron
        = inline_svg_tag("dropdown.svg", aria: { hidden: true })
    .ui-section-body
      p.ui-input-hint style="margin-bottom: 16px;" = t("dashboard.email_channels.form.imap_section_desc")

      .ui-toggle-row style="margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid #e2e8f0;"
        span.ui-toggle-label = t("dashboard.email_channels.form.enable_imap")
        label.ui-toggle
          = f.check_box :imap_enabled
          span.ui-toggle-slider

      .ui-form-row
        div
          label.ui-label = t("dashboard.email_channels.form.imap_address")
          = f.text_field :imap_address, name: "email_channel[imap_configurations][address]", value: email_channel.imap_configurations&.dig("address"), class: "ui-input", placeholder: t("dashboard.email_channels.form.imap_address_placeholder")
        div
          label.ui-label = t("dashboard.email_channels.form.imap_port")
          = f.number_field :imap_port, name: "email_channel[imap_configurations][port]", value: email_channel.imap_configurations&.dig("port") || 993, class: "ui-input", placeholder: t("dashboard.email_channels.form.imap_port_placeholder")

      .ui-form-row
        div
          label.ui-label = t("dashboard.email_channels.form.imap_username")
          = f.text_field :imap_username, name: "email_channel[imap_configurations][username]", value: email_channel.imap_configurations&.dig("username"), class: "ui-input", placeholder: t("dashboard.email_channels.form.imap_username_placeholder")
        div
          label.ui-label = t("dashboard.email_channels.form.imap_password")
          .ui-password-wrapper
            = f.password_field :imap_password, name: "email_channel[imap_configurations][password]", class: "ui-input", placeholder: email_channel.imap_configurations&.dig("password").present? ? "••••••••" : t("dashboard.email_channels.form.imap_password_placeholder"), autocomplete: "new-password", data: { "email-channel-target": "passwordField" }
            button.ui-password-toggle type="button" data-action="click->email-channel#togglePassword" aria-label=t("dashboard.channels.edit.toggle_token_visibility") aria-pressed="false"
              = inline_svg_tag("password_show.svg", class: "ui-password-toggle__icon ui-password-toggle__icon--show", aria: { hidden: true })
              = inline_svg_tag("password_hide.svg", class: "ui-password-toggle__icon ui-password-toggle__icon--hide", aria: { hidden: true })
          - if email_channel.imap_configurations&.dig("password").present?
            p.ui-input-hint style="margin-top: 4px;" = t("dashboard.email_channels.form.password_keep_hint", default: "Leave blank to keep existing password.")

      .ui-toggle-row
        span.ui-toggle-label = t("dashboard.email_channels.form.imap_ssl")
        label.ui-toggle
          = f.check_box :imap_enable_ssl, { checked: email_channel.imap_configurations&.dig("enable_ssl") != false, name: "email_channel[imap_configurations][enable_ssl]" }, "true", "false"
          span.ui-toggle-slider

      - if email_channel.persisted?
        div style="display: flex; align-items: center; margin-top: 8px;"
          button.channel-test-btn type="button" data-action="click->email-channel#testImap" data-url=test_imap_channels_email_path(email_channel) data-original-text=t("dashboard.email_channels.form.test_imap")
            | 🔌 #{t("dashboard.email_channels.form.test_imap")}
          span.channel-test-result data-email-channel-target="imapResult" style="display: none;"
