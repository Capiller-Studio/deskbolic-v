/* Entry point for auth PostCSS build */
@import "dashboard/helpers/colors.postcss";
@import "dashboard/helpers/variables.postcss";
@import "dashboard/helpers/mixins.postcss";
@import "dashboard/helpers/utilities.postcss";
@import "dashboard/basic/base.postcss";
@import "dashboard/components/form.postcss";
@import "dashboard/components/form_wizard.postcss";
@import "dashboard/components/choices.postcss";
@import "dashboard/components/login.postcss";
@import "dashboard/components/register.postcss";
@import "dashboard/components/email_invitation.postcss";
@import "dashboard/components/auth_shell.postcss";
@import "dashboard/components/flash_message.postcss";

.locale-dropdown-container {
  position: absolute;
  bottom: 1.5rem;
  right: 1.5rem;
  z-index: 50;
}

.locale-dropdown-container select {
  padding: 0.5rem 1rem;
  border-radius: 8px;
  border: 1px solid var(--clr-grey-light, #e0e0e0);
  background: white;
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  cursor: pointer;
}

.user-signup-container .form-section {
  background: linear-gradient(
    to top right,
    rgba(119, 141, 255, 1) -100%,
    rgba(255, 255, 255, 1) 50%,
    rgba(119, 141, 255, 1) 200%
  );
}

.user-signup-container .form-control {
  background-color: white !important;
}

.hidden {
  display: none !important;
}
