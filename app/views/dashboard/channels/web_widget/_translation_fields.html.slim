.ww-translation-card
  .ww-translation-header
    div
      span.ww-translation-locale = I18n.t("languages.#{f.object.locale.to_s.downcase}")
      = f.hidden_field :locale
    button.ww-action-delete type="button" data-action="click->nested-translations#removeTranslation" title=t("general.remove_language")
      svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
        path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"
    = f.hidden_field :_destroy, class: "destroy-flag"

  .ww-form-row.ww-translation-row
    div
      label.ww-label = t("dashboard.web_widget_channels.form.welcome_title_label")
      = f.text_field :welcome_title, class: "ww-input ww-translation-input", placeholder: t('dashboard.web_widget_channels.translations.eg_welcome_title')
    div
      label.ww-label = t("dashboard.web_widget_channels.form.welcome_tagline_label")
      = f.text_field :welcome_tagline, class: "ww-input ww-translation-input", placeholder: t('dashboard.web_widget_channels.translations.eg_welcome_tagline')

  .ww-form-row.ww-translation-row
    div
      label.ww-label = t("ui.dashboard.channels.web_widget.translation_fields.launcher_text")
      = f.text_field :launcher_text, class: "ww-input ww-translation-input", placeholder: t('dashboard.web_widget_channels.translations.eg_launcher_text')
    div
      label.ww-label = t("ui.dashboard.channels.web_widget.translation_fields.reply_time_text")
      = f.text_field :reply_time_text, class: "ww-input ww-translation-input", placeholder: t('dashboard.web_widget_channels.translations.eg_reply_time_text')

  .ww-form-row
    div
      label.ww-label = t("ui.dashboard.channels.web_widget.translation_fields.pre_chat_title")
      = f.text_field :pre_chat_title, class: "ww-input ww-translation-input", placeholder: t('dashboard.web_widget_channels.translations.eg_pre_chat_title')
    div
      label.ww-label = t("ui.dashboard.channels.web_widget.translation_fields.pre_chat_subtitle")
      = f.text_field :pre_chat_subtitle, class: "ww-input ww-translation-input", placeholder: t('dashboard.web_widget_channels.translations.eg_pre_chat_subtitle')