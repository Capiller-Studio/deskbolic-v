.confirmation-dialog {
  position: fixed;
  inset: 0;
  width: min(440px, calc(100vw - 32px));
  max-width: none;
  margin: auto;
  padding: 0;
  overflow: hidden;
  color: #1c2434;
  background: $white;
  border: 0;
  border-radius: 16px;
  box-shadow: 0 24px 70px rgba(15, 23, 42, 0.24);
}

.confirmation-dialog[open] {
  animation: confirmation-dialog-in 160ms ease-out;
}

.confirmation-dialog::backdrop {
  background: rgba(15, 23, 42, 0.52);
  backdrop-filter: blur(2px);
  animation: confirmation-backdrop-in 160ms ease-out;
}

.confirmation-dialog__content {
  padding: 28px;
}

.confirmation-dialog__icon {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  margin-bottom: 18px;
  color: #5b6ee1;
  background: #eef1ff;
  border-radius: 50%;
}

.confirmation-dialog__icon svg {
  width: 24px;
  height: 24px;
}

.confirmation-dialog__title {
  margin: 0;
  color: #172033;
  font-family: $font-family-inter-semibold;
  font-size: 19px;
  line-height: 28px;
}

.confirmation-dialog__message {
  margin: 8px 0 0;
  color: #64748b;
  font-family: $font-family-inter-regular;
  font-size: 14px;
  line-height: 22px;
  white-space: pre-line;
}

.confirmation-dialog__actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 26px;
}

.confirmation-dialog__button {
  min-height: 40px;
  padding: 9px 18px;
  border: 1px solid transparent;
  border-radius: 9px;
  font-family: $font-family-inter-semibold;
  font-size: 14px;
  line-height: 20px;
  cursor: pointer;
  transition: background-color 150ms ease, border-color 150ms ease, box-shadow 150ms ease;
}

.confirmation-dialog__button--cancel {
  color: #475569;
  background: $white;
  border-color: #dbe1ea;
}

.confirmation-dialog__button--cancel:hover {
  background: #f8fafc;
  border-color: #cbd5e1;
}

.confirmation-dialog__button--confirm {
  color: $white;
  background: $secondary-purple;
}

.confirmation-dialog__button--confirm:hover {
  background: #6579e8;
}

.confirmation-dialog--danger .confirmation-dialog__icon {
  color: #dc2626;
  background: #fef2f2;
}

.confirmation-dialog--danger .confirmation-dialog__button--confirm {
  background: #dc2626;
}

.confirmation-dialog--danger .confirmation-dialog__button--confirm:hover {
  background: #b91c1c;
}

.confirmation-dialog__button:focus-visible {
  outline: none;
  box-shadow: 0 0 0 3px rgba(119, 141, 255, 0.25);
}

.confirmation-dialog--danger .confirmation-dialog__button--confirm:focus-visible {
  box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.22);
}

body.confirmation-dialog-open {
  overflow: hidden;
}

@keyframes confirmation-dialog-in {
  from {
    opacity: 0;
    transform: translateY(8px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes confirmation-backdrop-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@media (max-width: 480px) {
  .confirmation-dialog__content {
    padding: 22px;
  }

  .confirmation-dialog__actions {
    flex-direction: column-reverse;
  }

  .confirmation-dialog__button {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .confirmation-dialog[open],
  .confirmation-dialog::backdrop {
    animation: none;
  }

  .confirmation-dialog__button {
    transition: none;
  }
}