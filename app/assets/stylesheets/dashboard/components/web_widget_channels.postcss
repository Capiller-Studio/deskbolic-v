/* Web Widget Channels Specific Styles */

.ww-embed-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 16px;
  padding: 12px 16px;
  background: #1e1e1e;
  border-radius: 12px;
}

.ww-embed-label {
  font-size: 11px;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  font-family: var(--font-family-inter-medium);
  white-space: nowrap;
}

.ww-embed-code {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.ww-embed-input {
  width: 100%;
  font-family: 'SF Mono', 'Fira Code', monospace;
  font-size: 13px;
  color: #a78bfa;
  background: transparent;
  border: none;
  outline: none;
  padding: 0;
  white-space: nowrap;
}

.ww-copy-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  background: #334155;
  color: #f8fafc;
  border: none;
  border-radius: 6px;
  font-size: 12px;
  font-family: var(--font-family-inter-medium);
  cursor: pointer;
  transition: all 0.2s ease;
}

.ww-copy-btn:hover {
  background: #475569;
}

.ww-copy-btn.ui-copy-btn--copied {
  background: #10b981;
  color: #fff;
}

.ww-color-picker-row {
  display: flex;
  align-items: center;
  gap: 12px;
}

.ww-color-swatch {
  width: 42px;
  height: 42px;
  padding: 0;
  border: 1px solid var(--black-10);
  border-radius: 10px;
  cursor: pointer;
  background: none;
  overflow: hidden;
}

.ww-color-swatch::-webkit-color-swatch-wrapper {
  padding: 0;
}

.ww-color-swatch::-webkit-color-swatch {
  border: none;
  border-radius: 8px;
}

.ww-translation-block {
  border: 1px solid #e2e8f0;
  padding: 16px;
  border-radius: 8px;
  margin-bottom: 16px;
  position: relative;
  background-color: #f8fafc;
}

.ww-remove-btn {
  position: absolute;
  right: 16px;
  top: 16px;
}

.ww-translation-row {
  margin-bottom: 12px;
}

.ww-locale-row {
  width: 50%;
  margin-bottom: 16px;
}

.ww-locale-display {
  background-color: #f1f5f9;
  color: #64748b;
  font-weight: 600;
  cursor: default;
  border-color: transparent;
}

.ww-translation-input {
  background-color: white;
}

/* ═══════════════════════════════════════════════════════════════════════
   Web Widget Theme Configuration
   ═══════════════════════════════════════════════════════════════════════ */
.channel-theme-web-widget {
  --channel-brand: #0f172a;
  --channel-brand-hover: #1e293b;
}
