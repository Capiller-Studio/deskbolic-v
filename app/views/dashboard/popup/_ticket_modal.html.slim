.model-content-section
  .model-content
    .modal-header
      h3 = t("ui.dashboard.popup.email_conv_modal.new_conversation")
      = inline_svg_tag("cross_button.svg", alt:t("ui.dashboard.agent.agent_sidebar.menu"), class:"conversation-icon m-close", data: { action: "click->modal-toggler#hideModal" })
    .modal-body 
      = form_with(url: "#", data: {controller: "form-validation renderer", "form-validation-target" => "form"}, html: {class: "needs-validation", novalidate: true, method: :post}) do |f|
        .add-customer-container
          .left-panel
            .add-customer
              = inline_svg_tag("plus_icon.svg", class:"plus-icon ml-auto", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
              p.add-tag.f-semi-14 = t("ui.dashboard.popup.ticket_modal.add_customer")
              .customer.ui-select
                = select_tag :customer_id, options_for_select(current_account.customers.map { |c| [c.name, c.id] }), { class: "f-reg-14 field form-control", data: { controller: "select" }, required: true, include_blank: t("forms.options.select_a_customer") }

            .message-box
              = f.text_area :response, class: "f-reg-14  note-area form-control", placeholder: t("dashboard.messages.response_placeholder"), required: true
              .commands
                .send-button
                  = f.submit t("dashboard.messages.send"), class: "f-semi-12 button",data: { action: "click->form-validation#validate click->modal-toggler#hideModal" }
          .right-panel.ui-select
            = select_tag :ticket_type, options_for_select([[t("forms.options.customer_ticket")], [t("forms.options.back_office_ticket")], [t("forms.options.tracker_ticket")]]), { class: "f-reg-14 form-control ", data: { controller: "select" }}

            .team.ui-select
              p.f-semi-14.team-label = t("dashboard.conversation_details.team")
              = select_tag :team_id, options_for_select(Team.where(account: current_account).all.map { |c| [c.name, c.id] }),{ class: "f-reg-14 form-control ", data: { controller: "select" }, required: true}
            .form-fields
              .form-floating
                = f.label :title,"Title", class: "f-semi-14 form-label"
                = f.text_field :title, class: "f-reg-14 form-control", placeholder: t("dashboard.popup.ticket.form.title_placeholder"),required: true
              .form-floating
                = f.label :description, t("forms.labels.description"), class: "f-semi-14 form-label"
                = f.text_area :description, class: "f-reg-14  note-area form-control", placeholder: t("dashboard.popup.ticket.form.description_placeholder"), required: true
              
