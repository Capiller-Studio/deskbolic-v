- show_unread_divider = (defined?(@unread_start_message_id) && @unread_start_message_id == message.id) || (defined?(show_divider) && show_divider && message.incoming?)
- translation_target_language = t("languages.#{I18n.locale.to_s.downcase}", default: I18n.locale.to_s)
- message_time = message.created_at.strftime('%H:%M')
- delivery_status = message_delivery_status(message)

- if show_unread_divider
  .unread-divider data-controller="fade-out"
    span.f-med-12 = t('dashboard.messages.new_messages')

- if message.sender_type == 'Customer'
  .user-response.response id=dom_id(message) data-controller="translator" data-translator-translate-url-value=translate_message_path(message) data-translator-target="response"
    .text-content
      .chat-user
        - customer = message.sender
        - if customer.avatar.attached?
          = image_tag(customer.avatar, class: 'img', alt: full_name(customer))
        - else
          .img.avatar-fallback.customer-message-initials-avatar.f-reg-12 class=avatar_fallback_color_class(full_name(customer))
            = initials(customer)
      .user-text
        - if message.deleted?
          .original.message-deleted-content
            span.f-light-italic-14 = t('dashboard.messages.message_unsent')
          .message-status-container
            .msg-time = message_time
        - else
          - if message.reply_to_message.present?
            .reply-to-context
              .reply-to-sender = message.reply_to_message.sender.try(:name) || message.reply_to_message.sender.try(:display_name) || message.reply_to_message.sender_type
              .reply-to-content = ActionView::Base.full_sanitizer.sanitize(message.reply_to_message.content.to_s).strip.truncate(80)
          - if message.content.present?
            - single_emoji = single_emoji_message?(message.content)
            .original data-translator-target="original" class=(single_emoji ? 'single-emoji-message' : 'f-reg-14')
              - if single_emoji
                = message.content.strip
              - else
                == sanitize(message.content, tags: Parser::MailParser::ALLOWED_TAGS, attributes: Parser::MailParser::ALLOWED_ATTRIBUTES)
            .message-status-container
              .msg-time = message_time
              - if message.edited?
                span.msg-edited-indicator title=t('dashboard.messages.edited_at', time: message.edited_at&.strftime('%H:%M')) = " (#{t('dashboard.messages.edited')})"
            - unless single_emoji
              .translate-text
                button.translate-button type="button" data-action="click->translator#toggle_translate" aria-label=t('dashboard.messages.translate', language: translation_target_language)
                  = inline_svg_tag('translate.svg', class: 'translate-button-icon', aria: { hidden: true })
                  span = t('dashboard.messages.translate', language: translation_target_language)
              .translated-text.d-none
                h5.f-med-10 = t('dashboard.messages.translation_header', language: translation_target_language)
                div
                  .translation.f-light-italic-12 data-translator-target="translation"
                  span.f-med-10.close-translation data-action="click->translator#toggle" = t('dashboard.messages.close')
          - if message.attachments.any?
            .msg-attachments
              - message.attachments.each do |attachment|
                - if attachment.audio? && attachment.file.attached?
                  .msg-attachment-audio
                    audio controls=true preload="metadata" src=rails_blob_path(attachment.file)
                - elsif attachment.image? && attachment.file.attached?
                  .msg-attachment-img
                    = image_tag(attachment.file, class: 'attachment-image')
                - elsif attachment.file.attached?
                  a.msg-attachment-file href=rails_blob_path(attachment.file, disposition: 'attachment') target="_blank"
                    span.file-icon 📄
                    span.file-name = attachment.file.filename
            - if message.content.blank?
              .message-status-container
                .msg-time = message_time
                - if message.edited?
                  span.msg-edited-indicator title=t('dashboard.messages.edited_at', time: message.edited_at&.strftime('%H:%M')) = " (#{t('dashboard.messages.edited')})"
        - if message.reactions.any?
          .message-reactions-container
            - message.reactions.group_by(&:emoji).each do |emoji, reactions_list|
              - reactor_names = reactions_list.map { |r| r.sender.try(:name) || r.sender.try(:display_name) || r.sender.try(:first_name) || r.sender_type }.compact.join(', ')
              .reaction-pill title=reactor_names
                span.reaction-emoji = emoji
                - if reactions_list.size > 1
                  span.reaction-count = reactions_list.size

- if ['User', 'Ai::Agent', 'Account'].include?(message.sender_type)
  - is_private = message.personal?
  - single_emoji = message.content.present? && single_emoji_message?(ActionView::Base.full_sanitizer.sanitize(message.content.to_s).strip)
  .agent-response.response id=dom_id(message) data-controller="translator" data-translator-translate-url-value=translate_message_path(message) data-translator-target="response"
    .agent-text
      .agent-message-sender = message.sender.try(:display_name).presence || message.sender.try(:name).presence || message.sender_type.humanize
      - if message.deleted?
        .original.message-deleted-content
          span.f-light-italic-14 = t('dashboard.messages.message_unsent')
        .message-status-container
          - if is_private
            = inline_svg_tag('lock_orange.svg', class: 'lock', aria: { hidden: true })
          .msg-time = message_time
          span.msg-delivery-state = "· #{delivery_status}"
      - else
        - if message.reply_to_message.present?
          .reply-to-context
            .reply-to-sender = message.reply_to_message.sender.try(:name) || message.reply_to_message.sender.try(:display_name) || message.reply_to_message.sender_type
            .reply-to-content = ActionView::Base.full_sanitizer.sanitize(message.reply_to_message.content.to_s).strip.truncate(80)
        - if message.csat?
          .conversation-csat-card
            .csat-survey-header
              .csat-survey-badge
                span.csat-survey-icon ⭐
                span.csat-survey-badge-title = t('dashboard.csat.survey_badge', default: 'Customer Satisfaction Survey')
            .csat-survey-body
              p.csat-survey-title = t('dashboard.csat.survey_sent_to_customer', default: 'Customer satisfaction survey was sent to the customer.')
            - if message.csat_survey_response&.submitted?
              .csat-survey-rating
                span.csat-rating-stars = "★" * message.csat_survey_response.rating.to_i
                span.csat-rating-score = "#{message.csat_survey_response.rating} / 5"
              - if message.csat_survey_response.content.present?
                .csat-feedback-quote
                  .csat-feedback-label = t('dashboard.csat.customer_feedback', default: 'Customer Feedback:')
                  p.csat-feedback-text = message.csat_survey_response.content
            - else
              .csat-survey-pending
                span = t('dashboard.csat.awaiting_rating', default: 'Awaiting customer response')
        - elsif message.content.present?
          .original data-translator-target="original" class=[(single_emoji ? 'single-emoji-message' : 'f-reg-14'), (is_private ? 'private-note-bg' : nil)]
            - if single_emoji
              == message.content
            - else
              == sanitize(message.content, tags: Parser::MailParser::ALLOWED_TAGS, attributes: Parser::MailParser::ALLOWED_ATTRIBUTES)
        - if message.attachments.any?
          .msg-attachments
            - message.attachments.each do |attachment|
              - if attachment.audio? && attachment.file.attached?
                .msg-attachment-audio
                  audio controls=true preload="metadata" src=rails_blob_path(attachment.file)
              - elsif attachment.image? && attachment.file.attached?
                .msg-attachment-img
                  = image_tag(attachment.file, class: 'attachment-image')
              - elsif attachment.file.attached?
                a.msg-attachment-file href=rails_blob_path(attachment.file, disposition: 'attachment') target="_blank"
                  span.file-icon 📄
                  span.file-name = attachment.file.filename
        - if message.content.present? || message.attachments.any?
          .message-status-container class=('message-status-container--failed' if message.failed?)
            - if is_private
              = inline_svg_tag('lock_orange.svg', class: 'lock', aria: { hidden: true })
            .msg-time = message_time
            - if message.edited?
              span.msg-edited-indicator title=t('dashboard.messages.edited_at', time: message.edited_at&.strftime('%H:%M')) = " (#{t('dashboard.messages.edited')})"
            span.msg-delivery-state = "· #{delivery_status}"
      - if message.reactions.any?
        .message-reactions-container
          - message.reactions.group_by(&:emoji).each do |emoji, reactions_list|
            - reactor_names = reactions_list.map { |r| r.sender.try(:name) || r.sender.try(:display_name) || r.sender.try(:first_name) || r.sender_type }.compact.join(', ')
            .reaction-pill title=reactor_names
              span.reaction-emoji = emoji
              - if reactions_list.size > 1
                span.reaction-count = reactions_list.size
