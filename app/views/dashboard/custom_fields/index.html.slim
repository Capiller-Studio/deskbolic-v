/ = render("dashboard/shared/dashboard_container", current_page: "settings") do
= render("dashboard/settings/settings_sidebar", current_page: "custom-fields") do
  .ui-settings-page
    header.ui-settings-page__header
      .ui-settings-page__heading
        h1 = t("dashboard.settings_index.custom_fields")
        p = t("ui.dashboard.custom_fields.index.master_data_attributes_for_personalized_customer_experiences")
      = link_to new_custom_field_path, class: "ui-settings-page__action" do
        span = t("ui.dashboard.custom_fields.index.create_new_field").delete_prefix("+ ")
        = inline_svg_tag("plus_white.svg", class: "ui-settings-page__action-icon", aria: { hidden: true })

    .ui-list
      - if @custom_fields.any?
        - @custom_fields.each do |field|
          div.ui-card
            .ui-card-top
              .ui-card-info
                h3.f-semi-16 = field.key
                p.f-reg-13.text-muted style="margin-top: 4px;" = field.entity_type.titleize
              .ui-card-actions
                = link_to edit_custom_field_path(field), class: "ui-action-btn", title: t("dashboard.skills.index.edit")
                  | ✏️
                = link_to custom_field_path(field), method: :delete, class: "ui-action-btn ui-action-delete", data: { turbo_method: :delete, turbo_confirm: t("dashboard.custom_fields.index.delete_confirm") }, title: t("dashboard.skills.index.delete")
                  | 🗑️

            .ui-card-meta
              .ui-meta-tag
                span.ui-meta-tag-icon 📝
                span = t("ui.dashboard.custom_fields.index.input_type", titleize: field.field_type.titleize)
              - if field.required?
                .ui-badge style="background: #fee2e2; color: #991b1b;"
                  span = t("dashboard.contact_form_channels.form.required_label")
              - if field.searchable?
                .ui-badge style="background: #dcfce7; color: #166534;"
                  span = t("ui.dashboard.custom_fields.form.searchable")

              .ui-meta-tag
                span.ui-meta-tag-icon 🕐
                span = t("ui.dashboard.custom_fields.index.created_ago", date: time_ago_in_words(field.created_at))

            - if field.translations.any?
              .channel-forward-row style="margin-top: 12px; display: flex; gap: 8px;"
                span.channel-forward-label Locales:
                - field.translations.pluck(:locale).each do |locale|
                  span style="background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-size: 11px; font-weight: 600; color: #475569;" = locale.upcase
      - else
        .ui-empty-state
          h3.f-semi-18 = t("ui.dashboard.custom_fields.index.no_custom_fields_found")
          p.f-reg-14.text-muted = t("ui.dashboard.custom_fields.index.create_your_first_custom_field_to_start_tracking_rich_customer")
          = link_to new_custom_field_path, class: "ui-btn-primary"
            | #{t("ui.dashboard.custom_fields.index.create_new_field")}
