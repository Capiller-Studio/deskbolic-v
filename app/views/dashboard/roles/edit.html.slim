= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "roles") do
    .roles-editor-page
      .roles-editor-backbar
        = link_to roles_path, class: "roles-back-link" do
          = inline_svg_tag("arrow_left.svg", class: "roles-icon")
          = t("dashboard.roles.form.back_label", default: "Back")
      .roles-editor-content
        .roles-editor-header
          div
            h1 = t("dashboard.roles.edit.title", name: @role.name)
            p = t("dashboard.roles.edit.description")
          - unless @role.system_provided?
            button.roles-primary-button type="submit" form=dom_id(@role, :form)
              = t("dashboard.roles.form.save")
        = render "form", role: @role
