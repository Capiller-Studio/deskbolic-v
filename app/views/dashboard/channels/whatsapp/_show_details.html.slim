section.channel-edit-section.channel-edit-card
  .channel-edit-section__heading.channel-edit-section__heading--with-description
    .channel-edit-section__icon
      = inline_svg_tag("code_snipet.svg", aria: { hidden: true })
    .channel-edit-section__heading-copy
      h2 = t("dashboard.channels.edit.integration_details", default: "Integration Details")
      p = t("dashboard.channels.show.whatsapp_webhook_description", default: "Use this public endpoint when reviewing the channel in Meta.")
  .channel-edit-section__body
    .channel-edit-copy data-controller="clipboard"
      label = t("dashboard.whatsapp_channels.edit.webhook.url_label", default: "Webhook URL")
      .channel-edit-copy__control
        input type="text" value=channel.webhook_url readonly=true data-clipboard-target="source"
        button.channel-edit-copy__button type="button" data-action="click->clipboard#copy" data-clipboard-target="button"
          = inline_svg_tag("copy.svg", aria: { hidden: true })
          span = t("general.copy")

section.channel-edit-section.channel-edit-card
  .channel-edit-section__heading.channel-edit-section__heading--with-description
    .channel-edit-section__icon
      = inline_svg_tag("message.svg", aria: { hidden: true })
    .channel-edit-section__heading-copy
      h2 = t("dashboard.whatsapp_channels.edit.whatsapp_templates_title", default: "WhatsApp Message Templates")
      p = t("dashboard.whatsapp_channels.edit.whatsapp_templates_desc", default: "Approved templates available for starting conversations.")
  .channel-edit-section__body
    dl.channel-show-details
      .channel-show-details__item
        dt = t("dashboard.channels.show.approved_templates", default: "Approved Templates")
        dd = channel.approved_templates.size
      .channel-show-details__item
        dt = t("dashboard.channels.show.last_synced", default: "Last Synced")
        dd = channel.templates_synced_at.present? ? time_ago_in_words(channel.templates_synced_at) : t("general.never", default: "Never")
      .channel-show-details__item
        dt = t("dashboard.whatsapp_channels.form.template_name_label", default: "Selected Template")
        dd = channel.template_name.presence || t("dashboard.channels.edit.none_selected", default: "None selected")
      .channel-show-details__item
        dt = t("dashboard.whatsapp_channels.form.template_language_label", default: "Template Language")
        dd = channel.template_language

    - if channel.approved_templates.any?
      .channel-show-template-list
        - channel.approved_templates.each do |template|
          .channel-show-template
            strong = template["name"]
            span = [template["language"], template["category"]].compact.join(" · ")

    - if channel_overview_policy(channel).edit?
      = link_to sync_templates_channels_whatsapp_path(id: channel.id), class: "channel-edit__button channel-edit__button--secondary channel-show-action", data: { turbo_method: :post } do
        = inline_svg_tag("refresh.svg", aria: { hidden: true })
        span = t("dashboard.whatsapp_channels.edit.sync_templates_btn", default: "Sync Templates")
