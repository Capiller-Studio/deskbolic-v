= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "all-channels") do
    .ui-settings-page.channel-index data-controller="modal-toggler frame-toggler"
      = render("dashboard/shared/modal_popper")
      header.ui-settings-page__header
        .ui-settings-page__heading
          h1 = t("dashboard.channels_overview.title", default: "Channels")
          p = t("dashboard.channels_overview.description", default: "Manage all your connected communication channels.")

        .tm-users-header-actions
          button.tm-users-invite.tm-team-modal-button type="button" data-action="click->modal-toggler#showModal click->frame-toggler#loadModal" data-popup-view="_new_channel_modal"
            span = t("dashboard.channels_overview.add_channel", default: "Add new channel")
            = inline_svg_tag("plus_white.svg", class:"plus-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))

      main.ui-settings-page__content
        nav.channel-tabs aria-label=t("dashboard.channels_overview.filter_label", default: "Filter channels by type")
          = link_to channels_settings_path,
            class: ["channel-tab", "channel-tab--all", ("channel-tab--active" if @selected_type == "all")],
            aria: { current: ("page" if @selected_type == "all"), label: t("dashboard.channels_overview.all_channels", default: "All Channels") } do
            span.channel-tab__label.channel-tab__label--full = t("dashboard.channels_overview.all_channels", default: "All Channels")
            span.channel-tab__label.channel-tab__label--compact = t("dashboard.channels_overview.all", default: "All")
            small = @channel_counts.values.sum

          - @channel_counts.each do |type, count|
            = link_to channels_settings_path(type: type),
              class: ["channel-tab", "channel-tab--#{type.dasherize}", ("channel-tab--active" if @selected_type == type)],
              aria: { current: ("page" if @selected_type == type), label: channel_overview_type_label(type) } do
              = image_tag channel_overview_icon(type), alt: "", aria: { hidden: true }
              span.channel-tab__label = channel_overview_type_label(type)
              small = count

        - if @channels.any?
          section.channel-grid aria-live="polite"
            - @channels.each do |channel|
              - type = channel_overview_type(channel)
              - status = channel_overview_status(channel)
              - channel_policy = channel_overview_policy(channel)
              article.channel-card id=dom_id(channel) class="channel-card--#{type.dasherize}"
                .channel-card__body
                  .channel-card__identity
                    .channel-card__avatar
                      - if (logo = channel_overview_logo(channel))
                        = image_tag logo, alt: channel_overview_name(channel)
                      - else
                        = image_tag channel_overview_icon(channel), class: "channel-card__avatar-icon", alt: "", aria: { hidden: true }

                    .channel-card__copy
                      .channel-card__title
                        h2 = channel_overview_name(channel)
                        - if @selected_type == "all"
                          span.channel-card__type class="channel-card__type--#{type.dasherize}"
                            = channel_overview_type_label(channel)
                      - if channel_overview_identifier(channel).present?
                        p.channel-card__identifier = channel_overview_identifier(channel)
                      - if (token_message = channel_overview_token_message(channel))
                        p.channel-card__token-warning = token_message

                  - if channel_policy.edit? || channel_policy.destroy?
                    - menu_id = dom_id(channel, :actions)
                    .channel-card__actions
                      button type="button" aria-label=t("dashboard.channels_overview.actions", default: "Channel actions") popovertarget=menu_id
                        = inline_svg_tag("dots.svg", aria: { hidden: true })
                      .channel-card__menu id=menu_id popover="auto" role="menu"
                        - if channel_policy.edit?
                          = link_to channel_overview_edit_path(channel), role: "menuitem" do
                            = inline_svg_tag("edit.svg", aria: { hidden: true })
                            span = t("general.edit", default: "Edit")
                        - if channel_policy.edit? && channel_policy.destroy?
                          .channel-card__menu-divider
                        - if channel_policy.destroy?
                          = link_to channel_overview_destroy_path(channel),
                            class: "channel-card__delete",
                            role: "menuitem",
                            data: { turbo_method: :delete, turbo_confirm: t("dashboard.channels_overview.delete_confirm", name: channel_overview_name(channel), default: "Delete %{name}?") } do
                            = inline_svg_tag("delete_red.svg", aria: { hidden: true })
                            span = t("general.delete", default: "Delete")

                footer.channel-card__footer
                  .channel-card__created
                    = inline_svg_tag("clock.svg", aria: { hidden: true })
                    span = t("dashboard.channels_overview.created_ago", time: time_ago_in_words(channel.created_at), default: "Created %{time} ago")
                  .channel-card__status class="channel-card__status--#{status}"
                    span.channel-card__status-dot aria-hidden="true"
                    span = t("dashboard.channels_overview.status.#{status}", default: status.humanize)
        - else
          .channel-empty
            .channel-empty__icon
              = image_tag channel_overview_icon(@selected_type == "all" ? "custom" : @selected_type), alt: "", aria: { hidden: true }
            h2 = t("dashboard.channels_overview.empty_title", default: "No channels found")
            - if @selected_type == "all"
              p = t("dashboard.channels_overview.empty_description", default: "Connect a channel to start receiving customer conversations in Deskbolic.")
            - else
              p = t("dashboard.channels_overview.empty_filtered_description", type: channel_overview_type_label(@selected_type), default: "You haven't connected any %{type} channels yet.")
