- content_for :head do
  = stylesheet_link_tag "subscriptions"

- plan_themes = ["symbolic", "anabolic", "hyperbolic", "parabolic"]
- plan_icons = ["skills.svg", "segment.svg", "star_plus.svg", "bag.svg"]

.ap-subscription-page
  .ap-subscription-container data-controller="billing-toggle"
    .ap-subscription-header
      h1.ap-subscription-title
        = I18n.t("dashboard.billing.subscription_page.title_prefix")
        span = " #{I18n.t("dashboard.billing.subscription_page.title_highlight")}"
      p.ap-subscription-subtitle
        = I18n.t("dashboard.billing.subscription_page.subtitle_first_line")
        br.ap-subscription-subtitle-break
        = " #{I18n.t("dashboard.billing.subscription_page.subtitle_second_line")}"

    .ap-billing-cycle-toggle.ap-subscription-cycle-toggle
      span.ap-billing-cycle-label.ap-billing-cycle-active data-billing-toggle-target="monthlyLabel" = I18n.t("dashboard.billing.monthly_label")
      label.ap-billing-toggle-switch
        input type="checkbox" data-billing-toggle-target="toggle" data-action="change->billing-toggle#toggle"
        span.ap-billing-toggle-slider
      span.ap-billing-cycle-label data-billing-toggle-target="yearlyLabel"
        = I18n.t("dashboard.billing.yearly")
        span.ap-billing-save-badge = I18n.t("dashboard.billing.subscription_page.annual_savings")

    .ap-subscription-grid
      - @available_plans.each_with_index do |plan, index|
        - theme = plan_themes[index] || plan_themes.last
        article.ap-subscription-card class="ap-subscription-card--#{theme} #{'ap-subscription-card--popular' if theme == 'hyperbolic'}"
          - if theme == "hyperbolic"
            .ap-subscription-popular-badge
              = image_tag "star.svg", alt: "", class: "ap-subscription-popular-icon"
              = I18n.t("dashboard.billing.subscription_page.most_popular").upcase

          .ap-subscription-card-body
            .ap-subscription-icon-wrap
              = image_tag plan_icons[index] || plan_icons.last, alt: "", class: "ap-subscription-plan-icon"
            h2.ap-subscription-plan-name = plan.display_name
            p.ap-subscription-desc = plan.description

            .ap-subscription-price-row
              span.ap-subscription-price data-billing-toggle-target="price" data-monthly-price=plan.base_price data-annual-price=plan.annual_price data-currency=plan.currency.upcase
                = number_to_currency(plan.base_price, unit: plan.currency.upcase + " ", precision: 0)
              span.ap-subscription-period data-billing-toggle-target="period" = I18n.t("dashboard.billing.subscription_page.per_month")
            - if plan.annual_price.positive? && plan.base_price.positive?
              p.ap-subscription-annual-note data-billing-toggle-target="annualNote"
                = I18n.t("dashboard.billing.subscription_page.annual_billing", amount: number_to_currency(plan.annual_price, unit: plan.currency.upcase + " ", precision: 0))
            - elsif plan.trial_days.positive?
              p.ap-subscription-annual-note
                = I18n.t("dashboard.billing.subscription_page.annual_billing", amount: number_to_currency(plan.annual_price, unit: plan.currency.upcase + " ", precision: 0))
            .ap-subscription-trial-badge
              = plan.trial_days.positive? ? I18n.t("dashboard.billing.subscription_page.trial_badge", days: plan.trial_days) : I18n.t("dashboard.billing.subscription_page.no_free_trial")

            ul.ap-subscription-features
              - plan_features(plan).each do |feature|
                li.ap-subscription-feature-item
                  span.ap-subscription-feature-check
                    = image_tag "tick.svg", alt: ""
                  span.ap-subscription-feature-text = feature

          .ap-subscription-footer
            = form_with url: subscriptions_path, method: :post, data: { turbo: false } do |f|
              = f.hidden_field :plan_id, value: plan.id
              = f.hidden_field :billing_cycle, value: "monthly", class: "billing-cycle-field", data: { billing_toggle_target: "cycleField" }
              = f.hidden_field :quantity, value: [plan.min_users, 1].max
              = f.submit(plan.trial_days.positive? ? I18n.t("dashboard.billing.subscription_page.start_free_trial") : I18n.t("dashboard.billing.subscription_page.get_started"), class: "ap-subscription-submit")
