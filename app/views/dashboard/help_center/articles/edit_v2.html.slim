- locale = @locale || @article.portal&.default_locale.presence || I18n.locale.to_s
- translation = @article.translations.find { |t| t.locale.to_s == locale.to_s } || @article.translations.first || @article.translations.build(locale: locale)
- portal = @article.portal || @selected_portal
- portal_locales = Array(portal&.locales).presence || [locale]
- existing_locales = @article.translations.map { |t| t.locale.to_s }.uniq
- all_locale_codes = (portal_locales | existing_locales).uniq
- available_to_add = all_locale_codes - existing_locales
- draft_content = translation.draft_content.presence || translation.content.presence || ""
- draft_title = translation.draft_title.presence || translation.title.presence || ""
- has_unpublished = @article.respond_to?(:has_unpublished_changes?) ? @article.has_unpublished_changes?(locale: locale) : false

= render("dashboard/shared/dashboard_container", current_page: "help_center") do
  = render("dashboard/help_center/help_center_sidebar", current_page: "articles") do
    - editor_opts = { class: "hc-form-no-sidebar", data: { \
        controller: "article-editor", \
        "article-editor-update-url-value" => help_center_article_path(id: @article.id), \
        "article-editor-publish-url-value" => publish_help_center_article_path(id: @article.id), \
        "article-editor-discard-url-value" => discard_draft_help_center_article_path(id: @article.id), \
        "article-editor-copy-locale-url-value" => copy_locale_help_center_article_path(id: @article.id), \
        "article-editor-upload-url-value" => attachments_path, \
        "article-editor-article-id-value" => @article.id, \
        "article-editor-csrf-token-value" => form_authenticity_token, \
        "article-editor-draft-content-value" => draft_content, \
        "article-editor-draft-title-value" => draft_title, \
        "article-editor-locale-value" => locale, \
        "article-editor-has-unpublished-changes-value" => has_unpublished, \
        "article-editor-status-value" => (@article.status || "draft"), \
        "article-editor-edit-url-value" => edit_help_center_article_path(id: @article.id) \
      } }
    .ae-editor-page *editor_opts

      /! ─── Top Header Bar ───
      .ae-header
        .ae-header-left
          = link_to help_center_article_path(id: @article.id), class: "ae-back-btn" do
            svg.ae-icon-sm xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
              path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd"
          .ae-locale-area
            /! Locale Switcher
            .ae-dropdown-wrapper
              button.ae-locale-btn type="button" data-action="click->article-editor#toggleLocaleMenu"
                span.ae-locale-flag = locale.upcase
                svg.ae-icon-xs xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                  path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 011.06 0L10 11.94l3.72-3.72a.75.75 0 111.06 1.06l-4.25 4.25a.75.75 0 01-1.06 0L5.22 9.28a.75.75 0 010-1.06z" clip-rule="evenodd"
              .ae-dropdown data-article-editor-target="localeMenu"
                .ae-dropdown-header Locale
                - existing_locales.each do |loc|
                  a.ae-dropdown-item href="#" data-action="click->article-editor#switchLocale" data-locale=loc class=("ae-dropdown-item--active" if loc == locale)
                    span.ae-locale-flag.ae-locale-flag--sm = loc.upcase
                    span = loc.upcase
                    - if loc == locale
                      svg.ae-icon-xs xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                        path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"

            /! Add Locale
            - if available_to_add.any?
              .ae-dropdown-wrapper
                button.ae-add-locale-btn type="button" data-action="click->article-editor#toggleAddLocaleMenu" title="Add locale"
                  | +
                .ae-dropdown data-article-editor-target="addLocaleMenu"
                  .ae-dropdown-header Add Locale
                  - available_to_add.each do |loc|
                    a.ae-dropdown-item href="#" data-action="click->article-editor#addLocale" data-locale=loc
                      span.ae-locale-flag.ae-locale-flag--sm = loc.upcase
                      span = loc.upcase

            /! Copy from Locale
            - if existing_locales.length > 1
              .ae-dropdown-wrapper
                button.ae-copy-locale-btn type="button" data-action="click->article-editor#toggleCopyMenu" title="Copy from another locale"
                  svg.ae-icon-sm xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
                    path d="M7 3.5A1.5 1.5 0 018.5 2h3.879a1.5 1.5 0 011.06.44l3.122 3.12A1.5 1.5 0 0117 6.622V12.5a1.5 1.5 0 01-1.5 1.5h-1v-3.379a3 3 0 00-.879-2.121L10.5 5.379A3 3 0 008.379 4.5H7v-1z"
                    path d="M4.5 6A1.5 1.5 0 003 7.5v9A1.5 1.5 0 004.5 18h7a1.5 1.5 0 001.5-1.5v-5.879a1.5 1.5 0 00-.44-1.06L9.44 6.439A1.5 1.5 0 008.378 6H4.5z"
                .ae-dropdown data-article-editor-target="copyMenu"
                  .ae-dropdown-header Copy content from
                  - existing_locales.reject { |l| l == locale }.each do |source_locale|
                    a.ae-dropdown-item href="#" data-action="click->article-editor#copyFromLocale" data-source-locale=source_locale
                      span.ae-locale-flag.ae-locale-flag--sm = source_locale.upcase
                      span Copy from #{source_locale.upcase}

          span.ae-draft-badge data-article-editor-target="draftBadge"
            = has_unpublished ? "Unsaved changes" : (@article.status || "draft").humanize

        .ae-header-right
          button#ae-save-btn.ae-btn.ae-btn--secondary type="button" data-action="click->article-editor#save"
            | Save Draft
          button#ae-discard-btn.ae-btn.ae-btn--ghost type="button" data-action="click->article-editor#discardDraft"
            | Discard
          button#ae-publish-btn.ae-btn.ae-btn--primary type="button" data-action="click->article-editor#publish"
            | Publish

      /! ─── Editor Body ───
      .ae-body
        .ae-editor-column
          /! Title input
          input.ae-title-input type="text" placeholder="Article title..." value=draft_title data-article-editor-target="titleInput"
          /! Tiptap content area
          .ae-editor-content data-article-editor-target="editorContainer"
          
          /! ─── Bubble Menu ───
          .hc-bubble-menu data-article-editor-target="bubbleMenu"
            button.hc-bubble-btn type="button" data-action="click->article-editor#toggleBold" data-article-editor-target="toolbar" data-format="bold" title="Bold (Cmd+B)" B
            button.hc-bubble-btn type="button" data-action="click->article-editor#toggleItalic" data-article-editor-target="toolbar" data-format="italic" title="Italic (Cmd+I)" I
            button.hc-bubble-btn type="button" data-action="click->article-editor#toggleStrike" data-article-editor-target="toolbar" data-format="strike" title="Strikethrough (Cmd+Shift+S)" S
            .hc-bubble-divider
            button.hc-bubble-btn type="button" data-action="click->article-editor#toggleCode" data-article-editor-target="toolbar" data-format="code" title="Code (Cmd+E)" <>
            button.hc-bubble-btn type="button" data-action="click->article-editor#toggleLink" data-article-editor-target="toolbar" data-format="link" title="Link (Cmd+K)" 🔗

          /! ─── Plus Menu (Block Inserter) ───
          button.hc-plus-menu type="button" data-article-editor-target="plusMenu" data-action="click->article-editor#insertSlashCommand" title="Click to add a block" +

          /! ─── Table Context Menu ───
          .hc-bubble-menu.hc-table-menu data-article-editor-target="tableMenu"
            button.hc-bubble-btn type="button" data-action="click->article-editor#tableAddColumnBefore" title="Add Column Before" +C←
            button.hc-bubble-btn type="button" data-action="click->article-editor#tableAddColumnAfter" title="Add Column After" →C+
            button.hc-bubble-btn.hc-bubble-btn--danger type="button" data-action="click->article-editor#tableDeleteColumn" title="Delete Column" -C
            .hc-bubble-divider
            button.hc-bubble-btn type="button" data-action="click->article-editor#tableAddRowBefore" title="Add Row Before" +R↑
            button.hc-bubble-btn type="button" data-action="click->article-editor#tableAddRowAfter" title="Add Row After" ↓R+
            button.hc-bubble-btn.hc-bubble-btn--danger type="button" data-action="click->article-editor#tableDeleteRow" title="Delete Row" -R
            .hc-bubble-divider
            button.hc-bubble-btn.hc-bubble-btn--danger type="button" data-action="click->article-editor#tableDelete" title="Delete Table" 🗑️

          /! ─── Image Popover ───
          .hc-image-popover data-article-editor-target="imagePopover"
            .hc-image-form data-action="keydown.enter->article-editor#saveImageProperties"
              .hc-form-row
                label Alt Text
                input type="text" data-article-editor-target="imageAltInput" placeholder="Describe the image"
              .hc-form-row.hc-form-row--split
                div
                  label Width
                  input type="text" data-article-editor-target="imageWidthInput" placeholder="e.g. 100% or 400px"
                div
                  label Height
                  input type="text" data-article-editor-target="imageHeightInput" placeholder="e.g. auto or 300px"
              .hc-form-actions
                button.ae-btn.ae-btn--primary.ae-btn--sm type="button" data-action="click->article-editor#saveImageProperties" Save

          /! ─── Accordion Context Menu ───
          .hc-bubble-menu.hc-accordion-menu data-article-editor-target="accordionMenu"
            button.hc-bubble-btn.hc-bubble-btn--danger type="button" data-action="click->article-editor#accordionDelete" title="Delete Accordion" 🗑️ Delete

          /! Hidden file inputs for image/file uploads
          input.ae-hidden-input type="file" accept="image/png, image/jpeg, image/gif, image/webp, image/svg+xml" multiple=true data-article-editor-target="imageInput" data-action="change->article-editor#insertImages"
          input.ae-hidden-input type="file" accept=".pdf,.doc,.docx,.xls,.xlsx,.zip,.txt,.csv" data-article-editor-target="fileInput" data-action="change->article-editor#insertFile"

        /! ─── Side Panel ───
        .ae-side-panel data-article-editor-target="sidePanel"
          .ae-side-section
            h4.ae-side-heading Overview
            .ae-meta-row
              span.ae-meta-label Status
              span.ae-status-pill class="ae-status--#{@article.status || 'draft'}"
                = (@article.status || "draft").humanize
            .ae-meta-row
              span.ae-meta-label Portal
              span.ae-meta-value = portal&.name.presence || "—"
            .ae-meta-row
              span.ae-meta-label Category
              span.ae-meta-value = @article.primary_category&.name.presence || "Uncategorized"
            .ae-meta-row
              span.ae-meta-label Author
              span.ae-meta-value = @article.author&.name.presence || "Unassigned"
            .ae-meta-row
              span.ae-meta-label Last Edit
              span.ae-meta-value = l(@article.updated_at, format: :short) rescue "—"
            .ae-meta-row
              span.ae-meta-label Views
              span.ae-meta-value = number_with_delimiter(@article.views_count)

          - if @article_options.present?
            .ae-side-section
              h4.ae-side-heading Related Articles
              select.ae-related-select multiple=true data-controller="select" data-article-editor-target="relatedArticles" data-action="change->article-editor#updateRelatedArticles"
                - @article_options.each do |option|
                  - selected = @article.related_article_ids.include?(option.id)
                  option value=option.id selected=selected = option.title.presence || "Untitled"

          .ae-side-section
            h4.ae-side-heading Revision History
            .ae-revisions-list
              - @article.activities.order(created_at: :desc).limit(8).each do |activity|
                .ae-revision-item
                  .ae-revision-dot
                  .ae-revision-info
                    span.ae-revision-action = activity.event_key.to_s.split('.').last.humanize
                    span.ae-revision-time = time_ago_in_words(activity.created_at) + " ago"
              - if @article.activities.none?
                p.ae-empty-text No revisions yet

      /! Toast container
      .ae-toast-container data-article-editor-target="toastContainer"