= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "api-channels") do
    .channel-theme-api
      .ui-page-body
        .ui-page-header
          = link_to channels_api_index_path, class: "ui-back-link"
            | ← #{t("general.back", default: "Back")}
            
        .channel-connect-container
          .channel-connect-card
            .channel-connect-visual
              .channel-gradient-ring
                .channel-connect-icon
                  svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="var(--channel-brand, #0f172a)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    polyline points="16 18 22 12 16 6"
                    polyline points="8 6 2 12 8 18"
            
            h3 = t("dashboard.api_channels.new.title", default: "Connect API Channel")
            p = t("dashboard.api_channels.new.description", default: "Create a new API channel to integrate a custom system.")

            = form_with model: @api_channel, url: channels_api_index_path, local: true, class: "ui-form-wrapper", data: { turbo: false } do |f|
              .ui-form-group
                = f.label :name, t("dashboard.api_channels.form.name_label", default: "Channel Name"), class: "ui-label"
                = f.text_field :name, class: "ui-input", placeholder: t("dashboard.api_channels.form.name_placeholder", default: "e.g. Acme CRM Integration"), required: true
                p.f-reg-12.text-gray-500.mt-1 = t("dashboard.api_channels.form.name_hint", default: "A recognizable name for this channel.")

              .ui-form-group
                = f.label :description, t("dashboard.api_channels.form.description_label", default: "Description"), class: "ui-label"
                = f.text_area :description, class: "ui-input", placeholder: t("dashboard.api_channels.form.description_placeholder", default: "Optional details about this integration.")

              .ui-form-group
                = f.label :webhook_url, t("dashboard.api_channels.form.webhook_url_label", default: "Outbound Webhook URL"), class: "ui-label"
                = f.text_field :webhook_url, class: "ui-input", placeholder: "https://..."
                p.f-reg-12.text-gray-500.mt-1 = t("dashboard.api_channels.form.webhook_url_hint", default: "We will POST events to this URL when a reply is sent from this channel.")

              .ui-form-actions
                = link_to t("general.cancel", default: "Cancel"), channels_api_index_path, class: "ui-btn-secondary"
                = f.submit t("general.create", default: "Create Channel"), class: "ui-btn-primary"
