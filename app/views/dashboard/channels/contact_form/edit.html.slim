= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "contact-form-channels") do
    .channel-theme-contact-form
      .ww-page
        .ww-header
          div
            h1 = t("dashboard.contact_form_channels.edit.title")
            p = t("dashboard.contact_form_channels.edit.subtitle", default: "Configure your contact form settings.")
          .ww-header-actions
            = link_to t("ui.dashboard.channels.contact_form.edit.back_to_contact_forms"), channels_contact_form_index_path, class: "ww-back-link"

        .ww-page-body
          .ww-form-layout
            .ww-form-main
              .ww-form-wrapper
                = render "form", contact_form_channel: @contact_form_channel