= render("dashboard/shared/dashboard_container", current_page: "help_desk") do
  = render("dashboard/settings/settings_sidebar", current_page: "") do
    .body-section.st-home-body
      h2.f-semi-18 Home
      .st-home-container data-controller="modalToggler frameToggler"
        .st-home-section
        
          / workspace
          h3 Workspace
          .cards.workspace-cards
            = link_to("#", class:"card") do
              = inline_svg_tag("general.svg", class:"card-icon", alt:"icon")
              .card-desc
                h4.f-semi-14  General
                p.f-reg-12 Set your workspace name, time zone, language, and more.
            = link_to("#", class:"card") do
              = inline_svg_tag("general.svg", class:"card-icon", alt:"icon")
              .card-desc
                h4.f-semi-14  Billing
                p.f-reg-12 Manage your subscription and payment details.
            = link_to(roles_settings_path, class:"card") do
              = inline_svg_tag("general.svg", class:"card-icon", alt:"icon")
              .card-desc
                h4.f-semi-14  Teammates
                p.f-reg-12 Manage or invite teammates and see all activity logs.
            = link_to(office_timings_settings_path, class:"card") do
              = inline_svg_tag("general.svg", class:"card-icon", alt:"icon")
              .card-desc
                h4.f-semi-14  Office Hours
                p.f-reg-12 Choose your office hours to manage customer expectation.
            = link_to("#", class:"card") do
              = inline_svg_tag("general.svg", class:"card-icon", alt:"icon")
              .card-desc
                h4.f-semi-14  Security
                p.f-reg-12 Configure all security settings for your workspace and data.
                
          / help center
          h3 Help Center
          .cards.help-center-cards
            = link_to(help_center_articles_path, class:"card") do
              = inline_svg_tag("green_book.svg", class:"card-icon", alt:"icon")
              .card-desc
