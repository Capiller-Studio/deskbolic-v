.channel-forwarding-panel
  h3.f-semi-18 = t("dashboard.email_channels.forwarding.title")
  p = t("dashboard.email_channels.forwarding.description")

  / ─── Forward Email Address ───
  .channel-forwarding-address
    span.channel-forwarding-address-label = t("dashboard.email_channels.forwarding.your_forwarding_address")
    span.channel-forwarding-address-value data-email-channel-target="forwardEmail" = email_channel.forward_email
    button.ui-copy-btn data-action="click->email-channel#copyForwardEmail" data-email=email_channel.forward_email
      | 📋 #{t("dashboard.email_channels.forwarding.copy")}

  / ─── Forwarding Status ───
  .channel-forwarding-status
    - if email_channel.configurations&.dig("forwarding_verified")
      .ui-badge.ui-badge-active
        span.ui-badge-icon ✓
        span = t("dashboard.email_channels.forwarding.verified")
    - else
      .ui-badge.ui-badge-pending
        span.ui-badge-icon ⏳
        span = t("dashboard.email_channels.forwarding.not_verified")
      button.channel-test-btn.ui-btn-sm data-action="click->email-channel#verifyForwarding" data-url=verify_forwarding_channels_email_path(email_channel) data-email-channel-target="verifyBtn" style="margin-left: 8px;"
        | 🔍 #{t("dashboard.email_channels.forwarding.verify")}

  / ─── Provider Tabs ───
  h4.f-semi-14 style="margin-bottom: 12px; color: #334155;" = t("dashboard.email_channels.forwarding.instructions_title")

  .ui-tabs
    button.ui-tab.ui-tab--active data-action="click->email-channel#selectTab" data-tab="gmail" = t("dashboard.email_channels.forwarding.gmail_title")
    button.ui-tab data-action="click->email-channel#selectTab" data-tab="outlook" = t("dashboard.email_channels.forwarding.outlook_title")
    button.ui-tab data-action="click->email-channel#selectTab" data-tab="yahoo" = t("dashboard.email_channels.forwarding.yahoo_title")
    button.ui-tab data-action="click->email-channel#selectTab" data-tab="other" = t("dashboard.email_channels.forwarding.other_title")

  / ─── Gmail ───
  .ui-tab-content.ui-tab-content--active data-tab-content="gmail"
    ol.ui-steps
      li.ui-step
        span.ui-step-text = t("dashboard.email_channels.forwarding.gmail_step_1")
      li.ui-step
        span.ui-step-text = t("dashboard.email_channels.forwarding.gmail_step_2")
      li.ui-step
        span.ui-step-text = t("dashboard.email_channels.forwarding.gmail_step_3")
      li.ui-step
        span.ui-step-text = t("dashboard.email_channels.forwarding.gmail_step_4")

  / ─── Outlook ───
  .ui-tab-content data-tab-content="outlook"
    ol.ui-steps
      li.ui-step
        span.ui-step-text = t("dashboard.email_channels.forwarding.outlook_step_1")
      li.ui-step
        span.ui-step-text = t("dashboard.email_channels.forwarding.outlook_step_2")
      li.ui-step
        span.ui-step-text = t("dashboard.email_channels.forwarding.outlook_step_3")
      li.ui-step
        span.ui-step-text = t("dashboard.email_channels.forwarding.outlook_step_4")

  / ─── Yahoo ───
  .ui-tab-content data-tab-content="yahoo"
    ol.ui-steps
      li.ui-step
        span.ui-step-text = t("dashboard.email_channels.forwarding.yahoo_step_1")
      li.ui-step
        span.ui-step-text = t("dashboard.email_channels.forwarding.yahoo_step_2")
      li.ui-step
        span.ui-step-text = t("dashboard.email_channels.forwarding.yahoo_step_3")
      li.ui-step
        span.ui-step-text = t("dashboard.email_channels.forwarding.yahoo_step_4")

  / ─── Other ───
  .ui-tab-content data-tab-content="other"
    ol.ui-steps
      li.ui-step
        span.ui-step-text = t("dashboard.email_channels.forwarding.other_step_1")
      li.ui-step
        span.ui-step-text = t("dashboard.email_channels.forwarding.other_step_2")
      li.ui-step
        span.ui-step-text = t("dashboard.email_channels.forwarding.other_step_3")
      li.ui-step
        span.ui-step-text = t("dashboard.email_channels.forwarding.other_step_4")
