.ww-translation-card style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin-bottom: 16px; position: relative; box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);"
  .ww-translation-header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid #f1f5f9;"
    div style="display: flex; align-items: center; gap: 8px;"
      span.f-semi-14 = I18n.t("languages.#{f.object.locale.to_s.downcase}")
      = f.hidden_field :locale
    button.ui-action-delete type="button" data-action="click->nested-translations#removeTranslation" title=t("general.remove_language")
      svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
        path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"
    = f.hidden_field :_destroy, class: "destroy-flag"

  .ui-form-row
    div
      = f.label :prompt, t("forms.labels.chat_prompt_whatsapp_widget"), class: "ui-label"
      = f.text_field :prompt, class: "ui-input", placeholder: t("dashboard.csat_surveys.form.email_prompt_placeholder")
      
    div
      = f.label :portal_title, t("forms.labels.portal_title_on_the_feedback_page"), class: "ui-label"
      = f.text_field :portal_title, class: "ui-input", placeholder: t("dashboard.csat_surveys.form.portal_title_placeholder")

  .ui-form-row style="margin-top: 16px;"
    div
      = f.label :portal_subtitle, t("forms.labels.portal_subtitle"), class: "ui-label"
      = f.text_field :portal_subtitle, class: "ui-input", placeholder: t("dashboard.csat_surveys.form.portal_subtitle_placeholder")
      
    div
      = f.label :portal_feedback_label, t("forms.labels.feedback_textbox_label"), class: "ui-label"
      = f.text_field :portal_feedback_label, class: "ui-input", placeholder: t("dashboard.csat_surveys.form.feedback_label_placeholder")
