.model-content-section
  .model-content
    .modal-header
      h3 New Conversation
      = inline_svg_tag("cross_button.svg", alt:"menu", class:"conversation-icon m-close", data: { action: "click->modal-toggler#hideModal" })
    .modal-body 
      = form_with(url: "#", data: {controller: "formValidation renderer", "formValidation-target" => "form"}, html: {class: "needs-validation", novalidate: true, method: :post}) do |f|
        .add-customer-container
          .left-panel
            .add-customer
              = inline_svg_tag("plus_icon.svg", class:"plus-icon ml-auto", alt:"menu")
              p.add-tag.f-semi-14 Add Customer
              .customer.ui-select
                = select_tag :customer_id, options_for_select(current_account.customers.map { |c| [c.name, c.id] }), { class: "f-reg-14 field form-control", data: { controller: "select" }, required: true, include_blank: "Select a customer" }

            .message-box
              = f.text_area :response, class: "f-reg-14  note-area form-control", placeholder: "Write your response for issue", required: true  
              .commands
                .send-button
                  = f.submit "Send", class: "f-semi-12 button",data: { action: "click->formValidation#validate click->modal-toggler#hideModal" }
          .right-panel.ui-select
            = select_tag :ticket_type, options_for_select([["Customer Ticket"], ["Back Office Ticket"], ["Tracker Ticket"]]), { class: "f-reg-14 form-control ", data: { controller: "select" }} 

            .team.ui-select
              p.f-semi-14.team-label Team
              = select_tag :team_id, options_for_select(Team.where(account: current_account).all.map { |c| [c.name, c.id] }),{ class: "f-reg-14 form-control ", data: { controller: "select" }, required: true}
            .form-fields
              .form-floating
                = f.label :title,"Title", class: "f-semi-14 form-label"
                = f.text_field :title, class: "f-reg-14 form-control", placeholder: "Add Title",required: true
              .form-floating
                = f.label :description, "Description", class: "f-semi-14 form-label"
                = f.text_area :description, class: "f-reg-14  note-area form-control", placeholder: "Write description", required: true 
              
