= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "users") do
    .ui-page-body
      .ui-form-header
        = link_to t("dashboard.users.form.back"), users_path, class: "ui-back-link"
        h2.f-semi-32 style="margin-top: 16px; color: #0f172a;" = t("dashboard.invitations.new.title", default: "Invite Teammate")
        p.f-reg-16 style="color: #64748b; margin-top: 4px;" = t("dashboard.invitations.new.description", default: "Send an invitation to a new teammate and assign them roles.")

      .ui-card style="margin-top: 24px;"
        .ui-card-body style="padding: 2rem;"
          = form_with url: invitations_path, local: true, class: "channel-form" do |f|
            .ui-form-group
              = f.label :email, t("dashboard.invitations.form.email_label", default: "Email Address"), class: "ui-label"
              = f.email_field :email, class: "ui-input", placeholder: "teammate@example.com", required: true

            h3.f-semi-20 style="margin-top: 2rem; margin-bottom: 1rem;" = t("dashboard.invitations.form.roles_title", default: "Assign Roles")
            p.f-reg-14 style="color: #666; margin-bottom: 1.5rem;" = t("dashboard.invitations.form.roles_desc", default: "Select one or more roles for this teammate.")

            .pm-matrix
              .pm-header
                .pm-header-col Role
                .pm-header-col Select
                
              - current_account.roles.order(system_provided: :desc, name: :asc).each do |role|
                .pm-row
                  .pm-resource style="display: flex; align-items: center;"
                    = role.name
                    - if role.system_provided?
                      span.ui-badge.ui-badge-verified.pm-badge-role
                        span.ui-badge-icon 🛡️
                        span = t("dashboard.users.form.system_default")
                  .pm-toggles-row
                    label.pm-toggle-label
                      = check_box_tag "role_ids[]", role.id, false, class: "pm-toggle-input"
                      span = t("dashboard.users.form.assign")

            .ui-form-actions style="margin-top: 2rem;"
              = f.submit t("dashboard.invitations.form.submit", default: "Send Invitation"), class: "ui-btn-primary"
              = link_to t("dashboard.invitations.form.cancel", default: "Cancel"), users_path, class: "ui-btn-secondary"
