= render("dashboard/shared/dashboard_container", current_page: "agent-test") do
  = render("dashboard/agent/agent_sidebar", current_page: "agent-test") do
    .agent-body-section.agent-task-body
      .agent-header.agent-task-header
        h2.f-semi-18 Tasks
      .agent-body.agent-task-container
        ul.agent-configs-list  data-controller="accordion modal-toggler frame-toggler"
          .configs-nav-menu
            .config-item
              li.config-nav-item class="" data-action="click->accordion#toggle"
                .config-nav-link
                  .link-text
                    = inline_svg_tag("setting_button.svg", class:"link-icon avatar", alt:"menu")
