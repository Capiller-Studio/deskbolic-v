[Unit]
Description=Deskbolic API Gateway (Puma)
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/apps/gateway
Environment=RAILS_ENV=production
Environment=PORT=3005
ExecStart=/home/deploy/.rbenv/shims/bundle exec puma -b tcp://0.0.0.0:3005 -e production
Restart=always

[Install]
WantedBy=multi-user.target
