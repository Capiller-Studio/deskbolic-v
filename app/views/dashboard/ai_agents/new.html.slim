= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "ai_agents") do
    .ui-page-body
      .ui-page-header
        = link_to t('shared.back'), ai_agents_path, class: "ui-back-link"
        h2.f-semi-24 style="color: #0f172a; margin-top: 12px;" = t('dashboard.ai_agents.new.title', default: 'Create AI Agent')
      
      .ui-form-wrapper style="padding-top: 24px;"
        = render "form", ai_agent: @ai_agent
