- reauthorization_required = @whatsapp_channel.reauthorization_required?
- connected = @whatsapp_channel.active? && !reauthorization_required
- status_label = connected ? t("dashboard.whatsapp_channels.index.status_active") : (reauthorization_required ? t("dashboard.whatsapp_channels.index.status_reauth") : t("dashboard.whatsapp_channels.index.status_disconnected"))
- channel_name = @whatsapp_channel.name.presence || @whatsapp_channel.full_phone_number
- overview_items = [{ icon: "users.svg", label: t("dashboard.channels.edit.phone_number", default: "Phone Number"), value: @whatsapp_channel.full_phone_number }, { icon: "code_snipet.svg", label: t("dashboard.channels.edit.waba_id", default: "WABA ID"), value: @whatsapp_channel.business_account_id }]
- reopen_window_options = [[t("forms.options.never_always_create_new"), 0], [t("forms.options.one_hour"), 3600], [t("forms.options.twelve_hours"), 43_200], [t("forms.options.twenty_four_hours"), 86_400], [t("forms.options.seven_days"), 604_800], [t("forms.options.fourteen_days"), 1_209_600]]

= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "whatsapp-channels") do
    .channel-edit.channel-theme-whatsapp
      header.channel-edit__header
        .channel-edit__header-main
          = link_to channels_settings_path(type: "whatsapp"), class: "channel-edit__back", aria: { label: t("dashboard.whatsapp_channels.form.back") } do
            = inline_svg_tag("back_arrow.svg", aria: { hidden: true })
          .channel-edit__heading
            h1 = t("dashboard.whatsapp_channels.edit.title")
            p = t("dashboard.channels.edit.whatsapp_description", default: "Update your WhatsApp connection and inbox settings.")

        .channel-edit__header-actions
          = link_to t("dashboard.whatsapp_channels.form.cancel"), channels_settings_path(type: "whatsapp"), class: "channel-edit__button channel-edit__button--secondary"
          button.channel-edit__button.channel-edit__button--primary type="submit" form="whatsapp-channel-edit-form"
            = inline_svg_tag("ai_agents/new_agent_check.svg", aria: { hidden: true })
            span = t("dashboard.whatsapp_channels.form.save")

      .channel-edit__viewport
        .channel-edit__layout
          = form_with model: @whatsapp_channel, url: channels_whatsapp_path(id: @whatsapp_channel.id), method: :patch, id: "whatsapp-channel-edit-form", class: "channel-edit__form ui-settings-form", data: { controller: "email-channel" } do |f|
            - if @whatsapp_channel.errors.any?
              .channel-edit__errors role="alert"
                p = @whatsapp_channel.errors.full_messages.to_sentence

            section.channel-edit-profile.channel-edit-card
              .channel-edit-profile__body
                .channel-edit-profile__identity
                  .channel-edit-profile__avatar.channel-edit-profile__avatar--fallback
                    = inline_svg_tag("whatsapp.svg", aria: { hidden: true })
                  .channel-edit-profile__copy
                    .channel-edit-profile__title
                      h2 = channel_name
                    p = @whatsapp_channel.full_phone_number

                = inline_svg_tag("menu.svg", class: "channel-edit-profile__menu", aria: { hidden: true })

              .channel-edit-profile__footer
                .channel-edit-profile__created
                  = inline_svg_tag("clock.svg", aria: { hidden: true })
                  span = t("dashboard.whatsapp_channels.index.created_ago", time: time_ago_in_words(@whatsapp_channel.created_at))
                .channel-edit-profile__status class=(connected ? "channel-edit-profile__status--connected" : "channel-edit-profile__status--disconnected")
                  span aria-hidden="true"
                  = connected ? t("dashboard.channels.edit.active", default: "Active") : status_label

              - if reauthorization_required
                .channel-edit-profile__reauth
                  .channel-edit-profile__reauth-copy
                    strong = t("dashboard.whatsapp_channels.edit.reauth_title")
                    span = t("dashboard.whatsapp_channels.edit.reauth_description")
                  = link_to t("dashboard.whatsapp_channels.index.reconnect"), reconnect_channels_whatsapp_path(id: @whatsapp_channel.id), class: "channel-edit-profile__reconnect", data: { turbo_method: :post }

            section.channel-edit-section.channel-edit-card
              .channel-edit-section__heading
                .channel-edit-section__icon
                  = inline_svg_tag("code_snipet.svg", aria: { hidden: true })
                h2 = t("dashboard.channels.edit.integration_details", default: "Integration Details")
              .channel-edit-section__body
                .channel-edit-copy-list
                  .channel-edit-copy data-controller="clipboard"
                    label = t("dashboard.whatsapp_channels.edit.webhook.url_label")
                    .channel-edit-copy__control
                      input type="text" value=@whatsapp_channel.webhook_url readonly=true data-clipboard-target="source"
                      button.channel-edit-copy__button type="button" data-action="click->clipboard#copy" data-clipboard-target="button"
                        = inline_svg_tag("copy.svg", aria: { hidden: true })
                        span = t("general.copy")

                  .channel-edit-copy data-controller="clipboard"
                    label = t("dashboard.whatsapp_channels.edit.webhook.secret_label")
                    .channel-edit-copy__control
                      input type="text" value=@whatsapp_channel.webhook_secret readonly=true data-clipboard-target="source"
                      button.channel-edit-copy__button type="button" data-action="click->clipboard#copy" data-clipboard-target="button"
                        = inline_svg_tag("copy.svg", aria: { hidden: true })
                        span = t("general.copy")

            section.channel-edit-section.channel-edit-card
              .channel-edit-section__heading
                .channel-edit-section__icon
                  = inline_svg_tag("info.svg", aria: { hidden: true })
                h2 = t("dashboard.channels.edit.channel_information", default: "Channel Information")
              .channel-edit-section__body
                .channel-edit-fields-grid
                  .channel-edit-field
                    = f.label :name, t("dashboard.whatsapp_channels.form.name_label")
                    = f.text_field :name, placeholder: t("dashboard.whatsapp_channels.form.name_placeholder"), required: true

                  .channel-edit-field
                    label = t("dashboard.whatsapp_channels.form.full_phone_label")
                    input type="text" value=@whatsapp_channel.full_phone_number readonly=true

                  .channel-edit-field.channel-edit-field--full
                    = f.label :api_key, t("dashboard.whatsapp_channels.form.api_key_label")
                    .channel-edit-password.ui-password-wrapper
                      = f.password_field :api_key, value: @whatsapp_channel.api_key, placeholder: t("dashboard.whatsapp_channels.form.api_key_placeholder"), required: true
                      button.ui-password-toggle type="button" data-action="click->email-channel#togglePassword" aria-label=t("dashboard.channels.edit.toggle_token_visibility", default: "Toggle access token visibility") 👁️

            - if @whatsapp_channel.primary_inbox
              = f.fields_for :primary_inbox, @whatsapp_channel.primary_inbox do |inbox|
                = inbox.hidden_field :id

                section.channel-edit-section.channel-edit-card
                  .channel-edit-section__heading
                    .channel-edit-section__icon
                      = inline_svg_tag("envelope.svg", aria: { hidden: true })
                    h2 = t("dashboard.whatsapp_channels.form.inbox_settings")
                  .channel-edit-section__body
                    .channel-edit-toggle-row
                      label.channel-edit-toggle
                        = inbox.check_box :csat_survey_enabled
                        span.channel-edit-toggle__track aria-hidden="true"
                      .channel-edit-toggle-row__copy
                        = inbox.label :csat_survey_enabled, t("dashboard.whatsapp_channels.form.enable_csat")
                        p = t("dashboard.channels.edit.csat_hint", default: "Show CSAT survey to customers after conversations are resolved.")

                    .channel-edit-fields-grid.channel-edit-fields-grid--selects
                      .channel-edit-field
                        = inbox.label :reopen_window_seconds, t("dashboard.whatsapp_channels.form.reopen_window_label")
                        .channel-edit-select.ui-field-control.ui-field-control--no-icon
                          = inbox.select :reopen_window_seconds, options_for_select(reopen_window_options, inbox.object.reopen_window_seconds), {}, class: "ui-select ui-control", data: { controller: "select" }

                      .channel-edit-field
                        = inbox.label :csat_survey_id, t("dashboard.whatsapp_channels.form.csat_survey_label")
                        .channel-edit-select.ui-field-control.ui-field-control--no-icon
                          = inbox.collection_select :csat_survey_id, current_account.csat_surveys, :id, :name, { include_blank: t("forms.options.default_system_survey") }, { class: "ui-select ui-control", data: { controller: "select" } }

                section.channel-edit-section.channel-edit-card
                  .channel-edit-section__heading.channel-edit-section__heading--with-description
                    .channel-edit-section__icon
                      = inline_svg_tag("clock.svg", aria: { hidden: true })
                    .channel-edit-section__heading-copy
                      h2 = t("forms.labels.business_hours")
                      p = t("dashboard.channels.edit.business_hours_hint", default: "Define when you are available to respond.")
                  .channel-edit-section__body
                    .channel-edit-field.channel-edit-field--select
                      = inbox.label :business_hour_group_id, t("forms.options.always_online_24_7")
                      .channel-edit-select.ui-field-control.ui-field-control--no-icon
                        = inbox.collection_select :business_hour_group_id, current_account.business_hour_groups, :id, :name, { include_blank: t("dashboard.channels.edit.always_available", default: "Your team is available 24/7") }, { class: "ui-select ui-control", data: { controller: "select" } }

                section.channel-edit-section.channel-edit-card
                  .channel-edit-section__heading.channel-edit-section__heading--with-description
                    .channel-edit-section__icon
                      = inline_svg_tag("reports-sla.svg", aria: { hidden: true })
                    .channel-edit-section__heading-copy
                      h2 = t("forms.labels.sla_policies")
                      p = t("dashboard.channels.edit.sla_hint", default: "Choose the SLA policy for this channel.")
                  .channel-edit-section__body
                    .channel-edit-field.channel-edit-field--select
                      .channel-edit-select.ui-field-control.ui-field-control--no-icon
                        = select_tag "#{inbox.object_name}[sla_policy_ids][]", options_from_collection_for_select(current_account.sla_policies, :id, :name, inbox.object.sla_policy_ids.first), include_blank: t("dashboard.channels.edit.none_selected", default: "None Selected"), class: "ui-select ui-control", data: { controller: "select" }

          aside.channel-edit__aside
            = render "dashboard/channels/shared/edit_overview", platform_icon: "inbox_ed.svg", platform_name: t("dashboard.channels.edit.whatsapp", default: "WhatsApp"), overview_items: overview_items, connected: connected, status_label: status_label, meta_item: nil

            section.channel-edit-danger.channel-edit-card
              h2 = t("dashboard.whatsapp_channels.edit.danger_title")
              p = t("dashboard.whatsapp_channels.edit.danger_description")
              = link_to channels_whatsapp_path(id: @whatsapp_channel.id), class: "channel-edit-danger__button", data: { turbo_method: :delete, turbo_confirm: t("dashboard.whatsapp_channels.index.delete_confirm") } do
                = inline_svg_tag("delete_red.svg", aria: { hidden: true })
                span = t("dashboard.whatsapp_channels.edit.disconnect")
