                    span.f-reg-14 = t("ui.dashboard.settings.team_inboxes.new_team_member")
                    = inline_svg_tag("plus_white.svg", class:"plus-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
                ul.members-list
                  table.index-section
                    thead
