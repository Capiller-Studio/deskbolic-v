<mjml>
  <mj-head>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text font-size="15px" color="#374151" line-height="24px" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-button background-color="#4f46e5" color="#ffffff" font-size="14px" font-weight="600" border-radius="8px" padding="16px 24px" inner-padding="12px 24px" />
    </mj-attributes>

    <mj-preview>
      Confirm your email to activate your Capiller Rely account
    </mj-preview>

    <mj-style>
      .confirm-shell { border: 1px solid #dfe3ea; border-radius: 16px; box-shadow: 0 12px 32px rgba(15, 23, 42, 0.08); overflow: hidden; }
      .brand-link { color: #64748b; text-decoration: none; }
      @media only screen and (max-width: 480px) { .mobile-center div { text-align: center !important; } }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f1f5f9">
    <mj-section padding="32px 16px"><mj-column><mj-spacer height="1px" /></mj-column></mj-section>

    <mj-wrapper css-class="confirm-shell" background-color="#ffffff" padding="0">
      <mj-section background-color="#ffffff" padding="24px 40px" border-bottom="1px solid #e5e7eb">
        <mj-column width="62%" vertical-align="middle">
          <mj-image src="[[ERB= asset_url('logo.png', host: ENV.fetch('FRONTEND_URL', 'http://localhost:3000')) ]]" href="[[ERB= ENV.fetch('FRONTEND_URL', 'http://localhost:3000') ]]" alt="Capiller Rely" width="132px" align="left" padding="0" />
        </mj-column>
        <mj-column width="38%" vertical-align="middle">
          <mj-text css-class="mobile-center" align="right" padding="0" font-size="11px" font-weight="700" color="#6366f1" letter-spacing="0.08em">ACCOUNT CONFIRMATION</mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#0f172a" padding="34px 40px 34px">
        <mj-column>
          <mj-text padding="0 0 10px" font-size="12px" font-weight="700" color="#a5b4fc" letter-spacing="0.12em">WELCOME TO DESKBOLIC</mj-text>
          <mj-text padding="0 0 12px" font-size="28px" line-height="36px" font-weight="700" color="#ffffff">Confirm your email address</mj-text>
          <mj-text padding="0" font-size="15px" line-height="24px" color="#cbd5e1">You're one step away from accessing your Capiller Rely workspace. Confirm your email below to activate your account and get started.</mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#ffffff" padding="36px 40px 18px">
        <mj-column>
          <mj-text padding="0 0 14px" font-size="16px" color="#0f172a">Hi <strong>[[ERB= @resource.email ]]</strong>,</mj-text>
          <mj-text padding="0" font-size="15px" line-height="25px" color="#475569">Thanks for signing up for Capiller Rely! To finish creating your account, please confirm your email address by clicking the button below.</mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#ffffff" padding="0 40px 24px">
        <mj-column background-color="#f8fafc" border="1px solid #e2e8f0" border-radius="10px" padding="18px 22px">
          <mj-text padding="0 0 6px" font-size="11px" font-weight="700" color="#4f46e5" letter-spacing="0.08em">ACCOUNT DETAILS</mj-text>
          <mj-text padding="0" font-size="14px" line-height="22px" color="#334155">Email: <strong>[[ERB= @resource.email ]]</strong></mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#ffffff" padding="0 40px 36px">
        <mj-column>
          <mj-button align="left" href="[[ERB= confirmation_url(@resource, confirmation_token: @token, locale: I18n.locale) ]]" background-color="#4f46e5" border-radius="8px" padding="0 0 20px" inner-padding="14px 24px" font-size="15px">
            Confirm my account &nbsp;&rarr;
          </mj-button>
          <mj-text padding="0" font-size="13px" line-height="21px" color="#64748b">If you didn't create this account, you can safely ignore this email. Your account won't be activated until you confirm your email address.</mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#f8fafc" padding="22px 40px" border-top="1px solid #e5e7eb">
        <mj-column>
          <mj-text align="center" padding="0 0 7px" font-size="12px" line-height="19px" color="#64748b">This confirmation was sent to [[ERB= @resource.email ]]. Please do not reply to this automated message.</mj-text>
          <mj-text align="center" padding="0" font-size="12px" line-height="19px" color="#94a3b8">&copy; [[ERB= Time.current.year ]] Capiller Rely &nbsp;&bull;&nbsp; <a href="[[ERB= ENV.fetch('FRONTEND_URL', 'http://localhost:3000') ]]" class="brand-link">Open workspace</a></mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section padding="24px 16px 32px">
      <mj-column>
        <mj-text align="center" padding="0" font-size="11px" color="#94a3b8">Secure customer-support operations, powered by Capiller Rely.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>