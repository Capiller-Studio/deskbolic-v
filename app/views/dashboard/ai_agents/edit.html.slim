/ = render("dashboard/shared/dashboard_container", current_page: "settings") do
= render("dashboard/settings/settings_sidebar", current_page: "ai_agents") do
  .ui-settings-editor
    header.ui-settings-editor__header
      = link_to ai_agents_path, class: "ui-settings-editor__back", aria: { label: t("shared.back") } do
        = image_tag("back-arrow.svg", alt: "", width: 14, height: 12, aria: { hidden: true })
      .ui-settings-editor__heading
        h1 = t("dashboard.ai_agents.edit.title", default: "Edit AI Agent")
        p = t("dashboard.ai_agents.edit.description", default: "Update and configure your AI agent to provide better support to your customers.")
      .ui-settings-editor__header-actions
        = link_to t("general.cancel"), ai_agents_path, class: "ui-btn-secondary"
        button.ui-btn-primary type="submit" form="ai-agent-form"
          = image_tag("ai_agents/new_agent_check.svg", alt: "", width: 16, height: 16, aria: { hidden: true })
          span = t("dashboard.ai_agents.edit.submit", default: "Update Agent")

    = render "form", ai_agent: @ai_agent, editor_layout: true
