/* =========================================================================
   Skills Component
   ========================================================================= */

.ap-section-title {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.ap-section-title small {
  color: $black-40;
  line-height: 18px;
}

.ap-required-marker {
  color: #ef4444;
  margin-left: 4px;
}

.ap-strategy-card.orange .ap-strategy-card-icon {
  background: #fff3e0;
}

.ap-skill-selected-dot {
  width: 14px;
  height: 14px;
  border: 4px solid $secondary-purple;
  border-radius: 50%;
  background: $white;
  box-shadow: 0 0 0 1px rgba(119, 141, 255, 0.2);
}

.ui-settings-page .ui-card-grid.sk-skill-card-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.sk-skill-card {
  height: auto;
  min-height: 168px;
  gap: 14px;
}

.sk-skill-card.inactive {
  opacity: 0.78;
}

.sk-skill-card .ai-agent-card-identity {
  min-width: 0;
}

.ui-settings-page .sk-skill-card.sk-skill-card--general .sk-skill-card-avatar {
  --ai-agent-avatar-filter: none;
  background: rgba(119, 141, 255, 0.1);
}

.ui-settings-page .sk-skill-card.sk-skill-card--language .sk-skill-card-avatar {
  --ai-agent-avatar-filter: none;
  background: $green-20;
}

.ui-settings-page .sk-skill-card.sk-skill-card--product .sk-skill-card-avatar {
  --ai-agent-avatar-filter: none;
  background: #fff3e0;
}

.ui-settings-page .sk-skill-card.sk-skill-card--technical .sk-skill-card-avatar {
  --ai-agent-avatar-filter: none;
  background: $blue-50;
}

.sk-skill-card-title {
  max-width: 100%;
}

.sk-skill-card-title-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 8px;
}

.sk-skill-card-title-row h2 {
  min-width: 0;
  overflow: visible;
  text-overflow: clip;
  white-space: normal;
}

.sk-skill-type-pill {
  display: inline-flex;
  height: 20px;
  flex: 0 0 auto;
  align-items: center;
  padding: 2px 8px;
  border-radius: 999px;
  font-family: $font-family-inter-medium;
  font-size: 12px;
  line-height: 16px;
}

.sk-skill-type-pill--general {
  background: rgba(119, 141, 255, 0.1);
  color: $secondary-purple;
}

.sk-skill-type-pill--language {
  background: $green-20;
  color: #15803d;
}

.sk-skill-type-pill--product {
  background: #fff3e0;
  color: #c2410c;
}

.sk-skill-type-pill--technical {
  background: $blue-50;
  color: #0369a1;
}

.sk-skill-card-description {
  display: -webkit-box;
  overflow: hidden;
  margin: 0;
  color: #6b7280;
  font-size: 14px;
  line-height: 22px;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.sk-skill-card-footer {
  margin-top: 0;
}

.sk-skill-created {
  min-width: 0;
  color: #6b7280;
  font-size: 14px;
  line-height: 20px;
}

.sk-skill-status {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 8px;
}

.sk-skill-status-label {
  color: #6b7280;
  font-size: 14px;
  line-height: 20px;
}

.sk-skill-card .ui-status-badge {
  height: auto;
  padding: 0;
  background: transparent;
  color: #34c759;
}

.sk-skill-card .ai-agent-card-menu summary,
.sk-skill-card .ai-agent-card-menu summary:hover,
.sk-skill-card .ai-agent-card-menu summary:focus {
  border: 0;
  outline: 0;
  background: transparent;
  box-shadow: none;
}

@media (max-width: 680px) {
  .ui-settings-page .ui-card-grid.sk-skill-card-grid {
    grid-template-columns: 1fr;
  }
}
