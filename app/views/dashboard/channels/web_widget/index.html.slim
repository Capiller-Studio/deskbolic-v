= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "web-widget-channels") do
    .body-container
      .channel-theme-web-widget
        .ui-index-header
          .ui-title-area
            h2.f-semi-32 = t("dashboard.web_widget_channels.index.title")
            p.f-reg-16 = t("dashboard.web_widget_channels.index.description")
          = link_to new_channels_web_widget_path, class: "ui-btn-primary"
            | + #{t("dashboard.web_widget_channels.index.new_channel")}

        .ui-list
          - if @web_widget_channels.any?
            - @web_widget_channels.each do |channel|
              div.ui-card id=dom_id(channel)
                .ui-card-top
                  .ui-card-info
                    h3.f-semi-16 = channel.name
                    p.ui-subtitle = channel.website_url.presence || t("forms.options.any_website")
                  .ui-card-actions
                    = link_to edit_channels_web_widget_path(channel), class: "ui-action-btn ww-icon-action", title: "Edit"
                      = image_tag "edit.svg", alt: "Edit", class: "ww-action-icon ww-action-icon--edit"
                    = link_to channels_web_widget_path(channel), method: :delete, class: "ui-action-btn ui-action-delete", data: { turbo_method: :delete, turbo_confirm: t("dashboard.web_widget_channels.index.delete_confirm") }, title: "Delete"
                      = image_tag "delete_red.svg", alt: "Delete", class: "ww-action-icon"

                .ui-card-meta
                  - if channel.anonymous_allowed?
                    .ui-badge.ui-badge-active
                      span.ui-badge-icon 👻
                      span = t("ui.dashboard.channels.web_widget.index.anonymous_allowed")
                  - else
                    .ui-badge.ui-badge-disconnected
                      span.ui-badge-icon 🔒
                      span = t("ui.dashboard.channels.web_widget.index.anonymous_restricted")

                  - if channel.portal_id.present?
                    .ui-badge.ui-badge-active
                      span.ui-badge-icon 📚
                      span = t("ui.dashboard.channels.web_widget.index.help_center_linked")

                  - if channel.configurations&.dig("contact_form_id").present?
                    .ui-badge.ui-badge-active
                      span.ui-badge-icon ✉️
                      span = t("ui.dashboard.channels.web_widget.index.contact_form_linked")

                  .ui-meta-tag
                    span.ui-meta-tag-icon 📬
                    span = t("dashboard.web_widget_channels.index.inboxes_count", count: channel.inboxes.size)

                  .ui-meta-tag
                    span.ui-meta-tag-icon 🕐
                    span = t("dashboard.web_widget_channels.index.created_ago", time: time_ago_in_words(channel.created_at))

                .ww-embed-row data-controller="web-widget-channel"
                  span.ww-embed-label EMBED
                  .ww-embed-code
                    input.ww-embed-input type="text" readonly=true value="<script src='https://widget.deskbolic.com/w/#{current_account.id}/#{channel.id}/embed.js'></script>"
                  button.ui-copy-btn.ww-index-copy-btn data-action="click->web-widget-channel#copyEmbedCode" data-code="<script src='https://widget.deskbolic.com/w/#{current_account.id}/#{channel.id}/embed.js'></script>"
                    span Copy

          - else
            .ui-empty-state
              .ui-empty-icon 💬
              h3.f-semi-18 = t("dashboard.web_widget_channels.index.empty_title")
              p.f-reg-14 = t("dashboard.web_widget_channels.index.empty_description")
              = link_to new_channels_web_widget_path, class: "ui-btn-primary ui-btn-sm"
                | + #{t("dashboard.web_widget_channels.index.new_channel")}
