= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "whatsapp-channels") do
    .wa-edit-header
      = link_to channels_whatsapp_index_path, class: "wa-back-link"
        | ← #{t("dashboard.whatsapp_channels.form.back")}
      h2.f-semi-32 = t("dashboard.whatsapp_channels.edit.title")

    .wa-edit-container
      .wa-section
        .wa-section-header
          h3.f-semi-18 = t("dashboard.whatsapp_channels.edit.title")
        
        .wa-connection-card
          .wa-connection-info
            .wa-page-avatar-placeholder
              | 💬
            .wa-page-details
              h4.f-semi-16 = @whatsapp_channel.name || @whatsapp_channel.full_phone_number
              p.f-reg-14 
                | Phone: #{@whatsapp_channel.full_phone_number} 
                span.wa-page-connected
                  | (WABA: #{@whatsapp_channel.business_account_id})

        - if @whatsapp_channel.reauthorization_required?
          .wa-reauth-banner
            .wa-reauth-icon ⚠️
            .wa-reauth-text
              p.f-semi-14 = t("dashboard.whatsapp_channels.edit.reauth_title")
              p.f-reg-12 = t("dashboard.whatsapp_channels.edit.reauth_description")
            = link_to reconnect_channels_whatsapp_path(@whatsapp_channel), method: :post, class: "wa-reconnect-btn", data: { turbo_method: :post }
              | 🔄 #{t("dashboard.whatsapp_channels.index.reconnect")}
        - else
          .wa-status-active
            .wa-badge.wa-badge-active
              span.wa-badge-icon 🟢
              span = t("dashboard.whatsapp_channels.index.status_active")

      .wa-section
        .wa-section-header
          h3.f-semi-18 = t("dashboard.whatsapp_channels.edit.webhook.title")
          p.f-reg-14 style="color: var(--gray-600); margin-top: 4px;" = t("dashboard.whatsapp_channels.edit.webhook.description")

        .wa-webhook-details
          .wa-form-group
            label.wa-label = t("dashboard.whatsapp_channels.edit.webhook.url_label")
            .wa-copy-group
              input.wa-input type="text" value="#{@whatsapp_channel.webhook_url}" readonly=true
              button.wa-btn-secondary type="button" onclick="navigator.clipboard.writeText('#{@whatsapp_channel.webhook_url}')"
                | 📋 #{t("general.copy")}

          .wa-form-group
            label.wa-label = t("dashboard.whatsapp_channels.edit.webhook.secret_label")
            .wa-copy-group
              input.wa-input type="text" value="#{@whatsapp_channel.webhook_secret}" readonly=true
              button.wa-btn-secondary type="button" onclick="navigator.clipboard.writeText('#{@whatsapp_channel.webhook_secret}')"
                | 📋 #{t("general.copy")}

      = form_with model: @whatsapp_channel, url: channels_whatsapp_path(@whatsapp_channel), class: "wa-config-form" do |f|
        .wa-section
          .wa-section-header
            h3.f-semi-18 = t("dashboard.whatsapp_channels.form.inbox_settings")
          
          .wa-form-group
            = f.label :name, t("dashboard.whatsapp_channels.form.name_label"), class: "wa-label"
            = f.text_field :name, class: "wa-input", placeholder: t("dashboard.whatsapp_channels.form.name_placeholder"), required: true
          
          .wa-form-group
            label.wa-label = t("dashboard.whatsapp_channels.form.full_phone_label")
            input.wa-input type="text" value="#{@whatsapp_channel.full_phone_number}" disabled=true style="background: var(--gray-50); color: var(--gray-500); cursor: not-allowed;"

        - if @whatsapp_channel.primary_inbox
          .wa-inbox-settings style="margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--gray-200);"
            h4.f-semi-16 = t("dashboard.whatsapp_channels.form.inbox_settings")

            = f.fields_for :primary_inbox, @whatsapp_channel.primary_inbox do |inbox|
              = inbox.hidden_field :id

              .wa-form-group.wa-checkbox-group style="margin-bottom: 12px;"
                = inbox.check_box :csat_survey_enabled, class: "wa-checkbox"
                = inbox.label :csat_survey_enabled, t("dashboard.whatsapp_channels.form.enable_csat"), class: "wa-checkbox-label"

              .wa-form-group
                = inbox.label :reopen_window_seconds, t("dashboard.whatsapp_channels.form.reopen_window_label", default: "Reopen Window"), class: "wa-label"
                = inbox.select :reopen_window_seconds, options_for_select([["Never (Always create new)", 0], ["1 Hour", 3600], ["12 Hours", 43200], ["24 Hours", 86400], ["7 Days", 604800], ["14 Days", 1209600]], inbox.object.reopen_window_seconds), {}, class: "wa-select"

              .wa-form-group
                = inbox.label :csat_survey_id, t("dashboard.whatsapp_channels.form.csat_survey_label"), class: "wa-label"
                = inbox.collection_select :csat_survey_id, current_account.csat_surveys, :id, :name, { include_blank: "Default System Survey" }, class: "wa-select"
              
              .wa-form-group
                = inbox.label :sla_policy_ids, "SLA Policies", class: "wa-label"
                = inbox.collection_select :sla_policy_ids, current_account.sla_policies, :id, :name, {}, { multiple: true, class: "wa-select" }
        
        .wa-form-actions
          = link_to channels_whatsapp_index_path, class: "wa-btn-secondary"
            | #{t("dashboard.whatsapp_channels.form.cancel")}
          = f.submit t("dashboard.whatsapp_channels.form.save"), class: "wa-btn-primary"

      .wa-danger-zone.wa-section style="margin-top: 3rem;"
        .wa-section-header
          h3.f-semi-18 = t("dashboard.whatsapp_channels.edit.danger_title")
        p.f-reg-14 = t("dashboard.whatsapp_channels.edit.danger_description")
        
        = button_to channels_whatsapp_path(@whatsapp_channel), method: :delete, class: "wa-btn-danger", form: { data: { turbo_confirm: t("dashboard.whatsapp_channels.index.delete_confirm") } } do
          | 🗑️ #{t("dashboard.whatsapp_channels.edit.disconnect")}
