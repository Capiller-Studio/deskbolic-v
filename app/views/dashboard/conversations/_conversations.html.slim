.inbox-section.center-wrapper
  .inbox-container data-controller="toggler"
    .inbox-nav
      .card
        .f-semi-24 = t('dashboard.conversations.title')
        .search-bar 
          = inline_svg_tag("search.svg", class:"search-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
          p.f-reg-14 = t('dashboard.conversations.search')

        = turbo_frame_tag "conversations-list-frame" do
          = form_with url: conversations_path, method: :get, html: { id: "conversations-filter-form", data: { turbo_frame: "conversations-list-frame", turbo_action: "advance" } } do
            = hidden_field_tag "resource_id", @inbox&.id
            .filter-tabs
              = button_tag t('dashboard.conversations.filter_all'), type: "submit", name: "filter", value: "", form: "conversations-filter-form", class: "filter-tab #{@filter.blank? ? 'active' : ''}"
              = button_tag t('dashboard.conversations.filter_assigned'), type: "submit", name: "filter", value: "assigned", form: "conversations-filter-form", class: "filter-tab #{@filter == 'assigned' ? 'active' : ''}"
              = button_tag t('dashboard.conversations.filter_unassigned'), type: "submit", name: "filter", value: "unassigned", form: "conversations-filter-form", class: "filter-tab #{@filter == 'unassigned' ? 'active' : ''}"
          ul data-toggler-target="conversation hide"
            .inbox-nav-menu#conversations-list
              - @conversations.each do |conversation|
                - customer = conversation.customers.first
                - conversation_url = conversation_path(conversation.id, filter: @filter.presence)
                li.nav-item id=dom_id(conversation) class="#{@conversation&.id == conversation.id ? 'inbox-nav-active' : ''}"
                  - if customer&.avatar&.attached?
                    = image_tag(customer.avatar, class:"user-img", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
                  - else
                    .user-img.avatar-fallback.customer-list-initials-avatar.f-reg-12 class=avatar_fallback_color_class(full_name(customer))
                      = initials(customer)
                  .nav-link.link data-target-id="conversations-frame" data-controller="section" data-action="click->section#toggleSection" data-url="#{conversation_url}"
                    - conversation.customers.each do |customer|
                      h4.f-semi-14 = full_name(customer)
                      p.f-reg-12 id="conversation-#{conversation.id}-preview" = conversation.last_message_preview
                  .actions
                    - unread_count = @unread_counts && @unread_counts[:conversations] ? @unread_counts[:conversations][conversation.id].to_i : 0
                    .unread-badge data-controller="unread-badge" data-action="deskbolic:unread-counts-updated@window->unread-badge#update" data-unread-badge-target="badge" data-unread-badge-id-value=conversation.id data-unread-badge-type-value="conversation" style="background: var(--primary-500, #4F46E5); color: white; border-radius: 12px; padding: 2px 8px; align-items: center; justify-content: center; display: #{unread_count > 0 ? 'flex' : 'none'};"
                      p.f-semi-12 = unread_count
                    = inline_svg_tag("menu.svg", class:"menu-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
                    = inline_svg_tag("close.svg", class:"close-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
                    p.f-reg-10 id="conversation-#{conversation.id}-date" = conversation.messages.order(:created_at).last&.created_at&.strftime("%d %b")
              
              - if @pagy_conversations&.next
                turbo-frame.inbox-nav-menu id="conversations-page-#{@pagy_conversations.next}" src=conversations_path(page: @pagy_conversations.next, resource_id: @inbox&.id, filter: @filter) loading="lazy"
                  .loading-spinner style="text-align: center; padding: 20px; color: #9CA3AF;"
                    p.f-reg-14 Loading more conversations...

    .inbox-body 
      turbo-frame#messages-frame
      == yield
