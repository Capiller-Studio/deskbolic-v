/ = render("dashboard/shared/dashboard_container", current_page: "domains") do
= render("dashboard/settings/settings_sidebar", current_page: "domains") do
  .ui-settings-editor
    header.ui-settings-editor__header
      = link_to domains_path, class: "ui-settings-editor__back", aria: { label: t("shared.back") } do
        = inline_svg_tag("back-arrow.svg", aria: { hidden: true })
      .ui-settings-editor__heading
        h1 = t("dashboard.domains.new.title")
        p = t("dashboard.domains.new.subtitle", default: "Add a custom domain to your help center.")

    - if current_account.feature_enabled?(:custom_domains)
      = form_with(model: @domain, url: domains_path, method: :post, class: "ui-settings-form ui-settings-editor__form", data: { controller: "form-validation", "form-validation-target": "form" }, html: { novalidate: true }) do |f|
        = f.hidden_field :domain_type, value: "custom"

        .ui-settings-editor__body
          section.ui-form-card
            .ui-form-card__header.ui-form-card__header--identity
              .ui-form-card__icon aria-hidden="true"
                = inline_svg_tag("domain.svg")
              div
                h2 = t("dashboard.domains.new.section_title")
                p = t("dashboard.domains.new.section_description", default: "Provide the details for your custom domain.")

            .ui-form-stack
              .ui-field-group
                = f.label :name, t("dashboard.domains.new.name_label"), class: "ui-label ui-label--title"
                p.ui-field-description = t("dashboard.domains.new.name_hint")
                .ui-field-control.ui-field-control--plain class=("ui-field-control--invalid" if @domain.errors[:name].any?)
                  = f.text_field :name, class: "ui-input ui-control", placeholder: t("dashboard.domains.new.name_placeholder"), autocomplete: "off", required: true, aria: { invalid: @domain.errors[:name].any?, describedby: "domain_name_feedback" }
                p#domain_name_feedback.ui-field-feedback class=("ui-field-feedback--server" if @domain.errors[:name].any?) role="alert"
                  = inline_svg_tag("cross_sign.svg", class: "ui-field-feedback__icon", aria: { hidden: true })
                  span = @domain.errors[:name].any? ? @domain.errors[:name].to_sentence : t("dashboard.domains.new.required_feedback", default: "This field is required.")

              .ui-field-group
                = f.label :value, t("dashboard.domains.new.value_label"), class: "ui-label ui-label--title"
                p.ui-field-description = t("dashboard.domains.new.value_hint")
                .ui-field-control.ui-field-control--plain class=("ui-field-control--invalid" if @domain.errors[:value].any?)
                  = f.text_field :value, class: "ui-input ui-control", placeholder: t("dashboard.domains.new.value_placeholder"), autocomplete: "off", required: true, pattern: "[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*", aria: { invalid: @domain.errors[:value].any?, describedby: "domain_value_feedback" }
                p#domain_value_feedback.ui-field-feedback class=("ui-field-feedback--server" if @domain.errors[:value].any?) role="alert"
                  = inline_svg_tag("cross_sign.svg", class: "ui-field-feedback__icon", aria: { hidden: true })
                  span = @domain.errors[:value].any? ? @domain.errors[:value].to_sentence : t("dashboard.domains.new.required_feedback", default: "This field is required.")

          section.ui-form-card.ui-form-card--roomy
            .ui-form-card__header.ui-form-card__header--identity
              .ui-form-card__icon aria-hidden="true"
                = inline_svg_tag("domain.svg")
              div
                h2 = t("dashboard.domains.new.after_adding_title")
                p = t("dashboard.domains.new.after_adding_desc")

            .ui-record-table
              table
                thead
                  tr
                    th = t("dashboard.domains.index.cname_instructions.cname_type")
                    th = t("dashboard.domains.index.cname_instructions.cname_host")
                    th = t("dashboard.domains.index.cname_instructions.cname_target")
                tbody
                  tr
                    td CNAME
                    td = t("dashboard.domains.new.cname_host_value")
                    td = Domain::CNAME_TARGET

            .ui-form-notice
              = inline_svg_tag("info.svg", aria: { hidden: true })
              div
                h3 = t("dashboard.domains.new.important", default: "Important")
                p = t("dashboard.domains.new.after_adding_note")

          .ui-form-submit-row
            = link_to t("dashboard.domains.new.cancel"), domains_path, class: "ui-btn-secondary"
            = f.submit t("dashboard.domains.new.submit"), class: "ui-btn-primary", data: { action: "click->form-validation#validate" }
    - else
      .ui-settings-form.ui-settings-editor__body
        section.ui-form-card
          .ui-form-upgrade-state
            h2 = t("dashboard.domains.custom_domain_not_supported", default: "Custom domains are not supported on your current plan.")
            p = t("dashboard.domains.upgrade_plan_desc", default: "Upgrade your plan to add custom domains to your help center.")
            = link_to t("dashboard.domains.upgrade_plan", default: "Upgrade Plan"), dashboard_billing_path, class: "ui-btn-primary"
