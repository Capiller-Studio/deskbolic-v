.card.conversation-card
  .chat-section
    .header
      .user-details
        - @conversation.customers.each do |customer|
            p.f-semi-18 = full_name(customer)
      / .actions data-controller="accordion conversations"
        = inline_svg_tag("plus.svg", class:"chat-action", alt:"menu")
        = inline_svg_tag("star.svg", class:"chat-action", alt:"menu")
        = inline_svg_tag("ticket.svg", class:"chat-action", alt:"menu")
        = inline_svg_tag("bell.svg", class:"chat-action", alt:"menu", data: { action: "click->conversations#open" })
        = inline_svg_tag("close_black.svg", class:"chat-action", alt:"menu")
        = inline_svg_tag("dots.svg", class:"chat-action", alt:"menu",  data: { "action" => "click->accordion#toggleMenu" })
        .menu data-accordion-target="menu"
          = link_to("#", class: "menu-link") do
            = inline_svg_tag("participent.svg", class:"menu-icon", alt:"menu")
            p.f-reg-12 Manage Participant
          = link_to("#", class: "menu-link") do
            = inline_svg_tag("export.svg", class:"menu-icon", alt:"menu")
            p.f-reg-12 Export Conversation
        
        = render "dashboard/conversations/snooz_conv_modal"
    .conversation#oppp
      - @messages.each do |message|
        - if message.sender_type == "Customer"
          .user-response.response data-controller="translator" data-translator-target="response"
            .text-content
              .chat-user
                - customer = message.sender
                - if customer.avatar.attached?
                  = image_tag(customer.avatar, class:"img", alt:"menu")
                - else
                  .img.avatar-fallback.customer-message-initials-avatar.f-reg-12 class=avatar_fallback_color_class(full_name(customer))
                    = initials(customer)
              .user-text
                - if message.content.present?
                  - if single_emoji_message?(message.content)
                    .original.single-emoji-message data-translator-target="original"
                      = message.content.strip
                  - else
                    .original.f-reg-14 data-translator-target="original"
                      = message.content
                    .translate-text
                      button.f-light-italic-10 data-action="click->translator#toggle_translate" Translate
                    .translated-text.d-none
                      h5.f-med-10 TRANSLATION IN ENGLISH:
                      p
                        span.translation.f-light-italic-12 data-translator-target="translation"
                        |  
                        span.f-med-10.close-translation data-action="click->translator#toggle" Close
                - if message.attachments.any?
                  .msg-attachments
                    - message.attachments.each do |attachment|
                      - if attachment.audio? && attachment.file.attached?
                        .msg-attachment-audio
                          audio controls=true preload="metadata" src=rails_blob_path(attachment.file)
                      - elsif attachment.image? && attachment.file.attached?
                        .msg-attachment-img
                          = image_tag(attachment.file, class: "attachment-image")
                      - elsif attachment.file.attached?
                        a.msg-attachment-file href=rails_blob_path(attachment.file, disposition: "attachment") target="_blank"
                          span.file-icon 📄
                          span.file-name = attachment.file.filename

        - if message.sender_type == "User"
          .agent-response.response data-controller="translator" data-translator-target="response"
            .agent-text
              - if message.content.present?
                - if single_emoji_message?(message.content)
                  .original.single-emoji-message data-translator-target="original"
                    = message.content.strip
                - else
                  .original.f-reg-14 data-translator-target="original"
                    = message.content
                  .translate-text
                    button.f-light-italic-10 data-action="click->translator#toggle_translate" Translate
                  .translated-text.d-none
                    h5.f-med-10 TRANSLATION IN ENGLISH:
                    p
                      span.translation.f-light-italic-12 data-translator-target="translation"
                      |  
                      span.f-med-10.close-translation data-action="click->translator#toggle" Close
              - if message.attachments.any?
                .msg-attachments
                  - message.attachments.each do |attachment|
                    - if attachment.audio? && attachment.file.attached?
                      .msg-attachment-audio
                        audio controls=true preload="metadata" src=rails_blob_path(attachment.file)
                    - elsif attachment.image? && attachment.file.attached?
                      .msg-attachment-img
                        = image_tag(attachment.file, class: "attachment-image")
                    - elsif attachment.file.attached?
                      a.msg-attachment-file href=rails_blob_path(attachment.file, disposition: "attachment") target="_blank"
                        span.file-icon 📄
                        span.file-name = attachment.file.filename
      turbo-frame#message-frame
      
    .footer
      .message-box data-controller="message-form"
        = form_with(model: Message.new, method: :post, class:"msg-form", remote: true, multipart: true) do |f|
          .text-translation
            .response-type 
              button.f-semi-14.reply.active type="button" Reply
              / button.f-semi-14.note type="button" Note
            .translation.f-semi-14
              | English
              = inline_svg_tag("violet_dropdown.svg", class:"action-btn")
          .note-area.menu
            .attachment-preview data-message-form-target="preview"
            .de-emoji-picker data-message-form-target="emojiPicker" style="display: none;"
            .recording-indicator data-message-form-target="recordingIndicator" style="display: none;"
              .pulse-dot
              span.f-reg-12 Recording voice...
            = f.text_area :response, class: "form-control f-reg-14 response-area", placeholder: "Write your response for issue", data: { message_form_target: "textarea" }
            = f.hidden_field :conversation_id, value: @conversation.id
            = f.file_field :attachments, multiple: true, class: "message-attachments-input", accept: "image/*,video/*,audio/*,.pdf,.doc,.docx,.txt,.zip", data: { message_form_target: "input", action: "change->message-form#previewFiles" }
          .commands
            .actions data-controller="modalToggler frameToggler"
              / .response-action
                = inline_svg_tag("menu.svg", class:"action-btn")
              .response-action data-controller="accordion"
                .replies data-action="click->accordion#toggleMenu"
                  = inline_svg_tag("reply_star.svg", class:"action-btn")
                .menu.save-replies data-accordion-target="menu"
                  .menu-buttons
                    .menu-options
                      = inline_svg_tag("star_plus.svg", class:"m-btn", alt:"menu",  data: { action: "click->modalToggler#showModal click->frameToggler#loadModal", popup_view:"_canned_response_modal" })
                      = link_to(canned_responses_settings_path, class: "", data: { turbo: false}) do
                        = inline_svg_tag("setting_button.svg", class:"m-btn", alt:"menu")
                    = image_tag("cross_btn.png", class:"m-btn", alt:"menu", data: { action: "click->accordion#toggleMenu" })
                  .panels
                    .left-panel
                      - @canned_responses&.each do |response|
                        - liquid_template = Liquid::Template.parse(response.description)
                        - rendered_content = liquid_template.render({ 'customer' => JSON.parse(@conversation.customers.first.to_json) })
                        .menu-link data-action="click->accordion#togglePanel" data-title="#{response.name}" data-description="#{rendered_content}"
                          = image_tag("gold_star.png", class:"menu-icon", alt:"menu")
                          .headings
                            p.f-reg-14 = response.name
                            p.f-reg-10 = rendered_content
                    .right-panel data-accordion-target="panel"
                      .response-description data-accordion-target="response"
                        p.f-semi-18.response-title
                        p.f-reg-14.response-text
                      .canned-submit.f-semi-12 type="button" data-action="click->accordion#switchResponse" Add
              button.response-action type="button" data-action="click->message-form#openFilePicker" title="Attach image or file"
                = inline_svg_tag("file_attach.svg", class:"action-btn")
              button.response-action type="button" data-action="click->message-form#toggleEmojiPicker" title="Add emoji"
                = inline_svg_tag("emoji.svg", class:"size-btn")
              / .response-action
              /   = inline_svg_tag("gif.svg", class:"size-btn")
              button.response-action type="button" data-action="click->message-form#toggleVoiceRecording" data-message-form-target="voiceBtn" title="Record voice"
                = inline_svg_tag("mic.svg", class:"action-btn")
              / .chat-gpt
              /   .response-action data-controller="accordion"
              /     .paraphrase-options data-action="click->accordion#toggleMenu"
              /       = inline_svg_tag("chat_gpt.svg", class:"gpt-btn")
              /       p.f-reg-12 Rephrase
              /     .menu data-accordion-target="menu"
              /       .paraphrase-text
              /         .text
              /           | Lorem ipsum dolor sit amet consectetur adipisicing elit. Minus veritatis odio voluptates ullam autem facilis exercitationem incidunt repellat, non ipsam. Molestias expedita, illum sapiente quia magnam facere ullam numquam voluptas!
              /         .paraphrase-commands
              /           .paraphrase-actions
              /             = inline_svg_tag("retry_transparent.svg", class:"button")
              /             = inline_svg_tag("copy.svg", class:"button")
              /           .paraphrase-buttons
              /             .keep-original
              /               p.f-reg-12 Keep Original
              /             .rephrase
              /               p.f-reg-12 Rephrase
              /   .rephrase-selection data-controller="accordion"
              /     = inline_svg_tag("arrow_down_green.svg", data: { "action" => "click->accordion#toggleMenu" })
              /     .menu data-accordion-target="menu"
              /       .rephrase-options
              /         = link_to("#", class: "menu-link") do
              /           p.f-reg-12 Default
              /         = link_to("#", class: "menu-link") do
              /           p.f-reg-12 Friendly
              /         = link_to("#", class: "menu-link") do
              /           p.f-reg-12 Professional
              /         = link_to("#", class: "menu-link") do
              /           p.f-reg-12 Confident
              /         = link_to("#", class: "menu-link options") do
              /           = inline_svg_tag("arrow_down.svg", class:"menu-icon", alt:"menu")
                        
            .send-button data-controller="accordion modalToggler frameToggler"
              = f.submit "Send", class: "f-semi-12"
              .arrow-container data-action="click->accordion#toggleMenu" 
                = inline_svg_tag("arrow_down_white.svg")

              .menu data-accordion-target="menu"
                .schedule-options 
                  .menu-link data-action="click->modalToggler#showModal click->frameToggler#loadModal" data-popup-view="_schedule_modal"
                    = inline_svg_tag("timer.svg",class:"option-icon")
                    p.f-reg-14 Schedule
                  .menu-link.send-close
                    = inline_svg_tag("send_close.svg",class:"option-icon" ,data: { "action" => "click->accordion#toggleMenu" })       
                    p.f-reg-14 Send and Close
  = render "dashboard/conversations/conversation_details"