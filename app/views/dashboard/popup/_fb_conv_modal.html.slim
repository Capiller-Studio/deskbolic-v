.model-content-section
  .model-content
    .modal-header
      h3 = t("ui.dashboard.popup.email_conv_modal.new_conversation")
      = inline_svg_tag("cross_button.svg", alt:t("ui.dashboard.agent.agent_sidebar.menu"), class:"conversation-icon m-close", data: { action: "click->modal-toggler#hideModal" })
    .modal-body.fb-con.email-con
      = form_with(url: conversations_path, data: {controller: "form-validation renderer", "form-validation-target" => "form"}, html: {class: "needs-validation", novalidate: true, method: :post}) do |f|
        .form-fields
          = f.hidden_field :conversation_source, value: "facebook_message"
          .form-floating.ui-select
            p.f-semi-14.to = t("ui.dashboard.popup.email_conv_modal.to")
            = select_tag :customer_id, options_for_select(current_account.customers.map { |c| [c.name, c.id] }),{ class: "f-reg-14 field form-control ", data: { controller: "select" },required: true, include_blank: t("forms.options.select_a_customer")}
          .form-floating.ui-select
            p.f-semi-14.channel = t("ui.dashboard.agent.workflow.channel")
            = select_tag :channel_id, options_for_select(Channel::FacebookPage.where(account: current_account).all.map { |c| [c.name, c.id] }),{ class: "f-reg-14 field form-control", data: { controller: "select" },required: true,include_blank: t("forms.options.select_a_channel")}
          .message-box
            = f.text_area :response, class: "f-reg-14  note-area form-control", placeholder: t("dashboard.messages.response_placeholder"), required: true
            .commands
              .send-button
                = f.submit t("dashboard.messages.send"),class: "f-semi-12 button",data: { action: "click->form-validation#validate click->modal-toggler#hideModal" }