- team ||= @team || Team.new
- is_edit = team.persisted?
- form_url = is_edit ? team_path(team) : teams_path
- form_method = is_edit ? :patch : :post
- users ||= @users || []
- inboxes ||= @inboxes || []

.model-content-section
  .model-content.team-modal-content
    .modal-header
      .modal-header-text
        h3.f-semi-18 = is_edit ? "Edit Team" : "New Team"
        p.f-reg-14.modal-subtitle = is_edit ? "Edit team details and view added users" : "Enter team details and view added users"
      = inline_svg_tag("cross_button.svg", alt: "close", class: "conversation-icon m-close", data: { action: "click->modalToggler#hideModal" })

    .team-form-body
      = form_with(model: team, url: form_url, method: form_method, data: { "controller" =>"formValidation", "formValidation-target" => "form", "turbo_frame" =>"teams_list" }, html: { class: "needs-validation team-form", novalidate: true } ) do |f|
        .form-fields
          .form-floating
            = f.label :name, class: "form-label f-reg-14" do
              | Team name
              span.required-star *
            = f.text_field :name, value: team.name, class: "form-control f-reg-14", placeholder: "e.g. Customer Success", required: true

          .form-floating
            = f.label :description, "Description (Optional)", class: "form-label f-reg-14"
            = f.text_area :description, value: team.description, class: "form-control f-reg-14 team-description-field", placeholder: "Describe what this team does...", rows: 4

          .form-floating.auto-assign-row
            label.custom-checkbox.auto-assign-checkbox
              = f.check_box :auto_assign, class: "auto-assign-input"
              .checkmark
              span.f-reg-14 Auto-assign new conversations to active members

          .team-users-section
            p.section-label.f-reg-14 Team Members
            .users-list
              - if users.present?
                - users.each do |user|
                  - checked = is_edit && team.users.include?(user)
                  .user-row data-name=user.display_name.to_s.downcase data-email=user.email.to_s.downcase
                    .user-info
                      - if user.avatar.attached?
                        = image_tag(user.avatar, class: "user-avatar", alt: user.display_name)
                      - else
                        .user-avatar.avatar-fallback.customer-list-initials-avatar.f-reg-12 class=avatar_fallback_color_class(full_name(user))
                          = initials(user)
                      .user-details
                        span.f-semi-14.user-name = user.display_name
                        span.f-reg-12.user-email = user.email
                    label.custom-checkbox
                      input type="checkbox" name="team[user_ids][]" value=user.id checked=checked
                      .checkmark
              - else
                .no-users-placeholder
                  p.f-reg-14 No users available

          - if inboxes.present?
            .team-inboxes-section
              p.section-label.f-reg-14 Connect to Inboxes
              .inboxes-list
                - inboxes.each do |inbox|
                  - inbox_checked = is_edit && team.inboxes.include?(inbox)
                  .inbox-row data-name=inbox.name.to_s.downcase
                    .inbox-info
                      span.f-reg-14.inbox-name = inbox.name
                    label.custom-checkbox
                      input type="checkbox" name="team[inbox_ids][]" value=inbox.id checked=inbox_checked
                      .checkmark

        .form-actions
          button.cancel-btn.f-med-14 type="button" data-action="click->modalToggler#hideModal" Cancel
          = f.submit(is_edit ? "Save Changes" : "Create Team",
              class: "submit-btn f-med-14",
              data: { action: "click->formValidation#validate" })
