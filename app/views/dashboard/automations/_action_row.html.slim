- action = action.is_a?(Hash) ? action : (JSON.parse(action.to_s) rescue {})
- action = {} unless action.is_a?(Hash)
- action_name = action["action"] || action[:action] || action["type"] || action[:type]
- action_params = (action["params"] || action[:params]).is_a?(Hash) ? (action["params"] || action[:params]) : {}
- action_value = action["value"] || action[:value]

.autom-action-row data-action-row=""
  .ui-field-control.ui-field-control--plain.ui-field-control--no-icon.ui-macro-action-select
    = select_tag "action_type_#{action_index}", options_for_select(action_type_options, action_name), include_blank: t("forms.options.select_action"), class: "ui-select ui-control", data: { controller: "select", action: "change->automation-builder#actionTypeChanged", "action-type": true }

  / Dynamic params area — rendered based on selected action type
  span.ui-field-control.ui-field-control--plain.ui-field-control--no-icon data-action-params=""
    - case action_name
    - when "assign_agent"
      = select_tag "action_param_#{action_index}", options_for_select(agent_options_for_select, action_params["agent_id"] || action_params[:agent_id]), include_blank: t("forms.options.select_agent"), class: "ui-select ui-control", data: { controller: "select", "action-param": "agent_id" }
    - when "assign_team"
      = select_tag "action_param_#{action_index}", options_for_select(team_options_for_select, action_params["team_id"] || action_params[:team_id]), include_blank: t("forms.options.select_team"), class: "ui-select ui-control", data: { controller: "select", "action-param": "team_id" }
    - when "set_status"
      = select_tag "action_param_#{action_index}", options_for_select([[t("forms.options.active"), "active"], [t("forms.options.closed"), "closed"], [t("forms.options.snoozed"), "snoozed"], [t("forms.options.resolved"), "resolved"]], action_params["status"] || action_params[:status] || action_value), class: "ui-select ui-control", data: { controller: "select", "action-param": "status" }
    - when "set_priority"
      = select_tag "action_param_#{action_index}", options_for_select([[t("forms.options.low"), "low"], [t("forms.options.medium"), "medium"], [t("forms.options.high"), "high"], [t("forms.options.urgent"), "urgent"]], action_params["priority"] || action_params[:priority] || action_value), class: "ui-select ui-control", data: { controller: "select", "action-param": "priority" }
    - when "add_label", "remove_label"
      - selected_label_id = Array(action_params["label_ids"] || action_params[:label_ids]).first
      = select_tag "action_param_#{action_index}", options_for_select(label_options_for_select, selected_label_id), include_blank: t("forms.options.select_label", default: "Select label..."), class: "ui-select ui-control autom-label-select", data: { controller: "select", "action-param": "label_ids" }
    - when "send_message", "add_note"
      = text_area_tag "action_param_#{action_index}", action_params["content"] || action_params[:content], placeholder: t("ui.dashboard.automations.action_row.enter_message", default: "Enter message..."), rows: 4, data: { "action-param": "content" }, class: "ap-input autom-action-textarea"
    - when "send_email_to_customer"
      = select_tag "action_param_#{action_index}", options_for_select(email_template_options_for_select, action_params["email_template_id"] || action_params[:email_template_id]), include_blank: t("forms.options.select_email_template", default: "Select email template..."), class: "ui-select ui-control", data: { controller: "select", "action-param": "email_template_id" }
    - when "send_email_to_team"
      = select_tag "action_param_template_#{action_index}", options_for_select(email_template_options_for_select, action_params["email_template_id"] || action_params[:email_template_id]), include_blank: t("forms.options.select_email_template", default: "Select email template..."), class: "ui-select ui-control", data: { controller: "select", "action-param": "email_template_id" }
      = select_tag "action_param_team_#{action_index}", options_for_select(team_options_for_select, action_params["team_id"] || action_params[:team_id]), include_blank: t("forms.options.select_team", default: "Select team..."), class: "ui-select ui-control", data: { controller: "select", "action-param": "team_id" }
    - when "snooze"
      = number_field_tag "action_param_#{action_index}", action_params["duration_hours"] || action_params[:duration_hours], placeholder: t("ui.dashboard.automations.action_row.hours", default: "Hours"), min: 1, data: { "action-param": "duration_hours" }, class: "ap-input"
    - when "set_locale"
      = text_field_tag "action_param_#{action_index}", action_params["locale"] || action_params[:locale], placeholder: t("ui.dashboard.automations.action_row.e_g_en_fr_de", default: "e.g. en, fr, de"), data: { "action-param": "locale" }, class: "ap-input"
    - when "trigger_webhook"
      = text_field_tag "action_param_url_#{action_index}", action_params["url"] || action_params[:url], placeholder: "https://...", data: { "action-param": "url" }, class: "ap-input"
      = select_tag "action_param_method_#{action_index}", options_for_select(%w[POST GET PUT PATCH], action_params["method"] || action_params[:method] || "POST"), class: "ui-select ui-control", data: { controller: "select", "action-param": "method" }

  button.autom-remove-action-btn.ui-macro-remove-action type="button" data-action="click->automation-builder#removeAction" aria-label=t("general.delete")
    = image_tag("delete_red.svg", class: "autom-delete-icon", alt: "", aria: { hidden: true })
