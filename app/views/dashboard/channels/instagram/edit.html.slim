= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "instagram-channels") do
    .channel-theme-instagram
      .ui-page-body
        .ui-page-header
          = link_to channels_instagram_index_path, class: "ui-back-link"
            | ← #{t("dashboard.instagram_channels.form.back")}
          h2.f-semi-32 = t("dashboard.instagram_channels.edit.title")

        /! Connection Status Section
        .ui-section
          .ui-section-header
            h3.f-semi-18 = t("dashboard.instagram_channels.form.connection_section")

          .channel-connection-card
            .channel-connection-info
              - if @instagram_channel.avatar_url.present?
                img.ui-avatar src=@instagram_channel.avatar_url alt=@instagram_channel.name
              - else
                .ui-avatar-placeholder
                  | 📸
              .ui-profile-details
                h3.f-semi-16 = @instagram_channel.name || @instagram_channel.username
                p.ui-username
                  | @#{@instagram_channel.username}

            - if @instagram_channel.reauthorization_required? || @instagram_channel.token_expired?
              .channel-reauth-banner
                .channel-reauth-icon ⚠️
                .channel-reauth-text
                  p.f-semi-14 = t("dashboard.instagram_channels.edit.reauth_title")
                  p.f-reg-12 = t("dashboard.instagram_channels.edit.reauth_description")
                = link_to oauth_authorize_channels_instagram_index_path, class: "channel-reconnect-btn", data: { turbo: false }
                  | 🔄 #{t("dashboard.instagram_channels.edit.reconnect")}
            - else
              .channel-token-info
                .ui-badge.ui-badge-active
                  span.ui-badge-icon 🟢
                  span = t("dashboard.instagram_channels.index.status_active")
                - if @instagram_channel.expires_at.present?
                  .channel-token-expiry
                    span.f-reg-12 = t("dashboard.instagram_channels.edit.token_expires_at", time: l(@instagram_channel.expires_at, format: :long))

        /! Inbox Configuration Section
        .ui-section
          .ui-section-header
            h3.f-semi-18 = t("dashboard.instagram_channels.form.inbox_section")

          = form_with model: @instagram_channel, url: channels_instagram_path(@instagram_channel), method: :patch, class: "ui-form-wrapper" do |f|
            .ui-form-group
              = f.label :name, t("dashboard.instagram_channels.edit.name_label"), class: "ui-label"
              = f.text_field :name, class: "ui-input", placeholder: t("dashboard.instagram_channels.edit.name_placeholder")

            - if @instagram_channel.primary_inbox
              .channel-inbox-settings
                h4.f-semi-14 = t("dashboard.instagram_channels.edit.inbox_settings_title")

                = f.fields_for :primary_inbox, @instagram_channel.primary_inbox do |inbox|
                  = inbox.hidden_field :id

                  .ui-form-group.ui-checkbox-group
                    = inbox.check_box :csat_survey_enabled, class: "ui-checkbox"
                    = inbox.label :csat_survey_enabled, t("dashboard.instagram_channels.edit.csat_enabled"), class: "ui-checkbox-label"

                  .ui-form-group
                    = inbox.label :csat_survey_id, "CSAT Survey", class: "ui-label"
                    = inbox.collection_select :csat_survey_id, current_account.csat_surveys, :id, :name, { include_blank: "Default System Survey" }, class: "ui-select"
                
                  .ui-form-group
                    = inbox.label :sla_policy_ids, "SLA Policies", class: "ui-label"
                    = inbox.collection_select :sla_policy_ids, current_account.sla_policies, :id, :name, {}, { multiple: true, class: "ui-select" }

            .ui-form-actions
              = link_to channels_instagram_index_path, class: "ui-btn-secondary"
                | #{t("dashboard.instagram_channels.form.cancel")}
              = f.submit t("dashboard.instagram_channels.form.save"), class: "ui-btn-primary"

        /! Danger Zone
        .ui-section.ui-danger-zone
          .ui-section-header
            h3.f-semi-18 = t("dashboard.instagram_channels.edit.danger_title")
          p.f-reg-14 = t("dashboard.instagram_channels.edit.danger_description")
          = link_to channels_instagram_path(@instagram_channel), method: :delete, class: "ui-btn-danger", data: { turbo_method: :delete, turbo_confirm: t("dashboard.instagram_channels.index.delete_confirm") }
            | #{t("dashboard.instagram_channels.edit.disconnect")}
