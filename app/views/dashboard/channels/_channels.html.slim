- view_items = dashboard_sidebar_view_items(@sidebar_counts, @unread_counts)

.helpdesk-section.center-wrapper.deskbolic-shell class=[(params[:mobile_view] == 'inboxes' ? 'mobile-view-inboxes' : nil), (@conversation.present? ? 'is-mobile-conversation-open' : nil)]
  .helpdesk-container data-controller="toggler"
    #channels-sidebar.helpdesk-nav.deskbolic-sidebar data-toggler-target="sidebar"
      .sidebar-brand
        .sidebar-brand-mark aria-hidden="true"
          = inline_svg_tag("gradient_logo.svg", class: "sidebar-brand-logo")
        .sidebar-brand-copy
          p.sidebar-brand-name Deskbolic
          p.sidebar-brand-product = t('dashboard.sidebar.channels.title')
        button.sidebar-toggle type="button" aria-controls="channels-sidebar" aria-expanded="true" aria-label=t("ui.dashboard.agent.agent_sidebar.menu") data-action="click->toggler#toggleSidebar" data-toggler-target="sidebarToggle"
          = image_tag("dashboard_collapse.svg", class: "link-icon", alt: "", aria: { hidden: true })

      button.sidebar-search type="button" data-action="click->toggler#openSearch"
        = image_tag("global_search.svg", class: "sidebar-search-icon", alt: "", aria: { hidden: true })
        span = t('dashboard.conversations.search', default: 'Search')
        kbd ⌘K

      .sidebar-notifications data-controller="modal-toggler frame-toggler"
        button.sidebar-notifications-trigger type="button" data-action="click->modal-toggler#showModal click->frame-toggler#loadModal" data-url=notifications_path aria-haspopup="dialog"
          = inline_svg_tag("bells.svg", class: "sidebar-notifications-icon", alt: "", aria: { hidden: true })
          span.sidebar-notifications-label = t("notifications.title")
          = render "dashboard/notifications/badge"
        = render "dashboard/shared/modal_popper"

      .sidebar-navigation
        section.sidebar-section
          h2.sidebar-section-title = t('dashboard.sidebar.channels.views', default: 'Views')
          ul.sidebar-list
            - view_items.each do |item|
              - active_view = @inbox.blank? && @team_id.blank? && @assignee_id.blank? && @filter.to_s == item[:key].to_s
              li
                .sidebar-link class=(active_view ? 'is-active' : '') data-controller="section" data-action="click->section#toggleSection" data-url=conversations_path(filter: item[:key].presence)
                  = inline_svg_tag(item[:icon], class: "sidebar-link-icon", aria: { hidden: true })
                  span.sidebar-link-label = item[:label]
                  span.sidebar-link-count = item[:count]

        section.sidebar-section
          h2.sidebar-section-title = t('dashboard.sidebar.channels.inboxes', default: 'Inboxes')
          ul.sidebar-list
            - @inboxes&.each do |inbox|
              - inbox_unread_count = @unread_counts&.dig(:inboxes, inbox.id.to_s).to_i
              li
                .sidebar-link class=(@inbox&.id == inbox.id ? 'is-active' : '') data-controller="section" data-action="click->section#toggleSection" data-url=conversations_path(resource_id: inbox.id)
                  span.sidebar-link-icon = inbox_icon(inbox)
                  span.sidebar-link-label title=inbox.name = inbox.name
                  span.sidebar-link-badges
                    span.sidebar-unread-notification role="img" aria-label=t('dashboard.sidebar.channels.unread_messages', default: 'Unread messages') data-controller="unread-badge" data-action="deskbolic:unread-counts-updated@window->unread-badge#update" data-unread-badge-id-value=inbox.id data-unread-badge-type-value="inbox" style=(inbox_unread_count.positive? ? nil : 'display: none')
                      = inline_svg_tag('notification.svg', class: 'sidebar-unread-notification-icon', aria: { hidden: true })
                    span.sidebar-link-count = inbox.conversations.count

        - if @teams.present?
          section.sidebar-section
            h2.sidebar-section-title = t('dashboard.sidebar.channels.teams')
            ul.sidebar-list
              - @teams.each do |team|
                - team_icon = team.name.to_s.downcase.include?('engineering') ? 'dashboard_team_engineering.svg' : 'dashboard_team_support.svg'
                li
                  .sidebar-link class=(@team_id.to_s == team.id.to_s ? 'is-active' : '') data-controller="section" data-action="click->section#toggleSection" data-url=conversations_path(team_id: team.id)
                    = image_tag(team_icon, class: "sidebar-link-icon sidebar-link-icon--team", alt: "", aria: { hidden: true })
                    span.sidebar-link-label = team.name
                    span.sidebar-link-count = team.conversations.active.count

        - if @team_users.present?
          section.sidebar-section
            h2.sidebar-section-title = t('dashboard.sidebar.channels.teammates')
            ul.sidebar-list
              - @team_users.each do |team_user|
                - teammate = team_user.user
                li
                  .sidebar-link class=(@assignee_id.to_s == teammate.id.to_s ? 'is-active' : '') data-controller="section" data-action="click->section#toggleSection" data-url=conversations_path(assignee_id: teammate.id)
                    - if teammate.avatar&.attached?
                      = image_tag(teammate.avatar, class: "sidebar-avatar", alt: teammate.display_name)
                    - else
                      .sidebar-avatar.avatar-fallback class=avatar_fallback_color_class(teammate.display_name)
                        = initials(teammate)
                    span.sidebar-link-label = teammate.display_name
                    span.sidebar-link-count = current_account.conversations.where(assignee: teammate, status: :active).count

      = render "dashboard/shared/sidebar_account_menu"

    button.dashboard-sidebar-backdrop type="button" tabindex="-1" aria-label=t('ui.dashboard.agent.agent_sidebar.menu') data-action="click->toggler#closeSidebar" data-toggler-target="sidebarBackdrop"

    .helpdesk-body
      turbo-frame#conversations-frame
        == yield

    = render 'dashboard/shared/mobile_navigation', active: (params[:mobile_view] == 'inboxes' ? 'inboxes' : 'inbox')
