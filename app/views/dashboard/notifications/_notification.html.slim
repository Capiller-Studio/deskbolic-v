- is_unread = notification.read_at.nil?
- target_url = root_path
- if notification.event.in?(%w[limit_approaching limit_reached subscription_created subscription_renewed subscription_cancelled trial_expiring payment_failed])
  - target_url = dashboard_billing_path
- elsif notification.resource.is_a?(Conversation)
  - target_url = conversation_path(notification.resource)
- elsif notification.resource.is_a?(Message) && notification.resource.conversation
  - target_url = conversation_path(notification.resource.conversation)
- notification_icon = notification_icon_for(notification.event)

.notif-item id="notification_#{notification.id}" class=(is_unread ? "unread" : "read")
  .notif-icon-wrapper class="#{notification.event}"
    = image_tag(notification_icon, class: "notif-svg-icon", alt: "", aria: { hidden: true })

  = link_to target_url, class: "notif-content", data: { turbo: false } do
    .notif-title = I18n.t("notifications.push.#{notification.event}.title")
    .notif-body-text
      - identifier = notification.resource.try(:identifier) || "##{notification.resource.try(:display_id) || notification.resource_id.to_s[0..6]}"
      - inbox_name = notification.resource.try(:inbox).try(:name) || ""
      - team_name = notification.resource.try(:team).try(:name) || t("forms.options.a_team")
      - assignee_name = notification.resource.try(:assignee).try(:name) || t("forms.options.an_agent")
      - days = notification.resource.respond_to?(:days_until_trial_end) ? notification.resource.days_until_trial_end : 0
      - plan_name = notification.resource.respond_to?(:plan) ? notification.resource.plan&.name&.capitalize : ""
      - resource_name = notification.resource_type
      - percentage = 100
      = I18n.t("notifications.push.#{notification.event}.body", identifier: identifier, inbox_name: inbox_name, team_name: team_name, assignee_name: assignee_name, days: days, plan_name: plan_name, resource: resource_name, percentage: percentage)
    .notif-time = t("general.ago", time: time_ago_in_words(notification.created_at))

  - if is_unread
    .notif-actions
      = button_to "", mark_read_notification_path(notification), method: :post, class: "notif-unread-dot", title: t("notifications.mark_read"), aria: { label: t("notifications.mark_read") }, data: { turbo: true }
