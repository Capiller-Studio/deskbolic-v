div id="automation_#{automation.id}" class="auto-card ui-responsive-list-card #{automation.inactive? ? 'inactive' : ''}" data-sortable-target="item" data-id="#{automation.id}" draggable="true"
  .auto-drag-handle.ui-responsive-list-card__handle data-action="dragstart->sortable#dragStart dragend->sortable#dragEnd" data-sortable-target="handle"
    = image_tag("drag_handle.svg", alt: "", aria: { hidden: true })

  .auto-card-icon.ui-responsive-list-card__icon
    = image_tag("automation.svg", alt: "", aria: { hidden: true })

  .auto-card-info.ui-responsive-list-card__content
    .auto-card-name-row.ui-responsive-wrap-mobile
      h3.auto-card-name = automation.name
      span.ui-status-badge class=(automation.active? ? "ui-status-badge--active" : "ui-status-badge--inactive")
        span.ui-status-badge__dot aria-hidden="true"
        = automation.active? ? t("general.active", default: "Active") : t("general.inactive", default: "Inactive")
    .auto-card-meta
      - if automation.event_name.present?
        span.auto-card-event = t("dashboard.automations.events.#{automation.event_name.tr('.', '_')}")
      - if automation.description.present?
        span.auto-card-event — #{truncate(automation.description, length: 60)}

  .auto-card-actions.ui-responsive-list-card__actions
    = button_to duplicate_automation_path(automation), method: :post, class: "auto-action-btn", title: t("dashboard.automations.index.duplicate"), aria: { label: t("dashboard.automations.index.duplicate") } do
      = image_tag("copy-check.svg", alt: "", aria: { hidden: true })

    = button_to toggle_automation_path(automation), method: :patch, class: "auto-toggle #{automation.active? ? 'active' : ''}", data: { turbo_frame: "_top" }, aria: { label: t("dashboard.automations.index.toggle") } do
      - if automation.active?
        span.auto-toggle-check aria-hidden="true" = image_tag("mark.svg", alt: "", aria: { hidden: true })

    details.auto-card-menu
      summary.auto-card-menu__trigger aria-label=t("dashboard.automations.index.actions_for", name: automation.name, default: "Actions for %{name}")
        span.auto-card-menu__icon aria-hidden="true" ⋮
      .auto-card-menu__popover role="menu"
        = link_to edit_automation_path(automation), role: "menuitem" do
          = t("general.edit", default: "Edit")
        - unless automation.system_provided?
          = button_to automation_path(automation), method: :delete, role: "menuitem", form: { class: "auto-card-menu__delete-form" }, data: { turbo_confirm: t("dashboard.automations.index.delete_confirm") } do
            span = t("general.delete", default: "Delete")
