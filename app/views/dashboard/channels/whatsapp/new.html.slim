= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "whatsapp-channels") do
    .channel-theme-whatsapp
      .ui-page-body
        .ui-page-header
          = link_to channels_whatsapp_index_path, class: "ui-back-link"
            | ← #{t("dashboard.whatsapp_channels.form.back")}
          h2.f-semi-32 = t("dashboard.whatsapp_channels.new.title")
          p.f-reg-16 = t("dashboard.whatsapp_channels.new.subtitle")

        .channel-setup-tabs data-controller="whatsapp-tabs"
          .ui-tabs-header
            button.ui-tab-btn disabled=true type="button" style="opacity: 0.6; cursor: not-allowed;"
              | ⚡ #{t("dashboard.whatsapp_channels.new.tabs.embedded")}
              span style="background: var(--primary-50); color: var(--primary-600); font-size: 11px; padding: 2px 6px; border-radius: 4px; margin-left: 8px; font-weight: 600;" = t("general.coming_soon")
            button.ui-tab-btn.active data-action="click->whatsapp-tabs#switch" data-target-tab="manual" type="button"
              | 🛠️ #{t("dashboard.whatsapp_channels.new.tabs.manual")}

          /! Quick Connect (Embedded Signup)
          #tab-embedded.ui-tab-content data-whatsapp-tabs-target="tabContent" data-tab-name="embedded" data-controller="whatsapp-channel" data-whatsapp-channel-app-id-value="#{@whatsapp_app_id}" data-whatsapp-channel-config-id-value="#{@whatsapp_config_id}" data-whatsapp-channel-callback-url-value="#{callback_channels_whatsapp_index_path}"
            .ui-step
              .ui-step-header
                .ui-step-number 1
                .ui-step-title
                  h3.f-semi-18 = t("dashboard.whatsapp_channels.new.embedded.step1_title")
                  p.f-reg-14 = t("dashboard.whatsapp_channels.new.embedded.step1_description")
                  ul.ui-guide-list
                    li = t("dashboard.whatsapp_channels.new.embedded.guide_1")
                    li = t("dashboard.whatsapp_channels.new.embedded.guide_2")
                    li = t("dashboard.whatsapp_channels.new.embedded.guide_3")

              .channel-connect-action
                button.ui-btn-primary type="button" data-action="click->whatsapp-channel#connectWa"
                  | 💬 #{t("dashboard.whatsapp_channels.new.embedded.connect_button")}

            /! Form submitted automatically by JS on success
            = form_with url: callback_channels_whatsapp_index_path, method: :post, class: "channel-hidden-form", data: { whatsapp_channel_target: "callbackForm" }, style: "display: none;" do |f|
              input type="hidden" name="code" data-whatsapp-channel-target="code"

          /! Manual Setup
          #tab-manual.ui-tab-content.active data-whatsapp-tabs-target="tabContent" data-tab-name="manual"
            .channel-manual-container
              .ui-guide-box
                h4.f-semi-16 = t("dashboard.whatsapp_channels.new.manual.guide_title")
                ol.ui-guide-list
                  li = t("dashboard.whatsapp_channels.new.manual.guide_1")
                  li = t("dashboard.whatsapp_channels.new.manual.guide_2")
                  li = t("dashboard.whatsapp_channels.new.manual.guide_3")
                  li = t("dashboard.whatsapp_channels.new.manual.guide_4")
                  li = t("dashboard.whatsapp_channels.new.manual.guide_5")

              = form_with model: @whatsapp_channel, url: channels_whatsapp_index_path, class: "ui-form-wrapper" do |f|
                .ui-form-group
                  = f.label :name, t("dashboard.whatsapp_channels.form.name_label"), class: "ui-label"
                  = f.text_field :name, class: "ui-input", placeholder: t("dashboard.whatsapp_channels.form.name_placeholder"), required: true
              
                .channel-phone-input-group
                  .ui-form-group style="width: 35%; margin-bottom: 0;"
                    = f.label :phone_code, t("dashboard.whatsapp_channels.form.phone_code_label"), class: "ui-label"
                    = f.select :phone_code, options_for_select(whatsapp_country_codes), { include_blank: t("forms.options.select_country_code") }, { class: "ui-select", required: true }
                  
                  .ui-form-group style="flex: 2;"
                    = f.label :phone_number, t("dashboard.whatsapp_channels.form.phone_number_label"), class: "ui-label"
                    = f.text_field :phone_number, class: "ui-input", placeholder: t("ui.dashboard.channels.whatsapp.new.e_g_234567890"), required: true

                .ui-form-group
                  = f.label :phone_number_id, t("dashboard.whatsapp_channels.form.phone_id_label"), class: "ui-label"
                  = f.text_field :phone_number_id, class: "ui-input", required: true

                .ui-form-group
                  = f.label :business_account_id, t("dashboard.whatsapp_channels.form.waba_id_label"), class: "ui-label"
                  = f.text_field :business_account_id, class: "ui-input", required: true

                .ui-form-group
                  = f.label :api_key, t("dashboard.whatsapp_channels.form.api_key_label"), class: "ui-label"
                  = f.text_area :api_key, class: "ui-input", rows: 3, placeholder: t("dashboard.whatsapp_channels.form.api_key_placeholder"), required: true

                .ui-form-actions
                  = link_to channels_whatsapp_index_path, class: "ui-btn-secondary"
                    | #{t("general.cancel")}
                  = f.submit t("dashboard.whatsapp_channels.form.create"), class: "ui-btn-primary"
