= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "integrations") do
    .body-container
      .channel-theme-email
        .ui-index-header
          .ui-title-area
            h2.f-semi-32 = t("dashboard.settings.integrations.index.title")
            p.f-reg-16 = t("dashboard.settings.integrations.index.description")

        .ap-integrations-grid style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; margin-top: 24px;"
          
          / Slack Integration
          .ui-card style="display: flex; flex-direction: column; justify-content: space-between; height: 100%;"
            div
              .d-flex.align-items-center.mb-3
                = image_tag "https://cdn.worldvectorlogo.com/logos/slack-new-logo.svg", width: 32, height: 32, alt: "Slack"
                h3.f-semi-16.ml-2.mb-0 Slack
              p.f-reg-14.ui-subtitle = t("dashboard.settings.integrations.slack.description")

            .mt-4
              - if @slack
                .d-flex.align-items-center.justify-content-between
                  .ui-badge.ui-badge-active
                    span.ui-badge-icon ✓
                    span = t("dashboard.settings.integrations.connected")
                  = button_to t("dashboard.settings.integrations.disconnect"), integration_path(@slack), method: :delete, data: { turbo_confirm: t("dashboard.shared.are_you_sure") }, class: "ui-btn-danger"
              - else
                - if @slack_client_id.present?
                  = link_to "https://slack.com/oauth/v2/authorize?client_id=#{@slack_client_id}&scope=incoming-webhook&redirect_uri=#{slack_callback_integrations_url}", data: { turbo: false }, class: "ui-btn-primary w-100 text-center" do
                    = t("dashboard.settings.integrations.slack.connect")
                - else
                  = link_to new_integration_path(provider: :slack), class: "ui-btn-primary w-100 text-center" do
                    = t("dashboard.settings.integrations.slack.connect")

          / Webhooks Integration
          .ui-card style="display: flex; flex-direction: column; justify-content: space-between; height: 100%;"
            div
              .d-flex.align-items-center.mb-3
                / Placeholder SVG for Webhooks
                svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                  path d="M12 8v4"
                  path d="M12 16h.01"
                h3.f-semi-16.ml-2.mb-0 = t("ui.dashboard.integrations.index.webhooks")
              p.f-reg-14.ui-subtitle = t("dashboard.settings.integrations.webhooks.description")

            .mt-4
              - if @webhooks.any?
                .d-flex.align-items-center.justify-content-between
                  span.f-reg-14.font-weight-bold = t("dashboard.settings.integrations.webhooks.configured_count", count: @webhooks.count)
                  = link_to t("dashboard.settings.integrations.manage"), new_integration_path(provider: :webhook), class: "ui-btn-secondary"

                .mt-3.pt-3 style="border-top: 1px solid var(--border-color);"
                  - @webhooks.each do |webhook|
                    .d-flex.justify-content-between.align-items-center.mb-2.gap-2
                      span.f-reg-14.text-truncate style="flex: 1;" = webhook.settings["webhook_url"]
                      .d-flex.align-items-center.gap-2 style="flex-shrink: 0;"
                        = link_to edit_integration_path(webhook), class: "ui-action-btn", title: t("dashboard.shared.edit")
                          | ✏️
                        = link_to integration_path(webhook), data: { turbo_method: :delete, turbo_confirm: t("dashboard.shared.are_you_sure") }, class: "ui-action-btn ui-action-delete", title: t("general.delete") do
                          | 🗑️
              - else
                = link_to t("dashboard.settings.integrations.webhooks.connect"), new_integration_path(provider: :webhook), class: "ui-btn-primary w-100 text-center"

          / Google Translate Integration
          .ui-card style="display: flex; flex-direction: column; justify-content: space-between; height: 100%;"
            div
              .d-flex.align-items-center.mb-3
                = image_tag "https://upload.wikimedia.org/wikipedia/commons/d/d7/Google_Translate_logo.svg", width: 32, height: 32, alt: t("ui.dashboard.integrations.index.google_translate")
                h3.f-semi-16.ml-2.mb-0 = t("ui.dashboard.integrations.index.google_translate")
              p.f-reg-14.ui-subtitle = t("dashboard.settings.integrations.google_translate.description")

            .mt-4
              button.ui-btn-secondary.w-100 disabled="disabled"
                = t("dashboard.settings.integrations.coming_soon")
