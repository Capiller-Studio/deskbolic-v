.ec-section.ec-section--open data-web-widget-channel-target="installationSection"
  .ec-section-header data-action="click->web-widget-channel#toggleSection"
    .ec-section-title
      span.ec-section-icon 💻
      span.ec-section-label = t("dashboard.web_widget_channels.form.installation_section", default: "Installation & Setup")
    span.ec-section-chevron ▼
  .ec-section-body
    .ww-credentials-grid style="display: grid; grid-template-columns: 1fr; gap: 16px; margin-bottom: 24px;"
      .ww-credential-box style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px;"
        h4.f-semi-14 style="color: #475569; margin-bottom: 8px;" HMAC Secret Key
        .ec-copy-field style="display: flex; gap: 8px;"
          input type="password" class="ec-input" value="#{web_widget_channel.hmac_token}" readonly=true style="flex: 1;"
          button.ec-btn-secondary type="button" data-action="click->web-widget-channel#copyEmbedCode" data-code="#{web_widget_channel.hmac_token}" Copy

    p.text-muted style="margin-bottom: 16px; font-size: 14px;" 
      | Embed the Deskbolic widget into your website or web app by placing the following snippet just before the closing <code>&lt;/body&gt;</code> tag.

    .ww-snippet-block style="margin-bottom: 24px;"
      .ww-snippet-header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;"
        h4.f-semi-14 Standard HTML
      pre style="background: #1e293b; color: #e2e8f0; padding: 16px; border-radius: 8px; font-family: monospace; font-size: 13px; overflow-x: auto;"
        code
          | &lt;script
          br
          |   src="#{ENV['WIDGET_APP_URL'] || 'https://widget.deskbolic.com'}/w/#{current_account.id}/#{web_widget_channel.id}/embed.js"
          br
          |   data-locale="en"&gt;
          br
          | &lt;/script&gt;

    .ww-snippet-block style="margin-bottom: 24px;"
      .ww-snippet-header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;"
        h4.f-semi-14 React / Next.js
      pre style="background: #1e293b; color: #e2e8f0; padding: 16px; border-radius: 8px; font-family: monospace; font-size: 13px; overflow-x: auto;"
        code
          | import { useEffect } from 'react';
          br
          br
          | export default function DeskbolicWidget() {
          br
          |   useEffect(() =&gt; {
          br
          |     const script = document.createElement('script');
          br
          |     script.src = "#{ENV['WIDGET_APP_URL'] || 'https://widget.deskbolic.com'}/w/#{current_account.id}/#{web_widget_channel.id}/embed.js";
          br
          |     script.setAttribute('data-locale', 'en');
          br
          |     document.body.appendChild(script);
          br
          |   }, []);
          br
          |   return null;
          br
          | }

    h4.f-semi-14 style="margin-bottom: 12px; margin-top: 32px;" Supported Parameters (Data Attributes)
    p.text-muted style="font-size: 13px; margin-bottom: 16px;" Pass these attributes directly to the script tag to identify users or customize behavior.

    .ec-table-responsive style="border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;"
      table.ec-table style="width: 100%; text-align: left; border-collapse: collapse; font-size: 13px;"
        thead style="background: #f8fafc; border-bottom: 1px solid #e2e8f0;"
          tr
            th style="padding: 12px 16px; font-weight: 600;" Attribute
            th style="padding: 12px 16px; font-weight: 600;" Description
        tbody
          tr style="border-bottom: 1px solid #e2e8f0;"
            td style="padding: 12px 16px; font-family: monospace; color: #0ea5e9;" data-identifier
            td style="padding: 12px 16px;" Your system's unique user ID (e.g., database ID). Required for Identity Verification.
          tr style="border-bottom: 1px solid #e2e8f0;"
            td style="padding: 12px 16px; font-family: monospace; color: #0ea5e9;" data-signature
            td style="padding: 12px 16px;" HMAC SHA-256 signature generated using your secret key. Required if Secure Identity is enforced.
          tr style="border-bottom: 1px solid #e2e8f0;"
            td style="padding: 12px 16px; font-family: monospace; color: #0ea5e9;" data-email
            td style="padding: 12px 16px;" The customer's email address.
          tr style="border-bottom: 1px solid #e2e8f0;"
            td style="padding: 12px 16px; font-family: monospace; color: #0ea5e9;" data-name
            td style="padding: 12px 16px;" The customer's full name.
          tr style="border-bottom: 1px solid #e2e8f0;"
            td style="padding: 12px 16px; font-family: monospace; color: #0ea5e9;" data-locale
            td style="padding: 12px 16px;" Force a specific language locale (e.g., "en", "fr"). Overrides browser default.
          tr
            td style="padding: 12px 16px; font-family: monospace; color: #0ea5e9;" data-position
            td style="padding: 12px 16px;" Position of the launcher. Options: <code>right</code> (default) or <code>left</code>.

    - if web_widget_channel.secure_identity_enforced?
      .ww-alert style="margin-top: 24px; padding: 16px; background: #eff6ff; border-left: 4px solid #3b82f6; border-radius: 4px;"
        h4.f-semi-14 style="color: #1e3a8a; margin-bottom: 8px;" HMAC Signature Example (Ruby)
        p.text-muted style="font-size: 13px; margin-bottom: 12px;" Because you have enabled <strong>Enforce Secure Identity</strong>, you must generate a signature on your backend and pass it to the frontend.
        pre style="background: #1e293b; color: #e2e8f0; padding: 16px; border-radius: 8px; font-family: monospace; font-size: 13px; overflow-x: auto;"
          code
            | require 'openssl'
            br
            | require 'base64'
            br
            br
            | secret_key = "#{web_widget_channel.hmac_token}"
            br
            | identifier = current_user.id.to_s
            br
            | signature = OpenSSL::HMAC.hexdigest('SHA256', secret_key, identifier)
