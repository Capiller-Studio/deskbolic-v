/ = render("dashboard/shared/dashboard_container", current_page: "profile") do
= render("dashboard/settings/settings_sidebar", current_page: "profile") do
  - mobile_profile_editing = params[:edit].present? || request.patch?
  .mobile-profile-home class=("is-hidden" if mobile_profile_editing)
    .mobile-profile-content
      section.mobile-profile-identity
        - if current_user.avatar&.attached?
          = image_tag(current_user.avatar, class: "mobile-profile-avatar", alt: current_user.display_name)
        - else
          .mobile-profile-avatar.avatar-fallback class=avatar_fallback_color_class(full_name(current_user))
            = initials(current_user)
        .mobile-profile-identity-copy
          strong = current_user.display_name
          span = current_user.email
        = link_to profile_path(edit: true), class: "mobile-profile-edit-link", aria: { label: t("auth.edit_profile.title") } do
          = inline_svg_tag("pencil.svg", aria: { hidden: true })
          span = t("auth.edit_profile.title")

      .mobile-profile-status
        span.mobile-profile-status-dot aria-hidden="true"
        span = t("enums.user.status.active", default: "Active")

      nav.mobile-profile-shortcuts
        = link_to conversations_path(filter: "assigned"), class: "mobile-profile-shortcut", data: { turbo: false } do
          = image_tag("dashboard_assigned.svg", alt: "", aria: { hidden: true })
          span = t("dashboard.sidebar.channels.assigned_to_me", default: "Assigned to me")
          small = @mobile_profile_counts&.dig(:assigned).to_i
          = inline_svg_tag("arrow_left.svg", class: "mobile-profile-chevron", aria: { hidden: true })
        = link_to conversations_path(filter: "mentions"), class: "mobile-profile-shortcut", data: { turbo: false } do
          = image_tag("dashboard_mentions.svg", alt: "", aria: { hidden: true })
          span = t("dashboard.sidebar.channels.mentions", default: "Mentions")
          small = @mobile_profile_counts&.dig(:mentions).to_i
          = inline_svg_tag("arrow_left.svg", class: "mobile-profile-chevron", aria: { hidden: true })
        = link_to conversations_path(filter: "resolved"), class: "mobile-profile-shortcut", data: { turbo: false } do
          = image_tag("dashboard_resolved.svg", alt: "", aria: { hidden: true })
          span = t("dashboard.mobile_profile.resolved_today", default: "Resolved today")
          small = @mobile_profile_counts&.dig(:resolved).to_i
          = inline_svg_tag("arrow_left.svg", class: "mobile-profile-chevron", aria: { hidden: true })

      section.mobile-profile-settings
        h2 = t("forms.options.select_language")
        .mobile-profile-language
          span.mobile-profile-language-icon aria-hidden="true"
            = inline_svg_tag("world.svg")
          - locale_names = { en: "English", de: "Deutsch", es: "Español", fr: "Français", "pt-BR": "Português", ar: "العربية", ko: "한국어" }
          - locale_options = Core::SUPPORTED_LOCALES.map { |loc| [locale_names[loc.to_sym] || loc.to_s.upcase, url_for(request.params.merge(locale: (loc.to_s == I18n.default_locale.to_s ? nil : loc), only_path: true))] }
          - selected_locale_url = url_for(request.params.merge(locale: (I18n.locale.to_s == I18n.default_locale.to_s ? nil : I18n.locale), only_path: true))
          .mobile-profile-language-picker
            = select_tag :mobile_profile_locale,
              options_for_select(locale_options, selected_locale_url),
              id: "mobile-profile-locale-select",
              class: "mobile-profile-language-select",
              data: { controller: "select" },
              aria: { label: t("forms.options.select_language") },
              onchange: "window.location.href=this.value"

      section.mobile-profile-account-actions
        h2 = t("ui.dashboard.shared.dashboard_container.switch_account", default: "Switch Account")
        .mobile-profile-account-panel
          .mobile-profile-workspace-list
            - current_user.accounts.sort_by { |account| account == current_account ? 0 : 1 }.each do |account|
              - active_account = account == current_account
              = link_to root_url(subdomain: account.identifier), class: "mobile-profile-workspace #{active_account ? 'is-active' : ''}", data: { turbo: false } do
                .mobile-profile-workspace-avatar.avatar-fallback class=avatar_fallback_color_class(account.name)
                  = initials(account, limit: 2)
                .mobile-profile-workspace-details
                  strong = account.name
                  span title=(account.email.presence || current_user.email) = account.email.presence || current_user.email
                - if active_account
                  span.mobile-profile-workspace-check aria-hidden="true"
                    svg viewBox="0 0 20 20" fill="none"
                      path d="M4 10.5 8 14l8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"

          = link_to workspaces_url(subdomain: ""), class: "mobile-profile-account-link", data: { turbo: false } do
            span = t("dashboard.sidebar.all_workspaces")

          = link_to workspace_path(subdomain: ""), class: "mobile-profile-account-link", data: { turbo: false } do
            span.mobile-profile-account-link-icon aria-hidden="true"
              = inline_svg_tag("plus_black.svg")
            span = t("auth.login.create_account", default: "Create Account")

          = button_to destroy_user_session_path, method: :delete, class: "mobile-profile-account-link mobile-profile-account-link--logout" do
            = inline_svg_tag("logout.svg", class: "mobile-profile-account-action-icon", aria: { hidden: true })
            span = t("ui.dashboard.shared.dashboard_container.sign_out", default: "Sign Out")

  .ui-settings-page.profile-page class=("is-mobile-edit" if mobile_profile_editing)
    header.ui-settings-page__header
      = link_to profile_path, class: "profile-mobile-back", aria: { label: t("ui.common.back", default: "Back") } do
        = inline_svg_tag("back_arrow.svg", aria: { hidden: true })
      .ui-settings-page__heading
        h1 = mobile_profile_editing ? t("auth.edit_profile.title") : t("dashboard.profile.index.title")
        p = t("dashboard.profile.index.description")

      button.ui-settings-page__action type="submit" form="profile-form"
        = t("dashboard.profile.index.save")

    main.ui-settings-page__content.profile-content
      = form_with(model: @user, url: profile_path, method: :patch, local: true, html: { multipart: true, id: "profile-form" }, class: "profile-form", data: { controller: "profile", action: "input->profile#refresh change->profile#refresh" }) do |f|
        .profile-layout
          .profile-summary
            .profile-avatar-field data-controller="dropzone" data-dropzone-max-file-size="2" data-dropzone-max-files="1" data-dropzone-accepted-files=".jpeg,.jpg,.png"
              .profile-dropzone
                = f.file_field :avatar, direct_upload: true, class: "profile-avatar-input", data: { "dropzone-target": "input" }
                .dropzone-msg.dz-message.needsclick
                  - if @user.avatar.attached?
                    = image_tag(@user.avatar, class: "profile-avatar", alt: t("ui.dashboard.profile.index.profile_avatar"))
                  - else
                    .profile-avatar.avatar-fallback class=avatar_fallback_color_class(full_name(@user))
                      = initials(@user)
                .form-check style="min-height: 0;"
                  input.d-none type="checkbox" value="" data-dropzone-target="doneCheck"
                span.d-none data-dropzone-target="fileName"
              .profile-avatar-edit-overlay data-action="click->dropzone#openFilePicker"
                = inline_svg_tag("camera.svg", class: "profile-avatar-edit-icon", alt: t("ui.dashboard.profile.index.change_avatar"))
            .profile-summary-content
              .profile-name
                - full = [@user.first_name.presence, @user.last_name.presence].compact.join(" ").presence
                h2 = full || t("dashboard.profile.index.unnamed_user")
                span.profile-badge = t("dashboard.profile.index.you")
              p.profile-summary-email = @user.email
              .profile-meta
                .profile-meta-item
                  = inline_svg_tag("location.svg", class: "profile-meta-icon", alt: "")
                  - location = [@address&.city.presence, @address&.state_name.presence].compact.join(", ")
                  span = location.presence || t("dashboard.profile.index.location_not_set")
                .profile-meta-item
                  = inline_svg_tag("calendar.svg", class: "profile-meta-icon", alt: "")
                  span
                    | #{t("dashboard.profile.index.active_in_last")}&nbsp;
                    - last_seen = @user.current_sign_in_at || @user.last_sign_in_at
                    = last_seen ? time_ago_in_words(last_seen) : t("dashboard.profile.index.nil")

          / .profile-section-label = t("dashboard.profile.index.you")

          .profile-card
            .profile-card-header
              h3 = t("dashboard.profile.index.public_profile")

            .profile-details
              .profile-row
                .profile-row-icon-cell
                  = inline_svg_tag("user.svg", class: "profile-icon", alt: "")
                .profile-row-content
                  label.profile-field-label for="user_name" = t("dashboard.profile.index.name_label")
                  = f.text_field :name, class: "profile-input", placeholder: t("dashboard.profile.index.name_label")

              .profile-row
                .profile-row-icon-cell
                  = inline_svg_tag("user.svg", class: "profile-icon", alt: "")
                .profile-row-content
                  label.profile-field-label for="user_display_name" = t("dashboard.profile.index.display_name_label")
                  = f.text_field :display_name, class: "profile-input", placeholder: t("dashboard.profile.index.display_name_label")

              = fields_for :address, @address || Address.new do |address_fields|
                .profile-row
                  .profile-row-icon-cell
                    = inline_svg_tag("calendar.svg", class: "profile-icon", alt: "")
                  .profile-row-content.profile-status-select
                    label.profile-field-label for="user_status" = t("dashboard.profile.index.status_label")
                    = f.select :status,
                      options_for_select(User.statuses.keys.map { |status| [t("enums.user.status.#{status}"), status] }, @user.status),
                      {},
                      class: "ui-select ui-control",
                      data: { controller: "select" }

                .profile-row
                  .profile-row-icon-cell
                    = inline_svg_tag("users.svg", class: "profile-icon", alt: "")
                  .profile-row-content
                    label.profile-field-label for="address_organization_name" = t("dashboard.profile.index.organization_label")
                    = address_fields.text_field :organization_name, class: "profile-input", placeholder: t("dashboard.profile.index.no_organization")

                .profile-row
                  .profile-row-icon-cell
                    = image_tag("phone_call.png", class: "profile-icon", alt: "")
                  .profile-row-content.profile-phone
                    label.profile-field-label for="address_phone_number" = t("dashboard.profile.index.phone_label")
                    = address_fields.text_field :phone_number, class: "profile-input", placeholder: t("dashboard.profile.index.no_phone")

                .profile-row
                  .profile-row-icon-cell
                    = inline_svg_tag("location.svg", class: "profile-icon", alt: "")
                  .profile-row-content
                    label.profile-field-label for="address_city" = t("dashboard.profile.index.city_placeholder")
                    = address_fields.text_field :city, class: "profile-input", placeholder: t("dashboard.profile.index.city_placeholder")

                .profile-row
                  .profile-row-icon-cell
                    = inline_svg_tag("location.svg", class: "profile-icon", alt: "")
                  .profile-row-content
                    label.profile-field-label for="address_state_name" = t("dashboard.profile.index.state_placeholder")
                    = address_fields.text_field :state_name, class: "profile-input", placeholder: t("dashboard.profile.index.state_placeholder")

          .profile-card.profile-account-card
            .profile-card-header
              h3 = t("dashboard.profile.index.account_information")
            .profile-details
              .profile-row
                .profile-row-icon-cell
                  = inline_svg_tag("calendar.svg", class: "profile-icon", alt: "")
                .profile-row-content.profile-readonly
                  span = t("dashboard.profile.index.created_at")
                  p = @user.created_at&.strftime("%d %b %Y").presence || t("dashboard.profile.index.nil")

              .profile-row
                .profile-row-icon-cell
                  = inline_svg_tag("email.svg", class: "profile-icon", alt: "")
                .profile-row-content.profile-readonly
                  span = t("dashboard.profile.index.email")
                  p = @user.email.presence || t("dashboard.profile.index.nil")
