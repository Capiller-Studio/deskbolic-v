.inbox-section.center-wrapper
  .inbox-container data-controller="toggler"
    .inbox-nav
      .card
        .f-semi-24 All Conversations
        .search-bar 
          = inline_svg_tag("search.svg", class:"search-icon", alt:"menu")
          p.f-reg-14 Search

        = turbo_frame_tag "conversations-list-frame" do
          = form_with url: conversations_path, method: :get, html: { id: "conversations-filter-form", data: { turbo_frame: "conversations-list-frame", turbo_action: "advance" } } do
            = hidden_field_tag "resource_id", @inbox&.id
            .filter-tabs
              = button_tag "All", type: "submit", name: "filter", value: "", form: "conversations-filter-form", class: "filter-tab #{@filter.blank? ? 'active' : ''}"
              = button_tag "Assigned", type: "submit", name: "filter", value: "assigned", form: "conversations-filter-form", class: "filter-tab #{@filter == 'assigned' ? 'active' : ''}"
              = button_tag "Unassigned", type: "submit", name: "filter", value: "unassigned", form: "conversations-filter-form", class: "filter-tab #{@filter == 'unassigned' ? 'active' : ''}"
          ul data-toggler-target="conversation hide"
            .inbox-nav-menu
              - @conversations.each do |conversation|
                - customer = conversation.customers.first
                - conversation_resource_id = [conversation.id, ("filter=#{@filter}" if @filter.present?)].compact.join("&")
                li.nav-item class="#{'55'=='cgh' ? 'inbox-nav-active' : ''}"
                  - if customer&.avatar&.attached?
                    = image_tag(customer.avatar, class:"user-img", alt:"menu")
                  - else
                    .user-img.avatar-fallback.customer-list-initials-avatar.f-reg-12 class=avatar_fallback_color_class(full_name(customer))
                      = initials(customer)
                  .nav-link.link data-target-id="conversations-frame" data-controller="section" data-action="click->section#toggleSection" data-url="#{conversation_path(conversation.id)}" data-resource-id="#{conversation_resource_id}"
                    - conversation.customers.each do |customer|
                      h4.f-semi-14 = full_name(customer)
                      p.f-reg-12 = conversation.messages.order(:created_at).last&.content
                  .actions
                    = inline_svg_tag("menu.svg", class:"menu-icon", alt:"menu")
                    = inline_svg_tag("close.svg", class:"close-icon", alt:"menu")
                    p.f-reg-10 = conversation.messages.order(:created_at).last&.created_at&.strftime("%d %b")
              
              turbo-frame.inbox-nav-menu#conversation-frame

    .inbox-body 
      turbo-frame#messages-frame
      == yield