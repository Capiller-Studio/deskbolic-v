= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "facebook-channels") do
    .channel-theme-facebook
      .ui-page-body
        .ui-page-header
          = link_to channels_facebook_index_path, class: "ui-back-link"
            | ← #{t("dashboard.facebook_channels.form.back")}
          h2.f-semi-32 = t("dashboard.facebook_channels.edit.title")

        /! Connection Status Section
        .ui-section
          .ui-section-header
            h3.f-semi-18 = t("dashboard.facebook_channels.form.connection_section")

          .channel-connection-card
            .channel-connection-info
              - if @facebook_channel.avatar_url.present?
                img.ui-avatar src=@facebook_channel.avatar_url alt=@facebook_channel.name
              - else
                .ui-avatar-placeholder
                  | 📘
              .ui-card-info
                h3.f-semi-16 = @facebook_channel.name || @facebook_channel.page_identifier
                p.ui-subtitle
                  | Page ID: #{@facebook_channel.page_identifier}

            - if @facebook_channel.reauthorization_required?
              .channel-reauth-banner
                .channel-reauth-icon ⚠️
                .channel-reauth-text
                  p.f-semi-14 = t("dashboard.facebook_channels.edit.reauth_title")
                  p.f-reg-12 = t("dashboard.facebook_channels.edit.reauth_description")
                = link_to reconnect_channels_facebook_path(@facebook_channel), method: :post, class: "channel-reconnect-btn", data: { turbo_method: :post }
                  | 🔄 #{t("dashboard.facebook_channels.index.reconnect")}
            - elsif @facebook_channel.active?
              .channel-status-active
                span.ui-badge.ui-badge-active
                  span.ui-badge-icon 🟢
                  span = t("dashboard.facebook_channels.index.status_active")

        /! Inbox Configuration Section
        .ui-section
          .ui-section-header
            h3.f-semi-18 = t("dashboard.facebook_channels.form.inbox_section")

          = form_with model: @facebook_channel, url: channels_facebook_path(@facebook_channel), method: :patch, class: "ui-form-wrapper" do |f|
            .ui-form-group
              = f.label :name, t("dashboard.facebook_channels.new.name_label"), class: "ui-label"
              = f.text_field :name, class: "ui-input", placeholder: t("dashboard.facebook_channels.new.name_placeholder")

            - if @facebook_channel.primary_inbox
              .channel-inbox-settings
                h4.f-semi-14 = t("dashboard.facebook_channels.edit.inbox_settings_title")

                = f.fields_for :primary_inbox, @facebook_channel.primary_inbox do |inbox|
                  = inbox.hidden_field :id

                  .ui-form-group.ui-checkbox-group
                    = inbox.check_box :csat_survey_enabled, class: "ui-checkbox"
                    = inbox.label :csat_survey_enabled, t("dashboard.facebook_channels.edit.csat_enabled"), class: "ui-checkbox-label"

                  .ui-form-group
                    = inbox.label :csat_survey_id, "CSAT Survey", class: "ui-label"
                    = inbox.collection_select :csat_survey_id, current_account.csat_surveys, :id, :name, { include_blank: "Default System Survey" }, class: "ui-select"
                
                  .ui-form-group
                    = inbox.label :sla_policy_ids, "SLA Policies", class: "ui-label"
                    = inbox.collection_select :sla_policy_ids, current_account.sla_policies, :id, :name, {}, { multiple: true, class: "ui-select" }

            .ui-form-actions
              = link_to channels_facebook_index_path, class: "ui-btn-secondary"
                | #{t("dashboard.facebook_channels.form.cancel")}
              = f.submit t("dashboard.facebook_channels.form.save"), class: "ui-btn-primary"

        /! Danger Zone
        .ui-section.ui-danger-zone
          .ui-section-header
            h3.f-semi-18 = t("dashboard.facebook_channels.edit.danger_title")
          p.f-reg-14 = t("dashboard.facebook_channels.edit.danger_description")
          = link_to channels_facebook_path(@facebook_channel), method: :delete, class: "ui-btn-danger", data: { turbo_method: :delete, turbo_confirm: t("dashboard.facebook_channels.index.delete_confirm") }
            | #{t("dashboard.facebook_channels.edit.disconnect")}
