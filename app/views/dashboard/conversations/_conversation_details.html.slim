.details-section data-controller="accordion"
  h2.f-semi-24 Details
  .descriptive-details
    .agent
      p.f-semi-14 Agent
      .card.agent-detail
        button.accordian data-action="click->accordion#toggle"
          = image_tag("profile_icon.png", class:"chat-user", alt: "menu")
          - if assigned_conversation
            p.f-reg-14 = current_user.display_name
          - else 
            p.f-reg-14 Unassigned
          = inline_svg_tag("arrow_down.svg", class:"arrow-icon ml-auto")
        .panel data-accordion-target="panel"
          .section-flex
            h5.f-reg-12 Assignee
            = inline_svg_tag("agent_icon.svg", class:"menu-icon", alt:"menu")
            - if assigned_conversation
              p.f-reg-12 = current_user.display_name
            - else
              = button_to("Assign to me", assign_member_conversation_path(@conversation), method: :post, class: "assign-btn f-reg-12")
    .team
      p.f-semi-14 Team
      .card.team-info
        button.accordian data-action="click->accordion#toggle"
          = inline_svg_tag("info.svg", class:"")
          p.f-reg-14 Technical
          = inline_svg_tag("arrow_down.svg", class:"arrow-icon ml-auto")
        .panel data-accordion-target="panel"
    .card.ticket-info
      button.accordian data-action="click->accordion#toggle"
        p.f-reg-14 Ticket info
        = inline_svg_tag("arrow_down.svg", class:"arrow-icon")
      .panel data-accordion-target="panel"
        .section-flex 
          h5.f-reg-14 Ticket ID: 
          .status-tag.bg-gray.f-reg-12 #1E233
        .section-flex 
          h5.f-reg-14 Created: 
          p.f-reg-14 = DateTime.current.strftime("%d %b %Y")
        .section-flex 
          h5.f-reg-14 Last message: 
          p.f-reg-14 = DateTime.current.strftime("%d %b %Y")
        .section-flex 
          h5.f-reg-14 Status: 
          .status-tag.bg-green.f-reg-12 Open
        .section-flex 
          h5.f-reg-14 Priority:
          .status-tag.bg-red.f-reg-12 Urgent
    .card.user-data
      button.accordian data-action="click->accordion#toggle"
        p.f-reg-14 Customer data
        = inline_svg_tag("arrow_down.svg", class:"arrow-icon")
      .panel data-accordion-target="panel"
        .user-details data-controller="accordion"
          .user-info
            .profile-pic
              = image_tag("profile_icon.png", class:"img", alt:"menu")
              p.f-reg-12 = @conversation.customers.first.display_name
            = inline_svg_tag("menu.svg", class:"profile-menu",  data: { "action" => "click->accordion#toggleMenu" })
          .menu data-accordion-target="menu"
            = link_to("#", class: "all menu-link") do
              p.f-reg-12 Show All
              = inline_svg_tag("export_arrow.svg", class:"menu-icon", alt:"menu")
            = link_to("#", class: "block menu-link") do
              = inline_svg_tag("block.svg", class:"menu-icon", alt:"menu")
              p.f-reg-12 Block
            = link_to("#", class: "unsub menu-link") do
              = inline_svg_tag("cross.svg", class:"menu-icon", alt:"menu")
              p.f-reg-12 Unsubscribe
        .section-flex
          = inline_svg_tag("user_id.svg", class: "left-img")
          h5.f-reg-12 Customer Id 
          p.f-reg-12.ml-auto = @conversation.customers.first.id.last(10)
        .section-flex 
          = inline_svg_tag("mail.svg", class: "left-img")
          h5.f-reg-12 Email
          p.f-reg-12.ml-auto = @conversation.customers.first.email
        .section-flex 
          = inline_svg_tag("location.svg", class: "left-img")
          h5.f-reg-12 Location
          p.f-reg-12.ml-auto = @conversation.customers.first.address.address1
    .card.tickets
      button.accordian data-action="click->accordion#toggle"
        p.f-reg-14 Tickets
        = inline_svg_tag("arrow_down.svg", class:"arrow-icon")
      .panel data-accordion-target="panel"
        .section-flex
          = inline_svg("ticket_black.svg", class: "left-img")
          h5.f-reg-12 Customer Ticket
          .ml-auto = inline_svg("refresh.svg")
        .section-flex
          = inline_svg("track.svg", class: "left-img")
          h5.f-reg-12 Tracker Ticket
          .ml-auto = inline_svg("plus_black.svg")
        .section-flex
          = inline_svg("office.svg", class: "left-img")
          h5.f-reg-12 Back-office Ticket
          p.f-reg-12.ml-auto = inline_svg("plus_black.svg")
        .section-flex
          = inline_svg("chat.svg", class: "left-img")
          h5.f-reg-12 Side Conversation
          .ml-auto = inline_svg("plus_black.svg")
    .card.user-notes
      button.accordian data-action="click->accordion#toggle"
        p.f-reg-14.mr-auto User notes
        = inline_svg_tag("plus_black.svg", class:"plus-icon", data: { action: "click->accordion#toggleNote"})
        = inline_svg_tag("arrow_down.svg", class:"arrow-icon")
      .panel.notes-panel data-accordion-target="panel"
        - @notes.each do |note|
          = render 'dashboard/notes/note', note: note
      .panel.note-panel data-accordion-target="npanel"
        .new-note
          = text_area_tag :content, "", class: "note-field f-reg-12", placeholder: "Add new note"
          .actions
            = image_tag("delete_note.png", class:"note-btn cancel-note", data: { action: "click->accordion#toggleNote"}, alt:"cancel")
            = image_tag("update_note.png", class:"note-btn add-note", data: { action: "click->accordion#addNote"}, alt: "Add")
            
    .card.user-tags
      button.accordian data-action="click->accordion#toggle"
        p.f-reg-14 User tags
        = inline_svg_tag("arrow_down.svg", class:"arrow-icon")
      .panel data-accordion-target="panel"
        .section-flex
          = inline_svg("tag.svg", class: "left-img")
          h5.f-reg-12 Featured Request
          .ml-auto = inline_svg("plus_black.svg")
        .section-flex
          = inline_svg("tag.svg", class: "left-img")
          h5.f-reg-12 Featured Request
          .ml-auto = inline_svg("plus_black.svg")
    / .card.recent-chats
      button.accordian data-action="click->accordion#toggle"
        p.f-reg-14 Recent chats
        = inline_svg_tag("arrow_down.svg", class:"arrow-icon")
      .panel data-accordion-target="panel"
        ul
          .inbox-nav-menu
            li.nav-item class=""
              = inline_svg_tag("chat1.svg", class:"user-img", alt:"menu")
              = link_to("#", class: "nav-link") do
                h4.f-semi-14 ProjectFlow Pro
                p.f-reg-12 scdbe fnjw fhbwj
              .actions
                = inline_svg_tag("menu.svg", class:"close-icon", alt:"menu")
                .status-tag.bg-green.f-reg-10 open
                = inline_svg_tag("close.svg", class:"close-icon", alt:"menu")
                p.f-reg-10 10 Day
                
            li.nav-item class=""
              = inline_svg_tag("chat1.svg", class:"user-img", alt:"menu")
              = link_to(conversations_path, class: "nav-link") do
                h4.f-semi-14 ProjectFlow Pro
                p.f-reg-12 scdbe fnjw fhbwj
              .actions
                = inline_svg_tag("menu.svg", class:"close-icon", alt:"menu")
                .status-tag.bg-red.f-reg-10 close
                = inline_svg_tag("close.svg", class:"close-icon", alt:"menu")
                p.f-reg-10 10 Day
                
            li.nav-item class=""
              = inline_svg_tag("chat1.svg", class:"user-img", alt:"menu")
              = link_to("#", class: "nav-link") do
                h4.f-semi-14 ProjectFlow Pro
                p.f-reg-12 scdbe fnjw fhbwj
              .actions
                = inline_svg_tag("menu.svg", class:"close-icon", alt:"menu")
                .status-tag.bg-green.f-reg-10 open
                = inline_svg_tag("close.svg", class:"close-icon", alt:"menu")
                p.f-reg-10 10 Day