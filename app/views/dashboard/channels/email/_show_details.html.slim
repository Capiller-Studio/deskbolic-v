section.channel-edit-section.channel-edit-card
  .channel-edit-section__heading.channel-edit-section__heading--with-description
    .channel-edit-section__icon
      = inline_svg_tag("mail.svg", aria: { hidden: true })
    .channel-edit-section__heading-copy
      h2 = t("dashboard.channels.show.email_forwarding", default: "Email Forwarding")
      p = t("dashboard.channels.show.email_forwarding_description", default: "Forward incoming support email to this Capiller Rely address.")
  .channel-edit-section__body
    .channel-edit-copy data-controller="clipboard"
      label = t("dashboard.channels.show.forwarding_address", default: "Forwarding Address")
      .channel-edit-copy__control
        input type="text" value=channel.forward_email readonly=true data-clipboard-target="source"
        button.channel-edit-copy__button type="button" data-action="click->clipboard#copy" data-clipboard-target="button"
          = inline_svg_tag("copy.svg", aria: { hidden: true })
          span = t("general.copy")

    dl.channel-show-details.channel-show-details--spaced
      .channel-show-details__item
        dt = t("dashboard.channels.show.forwarding_status", default: "Forwarding Status")
        dd
          span.channel-show-status class=(channel.forwarding_verified? ? "channel-show-status--enabled" : nil)
            span aria-hidden="true"
            = channel.forwarding_verified? ? t("dashboard.channels.show.verified", default: "Verified") : t("dashboard.channels.show.awaiting_verification", default: "Awaiting verification")
      .channel-show-details__item
        dt = t("dashboard.channels.show.receiving_address", default: "Receiving Address")
        dd = channel.email.presence || t("general.not_available", default: "Not available")

section.channel-edit-section.channel-edit-card
  .channel-edit-section__heading
    .channel-edit-section__icon
      = inline_svg_tag("settings.svg", aria: { hidden: true })
    h2 = t("dashboard.channels.show.mail_servers", default: "Mail Server Details")
  .channel-edit-section__body
    dl.channel-show-details
      .channel-show-details__item
        dt = t("dashboard.email_channels.form.smtp_address", default: "SMTP Server")
        dd = channel.smtp_configurations&.dig("address").presence || t("general.not_configured", default: "Not configured")
      .channel-show-details__item
        dt = t("dashboard.email_channels.form.smtp_port", default: "SMTP Port")
        dd = channel.smtp_configurations&.dig("port").presence || "587"
      .channel-show-details__item
        dt = t("dashboard.email_channels.form.smtp_authentication", default: "SMTP Authentication")
        dd = channel.smtp_configurations&.dig("authentication")&.humanize || t("general.not_configured", default: "Not configured")
      .channel-show-details__item
        dt = t("dashboard.email_channels.form.smtp_starttls", default: "STARTTLS")
        dd = channel_show_boolean_label(channel_show_configuration_enabled?(channel.smtp_configurations&.dig("enable_starttls")))
      .channel-show-details__item
        dt = t("dashboard.email_channels.form.imap_address", default: "IMAP Server")
        dd = channel.imap_configurations&.dig("address").presence || t("general.not_configured", default: "Not configured")
      .channel-show-details__item
        dt = t("dashboard.email_channels.form.imap_port", default: "IMAP Port")
        dd = channel.imap_configurations&.dig("port").presence || "993"
      .channel-show-details__item
        dt = t("dashboard.email_channels.form.imap_ssl", default: "IMAP SSL")
        dd = channel_show_boolean_label(channel_show_configuration_enabled?(channel.imap_configurations&.dig("enable_ssl")))
