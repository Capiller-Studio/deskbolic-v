= render("dashboard/settings/settings_sidebar", current_page: "macros") do
  .ui-settings-page.ui-macros-page
    header.ui-settings-page__header
      .ui-settings-page__heading
        h1 = t("dashboard.macros.index.title", default: "Macros")
        p = t("dashboard.macros.index.description", default: "One-click actions to speed up your workflow.")

      = link_to new_macro_path, class: "ui-settings-page__action" do
        span = t("dashboard.macros.index.new_macro", default: "New Macro")
        = inline_svg_tag("plus_white.svg", class: "ui-settings-page__action-icon", aria: { hidden: true })

    main.ui-settings-page__content
      .ui-macros-toolbar
        .ui-tabs.ui-responsive-tabs
          = link_to macros_path(q: params[:q]), class: "ui-tab #{params[:visibility].blank? ? 'ui-tab--active' : ''}"
            = t("dashboard.macros.index.tab_all", default: "All")
          = link_to macros_path(visibility: :account_wide, q: params[:q]), class: "ui-tab #{params[:visibility] == 'account_wide' ? 'ui-tab--active' : ''}"
            = t("dashboard.macros.index.account_wide", default: "Account-wide")
          = link_to macros_path(visibility: :personal, q: params[:q]), class: "ui-tab #{params[:visibility] == 'personal' ? 'ui-tab--active' : ''}"
            = t("dashboard.macros.index.tab_personal", default: "Personal")
          = link_to macros_path(visibility: :team, q: params[:q]), class: "ui-tab #{params[:visibility] == 'team' ? 'ui-tab--active' : ''}"
            = t("forms.options.team", default: "Team")

        = form_with url: macros_path, method: :get, class: "ui-macro-search-form" do
          = hidden_field_tag :visibility, params[:visibility] if params[:visibility].present?
          label.ui-search-field
            = inline_svg_tag("search_gray.svg", class: "ui-search-field__icon", aria: { hidden: true })
            = search_field_tag :q, params[:q], placeholder: t("dashboard.canned_responses.index.search_placeholder", default: "Search..."), class: "ui-search-field__input", onchange: "this.form.requestSubmit()"

      section.ui-panel.ui-macros-panel aria-labelledby="macros-table-title"
        h2#macros-table-title.ui-sr-only = t("dashboard.macros.index.title")

        .ui-table-wrap.ui-table-wrap--macros
          table.ui-table.ui-table--macros.ui-card-table
            colgroup
              col.ui-table__macro-column style="width: 38%;"
              col style="width: 20%;"
              col style="width: 16%;"
              col style="width: 12%;"
              col.ui-table__macro-actions-column style="width: 14%;"
            thead
              tr
                th = t("dashboard.macros.index.action", default: "Macro")
                th = t("dashboard.macros.form.visibility", default: "Visibility")
                th = t("dashboard.macros.form.action_details", default: "Actions")
                th style="text-align: center;" = t("dashboard.automations.form.status", default: "Status")
                th.ui-table__actions-heading style="text-align: right;" = t("dashboard.macros.index.actions", default: "Actions")
            tbody#macros-table-body
              - if @macros.empty?
                tr
                  td.ui-table__empty colspan="5"
                    = t("dashboard.macros.index.empty_description", default: "No macros found.")
              - else
                - @macros.each do |macro|
                  = render "dashboard/macros/macro_row", macro: macro

        - if @macros.any?
          footer.ui-pagination.ui-pagination--large.ui-labels-pagination
            p.ui-pagination__summary
              = t("dashboard.macros.index.showing", default: "Showing %{from} to %{to} of %{count} macros", from: @pagy.from, to: @pagy.to, count: @pagy.count)

            .ui-pagination__end
              = form_with url: macros_path, method: :get, class: "ui-rows-per-page" do
                = hidden_field_tag :visibility, params[:visibility] if params[:visibility].present?
                = hidden_field_tag :q, params[:q] if params[:q].present?
                label for="macro-rows-per-page" = t("dashboard.macros.index.rows_per_page", default: "Rows per page")
                .ui-settings-form
                  .ui-field-control.ui-field-control--compact.ui-field-control--no-icon.ui-field-control--rows
                    = select_tag :per_page,
                      options_for_select([10, 20, 50], @per_page),
                      id: "macro-rows-per-page",
                      class: "ui-select ui-control",
                      data: { controller: "select" },
                      onchange: "this.form.requestSubmit()"

              nav.ui-pagination__controls aria-label=t("dashboard.macros.index.pagination", default: "Macro pagination")
                - if @pagy.prev
                  = link_to macros_path(request.query_parameters.merge(page: @pagy.prev)), class: "ui-pagination__button", aria: { label: t("dashboard.macros.index.previous_page", default: "Previous page") }
                    = image_tag("audit_logs/audit-previous.svg", alt: "", aria: { hidden: true })
                - else
                  span.ui-pagination__button.ui-pagination__button--disabled aria-hidden="true"
                    = image_tag("audit_logs/audit-previous.svg", alt: "")

                span.ui-pagination__button.ui-pagination__button--active aria-current="page" = @pagy.page

                - if @pagy.next
                  = link_to macros_path(request.query_parameters.merge(page: @pagy.next)), class: "ui-pagination__button", aria: { label: t("dashboard.macros.index.next_page", default: "Next page") }
                    = image_tag("audit_logs/audit-next.svg", alt: "", aria: { hidden: true })
                - else
                  span.ui-pagination__button.ui-pagination__button--disabled aria-hidden="true"
                    = image_tag("audit_logs/audit-next.svg", alt: "")
