= form_with model: integration, url: url, id: "integration-form" do |f|
  = f.hidden_field :provider

  .ui-section.ui-section--always-open
    .ui-section-header
      .ui-section-title
        span.ui-section-icon 🔗
        span.ui-section-label = t("dashboard.settings.integrations.webhooks.basic_section")
    .ui-section-body
      .ui-form-row
        div
          = f.label :name, t("dashboard.settings.integrations.name_label", default: "Integration Name"), class: "ui-label"
          p.ui-input-hint style="margin-top: 0; margin-bottom: 8px;" = t("dashboard.settings.integrations.name_hint", default: "A friendly name to identify this integration.")
          = f.text_field :name, class: "ui-input", placeholder: "e.g. Production Webhook / CRM Sync"

      .ui-form-row style="margin-top: 24px;"
        div
          = f.label :webhook_url, t("dashboard.settings.integrations.webhooks.url_label"), class: "ui-label"
          p.ui-input-hint style="margin-top: 0; margin-bottom: 8px;" = t("dashboard.settings.integrations.webhooks.url_hint")
          = f.text_field :webhook_url, name: "integration[settings][webhook_url]", value: integration.webhook_url, class: "ui-input", placeholder: "https://your-server.com/webhooks/deskbolic", required: true

      - if integration.persisted?
        .ui-form-row style="margin-top: 24px;"
          div
            = f.label :webhook_secret, t("dashboard.settings.integrations.webhooks.secret_label"), class: "ui-label"
            p.ui-input-hint style="margin-top: 0; margin-bottom: 8px;" = t("dashboard.settings.integrations.webhooks.secret_hint")
            = f.text_field :webhook_secret, value: integration.webhook_secret, class: "ui-input", readonly: true, style: "background-color: #f8fafc; font-family: monospace;"
      
      .ui-form-row style="margin-top: 24px;"
        div
          = f.label :subscribed_events, t("dashboard.settings.integrations.webhooks.events_label"), class: "ui-label"
          
          .events-grid style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 12px;"
            - Integration::WEBHOOK_EVENTS.each do |event|
              .ui-toggle-row style="justify-content: flex-start; gap: 12px;"
                label.ui-toggle
                  = check_box_tag "integration[settings][subscribed_events][]", event, integration.subscribed_events.include?(event), id: "event_#{event.parameterize}"
                  span.ui-toggle-slider
                span.ui-toggle-label = event
                
  - if integration.persisted?
    .ui-section.ui-section--always-open style="margin-top: 24px;"
      .ui-section-header
        .ui-section-title
          span.ui-section-icon 📤
          span.ui-section-label = t("dashboard.settings.integrations.webhooks.instructions_title")
      .ui-section-body
        p.f-reg-14.text-muted.ui-inst-desc
          | #{t("ui.dashboard.integrations.webhook_form.when_subscribed_events_occur_deskbolic_will_send_an_http_post")}
          strong = t("dashboard.custom_channels.form.webhook_url")
          | .
        
        pre.ui-code-block style="margin-top: 12px; background: #1e293b; color: #f8fafc; padding: 16px; border-radius: 8px; font-size: 13px; overflow-x: auto;"
          code = "{\n  \"event\": \"message.created\",\n  \"data\": {\n    \"id\": \"msg_12345\",\n    \"content\": \"Hello, how can I help you today?\"\n  }\n}"
        
        p.f-reg-14.text-muted.ui-inst-verify style="margin-top: 24px;"
          | #{t("ui.dashboard.channels.custom.instructions.to_verify_that_the_request_actually_came_from_deskbolic_we")}
          strong = t("dashboard.settings.integrations.webhooks.secret_label")
          | #{t("ui.dashboard.channels.custom.instructions.we_include_this_signature_in_the")}
          code.ui-inst-inline-code = t("ui.dashboard.channels.custom.instructions.deskbolic_signature")
          | #{t("ui.dashboard.channels.custom.instructions.header_using_the_format")}
          code.ui-inst-inline-code
            | #{t("ui.dashboard.channels.custom.instructions.t_timestamp_v1_signature")}
          | .
          
        p.f-reg-14.text-muted.ui-inst-verify style="margin-top: 12px;"
          | #{t("ui.dashboard.channels.custom.instructions.you_should_verify_the_signature_on_your_server_to_prevent")}
          
        pre.ui-code-block style="margin-top: 12px; background: #f8fafc; color: #334155; padding: 16px; border-radius: 8px; font-size: 13px; overflow-x: auto; border: 1px solid #e2e8f0;"
          code = "header = request.headers[\"Deskbolic-Signature\"]\ntimestamp = header.match(/t=(\\d+)/)[1]\nsignature = header.match(/v1=([a-f0-9]+)/)[1]\n\n# 1. Prevent replay attacks\nreturn 401 if Time.now.to_i - timestamp.to_i > 300 # 5 minutes\n\n# 2. Verify HMAC signature\nexpected = OpenSSL::HMAC.hexdigest(\"SHA256\", WEBHOOK_SECRET, \"\#{timestamp}-\#{request.raw_post}\")\nreturn 401 unless Rack::Utils.secure_compare(expected, signature)"
