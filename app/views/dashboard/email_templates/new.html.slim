= render("dashboard/shared/dashboard_container", current_page: "email_templates") do
  = render("dashboard/settings/settings_sidebar", current_page: "email_templates") do
    .eb-templates
      .eb-templates__header
        div
          h2.eb-templates__title = t("dashboard.email_templates.new.title", default: "Create Email Template")
          p.eb-templates__subtitle = t("dashboard.email_templates.new.subtitle", default: "Choose a template type and name your template.")
        .eb-templates__nav
          = link_to email_templates_path, class: "eb-btn eb-btn--outline"
            = "Back"

      .eb-card
        .eb-card__body
          = form_with(model: @email_template, url: email_templates_path, method: :post, local: true, class: "eb-form") do |f|
            .eb-form-group
              = f.label :name, "Template Name", class: "eb-label"
              = f.text_field :name, class: "eb-form-input", required: true, placeholder: "e.g. My Custom Reply"
              
            .eb-form-group
              = f.label :template_type, "Template Type", class: "eb-label"
              = f.select :template_type, EmailTemplate.template_types.slice("conversation_reply", "csat_survey").keys.map { |type| [type.titleize, type] }, {}, class: "eb-form-input eb-select"

            .eb-form-actions
              = f.submit "Create Template", class: "eb-btn eb-btn--primary"
