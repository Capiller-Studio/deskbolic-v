= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "instagram-channels") do
    .ig-index-header
      .ig-title-area
        h2.f-semi-32 = t("dashboard.instagram_channels.index.title")
        p.f-reg-16 = t("dashboard.instagram_channels.index.description")
      = link_to new_channels_instagram_path, class: "ig-btn-primary"
        | + #{t("dashboard.instagram_channels.index.connect_account")}

    .ig-list
      - if @instagram_channels.any?
        - @instagram_channels.each do |channel|
          div.ig-card id=dom_id(channel)
            .ig-card-top
              .ig-card-info
                - if channel.avatar_url.present?
                  img.ig-profile-avatar src=channel.avatar_url alt=channel.name
                - else
                  .ig-profile-avatar-placeholder
                    | 📸
                .ig-profile-details
                  h3.f-semi-16 = channel.name || channel.username
                  p.ig-username
                    | @#{channel.username}
              .ig-card-actions
                = link_to edit_channels_instagram_path(channel), class: "ig-action-btn", title: "Edit"
                  | ✏️
                = link_to channels_instagram_path(channel), method: :delete, class: "ig-action-btn ig-action-delete", data: { turbo_method: :delete, turbo_confirm: t("dashboard.instagram_channels.index.delete_confirm") }, title: "Delete"
                  | 🗑️

            .ig-card-meta
              - if channel.reauthorization_required?
                .ig-badge.ig-badge-reauth
                  span.ig-badge-icon ⚠️
                  span = t("dashboard.instagram_channels.index.status_reauth")
              - elsif channel.token_expired?
                .ig-badge.ig-badge-expired
                  span.ig-badge-icon 🔴
                  span = t("dashboard.instagram_channels.index.status_expired")
              - elsif channel.token_expiring_soon?
                .ig-badge.ig-badge-expiring
                  span.ig-badge-icon ⏳
                  span = t("dashboard.instagram_channels.index.status_expiring")
              - elsif channel.active?
                .ig-badge.ig-badge-active
                  span.ig-badge-icon 🟢
                  span = t("dashboard.instagram_channels.index.status_active")

              .ig-meta-tag
                span.ig-meta-tag-icon 📬
                span = t("dashboard.instagram_channels.index.inboxes_count", count: channel.inboxes.size)

              - if channel.expires_at.present?
                .ig-meta-tag
                  span.ig-meta-tag-icon 🔑
                  span = t("dashboard.instagram_channels.index.token_expires", time: time_ago_in_words(channel.expires_at))

              .ig-meta-tag
                span.ig-meta-tag-icon 🕐
                span = t("dashboard.instagram_channels.index.created_ago", time: time_ago_in_words(channel.created_at))

      - else
        .ig-empty-state
          .ig-empty-icon 📸
          h3.f-semi-18 = t("dashboard.instagram_channels.index.empty_title")
          p.f-reg-14 = t("dashboard.instagram_channels.index.empty_description")
          = link_to new_channels_instagram_path, class: "ig-btn-primary ig-btn-sm"
            | + #{t("dashboard.instagram_channels.index.connect_account")}
