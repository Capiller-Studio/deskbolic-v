.autom-condition-group data-automation-builder-target="conditionGroup"
  .autom-group-header.ui-responsive-wrap-mobile
    span.autom-group-label = t("ui.dashboard.automations.condition_group.group_match", value: group_index + 1, default: "Group: %{value} — Match")
    .autom-group-pills
      button.autom-pill.autom-pill--sm type="button" class=("autom-pill--active" if (group.dig("operator") || "AND") == "AND") data-action="click->automation-builder#setGroupOperator" data-operator="AND" data-group-index="#{group_index}"
        = t("forms.options.all", default: "All")
      button.autom-pill.autom-pill--sm type="button" class=("autom-pill--active" if (group.dig("operator") || "AND") == "OR") data-action="click->automation-builder#setGroupOperator" data-operator="OR" data-group-index="#{group_index}"
        = t("forms.options.any", default: "Any")
    = hidden_field_tag "condition_group_operator_#{group_index}", (group.dig("operator") || "AND"), data: { "condition-group-operator": true }
    button.autom-remove-group-btn type="button" data-action="click->automation-builder#removeConditionGroup" title=t("ui.dashboard.automations.condition_group.remove_group", default: "Remove group")
      = image_tag("delete.svg", class: "autom-trash-icon", alt: "", aria: { hidden: true })

  div data-condition-group-rows=""
    - conditions = group.dig("conditions") || [{}]
    - conditions.each_with_index do |cond, ci|
      .autom-condition-row data-condition-row=""
        .ui-field-control.ui-field-control--plain.ui-field-control--no-icon style="flex: 1; min-width: 0;"
          = select_tag "cond_attr_#{group_index}_#{ci}", options_for_select(condition_attribute_options, cond["attribute"]), include_blank: t("forms.options.select_attribute"), class: "ui-select ui-control", data: { controller: "select", action: "change->automation-builder#attributeChanged", "condition-attr": true }
        .ui-field-control.ui-field-control--plain.ui-field-control--no-icon style="flex: 1; min-width: 0;"
          = select_tag "cond_op_#{group_index}_#{ci}", options_for_select(condition_operator_options, cond["operator"]), include_blank: t("forms.options.select_operator"), class: "ui-select ui-control", data: { controller: "select", "condition-op": true }
        span.ui-field-control.ui-field-control--plain.ui-field-control--no-icon data-condition-value-container="" style="flex: 1; min-width: 0;"
          = text_field_tag "cond_val_#{group_index}_#{ci}", cond["value"], placeholder: t("ui.dashboard.automations.condition_group.value", default: "Value..."), data: { "condition-val": true }, class: "ap-input"

        button.autom-remove-condition-btn type="button" data-action="click->automation-builder#removeCondition" aria-label=t("ui.dashboard.automations.condition_group.remove_condition", default: "Remove condition")
          = image_tag("cross.svg", class: "autom-close-icon", alt: "", aria: { hidden: true })

  button.autom-add-condition-link type="button" data-action="click->automation-builder#addCondition" data-group-index="#{group_index}"
    | + #{t("dashboard.automations.builder.add_condition", default: "Add Condition")}
