.helpdesk-section.center-wrapper
  .helpdesk-container data-controller="toggler"
    #channels-sidebar.helpdesk-nav data-toggler-target="sidebar"
      .card
        .header data-controller="modal-toggler frame-toggler"
          button.sidebar-toggle type="button" aria-controls="channels-sidebar" aria-expanded="true" aria-label=t("ui.dashboard.agent.agent_sidebar.menu") data-action="click->toggler#toggleSidebar" data-toggler-target="sidebarToggle"
            = inline_svg_tag("sidebar.svg", class:"link-icon", aria: { hidden: true })
          p.f-reg-14 = t('dashboard.sidebar.channels.title')
          = inline_svg_tag("note_pencil.svg", class:"note-pencil-icon ml-auto", alt:t("ui.dashboard.agent.agent_sidebar.menu"), data: { action: "click->modal-toggler#showModal click->frame-toggler#loadModal", popup_view:"_suggested_ticket_modal"})
          = render("dashboard/shared/modal_popper")
          turbo-frame#facebook-page-frame
        .channel-header.list-header data-controller="accordion modal-toggler frame-toggler"
          = inline_svg_tag("dropdown_icon.svg", class:"channel-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
          h4.f-reg-14 = t('dashboard.sidebar.channels.inboxes')
          .toggle-menu.ml-auto data-action="click->accordion#toggleMenu"
            = inline_svg_tag("menu.svg", class:"channel-menu ml-auto", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
          .menu data-accordion-target="menu"
            = link_to channels_settings_path(type: "email"), class: "menu-link"
              = inline_svg_tag("email.svg", class:"menu-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
              p.f-reg-14 = t('dashboard.sidebar.channels.email')
              = inline_svg_tag("plus.svg", class:"menu-icon ml-auto", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
            = link_to channels_settings_path(type: "facebook"), class: "menu-link"
              = inline_svg_tag("facebook.svg", class:"menu-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
              p.f-reg-14 = t('dashboard.sidebar.channels.facebook')
              = inline_svg_tag("plus.svg", class:"menu-icon ml-auto", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
            = link_to channels_settings_path(type: "instagram"), class: "menu-link"
              = inline_svg_tag("instagram.svg", class:"menu-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
              p.f-reg-14 = t('dashboard.sidebar.channels.instagram')
              = inline_svg_tag("plus.svg", class:"menu-icon ml-auto", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
            = link_to channels_settings_path(type: "whatsapp"), class: "menu-link"
              = inline_svg_tag("whatsapp.svg", class:"menu-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
              p.f-reg-14 = t('dashboard.sidebar.channels.whatsapp')
              = inline_svg_tag("plus.svg", class:"menu-icon ml-auto", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
            = link_to channels_settings_path(type: "web_widget"), class: "menu-link"
              = inline_svg_tag("widget.svg", class:"menu-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
              p.f-reg-14 = t('dashboard.sidebar.channels.widget')
              = inline_svg_tag("plus.svg", class:"menu-icon ml-auto", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
            = link_to channels_settings_path(type: "contact_form"), class: "menu-link"
              = inline_svg_tag("contact_form.svg", class:"menu-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
              p.f-reg-14 = t('dashboard.sidebar.channels.contact_form')
              = inline_svg_tag("plus.svg", class:"menu-icon ml-auto", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
        ul.channel-list  data-controller="accordion modal-toggler frame-toggler"
          .help-nav-menu
            / All inboxes
            li.nav-item class=""
              .nav-link.link data-target-id="conversations-frame" data-controller="section" data-action="click->section#toggleSection" data-url="#{conversations_path}"
                .link-text
                  = inline_svg_tag("inbox.svg", class:"link-icon", alt:t("ui.dashboard.channels.channels.inbox_icon"))
                  p.f-reg-14 = t('dashboard.sidebar.channels.all')
                .nav-link-badges style="display: flex; gap: 4px;"
                  - all_unread = @inboxes&.sum { |inbox| @unread_counts[:inboxes][inbox.id].to_i } || 0
                  .unread-badge data-controller="unread-badge" data-action="deskbolic:unread-counts-updated@window->unread-badge#update" data-unread-badge-target="badge" data-unread-badge-type-value="all" style="background: var(--primary-500, #4F46E5); color: white; border-radius: 12px; padding: 2px 8px; align-items: center; justify-content: center; display: #{all_unread > 0 ? 'flex' : 'none'}; width: 24px; height: 24px;"
                    p.f-semi-12 = all_unread
                  .back-oval-gray
                    p.f-reg-12 = current_account.conversations.count
            - @inboxes&.each do |inbox|
              li.nav-item class=""
                .nav-link.link data-target-id="conversations-frame" data-controller="section" data-action="click->section#toggleSection" data-url="#{conversations_path(resource_id: inbox.id)}"
                  .link-text
                    = inbox_icon(inbox)
                    p.f-reg-14 title=inbox.name style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 150px;" = inbox.name
                  .nav-link-badges style="display: flex; gap: 4px;"
                    - unread = @unread_counts[:inboxes][inbox.id].to_i
                    .unread-badge data-controller="unread-badge" data-action="deskbolic:unread-counts-updated@window->unread-badge#update" data-unread-badge-target="badge" data-unread-badge-id-value=inbox.id data-unread-badge-type-value="inbox" style="background: var(--primary-500, #4F46E5); color: white; border-radius: 12px; padding: 2px 8px; align-items: center; justify-content: center; display: #{unread > 0 ? 'flex' : 'none'}; width: 24px; height: 24px;"
                      p.f-semi-12 = unread
                    .back-oval-gray
                      p.f-reg-12 = inbox.conversations&.count
        
        / teams
        .teams-header.list-header
          = inline_svg_tag("dropdown_icon.svg", class:"channel-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
          h4.f-reg-14 = t('dashboard.sidebar.channels.teams')
        ul.teams-list.channel-list
          .help-nav-menu
            - @teams.each do |team|
              li.nav-item class=""
                .nav-link.pad-link
                  .link-text
                    = inline_svg_tag("users.svg", class:"link-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
                    p.f-reg-14 = team.name
                  .back-oval-gray
                    p.f-reg-12 = team.team_users.count

        / teammates
        .teams-header.list-header
          = inline_svg_tag("dropdown_icon.svg", class:"channel-icon", alt:t("ui.dashboard.agent.agent_sidebar.menu"))
          h4.f-reg-14 = t('dashboard.sidebar.channels.teammates')
        ul.teams-list.channel-list
          .help-nav-menu
            - @team_users.each do |team_user|
              li.nav-item class=""
                .nav-link.pad-link
                  .link-text
                    - if team_user.user.avatar&.attached?
                      = image_tag(team_user.user.avatar, class:"user-icon", alt:t("ui.dashboard.channels.channels.img"))
                    - else
                      .link-icon.avatar-fallback.customer-list-initials-avatar.f-reg-12 class=avatar_fallback_color_class(team_user.user.display_name)
                        = (team_user.user.display_name)&.first&.upcase
                    p.f-reg-14 = team_user.user.display_name
                  .back-oval-gray
                    p.f-reg-12 = team_user.user.teams.count
    
    .helpdesk-body
      turbo-frame#conversations-frame[data-turbo-permanent]
      == yield
