= render("dashboard/shared/dashboard_container", current_page: "settings") do
  = render("dashboard/settings/settings_sidebar", current_page: "custom-fields") do
    .ui-index-header
      .ui-title-area
        h1.f-semi-32 Custom Fields
        p.f-reg-16.text-muted Master data attributes for personalized customer experiences.
      = link_to new_custom_field_path, class: "ui-btn-primary"
        | + Create New Field

    .ui-list
      - if @custom_fields.any?
        - @custom_fields.each do |field|
          div.ui-card
            .ui-card-top
              .ui-card-info
                h3.f-semi-16 = field.key
                p.f-reg-13.text-muted style="margin-top: 4px;" = field.entity_type.titleize
              .ui-card-actions
                = link_to edit_custom_field_path(field), class: "ui-action-btn", title: "Edit"
                  | ✏️
                = link_to custom_field_path(field), method: :delete, class: "ui-action-btn ui-action-delete", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, title: "Delete"
                  | 🗑️

            .ui-card-meta
              .ui-meta-tag
                span.ui-meta-tag-icon 📝
                span Input Type: #{field.field_type.titleize}
              - if field.required?
                .ui-badge style="background: #fee2e2; color: #991b1b;"
                  span Required
              - if field.searchable?
                .ui-badge style="background: #dcfce7; color: #166534;"
                  span Searchable
              
              .ui-meta-tag
                span.ui-meta-tag-icon 🕐
                span Created #{time_ago_in_words(field.created_at)} ago

            - if field.translations.any?
              .channel-forward-row style="margin-top: 12px; display: flex; gap: 8px;"
                span.channel-forward-label Locales:
                - field.translations.pluck(:locale).each do |locale|
                  span style="background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-size: 11px; font-weight: 600; color: #475569;" = locale.upcase
      - else
        .ui-empty-state
          h3.f-semi-18 No Custom Fields found
          p.f-reg-14.text-muted Create your first custom field to start tracking rich customer data.
          = link_to new_custom_field_path, class: "ui-btn-primary"
            | + Create New Field
