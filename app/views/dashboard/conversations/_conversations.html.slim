- selected_scope = conversation_list_scope(inbox: @inbox, team_id: @team_id, teams: @teams, assignee_id: @assignee_id, account: current_account, filter: @filter)
- list_title = selected_scope.presence || t('dashboard.sidebar.channels.all_conversations', default: 'All conversations')
- list_total = @list_counts&.dig(@filter&.to_sym || :all) || @conversations.size
- scope_description = @inbox ? t('dashboard.conversations.in_inbox', default: 'Conversations in this inbox') : t('dashboard.conversations.across_inboxes', default: 'Everything across every inbox')
- filter_items = conversation_filter_items(@list_counts)

.inbox-section.center-wrapper.conversations-workspace class=(@conversation.present? ? 'is-conversation-open' : nil)
  .inbox-container
    aside.inbox-nav.conversation-list-pane
      .conversation-list-header
        .conversation-list-mobile-avatar
          - if current_user.avatar&.attached?
            = image_tag(current_user.avatar, alt: current_user.display_name)
          - else
            .avatar-fallback class=avatar_fallback_color_class(full_name(current_user))
              = initials(current_user)
        .conversation-list-heading
          .conversation-list-title
            h1 = list_title
            = inline_svg_tag('arrow.svg', class: 'conversation-list-title-chevron', aria: { hidden: true })
          p
            span = t('dashboard.conversations.showing_count', visible: @conversations.size, total: list_total)
            |  · #{scope_description}
      = form_with url: conversations_path, method: :get, local: true, class: 'conversation-search' do
        = hidden_field_tag :resource_id, @inbox&.id
        = hidden_field_tag :team_id, @team_id if @team_id.present?
        = hidden_field_tag :assignee_id, @assignee_id if @assignee_id.present?
        = hidden_field_tag :filter, @filter if @filter.present?
        = inline_svg_tag('search.svg', class: 'conversation-search-icon', aria: { hidden: true })
        = text_field_tag :q, @query, class: 'conversation-search-input', placeholder: t('dashboard.conversations.search_full', default: 'Search name, message or ticket'), aria: { label: t('dashboard.conversations.search') }, autocomplete: 'off', oninput: "clearTimeout(this._timer); this._timer=setTimeout(()=>Turbo.visit(this.form.action+'?'+new URLSearchParams(new FormData(this.form)).toString(),{action:'replace'}),300)"
        - if @query.present?
          = link_to conversations_path(resource_id: @inbox&.id, team_id: @team_id, assignee_id: @assignee_id, filter: @filter), class: 'conversation-search-clear', title: t('dashboard.conversations.search') do
            = image_tag('cross_clear.svg', alt: '', class: 'conversation-search-clear-icon')

      nav.conversation-filter-tabs aria-label=t('dashboard.conversations.filters', default: 'Conversation filters')
        - filter_items.each do |item|
          button.conversation-filter-tab type="button" class=(@filter.to_s == item[:key].to_s ? 'is-active' : '') data-controller="section" data-action="click->section#toggleSection" data-url=conversations_path(resource_id: @inbox&.id, team_id: @team_id, assignee_id: @assignee_id, filter: item[:key].presence, q: @query.presence)
            span = item[:label]
            small = item[:count]

      .conversation-list-mobile-summary
        span = t('dashboard.conversations.showing_count', visible: @conversations.size, total: list_total)

      .conversation-list-scroll data-controller="toggler"
        #conversations-list
          - if @conversations.empty?
            #conversation-list-empty.conversation-list-empty
              = image_tag('dashboard_empty_conversations.png', alt: '')
              h2 = t('dashboard.conversations.no_conversations_yet', default: 'No conversations yet')
              p = t('dashboard.conversations.no_conversations_description', default: 'When someone sends you a message, your conversations will appear here.')
          - else
            - @conversations.each do |conversation|
              = render 'dashboard/conversations/conversation', conversation: conversation

          - if @pagy_conversations&.next
            turbo-frame id="conversations-page-#{@pagy_conversations.next}" src=conversations_path(page: @pagy_conversations.next, resource_id: @inbox&.id, team_id: @team_id, assignee_id: @assignee_id, filter: @filter, q: @query.presence) loading="lazy"
              .conversation-list-loading = t('dashboard.conversations.loading_more', default: 'Loading more conversations…')

    main.inbox-body.conversation-content-pane
      turbo-frame#messages-frame
        == yield
        - unless @conversation
          - if @inboxes.empty?
            .conversation-selection-empty.ui-empty-state
              = image_tag('dashboard_no_conversation_selected.png', alt: '')
              h2 = t('dashboard.channels_overview.empty_title', default: 'No channels found')
              p = t('dashboard.channels_overview.empty_description', default: 'Connect a channel to start receiving customer conversations in Deskbolic.')
              = link_to t('dashboard.channels_overview.add_channel', default: 'Add new channel'), channels_path, class: 'ui-btn-primary', data: { turbo_frame: '_top' }
          - else
            .conversation-selection-empty
              = image_tag('dashboard_no_conversation_selected.png', alt: '')
              h2 = t('dashboard.conversations.no_selection', default: 'No conversation selected')
              p = t('dashboard.conversations.no_selection_description', default: 'Choose a conversation from the list to view messages and details here.')
